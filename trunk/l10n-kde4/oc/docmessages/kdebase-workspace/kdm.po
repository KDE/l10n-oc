#. Tag: para
#: index.docbook:59
#, no-c-format
msgid ""
"This document describes &kdm; the &kde; Display Manager. &kdm; is also known "
"as the <quote>Login Manager</quote>."
msgstr ""

#. Tag: keyword
#: index.docbook:64
#, no-c-format
msgid "<keyword>KDE</keyword>"
msgstr "<keyword>KDE</keyword>"

#. Tag: keyword
#: index.docbook:65
#, no-c-format
msgid "<keyword>kdm</keyword>"
msgstr ""

#. Tag: keyword
#: index.docbook:66
