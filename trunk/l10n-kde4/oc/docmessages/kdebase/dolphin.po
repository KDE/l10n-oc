#. Tag: title
#: index.docbook:1335
#, no-c-format
msgid "Requirements"
msgstr ""

#. Tag: para
#: index.docbook:1337
#, no-c-format
msgid ""
"In order to successfully use &dolphin; you need to at least have kdebase and "
"kdelibs from &kde; 3.5 installed. &dolphin; may work on older versions of "
"&kde;, however not all functions offered by &dolphin; may work."
msgstr ""

#. Tag: para
#: index.docbook:1342
#, no-c-format
msgid ""
"In order to compile &dolphin; you will also require libqt2-mt-dev, libx11-"
"dev, kdebase-dev, zlibg-dev and gcc."
msgstr ""

#. Tag: para
#: index.docbook:1346
#, no-c-format
msgid "Other &kde; libraries may also be required for some advanced features."
msgstr ""

