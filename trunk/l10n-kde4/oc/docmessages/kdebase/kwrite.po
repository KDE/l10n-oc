"Lists version information for &Qt;, &kde;, and &kwrite;. Also available "
"through <userinput><command>kwrite</command> <option>-v</option></userinput>"
msgstr ""

#. Tag: userinput
#: index.docbook:168
#, no-c-format
msgid "<command>kwrite</command> <option>--stdin</option>"
msgstr ""

#. Tag: para
#: index.docbook:170
#, no-c-format
msgid ""
"Causes &kwrite; to read the document content from STDIN. This is similar to "
"the common option <option>-</option> used in many command line programs, and "
"allows you to pipe command output into &kwrite;."
msgstr ""

#. Tag: userinput
#: index.docbook:175
#, no-c-format
msgid ""
"<command>kwrite</command> <option>--encoding</option> <parameter>encoding</"
"parameter> <parameter>&URL;</parameter>"
msgstr ""

#. Tag: para
#: index.docbook:178
#, no-c-format
msgid "Causes &kwrite; to use the specified encoding for the document."
msgstr ""

#. Tag: userinput
#: index.docbook:182
#, no-c-format
