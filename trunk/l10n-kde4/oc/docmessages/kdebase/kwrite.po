#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>O</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Open...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:574
#, no-c-format
msgid ""
"Displays a standard &kde; <guilabel>Open File</guilabel> dialog. Use the "
"file view to select the file you want to open, and click on <guibutton>Open</"
"guibutton> to open it. You can find more information about the &kde; "
"<guilabel>Open File</guilabel> dialog in the &kde; User Guide."
msgstr ""

#. Tag: menuchoice
#: index.docbook:585
#, no-c-format
msgid "<guimenu>File</guimenu> <guisubmenu>Open Recent</guisubmenu>"
msgstr ""

#. Tag: para
#: index.docbook:591
#, no-c-format
msgid ""
"This is a shortcut to open recently saved documents. Clicking on this item "
"opens a list to the side of the menu with several of the most recently saved "
"files. Clicking on a specific file will open it in &kwrite; - if the file "
"still resides at the same location."
msgstr ""

#. Tag: menuchoice
#: index.docbook:603
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Save</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:612
#, no-c-format
msgid ""
"This saves the current document. If there has already been a save of the "
"document then this will overwrite the previously saved file without asking "
"for the user's consent. If it is the first save of a new document the save "
"as dialog (described below) will be invoked."
msgstr ""

#. Tag: menuchoice
#: index.docbook:623
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Save As...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:629
#, no-c-format
msgid ""
"This allows a document to be saved with a new file name. This is done by "
"means of the file dialog box described above in the <link linkend=\"open"
"\">Open</link> section of this help file."
msgstr ""

#. Tag: menuchoice
#: index.docbook:639
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\"><keycap>F5</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Reload</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:648
#, no-c-format
msgid ""
"Reloads the active file from disk. This command is useful if another program "
"or process has changed the file while you have it open in &kwrite;."
msgstr ""

#. Tag: menuchoice
#: index.docbook:657
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Print...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:666
#, no-c-format
msgid ""
"Opens a simple print dialog allowing the user to specify what, where, and "
"how to print."
msgstr ""

#. Tag: menuchoice
#: index.docbook:675
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Export as HTML...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:681
#, no-c-format
msgid ""
"Export your file in HTML format so your document can be viewed as a web page."
msgstr ""

#. Tag: menuchoice
#: index.docbook:689
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>W</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Close</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:698
#, no-c-format
msgid ""
"Close the active file with this command. If you have made unsaved changes, "
"you will be prompted to save the file before &kwrite; closes it."
msgstr ""

#. Tag: menuchoice
#: index.docbook:707
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:716
#, no-c-format
msgid ""
"This will close the editor window, if you have more than one instance of "
"&kwrite; running, through the <guimenuitem>New View</guimenuitem> or "
"<guimenuitem>New Window</guimenuitem> menu items, those instances will not "
"be closed."
msgstr ""

#. Tag: title
#: index.docbook:730
#, no-c-format
msgid "The <guimenu>Edit</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: index.docbook:734
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Undo</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:740
#, no-c-format
msgid ""
"This is used to eliminate or reverse the most recent user action or "
"operation."
msgstr ""

#. Tag: menuchoice
#: index.docbook:752
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>Z</keycap></"
"keycombo></shortcut> <guimenu>Edit</guimenu><guimenuitem>Redo</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:757
#, no-c-format
msgid "This will reverse the most recent change (if any) made using Undo"
msgstr ""

#. Tag: menuchoice
#: index.docbook:762
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>X</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu><guimenuitem>Cut</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:767
#, no-c-format
msgid ""
"This command deletes the current selection and places it on the clipboard. "
"The clipboard is a feature of &kde; that works invisibly to provide a way to "
"transfer data between applications."
msgstr ""

#. Tag: menuchoice
#: index.docbook:775
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu><guimenuitem>Copy</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:780
#, no-c-format
msgid ""
"This copies the currently selected text to the clipboard so that it may be "
"pasted elsewhere. The clipboard is a feature of &kde; that works invisibly "
"to provide a way to transfer data between applications."
msgstr ""

#. Tag: menuchoice
#: index.docbook:787
#, no-c-format
msgid "<guimenu>Edit</guimenu><guimenuitem>Copy as HTML</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:791
#, no-c-format
msgid "This copies the currently selected text to the clipboard as HTML."
msgstr ""

#. Tag: menuchoice
#: index.docbook:796
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>V</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu><guimenuitem>Paste</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:801
#, no-c-format
msgid ""
"This will insert the contents of the clipboard at the cursor position. The "
"clipboard is feature of &kde; that works invisibly to provide a way to "
"transfer data between applications."
msgstr ""

#. Tag: menuchoice
#: index.docbook:808
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>A</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu><guimenuitem>Select All</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:813
#, no-c-format
msgid ""
"This will select the entire document. This could be very useful for copying "
"the entire file to another application."
msgstr ""

#. Tag: menuchoice
#: index.docbook:819
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>A</keycap></"
"keycombo> </shortcut> <guimenu>Edit</guimenu><guimenuitem>Deselect</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:825
#, no-c-format
msgid "Deselects the selected text in the editor if any."
msgstr ""

#. Tag: menuchoice
#: index.docbook:830
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>B</keycap></"
"keycombo> </shortcut> <guimenu>Edit</guimenu><guimenuitem>Bloc Selection "
"Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:837
#, no-c-format
msgid ""
"Toggles Selection Mode. When the Selection Mode is “BLOCK”, you can make "
"vertical selections, ie select column 5 to 10 in lines 9 to 15. The status "
"bar shows the current state of the Selection Mode, either “NORM” or “BLK”."
msgstr ""

#. Tag: menuchoice
#: index.docbook:845
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\"><keycap>Insert</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu><guimenuitem>Overwrite Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:852
#, no-c-format
msgid ""
"Toggles the Insert/Overwrite modes. When the mode is \"INS\", you insert "
"characters where the cursor is. When the mode is \"OVR\", writing characters "
"will replace the current characters if your cursor is positioned before any "
"character. The status bar shows the current state of the Overwrite Mode, "
"either “INS” or “OVR”."
msgstr ""

#. Tag: menuchoice
#: index.docbook:861
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>F</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu><guimenuitem>Find</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:866
#, no-c-format
msgid ""
"This opens the find dialog which is used to specify the <guilabel>Text to "
"Find</guilabel> in the document. There is small text box for entering the "
"search pattern which also doubles as a dropdown box. Clicking on the "
"dropdown arrow at the side of the box makes available other recent search "
"patterns. Other parameters are included to make the search more efficient. "
"Selecting <guilabel>Case Sensitive</guilabel> will limit finds to entries "
"that match the case (upper or lower) of each of the characters in the search "
"pattern. <guilabel>Find Backwards</guilabel> directs the search to proceed "
"in an upwardly direction. The <guilabel>Selected Text</guilabel> option "
"keeps the search within currently selected text. Checking <guilabel>Whole "
"Words Only</guilabel> prevents the search from stopping on words that "
"contain the searched for pattern. The <guilabel>Search from Cursor</"
"guilabel> option begins the search from the current position of the cursor "
"within the document rather than from the beginning."
msgstr ""

#. Tag: menuchoice
#: index.docbook:884
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F3</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu><guimenuitem>Find Next</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:888
#, no-c-format
msgid ""
"This repeats the last find operation, if any, without calling the find "
"dialog box."
msgstr ""

#. Tag: menuchoice
#: index.docbook:896
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Shift;<keycap>F3</keycap></keycombo> "
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find Previous</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:905
#, no-c-format
msgid ""
"This repeats the last find operation, if any, without calling the find "
"dialog box, and searching backwards instead of forwards through the document."
msgstr ""

#. Tag: menuchoice
#: index.docbook:914
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>R</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu><guimenuitem>Replace...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:919
#, no-c-format
msgid ""
"This command opens the replace dialog box. The replace dialog is almost "
"identical to the above-mentioned find dialog. In addition to the features in "
"the find dialog it contains a <guilabel>Replace With:</guilabel> text entry/"
"dropdown box. Using this dialog the user can specify both the text to be "
"found and text with which to replace it. The additional <guilabel>Prompt On "
"Replace</guilabel> option allows the user to have &kwrite; ask for "
"confirmation before each replacement."
msgstr ""

#. Tag: menuchoice
#: index.docbook:932
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>G</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Go to line</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:939
#, no-c-format
msgid ""
"This opens the goto line dialog box which is used to have the cursor jump to "
"a particular line (specified by number) in the document. The line number may "
"be entered directly into the text box or graphically by clicking on the up "
"or down arrow spin controls at the side of the text box. The little up arrow "
"will increase the line number and the down arrow decrease it. There is also "
"a slide control to the right of the text box which allows the user to move "
"the goto point in the document in an analog manner."
msgstr ""

#. Tag: title
#: index.docbook:955
#, no-c-format
msgid "The <guimenu>View</guimenu> menu"
msgstr ""

#. Tag: para
#: index.docbook:957
#, no-c-format
msgid ""
"The <guimenu>View</guimenu> menu allows you to manage settings specific to "
"the active editor, and to manage frames."
msgstr ""

#. Tag: menuchoice
#: index.docbook:965
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>New Window</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:971
#, no-c-format
msgid "Opens a new window with the same text."
msgstr ""

#. Tag: menuchoice
#: index.docbook:978
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F7</keycap></keycombo></"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Switch to Command Line</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:986
#, no-c-format
msgid ""
"Displays the Katepart command line at the bottom of the window. In the "
"command line, type \"help\" to get help and \"help list\" to get a list of "
"commands."
msgstr ""

#. Tag: menuchoice
#: index.docbook:995
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Schema</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1001
#, no-c-format
msgid "Select a font schema."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1008
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F10</keycap></keycombo></"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Dynamic Word Wrap</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1015
#, no-c-format
msgid "The text lines will be wrapped at the view border on the screen."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1023
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F10</keycap></keycombo></"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Dynamic Word Wrap Indicators</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1030
#, no-c-format
msgid ""
"Choose when and how the dynamic word wrap indicators should be displayed. "
"This is only available if the <guilabel>Dynamic Word Wrap</guilabel> option "
"is checked."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1039
#, no-c-format
msgid ""
"<guimenu>View</guimenu> <guimenuitem>Show Static Word Wrap Marker</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1045 index.docbook:2204
#, no-c-format
msgid ""
"If this option is checked, a vertical line will be drawn at the word wrap "
"column as defined in the <menuchoice> <guimenu>Settings</guimenu> "
"<guimenuitem>Configure Editor...</guimenuitem></menuchoice> in the Editing "
"tab. Please note that the word wrap marker is only drawn if you use a fixed "
"pitch font."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1057
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F6</keycap></keycombo></"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Show Icon Border</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1064
#, no-c-format
msgid ""
"This is a toggle item. Setting it on checked will make the side of the "
"active editor, and vice versa."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1072
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F11</keycap></keycombo></"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Show Line Numbers</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1079
#, no-c-format
msgid ""
"This is a toggle Item. Setting it on checked will make a pane displaying the "
"line numbers of the document visible in the left border of the active "
"editor, and vice versa."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1088
#, no-c-format
msgid "<guimenu>View</guimenu> <guisubmenu>Show Scrollbar Marks</guisubmenu>"
msgstr ""

#. Tag: para
#: index.docbook:1094
#, no-c-format
msgid ""
"If this option is checked, the view will show marks on the vertical "
"scrollbar."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1102
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F9</keycap></keycombo></"
"shortcut> <guimenuitem>Hide Folding Markers</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1108
#, no-c-format
msgid "If this option is checked, the marks for code folding will be hidden."
msgstr ""

#. Tag: guimenuitem
#: index.docbook:1117
#, no-c-format
msgid "<guimenuitem>Code Folding</guimenuitem>"
msgstr ""

#. Tag: menuchoice
#: index.docbook:1123
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>Ctrl</keycap> <keycap>Shift</"
"keycap><keycap>-</keycap></keycombo></shortcut> <guimenuitem>Collapse "
"Toplevel</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1127
#, no-c-format
msgid "Collapse all toplevel regions in the document."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1130
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>Ctrl</keycap> <keycap>Shift</"
"keycap><keycap>+</keycap></keycombo></shortcut> <guimenuitem>Expand "
"Toplevel</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1134
#, no-c-format
msgid "Expand all toplevel regions in the document."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1137
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>Ctrl</keycap> <keycap>-</"
"keycap></keycombo></shortcut> <guimenuitem>Collapse One Local Level</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1141
#, no-c-format
msgid "Collapse the region closest to the cursor."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1144
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>Ctrl</keycap> <keycap>+</"
"keycap></keycombo></shortcut> <guimenuitem>Expand One Local Level</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1148
#, no-c-format
msgid "Expand the region closest to the cursor."
msgstr ""

#. Tag: title
#: index.docbook:1159
#, no-c-format
msgid "The <guimenu>Bookmarks</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: index.docbook:1164
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>B</keycap></keycombo> </"
"shortcut> <guimenu>Bookmarks</guimenu> <guimenuitem>Set Bookmark</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1173
#, no-c-format
msgid ""
"Sets or removes a bookmark in the current line of the active document. (If "
"it's there, it is removed, otherwise one is set)."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1182
#, no-c-format
msgid ""
"<guimenu>Bookmarks</guimenu> <guimenuitem>Clear All Bookmarks</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1188
#, no-c-format
msgid ""
"This command will remove all the markers from the document as well as the "
"list of markers which is appended at the bottom of this menu item."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1196
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>Alt</keycap> <keycap>Page Up</"
"keycap></keycombo></shortcut> <guimenu>Bookmarks</"
"guimenu><guimenuitem>Previous</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1200
#, no-c-format
msgid ""
"This will move the cursor to beginning of the first above line with a "
"bookmark. The menuitem text will include the line number and the first piece "
"of text on the line. This item is only available when there is a bookmark in "
"a line above the cursor."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1207
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>Alt</keycap> <keycap>Page Down</"
"keycap></keycombo></shortcut> <guimenu>Bookmarks</guimenu><guimenuitem>Next</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1210
#, no-c-format
msgid ""
"This will move the cursor to beginning of the next line with a bookmark. The "
"menuitem text will include the line number and the first piece of text on "
"the line. This item is only available when there is a bookmark in a line "
"below the cursor."
msgstr ""

#. Tag: para
#: index.docbook:1218
#, no-c-format
msgid ""
"At the bottom of this menu, a list of markers appears if any markers are "
"available for this window."
msgstr ""

#. Tag: title
#: index.docbook:1226
#, no-c-format
msgid "The <guimenu>Tools</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: index.docbook:1230
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Read Only Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1234
#, no-c-format
msgid ""
"Set the current document to Read Only mode. This prevents any text addition "
"and any changes in the document formatting."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1240
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Filletype</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1244
#, no-c-format
msgid ""
"Choose the filetype scheme you prefer for the active document. This "
"overwrites the global filetype mode set in <menuchoice> <guimenu>Settings</"
"guimenu> <guimenuitem>Configure Editor...</guimenuitem></menuchoice> in the "
"Filetypes tab for your current document only."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1254
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Highlighting</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1258
#, no-c-format
msgid ""
"Choose the Highlighting scheme you prefer for the active document. This "
"overwrites the global highlighting mode set in <menuchoice> "
"<guimenu>Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem></"
"menuchoice> for your current document only."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1267
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Indentation</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1271
#, no-c-format
msgid ""
"Choose the style of indentation you want for your active document. This "
"overwrites the global indentation mode set in <menuchoice> "
"<guimenu>Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem></"
"menuchoice> for your current document only."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1280
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Encoding</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1284
#, no-c-format
msgid ""
"You can overwrite the default encoding set in <menuchoice> "
"<guimenu>Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem></"
"menuchoice> in the <guilabel>Open/Save</guilabel> tab to set a different "
"encoding for your current document. The encoding you set here will be only "
"valid for your current document."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1294
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>End of Line</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1298
#, no-c-format
msgid ""
"Choose your prefered end of line mode for your active document. This "
"overwrites the global end of line mode set in <menuchoice> "
"<guimenu>Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem></"
"menuchoice> for your current document only."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1307
#, no-c-format
msgid "<guimenu>Tools</guimenu><guimenuitem>Spelling...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1311
#, no-c-format
msgid ""
"<action>This initiates the spellchecking program - a program designed to "
"help the user catch and correct any spelling errors.</action> Clicking on "
"this entry will start the checker and bring up the speller dialog box "
"through which the user can control the process. There are four settings "
"lined up vertically in the center of the dialog with their corresponding "
"labels just to the left. Starting at the top they are:"
msgstr ""

#. Tag: guilabel
#: index.docbook:1320
#, no-c-format
msgid "Unknown word:"
msgstr ""

#. Tag: para
#: index.docbook:1321
#, no-c-format
msgid ""
"Here, the spellchecker indicates the word currently under consideration. "
"This happens when the checker encounters a word not in its dictionary - a "
"file containing a list of correctly spelled words against which it compares "
"each word in the editor."
msgstr ""

#. Tag: guilabel
#: index.docbook:1327
#, no-c-format
msgid "Replace with:"
msgstr ""

#. Tag: para
#: index.docbook:1328
#, no-c-format
msgid ""
"If the checker has any similar words in its dictionary the first one will be "
"listed here. The user can accept the suggestion, type in his or her own "
"correction, or choose a different suggestion from the next box."
msgstr ""

#. Tag: guilabel
#: index.docbook:1334
#, no-c-format
msgid "Suggested Words:"
msgstr ""

#. Tag: para
#: index.docbook:1335
#, no-c-format
msgid ""
"The checker may list here a number of possible replacements for the word "
"under consideration. Clicking on any one of the suggestions will cause that "
"word to be entered in the <guilabel>Replacement:</guilabel> box, above."
msgstr ""

#. Tag: guilabel
#: index.docbook:1341
#, no-c-format
msgid "Language:"
msgstr "Lenga :"

#. Tag: para
#: index.docbook:1342
#, no-c-format
msgid ""
"If you have installed multiple dictionaries, here you can select which "
"dictionary/language should be used."
msgstr ""

#. Tag: para
#: index.docbook:1347
#, no-c-format
msgid ""
"On the right side of the dialog box are 5 buttons that allow the user to "
"control the spellcheck process. They are:"
msgstr ""

#. Tag: guibutton
#: index.docbook:1352
#, no-c-format
msgid "Add to Dictionary"
msgstr ""

#. Tag: para
#: index.docbook:1353
#, no-c-format
msgid ""
"Pressing this button adds the word in the <guilabel>Misspelled Word:</"
"guilabel> box to the checker's dictionary. This means that in the future the "
"checker will always consider this word to be correctly spelled."
msgstr ""

#. Tag: guibutton
#: index.docbook:1359
#, no-c-format
msgid "<guibutton>Replace</guibutton>"
msgstr ""

#. Tag: para
#: index.docbook:1360
#, no-c-format
msgid ""
"This button has the checker replace the word under consideration in the "
"document with the word in the <guilabel>Replacement:</guilabel> box."
msgstr ""

#. Tag: guibutton
#: index.docbook:1365
#, no-c-format
msgid "Replace All"
msgstr "Tot remplaçar"

#. Tag: para
#: index.docbook:1366
#, no-c-format
msgid ""
"This button causes the checker to replace not only the current "
"<guilabel>Unknown word:</guilabel> but to automatically make the same "
"substitution for any other occurrences of this <guilabel>Misspelled Word:</"
"guilabel> in the document."
msgstr ""

#. Tag: guibutton
#: index.docbook:1372
#, no-c-format
msgid "Ignore"
msgstr "Ignorar"

#. Tag: para
#: index.docbook:1373
#, no-c-format
msgid ""
"Activating this button will have the checker move on without making any "
"changes."
msgstr ""

#. Tag: guibutton
#: index.docbook:1377
#, no-c-format
msgid "Ignore All"
msgstr ""

#. Tag: para
#: index.docbook:1378
#, no-c-format
msgid ""
"This button tells the checker to do nothing with the current "
"<guilabel>Unknown word:</guilabel> and to pass over any other instances of "
"the same word."
msgstr ""

#. Tag: para
#: index.docbook:1380
#, no-c-format
msgid ""
"This only applies to the current spellcheck run. If the checker is run again "
"later it will stop on this same word."
msgstr ""

#. Tag: para
#: index.docbook:1397
#, no-c-format
msgid ""
"Three more buttons are located horizontally along the bottom of the "
"spellcheck dialog. They are:"
msgstr ""

#. Tag: guibutton
#: index.docbook:1402
#, no-c-format
msgid "<guibutton>Help</guibutton>"
msgstr ""

#. Tag: para
#: index.docbook:1403
#, no-c-format
msgid ""
"This invokes the &kde; help system starting at the &kwrite; help pages (this "
"document)."
msgstr ""

#. Tag: guibutton
#: index.docbook:1408
#, no-c-format
msgid "Finished"
msgstr "Terminat"

#. Tag: para
#: index.docbook:1409
#, no-c-format
msgid "This button ends the spellcheck process, and returns to the document."
msgstr ""

#. Tag: guibutton
#: index.docbook:1414
#, no-c-format
msgid "Cancel"
msgstr "Anullar"

#. Tag: para
#: index.docbook:1415
#, no-c-format
msgid ""
"This button cancels the spellcheck process, all modifications are reverted, "
"and you will return to your document."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1425
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Spelling (from cursor)...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1429
#, no-c-format
msgid ""
"This initiates the spellchecking program but it starts where your cursor is "
"instead of at the beginning of the document."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1435
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Spellcheck Selection...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1439
#, no-c-format
msgid "Spellchecks the current selection."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1444
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>I</keycap></keycombo> </"
"shortcut> <guimenu>Tools</guimenu><guimenuitem>Indent</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1450
#, no-c-format
msgid ""
"This increases the paragraph's indentation by one step. The size of the step "
"depends on the <link linkend=\"pref-indent\"> indentation settings</link>."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1457
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>I</keycap></"
"keycombo> </shortcut> <guimenu>Tools</guimenu><guimenuitem>Unindent</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1464
#, no-c-format
msgid ""
"This reduces the paragraph's indentation by one step. The size of the step "
"depends on the <link linkend=\"pref-indent\"> indentation settings</link>."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1472
#, no-c-format
msgid "<guimenu>Tools</guimenu><guimenuitem>Clean Indentation</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1475
#, no-c-format
msgid ""
"This cleans the indentation for the current selection or for the line the "
"cursor is currently in. Cleaning the indentation ensures that all your "
"selected text follows the indentation mode you choose."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1482
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Align</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1487
#, no-c-format
msgid ""
"Causes a realign of the current line or selected lines using the indentation "
"mode and indentation settings in the doucment."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1493
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>D</keycap></keycombo> </"
"shortcut> <guimenu>Tools</guimenu> <guimenuitem>Comment</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1500
#, no-c-format
msgid ""
"This adds one space to the beginning of the line where the text cursor is "
"located or to the beginning of any selected lines."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1507
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>D</keycap></"
"keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Uncomment</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1514
#, no-c-format
msgid ""
"This removes one space (if any exist) from the beginning of the line where "
"the text cursor is located or from the beginning of any selected lines."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1520
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>U</keycap></keycombo> </"
"shortcut> <guimenu>Tools</guimenu> <guimenuitem>Uppercase</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1527
#, no-c-format
msgid "Put the selected text or the letter after the cursor in uppercase."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1532
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>U</keycap></"
"keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Lowercase</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1539
#, no-c-format
msgid "Put the selected text or the letter after the cursor in lowercase."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1544
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Alt;&Ctrl;<keycap>U</keycap></"
"keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Capitalize</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1551
#, no-c-format
msgid "Capitalize the selected text or the current word."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1556
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>J</keycap></keycombo> </"
"shortcut> <guimenu>Tools</guimenu> <guimenuitem>Join Lines</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1563
#, no-c-format
msgid ""
"Joins the selected lines, or the current line and the line below with one "
"white space character as a separator. Leading/trailing white space on joined "
"lines is removed in the affected ends."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1569
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Word Wrap Document</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1573
#, no-c-format
msgid ""
"Apply static word wrapping on all the document. That means that a new line "
"of text will automatically start when the current line exceeds the length "
"specified by the Wrap words at: option in the Editing tab in <menuchoice> "
"<guimenu>Settings</guimenu><guimenuitem>Configure Editor...</guimenuitem></"
"menuchoice>"
msgstr ""

#. Tag: title
#: index.docbook:1587
#, no-c-format
msgid "The <guimenu>Settings</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: index.docbook:1591
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Toolbar</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1597
#, no-c-format
msgid ""
"When checked, this displays a movable toolbar containing buttons used to "
"initiate frequently used commands. When unchecked the toolbar is hidden."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1605
#, no-c-format
msgid "<guimenu>Settings</guimenu><guimenuitem>Show Statusbar</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1609
#, no-c-format
msgid ""
"When checked, this displays a small bar at the bottom of the editor "
"containing information about the status of the current document. When "
"unchecked the statusbar is hidden."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1616
#, no-c-format
msgid "<guimenu>Settings</guimenu><guimenuitem>Show Path</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1620
#, no-c-format
msgid ""
"When selected, this displays in the titlebar the path (its location in the "
"file system) of the current document. When unchecked the path is hidden."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1626
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1632
#, no-c-format
msgid ""
"This menu item opens a dialog whereby several different <link linkend=\"pref-"
"dialog\">settings</link> may be adjusted."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1640
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Choose Editor...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1646
#, no-c-format
msgid ""
"Choose the default text editing component that you wish to use in &kwrite;. "
"You can choose <guilabel>System Default</guilabel>, <guilabel>Embedded "
"Advanced Text Editor</guilabel> or <guilabel>&Qt; Designer Based Text "
"Editor</guilabel> (note that the &Qt; Designer Based Text Editor is only "
"available if you have KDevelop installed on your system). If you choose "
"<guilabel>System Default</guilabel>, &kwrite; will honor your changes in "
"&kcontrolcenter;. All other choices will override that setting."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1659
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu><guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1663
#, no-c-format
msgid ""
"This command opens a dialog box whereby the <link linkend=\"keybindings"
"\">shortcuts</link> may be changed. A display window at the top of the "
"dialog box shows the list of commands (actions) that can have keyboard "
"shortcuts. Below the display are three radio buttons. The user may choose "
"between No Key, Default Key, and Custom Key. (Note that a set of radio "
"buttons only allows the selection of one of the offered items - in the way "
"that buttons on a car radio only offer the selection of one preset station. "
"Also, the Default Key selection is only available for those commands that "
"actually have a 'default' shortcut.) Selecting the Custom Key option "
"activates the three check boxes and key button at the bottom of the dialog. "
"The user may then select a key combination for the command in question by "
"means of the check boxes and key button. For example, with the About &kde; "
"command selected in the display window, the user could select &Ctrl; and "
"<keycap>Alt</keycap>, click on the key button, and then press the <keycap>K</"
"keycap> key on the keyboard. This would mean that anytime he or she held "
"down the &Ctrl; and <keycap>Alt</keycap> buttons and pressed <keycap>K</"
"keycap> (while using &kwrite;) the About &kde; display box would be called."
msgstr ""

#. Tag: menuchoice
#: index.docbook:1684
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu><guimenuitem>Configure Toolbars...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1687
#, no-c-format
msgid ""
"This will open the dialog whereby the toolbar configuration may be changed. "
"The user can choose which shortcut buttons should appear on the toolbar. A "
"display window on the left lists the commands available to placed on the "
"toolbar. A display on the right lists those commands already on the toolbar. "
"A set of four arrow buttons between the two displays manipulates the "
"selections. The right pointing arrow places any command selected in the left "
"pane onto the right pane, <abbrev>i.e.</abbrev>, it is added to the toolbar. "
"The left arrow does just the opposite, removing any action selected in the "
"right window from the toolbar. The up and down pointing arrows change the "
"position of an action selected in the right window which changes the "
"position of its button in the toolbar."
msgstr ""

#. Tag: title
#: index.docbook:1788
#, no-c-format
msgid "The <guimenu>Help</guimenu> Menu"
msgstr ""

#. Tag: sect1
#: index.docbook:1788
#, no-c-format
msgid "&help.menu.documentation;"
msgstr ""

#. Tag: title
#: index.docbook:1796
#, no-c-format
msgid "Configure &kwrite;"
msgstr ""

#. Tag: para
#: index.docbook:1798
#, no-c-format
msgid ""
"Selecting <menuchoice><guimenu>Settings</guimenu><guimenuitem>Configure "
"Editor...</guimenuitem></menuchoice> from the menu brings up the "
"<guilabel>Configure Editor</guilabel> dialog box. This dialog can be used to "
"alter a number of different settings. The settings available for change vary "
"according to which category the user chooses from a vertical list on the "
"left side of the dialog. By means of three buttons along the bottom of the "
"box the user can control the process."
msgstr ""

#. Tag: para
#: index.docbook:1808
#, no-c-format
msgid ""
"She or he may invoke the <guilabel>Help</guilabel> system, accept the "
"current settings and close the dialog by means of the <guibutton>OK</"
"guibutton> button, or <guibutton>Cancel</guibutton> the process. The "
"categories <guilabel>Colors</guilabel>, <guilabel>Fonts</guilabel> "
"<guilabel>Indent</guilabel>, <guilabel>Select</guilabel>, <guilabel>Edit</"
"guilabel>, <guilabel>Spelling</guilabel> and <guilabel>Highlighting</"
"guilabel> are detailed below."
msgstr ""

#. Tag: title
#: index.docbook:1820
#, no-c-format
msgid "Appearance"
msgstr "Aparéncia"

#. Tag: guilabel
#: index.docbook:1824
#, no-c-format
msgid "Word Wrap"
msgstr ""

#. Tag: guilabel
#: index.docbook:1828
#, no-c-format
msgid "Dynamic word wrap"
msgstr ""

#. Tag: para
#: index.docbook:1829
#, no-c-format
msgid ""
"If this option is checked, the text lines will be wrapped at the view border "
"on the screen."
msgstr ""

#. Tag: guilabel
#: index.docbook:1833
#, no-c-format
msgid "Dynamic word wrap indicators"
msgstr ""

#. Tag: para
#: index.docbook:1834
#, no-c-format
msgid "Choose when the Dynamic word wrap indicators should be displayed."
msgstr ""

#. Tag: guilabel
#: index.docbook:1838
#, no-c-format
msgid "Vertically align dynamically wrapped lines to indentation depth:"
msgstr ""

#. Tag: para
#: index.docbook:1841
#, no-c-format
msgid ""
"Enables the start of dynamically wrapped lines to be aligned vertically to "
"the indentation level of the first line. This can help to make code and "
"markup more readable."
msgstr ""

#. Tag: para
#: index.docbook:1844
#, no-c-format
msgid ""
"Additionally, this allows you to set a maximum width of the screen, as a "
"percentage, after which dynamically wrapped lines will no longer be "
"vertically aligned. For example, at 50%, lines whose indentation levels are "
"deeper than 50% of the width of the screen will not have vertical alignment "
"applied to subsequent wrapped lines."
msgstr ""

#. Tag: guilabel
#: index.docbook:1856
#, no-c-format
msgid "<guilabel>Code Folding</guilabel>"
msgstr ""

#. Tag: guilabel
#: index.docbook:1860
#, no-c-format
msgid "Show folding markers (if available)"
msgstr ""

#. Tag: para
#: index.docbook:1862
#, no-c-format
msgid ""
"If this option is checked, the current view will display marks for code "
"folding, if code folding is available."
msgstr ""

#. Tag: guilabel
#: index.docbook:1870
#, no-c-format
msgid "Borders"
msgstr "Borders"

#. Tag: guilabel
#: index.docbook:1874
#, no-c-format
msgid "Show icon border"
msgstr ""

#. Tag: para
#: index.docbook:1876
#, no-c-format
msgid ""
"If this is checked, you will see an icon border on the left hand side. The "
"icon border shows bookmark signs for instance."
msgstr ""

#. Tag: guilabel
#: index.docbook:1880
#, no-c-format
msgid "Show line numbers"
msgstr ""

#. Tag: para
#: index.docbook:1882
#, no-c-format
msgid "If this is checked, you will see line numbers on the left hand side."
msgstr ""

#. Tag: guilabel
#: index.docbook:1886
#, no-c-format
msgid "Show scrollbar marks"
msgstr ""

#. Tag: para
#: index.docbook:1888
#, no-c-format
msgid ""
"If this option is checked the current view will show marks on the vertical "
"scrollbar. These marks will for instance show bookmarks."
msgstr ""

#. Tag: guilabel
#: index.docbook:1897
#, no-c-format
msgid "Sort Bookmarks Menu"
msgstr ""

#. Tag: guilabel
#: index.docbook:1902
#, no-c-format
msgid "By position"
msgstr ""

#. Tag: para
#: index.docbook:1904
#, no-c-format
msgid "The bookmarks will be ordered by the line numbers they are placed at."
msgstr ""

#. Tag: guilabel
#: index.docbook:1908
#, no-c-format
msgid "By creation"
msgstr ""

#. Tag: para
#: index.docbook:1910
#, no-c-format
msgid ""
"Each new bookmark will be added to the bottom, independently from where it "
"is placed in the document."
msgstr ""

#. Tag: guilabel
#: index.docbook:1918
#, no-c-format
msgid "Show identation lines"
msgstr ""

#. Tag: para
#: index.docbook:1920
#, no-c-format
msgid ""
"If this is checked, the editor wil display vertical lines to help "
"identifying indent lines."
msgstr ""

#. Tag: title
#: index.docbook:1927
#, no-c-format
msgid "Fonts &amp; Colors"
msgstr ""

#. Tag: para
#: index.docbook:1929
#, no-c-format
msgid ""
"This section of the dialog lets you configure all fonts and colors in any "
"color scheme you have, as well creating new schemes or deleting existing "
"ones. Each scheme has settings for colors, fonts and normal and highlight "
"text styles."
msgstr ""

#. Tag: para
#: index.docbook:1935
#, no-c-format
msgid ""
"&kwrite; will preselect the currently active scheme for you, if you want to "
"work on a different scheme start by selecting that from the "
"<guilabel>Schema</guilabel> combobox."
msgstr ""

#. Tag: title
#: index.docbook:1940
#, no-c-format
msgid "Colors"
msgstr "Colors"

#. Tag: guilabel
#: index.docbook:1944
#, no-c-format
msgid "Text Area Background"
msgstr ""

#. Tag: guilabel
#: index.docbook:1950
#, no-c-format
msgid "Normal text"
msgstr ""

#. Tag: para
#: index.docbook:1951
#, no-c-format
msgid ""
"This is the default background for the editor area, it will be the dominant "
"color on the editor area."
msgstr ""

#. Tag: guilabel
#: index.docbook:1956
#, no-c-format
msgid "Selected Text"
msgstr ""

#. Tag: para
#: index.docbook:1957
#, no-c-format
msgid ""
"This is the background for selected text. The default is the global "
"selection color, as set in your &kde; color preferences."
msgstr ""

#. Tag: guilabel
#: index.docbook:1963
#, no-c-format
msgid "Current Line"
msgstr ""

#. Tag: para
#: index.docbook:1964
#, no-c-format
msgid ""
"Set the color for the current line. Setting this a bit different from the "
"Normal text background helps to keep focus on the current line."
msgstr ""

#. Tag: guilabel
#: index.docbook:1970
#, no-c-format
msgid "Bookmark"
msgstr "Favorit"

#. Tag: para
#: index.docbook:1971
#, no-c-format
msgid ""
"This combo lets you set overlay colors for various mark types. The color is "
"mixed into the background color of a marked line, so that a line with more "
"marks or a marked line that is current has a background that is a mix of "
"more colors. The mark colors are also used if you enable display of "
"scrollbar marks."
msgstr ""

#. Tag: guilabel
#: index.docbook:1983
#, no-c-format
msgid "Other Elements"
msgstr ""

#. Tag: guilabel
#: index.docbook:1987
#, no-c-format
msgid "Left Border Background"
msgstr ""

#. Tag: para
#: index.docbook:1988
#, no-c-format
msgid ""
"This color is used for the marks, line numbers and folding marker borders in "
"the left side of the editor view when they are displayed."
msgstr ""

#. Tag: guilabel
#: index.docbook:1993
#, no-c-format
msgid "Line Numbers"
msgstr ""

#. Tag: para
#: index.docbook:1994
#, no-c-format
msgid ""
"This color is used to draw the line numbers on the left side of the view "
"when displayed."
msgstr ""

#. Tag: guilabel
#: index.docbook:1998
#, no-c-format
msgid "Bracket Highlight"
msgstr ""

#. Tag: para
#: index.docbook:1999
#, no-c-format
msgid "This color is used to draw the background of matching brackets."
msgstr ""

#. Tag: guilabel
#: index.docbook:2003
#, no-c-format
msgid "Word Wrap Markers"
msgstr ""

#. Tag: para
#: index.docbook:2004
#, no-c-format
msgid ""
"This color is used to draw a pattern to the left of dynamically wrapped "
"lines when those are aligned vertically, as well as for the static word wrap "
"marker."
msgstr ""

#. Tag: guilabel
#: index.docbook:2009
#, no-c-format
msgid "Tab Markers"
msgstr ""

#. Tag: para
#: index.docbook:2010
#, no-c-format
msgid "This color is used to draw white space indicators when enabled."
msgstr ""

#. Tag: title
#: index.docbook:2021
#, no-c-format
msgid "Fonts"
msgstr "Poliças"

#. Tag: para
#: index.docbook:2022
#, no-c-format
msgid ""
"Here you can choose the font for the schema. You can choose from any font "
"available on your system, and set a default size. A sample text displays at "
"the bottom of the dialog, so you can see the effect of your choices."
msgstr ""

#. Tag: title
#: index.docbook:2030
#, no-c-format
msgid "Normal Text Styles"
msgstr ""

#. Tag: para
#: index.docbook:2031
#, no-c-format
msgid ""
"The normal text styles are inherited by the highlight text styles, allowing "
"the editor to present text in a very consistent way, for example comment "
"text is using the same style in allmost all of the text formats that kate "
"can highlight."
msgstr ""

#. Tag: para
#: index.docbook:2035 index.docbook:2050
#, no-c-format
msgid ""
"The name in the list of styles is using the style configured for the item, "
"providing you with an immediate preview when configuring a style."
msgstr ""

#. Tag: para
#: index.docbook:2038
#, no-c-format
msgid ""
"Each style lets you select common attributes as well as foreground and "
"background colors. To unset a background color, rightclick to use the "
"context menu."
msgstr ""

#. Tag: title
#: index.docbook:2044
#, no-c-format
msgid "Highlighting Text Styles"
msgstr ""

#. Tag: para
#: index.docbook:2045
#, no-c-format
msgid ""
"Here you can edit the text styles used by a specific highlight definition. "
"The editor preselects the highlight used by your current document. To work "
"on a different highlight, select one in the <guilabel>Highlight</guilabel> "
"combobox above the style list."
msgstr ""

#. Tag: para
#: index.docbook:2053
#, no-c-format
msgid ""
"Each style lets you select common attributes as well as foreground and "
"background colors. To unset a background color, rightclick to use the "
"context menu. In addition you can see if a style is equal to the default "
"style used for the item, and set it to that if not."
msgstr ""

#. Tag: para
#: index.docbook:2057
#, no-c-format
msgid ""
"You will notice that many highlights contain other highlights represented by "
"groups in the style list. For example most highlights import the Alert "
"highlight, and many source code formats imports the Doxygen highlight. "
"Editing colors in those groups only affects the styles when used in the "
"edited highlight format."
msgstr ""

#. Tag: title
#: index.docbook:2068
#, no-c-format
msgid "Cursor &amp; Selection"
msgstr ""

#. Tag: guilabel
#: index.docbook:2073
#, no-c-format
msgid "Text Cursor Movement"
msgstr ""

#. Tag: guilabel
#: index.docbook:2077
#, no-c-format
msgid "Smart home"
msgstr ""

#. Tag: para
#: index.docbook:2079
#, no-c-format
msgid ""
"When selected, pressing the home key will cause the cursor to skip white "
"space and go to the start of a line's text."
msgstr ""

#. Tag: guilabel
#: index.docbook:2084
#, no-c-format
msgid "Wrap cursor"
msgstr ""

#. Tag: para
#: index.docbook:2086
#, no-c-format
msgid ""
"When on, moving the insertion cursor using the <emphasis role=\"bold\">Left</"
"emphasis> and <emphasis role=\"bold\">Right</emphasis> keys will go on to "
"previous/next line at beginning/end of the line, similar to most editors."
msgstr ""

#. Tag: para
#: index.docbook:2089
#, no-c-format
msgid ""
"When off, the insertion cursor cannot be moved left of the line start, but "
"it can be moved off the line end, which can be very handy for programmers. "
"When this option is chosen, moving the cursor with the arrow keys off the "
"end of a line (to the right) causes it to jump down to the beginning of the "
"next line. Likewise when the cursor is moved past the beginning of a line "
"(to the left) it jumps up to the end of the preceding line. When this option "
"is not selected, moving the cursor right past the end of a line merely "
"causes it to continue horizontally in the same line and trying to move it "
"left past the beginning does nothing."
msgstr ""

#. Tag: guilabel
#: index.docbook:2101
#, no-c-format
msgid "Page Up/Page Down moves cursor"
msgstr ""

#. Tag: para
#: index.docbook:2103
#, no-c-format
msgid ""
"This option changes the behavior of the cursor when the user presses the "
"<keycap>Page Up</keycap> or <keycap>Page Down</keycap> key. If unselected "
"the text cursor will maintain its relative position within the visible text "
"in &kwrite; as new text becomes visible as a result of the operation. So if "
"the cursor is in the middle of the visible text when the operation occurs it "
"will remain there (except when one reaches the beginning or end.) With this "
"option selected, the first key press will cause the cursor to move to either "
"the top or bottom of the visible text as a new page of text is displayed."
msgstr ""

#. Tag: guilabel
#: index.docbook:2114
#, no-c-format
msgid "Autocenter cursor (lines):"
msgstr ""

#. Tag: para
#: index.docbook:2116
#, no-c-format
msgid ""
"Sets the number of lines to maintain visible above and below the cursor when "
"possible."
msgstr ""

#. Tag: guilabel
#: index.docbook:2125
#, no-c-format
msgid "Selection Mode"
msgstr "Mòde de seleccion"

#. Tag: guilabel
#: index.docbook:2129
#, no-c-format
msgid "Normal"
msgstr "Normal"

#. Tag: para
#: index.docbook:2131
#, no-c-format
msgid ""
"Selections will be overwritten by typed text and will be lost on cursor "
"movement."
msgstr ""

#. Tag: guilabel
#: index.docbook:2136
#, no-c-format
msgid "Persistent"
msgstr ""

#. Tag: para
#: index.docbook:2138
#, no-c-format
msgid "Selections will stay even after cursor movement and typing."
msgstr ""

#. Tag: title
#: index.docbook:2149
#, no-c-format
msgid "Editing"
msgstr ""

#. Tag: guilabel
#: index.docbook:2153
#, no-c-format
msgid "Tabulators"
msgstr ""

#. Tag: guilabel
#: index.docbook:2157
#, no-c-format
msgid "Insert spaces instead of tabulators"
msgstr ""

#. Tag: para
#: index.docbook:2159
#, no-c-format
msgid ""
"When this is enabled the editor will insert a calculated number of spaces "
"according to the position in the text and the <option>tab-width</option> "
"setting when you press the <keycap>TAB</keycap> key."
msgstr ""

#. Tag: guilabel
#: index.docbook:2165
#, no-c-format
msgid "Show tabulators"
msgstr ""

#. Tag: para
#: index.docbook:2167
#, no-c-format
msgid ""
"When this is enabled &kwrite; will display a small dot as a visual "
"representation of tabulator characters."
msgstr ""

#. Tag: para
#: index.docbook:2169
#, no-c-format
msgid ""
"This also causes dots to be drawn to indicate trailing white space. This "
"will be fixed in a future version of &kwrite;"
msgstr ""

#. Tag: term
#: index.docbook:2174
#, no-c-format
msgid "Tab Width"
msgstr ""

#. Tag: para
#: index.docbook:2174
#, no-c-format
msgid ""
"If the <link linkend=\"pref-word-wrap\"><guilabel>Replace Tabs By Spaces</"
"guilabel></link> option is selected this entry determines the number of "
"spaces with which the editor will automatically replace tabs."
msgstr ""

#. Tag: guilabel
#: index.docbook:2186
#, no-c-format
msgid "Static Word Wrap"
msgstr ""

#. Tag: para
#: index.docbook:2187
#, no-c-format
msgid ""
"Word wrap is a feature that causes the editor to automatically start a new "
"line of text and move (wrap) the cursor to the beginning of that new line. "
"&kwrite; will automatically start a new line of text when the current line "
"reaches the length specified by the <link linkend=\"pref-wrap-words-at"
"\">Wrap Words At:</link> option."
msgstr ""

#. Tag: guilabel
#: index.docbook:2195
#, no-c-format
msgid "Enable static word wrap"
msgstr ""

#. Tag: para
#: index.docbook:2197
#, no-c-format
msgid "Turns static word wrap on or off."
msgstr ""

#. Tag: guilabel
#: index.docbook:2201
#, no-c-format
msgid "Show static word wrap markers (if applicable)"
msgstr ""

#. Tag: guilabel
#: index.docbook:2212
#, no-c-format
msgid "Wrap words at:"
msgstr ""

#. Tag: para
#: index.docbook:2214
#, no-c-format
msgid ""
"If the <link linkend=\"pref-word-wrap\">Word Wrap</link> option is selected "
"this entry determines the length (in characters) at which the editor will "
"automatically start a new line."
msgstr ""

#. Tag: guilabel
#: index.docbook:2224
#, no-c-format
msgid "Remove Trailing Spaces"
msgstr ""

#. Tag: para
#: index.docbook:2225
#, no-c-format
msgid ""
"&kwrite; will automatically eliminate extra spaces at the ends of lines of "
"text."
msgstr ""

#. Tag: guilabel
#: index.docbook:2229
#, no-c-format
msgid "Auto Brackets"
msgstr ""

#. Tag: para
#: index.docbook:2229
#, no-c-format
msgid ""
"When the user types a left bracket ([, (, or {) &kwrite; automatically "
"enters the right bracket (}, ), or ]) to the right of the cursor."
msgstr ""

#. Tag: term
#: index.docbook:2234
#, no-c-format
msgid "Maximum <link linkend=\"undo\">undo</link> steps:"
msgstr ""

#. Tag: para
#: index.docbook:2235
#, no-c-format
msgid ""
"Here the user may specify the number of steps &kwrite; will retain in memory "
"for purposes of undoing entries and actions. This means that the higher the "
"number of steps set the more memory &kwrite; will use for this. Setting this "
"entry to 10 would mean that the user would be be able reverse the last ten "
"operations, <abbrev>i.e.</abbrev> click the <guibutton>undo</guibutton> "
"button 10 times and obtain results."
msgstr ""

#. Tag: term
#: index.docbook:2242
#, no-c-format
msgid "Smart search text from:"
msgstr ""

#. Tag: para
#: index.docbook:2243
#, no-c-format
msgid ""
"This determines where &kwrite; will get the search text from (this will be "
"automatically entered into the Find Text dialog): <itemizedlist> "
"<listitem><para><emphasis role=\"bold\">Nowhere:</emphasis> Don't guess the "
"search text.</para></listitem> <listitem><para><emphasis role=\"bold"
"\">Selection Only:</emphasis> Use the current text selection, if available. "
"</para></listitem> <listitem><para><emphasis role=\"bold\">Selection, then "
"Current Word:</emphasis> Use the current selection if available, otherwise "
"use the current word. </para></listitem> <listitem><para><emphasis role="
"\"bold\">Current Word Only:</emphasis> Use the word that the cursor is "
"currently resting on, if available. </para></listitem> "
"<listitem><para><emphasis role=\"bold\">Current Word, then Selection:</"
"emphasis> Use the current word if available, otherwise use the current "
"selection. </para></listitem> </itemizedlist> Note that, in all the above "
"modes, if a search string has not been or cannot be determined, then the "
"Find Text Dialog will fall back to the last search text."
msgstr ""

#. Tag: title
#: index.docbook:2281
#, no-c-format
msgid "Indentation"
msgstr ""

#. Tag: guilabel
#: index.docbook:2284
#, no-c-format
msgid "Automatic indentation"
msgstr ""

#. Tag: guilabel
#: index.docbook:2288
#, no-c-format
msgid "Indentation mode:"
msgstr ""

#. Tag: para
#: index.docbook:2290
#, no-c-format
msgid ""
"Select the automatic indentation mode you want to use as default. It is "
"strongly recommended to use <userinput>None</userinput> or "
"<userinput>Normal</userinput>here, and use filetype configurations to set "
"other indentation modes for text formats like C/C++ code or &XML;."
msgstr ""

#. Tag: guilabel
#: index.docbook:2297
#, no-c-format
msgid "Insert leading Doxygen \"*\" when typing"
msgstr ""

#. Tag: para
#: index.docbook:2299
#, no-c-format
msgid ""
"Automatically insert a leading \"*\" while typing within a doxygen style "
"comment. This setting is only enabled when applicable."
msgstr ""

#. Tag: guilabel
#: index.docbook:2308
#, no-c-format
msgid "Indentation with Spaces"
msgstr ""

#. Tag: guilabel
#: index.docbook:2312
#, no-c-format
msgid "Use spaces instead of tabs to indent"
msgstr ""

#. Tag: para
#: index.docbook:2314
#, no-c-format
msgid ""
"This replaces tabs with the number of spaces set in <guilabel>Number of "
"spaces:</guilabel> below."
msgstr ""

#. Tag: guilabel
#: index.docbook:2319
#, no-c-format
msgid "Emacs style mixed mode"
msgstr ""

#. Tag: para
#: index.docbook:2321
#, no-c-format
msgid "Use a mix of tabs and space characters for indentation."
msgstr ""

#. Tag: guilabel
#: index.docbook:2325
#, no-c-format
msgid "Number of spaces:"
msgstr ""

#. Tag: para
#: index.docbook:2327
#, no-c-format
msgid ""
"Set the number of spaces you want to use for indentation when you check "
"<guilabel>Use spaces instead of tabs to indent</guilabel> above."
msgstr ""

#. Tag: guilabel
#: index.docbook:2337
#, no-c-format
msgid "Keep Indent Profile"
msgstr ""

#. Tag: para
#: index.docbook:2338
#, no-c-format
msgid ""
"When this is enabled, the editor will not unindent lines in a selection "
"further when the line with the least indentation becomes unindented. If you "
"sometimes unindent blocks of indented code, this may be helpful."
msgstr ""

#. Tag: guilabel
#: index.docbook:2345
#, no-c-format
msgid "Keep Extra Spaces"
msgstr ""

#. Tag: para
#: index.docbook:2346
#, no-c-format
msgid ""
"Indentations of more than the selected number of spaces will not be "
"shortened."
msgstr ""

#. Tag: guilabel
#: index.docbook:2351
#, no-c-format
msgid "Keys to use"
msgstr ""

#. Tag: guilabel
#: index.docbook:2355
#, no-c-format
msgid "Tab key indents"
msgstr ""

#. Tag: para
#: index.docbook:2357
#, no-c-format
msgid ""
"This allows the <keycombo action=\"simul\"><keycap>tab</keycap></keycombo> "
"key to be used to indent."
msgstr ""

#. Tag: guilabel
#: index.docbook:2362
#, no-c-format
msgid "Backspace key indent"
msgstr ""

#. Tag: para
#: index.docbook:2364
#, no-c-format
msgid ""
"This allows the <keycombo action=\"simul\"><keycap>backspace</keycap></"
"keycombo> key to be used to indent."
msgstr ""

#. Tag: guilabel
#: index.docbook:2374
#, no-c-format
msgid "Tab Key Mode if Nothing Selected"
msgstr ""

#. Tag: guilabel
#: index.docbook:2378
#, no-c-format
msgid "Insert indent characters"
msgstr ""

#. Tag: para
#: index.docbook:2380
#, no-c-format
msgid ""
"This allows the <keycombo action=\"simul\"><keycap>Tab</keycap></keycombo> "
"key insert indent characters."
msgstr ""

#. Tag: guilabel
#: index.docbook:2386
#, no-c-format
msgid "Insert tab character"
msgstr ""

#. Tag: para
#: index.docbook:2388
#, no-c-format
msgid ""
"This allows the <keycombo action=\"simul\"><keycap>Tab</keycap></keycombo> "
"key insert a tab."
msgstr ""

#. Tag: guilabel
#: index.docbook:2393
#, no-c-format
msgid "Indent current line"
msgstr ""

#. Tag: para
#: index.docbook:2395
#, no-c-format
msgid ""
"This allows the <keycombo action=\"simul\"><keycap>Tab</keycap></keycombo> "
"key indent the current line."
msgstr ""

#. Tag: title
#: index.docbook:2413
#, no-c-format
msgid "Open &amp; Save"
msgstr ""

#. Tag: guilabel
#: index.docbook:2418
#, no-c-format
msgid "File Format"
msgstr ""

#. Tag: guilabel
#: index.docbook:2422
#, no-c-format
msgid "Encoding:"
msgstr ""

#. Tag: para
#: index.docbook:2424
#, no-c-format
msgid "This sets the default character encoding for your files."
msgstr ""

#. Tag: guilabel
#: index.docbook:2428
#, no-c-format
msgid "End of line:"
msgstr ""

#. Tag: para
#: index.docbook:2430
#, no-c-format
msgid ""
"Choose your prefered end of line mode for your active document. You have the "
"choice between &UNIX;, DOS/&Windows; or Macintosh."
msgstr ""

#. Tag: guilabel
#: index.docbook:2435
#, no-c-format
msgid "Automatic end of line detection"
msgstr ""

#. Tag: para
#: index.docbook:2437
#, no-c-format
msgid ""
"Check this if you want the editor to autodetect the end of line type. The "
"first found end of line type will be used for the whole file."
msgstr ""

#. Tag: guilabel
#: index.docbook:2446
#, no-c-format
msgid "Memory Usage"
msgstr ""

#. Tag: guilabel
#: index.docbook:2450
#, no-c-format
msgid "Maximum loaded blocks per file:"
msgstr ""

#. Tag: para
#: index.docbook:2452
#, no-c-format
msgid ""
"The editor will load given number of blocks (of around 2048 lines) of text "
"into memory; if the filesize is bigger than this the other blocks are "
"swapped to disk and loaded transparently as-needed."
msgstr ""

#. Tag: para
#: index.docbook:2455
#, no-c-format
msgid ""
"This can cause little delays while navigating in the document; a larger "
"block count increases the editing speed at the cost of memory."
msgstr ""

#. Tag: para
#: index.docbook:2457
#, no-c-format
msgid ""
"For normal usage, just choose the highest possible block count: limit it "
"only if you have problems with the memory usage."
msgstr ""

#. Tag: guilabel
#: index.docbook:2466
#, no-c-format
msgid "Automatic Cleanups on Load/Save"
msgstr ""

#. Tag: guilabel
#: index.docbook:2470
#, no-c-format
msgid "Remove trailing spaces"
msgstr ""

#. Tag: para
#: index.docbook:2472
#, no-c-format
msgid ""
"The editor will automatically eliminate extra spaces at the ends of lines of "
"text while loading/saving the file."
msgstr ""

#. Tag: guilabel
#: index.docbook:2481
#, no-c-format
msgid "Folder Config File"
msgstr ""

#. Tag: guilabel
#: index.docbook:2485
#, no-c-format
msgid "Search depth for config file:"
msgstr ""

#. Tag: para
#: index.docbook:2487
#, no-c-format
msgid ""
"The editor will search the given number of folder levels upwards for "
"&kwrite; config file and load the settings line from it."
msgstr ""

#. Tag: guilabel
#: index.docbook:2496
#, no-c-format
msgid "Backup on Save"
msgstr ""

#. Tag: para
#: index.docbook:2497
#, no-c-format
msgid ""
"Backing up on save will cause &kwrite; to copy the disk file to &lt;"
"prefix&gt;&lt;filename&gt;&lt;suffix&gt;' before saving changes. The suffix "
"defaults to <emphasis role=\"bold\">~</emphasis> and prefix is empty by "
"default."
msgstr ""

#. Tag: guilabel
#: index.docbook:2503
#, no-c-format
msgid "Local files"
msgstr ""

#. Tag: para
#: index.docbook:2505
#, no-c-format
msgid "Check this if you want backups of local files when saving."
msgstr ""

#. Tag: guilabel
#: index.docbook:2510
#, no-c-format
msgid "Remote files"
msgstr ""

#. Tag: para
#: index.docbook:2512
#, no-c-format
msgid "Check this if you want backups of remote files when saving."
msgstr ""

#. Tag: guilabel
#: index.docbook:2516
#, no-c-format
msgid "Prefix"
msgstr "Prefixe"

#. Tag: para
#: index.docbook:2518
#, no-c-format
msgid "Enter the prefix to prepend to the backup file names."
msgstr ""

#. Tag: guilabel
#: index.docbook:2522
#, no-c-format
msgid "Suffix"
msgstr "Sufixe"

#. Tag: para
#: index.docbook:2524
#, no-c-format
msgid "Enter the suffix to add to the backup file names."
msgstr ""

#. Tag: title
#: index.docbook:2536
#, no-c-format
msgid "Highlighting"
msgstr "Enlusiment"

#. Tag: para
#: index.docbook:2537
#, no-c-format
msgid ""
"This group of options is used to customize the highlighting styles for each "
"programming language type. Any changes you made in other areas of this "
"dialog apply only to this type."
msgstr ""

#. Tag: guilabel
#: index.docbook:2543
#, no-c-format
msgid "Highlight:"
msgstr ""

#. Tag: para
#: index.docbook:2544
#, no-c-format
msgid "This is used to choose the language type to configure."
msgstr ""

#. Tag: guilabel
#: index.docbook:2549
#, no-c-format
msgid "Informations"
msgstr ""

#. Tag: para
#: index.docbook:2551
#, no-c-format
msgid ""
"View the properties of the chosen language highlighting rules: author name "
"and license."
msgstr ""

#. Tag: guilabel
#: index.docbook:2559
#, no-c-format
msgid "Properties"
msgstr "Propietats"

#. Tag: guilabel
#: index.docbook:2563 index.docbook:2801
#, no-c-format
msgid "File extensions:"
msgstr ""

#. Tag: para
#: index.docbook:2564
#, no-c-format
msgid ""
"This is the list of file extensions used to determine which files to "
"highlight using the current syntax highlight mode."
msgstr ""

#. Tag: guilabel
#: index.docbook:2568 index.docbook:2808
#, no-c-format
msgid "MIME types:"
msgstr ""

#. Tag: para
#: index.docbook:2569
#, no-c-format
msgid ""
"Clicking the wizard button will display a dialog with a list of all "
"available mime types to choose from."
msgstr ""

#. Tag: para
#: index.docbook:2570
#, no-c-format
msgid ""
"The <emphasis role=\"bold\">File Extensions</emphasis> entry will "
"automatically be edited as well."
msgstr ""

#. Tag: guilabel
#: index.docbook:2575 index.docbook:2813
#, no-c-format
msgid "Priority:"
msgstr "Prioritat"

#. Tag: para
#: index.docbook:2576
#, no-c-format
msgid "Set the priority of the highlight rule."
msgstr ""

#. Tag: guibutton
#: index.docbook:2583
#, no-c-format
msgid "Download..."
msgstr ""

#. Tag: para
#: index.docbook:2585
#, no-c-format
msgid ""
"Click this button to download new or updated syntax highlight descriptions "
"from the &kate; website."
msgstr ""

#. Tag: title
#: index.docbook:2744
#, no-c-format
msgid "Filetypes"
msgstr ""

#. Tag: para
#: index.docbook:2745
#, no-c-format
msgid ""
"This page allows you to override the default configuration for documents of "
"specified mimetypes. When the editor loads a document, it will try if it "
"matches the file masks or mimetypes for one of the defined filetypes, and if "
"so apply the variables defined. If more filetypes match, the one with the "
"highest priority will be used."
msgstr ""

#. Tag: guilabel
#: index.docbook:2753
#, no-c-format
msgid "Filetype:"
msgstr ""

#. Tag: para
#: index.docbook:2754 index.docbook:2774
#, no-c-format
msgid ""
"The filetype with the highest priority is the one displayed in the first "
"drop down box. If more filetypes were found, they are also listed."
msgstr ""

#. Tag: guilabel
#: index.docbook:2759
#, no-c-format
msgid "<guilabel>New</guilabel>"
msgstr ""

#. Tag: para
#: index.docbook:2760
#, no-c-format
msgid ""
"This is used to create a new filetype. After you click on this button, the "
"fields below get empty and you can fill the properties you want for the new "
"filetype."
msgstr ""

#. Tag: guilabel
#: index.docbook:2765
#, no-c-format
msgid "<guilabel>Delete</guilabel>"
msgstr ""

#. Tag: para
#: index.docbook:2766
#, no-c-format
msgid ""
"To remove an existing filetype, select it from the drop down box and press "
"the Delete button."
msgstr ""

#. Tag: guilabel
#: index.docbook:2773
#, no-c-format
msgid "Properties of current filetype"
msgstr ""

#. Tag: guilabel
#: index.docbook:2779
#, no-c-format
msgid "Name:"
msgstr "Nom :"

#. Tag: para
#: index.docbook:2780
#, no-c-format
msgid ""
"The name of the filetype will be the text of the corresponding menu item. "
"This name is displayed in the <menuchoice><guimenu>Tools</"
"guimenu><guimenuitem>Filetypes</guimenuitem> </menuchoice>"
msgstr ""

#. Tag: guilabel
#: index.docbook:2786
#, no-c-format
msgid "Section:"
msgstr ""

#. Tag: para
#: index.docbook:2787
#, no-c-format
msgid ""
"The section name is used to organize the file types in menus. This is also "
"used in the <menuchoice><guimenu>Tools</guimenu><guimenuitem>Filetypes</"
"guimenuitem> </menuchoice> menu."
msgstr ""

#. Tag: guilabel
#: index.docbook:2793
#, no-c-format
msgid "Variables:"
msgstr ""

#. Tag: para
#: index.docbook:2794
#, no-c-format
msgid ""
"This string allows you to configure &kwrite;'s settings for the files "
"selected by this mimetype using &kwrite; variables. You can set almost any "
"configuration option, such as highlight, indent-mode, encoding, etc."
msgstr ""

#. Tag: para
#: index.docbook:2797
#, no-c-format
msgid "For a full list of known variables, see the manual."
msgstr ""

#. Tag: para
#: index.docbook:2802
#, no-c-format
msgid ""
"The wildcards mask allows you to select files by filename. A typical mask "
"uses an asterisk and the file extension, for example <filename>*.txt; *."
"text</filename>. The string is a semicolon-separated list of masks."
msgstr ""

#. Tag: para
#: index.docbook:2809
#, no-c-format
msgid "Displays a wizard that helps you easily select mimetypes."
msgstr ""

#. Tag: para
#: index.docbook:2814
#, no-c-format
msgid ""
"Sets a priority for this file type. If more than one file type selects the "
"same file, the one with the highest priority will be used."
msgstr ""

#. Tag: para
#: index.docbook:2826
#, no-c-format
msgid ""
"You can change here the shortcut keys configuration. Select an action and "
"click on <guilabel>Custom</guilabel> if you want a different shortcut for "
"this action."
msgstr ""

#. Tag: para
#: index.docbook:2829
#, no-c-format
msgid ""
"The search line alllows you to look for a specific action and see its "
"associated shortcut."
msgstr ""

#. Tag: title
#: index.docbook:2834
#, no-c-format
msgid "Plugins"
msgstr "Ajustons"

#. Tag: para
#: index.docbook:2835
#, no-c-format
msgid ""
"This tab lists all available plugins and you can check those you want to "
"use. Once a plugin is checked, the <guibutton>Configure</guibutton> button "
"is enabled and you can click it in order to configure the highlighted plugin."
msgstr ""

