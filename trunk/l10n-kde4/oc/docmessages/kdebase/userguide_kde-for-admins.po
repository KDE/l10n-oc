"konsole</option></userinput>\n"
"konsole-9058\n"
"\n"
"\n"
"#!/bin/sh\n"
"konsole=$(dcopstart konsole-script)\n"
"session=$(dcop $konsole konsole currentSession)\n"
"dcop $konsole $session renameSession Local\n"
"\n"
"session=$(dcop $konsole konsole newSession)\n"
"dcop $konsole $session renameSession Remote\n"
"\n"
"session=$(dcop $konsole konsole newSession)\n"
"dcop $konsole $session renameSession Code\n"
"dcop $konsole $session sendSession 'cd /my/work/directory'"
msgstr ""

#. Tag: title
#: kde-for-admins.docbook:2203
#, no-c-format
msgid "KDialog"
msgstr ""

#. Tag: subtitle
#: kde-for-admins.docbook:2204
#, no-c-format
msgid "<subtitle>&kde; DIY - Building Your Own Tools</subtitle>"
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:2206
#, no-c-format
msgid ""
"You can use &kde; dialogs from your own scripts, to combine the power of "
"&UNIX; shell scripting with the ease of use of &kde;."
msgstr ""

#. Tag: screen
#: kde-for-admins.docbook:2209
#, no-c-format
msgid ""
"<userinput><command>kdialog</command> <option>--msgbox 'You have new mail!'</"
"option></userinput>"
msgstr ""

#. Tag: screen
#: kde-for-admins.docbook:2211
#, no-c-format
msgid ""
"<userinput><command>kdialog</command> <option>--title 'New Mail'</option> "
"<option>--msgbox 'You have new mail!'</option></userinput>"
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:2213
#, no-c-format
msgid ""
"The <application>KDialog</application> part can be replaced via <option>--"
"caption</option> option"
msgstr ""

#. Tag: screen
#: kde-for-admins.docbook:2216
#, no-c-format
msgid ""
"<userinput><command>kdialog</command> <option>--title 'New Mail'</option> "
"<option>--msgbox 'You have new mail!'</option> <option>--dontagain myfile:"
"mykey</option></userinput>"
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:2218
#, no-c-format
msgid ""
"Saves whether to show again in <filename>$<envar>KDEHOME</envar>/share/"
"config/myfile</filename> (by writing into this file the following lines:"
msgstr ""

#. Tag: screen
#: kde-for-admins.docbook:2222
#, no-c-format
msgid ""
"[Notification Messages]\n"
"mykey=false"
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:2224
#, no-c-format
msgid ""
"Instead of <option>--msgbox</option> you can also use <option>--sorry</"
"option> and <option>--error</option>, as appropriate. For instance, you "
"might use <command>kdialog</command> <option>--sorry 'The network can not be "
"reached'</option> or <command>kdialog</command> <option>--error 'Mail box "
"can not be opened'</option>."
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:2230
#, no-c-format
msgid ""
"It is also possible to create message boxes that accept a yes or no answer."
msgstr ""

#. Tag: screen
#: kde-for-admins.docbook:2233
#, no-c-format
msgid ""
"<command>kdialog</command> <option>--yesno 'Do you want to connect\n"
"to the Internet?'</option> <command>echo</command> <returnvalue>$?</"
"returnvalue>"
msgstr ""

#. Tag: entry
#: kde-for-admins.docbook:2239
#, no-c-format
msgid "Return Value"
msgstr ""

#. Tag: entry
#: kde-for-admins.docbook:2240
#, no-c-format
msgid "Meaning"
msgstr ""

#. Tag: entry
#: kde-for-admins.docbook:2244
#, no-c-format
msgid "<entry>0</entry>"
msgstr ""

#. Tag: entry
#: kde-for-admins.docbook:2244
#, no-c-format
msgid "Yes, OK, Continue"
msgstr ""

#. Tag: entry
#: kde-for-admins.docbook:2245
#, no-c-format
msgid "<entry>1</entry>"
msgstr ""

#. Tag: entry
#: kde-for-admins.docbook:2245
#, no-c-format
msgid "<entry>No</entry>"
msgstr ""

#. Tag: entry
#: kde-for-admins.docbook:2246
#, no-c-format
msgid "<entry>2</entry>"
msgstr ""

#. Tag: entry
#: kde-for-admins.docbook:2246
#, no-c-format
msgid "Cancel"
msgstr "Anullar"

#. Tag: para
#: kde-for-admins.docbook:2251
#, no-c-format
msgid ""
"Make sure to store the result in a variable if you do not use it directly, "
"the next command will fill $? with a new value You can use <option>--"
"dontagain</option> here as well, it will remember the users choice and "
"returns it the next times without showing the dialog any more."
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:2256
#, no-c-format
msgid "Further variations are:"
msgstr ""

#. Tag: option
#: kde-for-admins.docbook:2260
#, no-c-format
msgid "--warningyesno"
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:2262
#, no-c-format
msgid "like <option>--yesno</option> but with a different icon"
msgstr ""

#. Tag: option
#: kde-for-admins.docbook:2267
#, no-c-format
msgid "--warningcontinuecancel"
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:2268
#, no-c-format
msgid ""
"With <guibutton>Continue</guibutton> and <guibutton>Cancel</guibutton> "
"buttons."
msgstr ""

#. Tag: option
#: kde-for-admins.docbook:2273
#, no-c-format
msgid "--warningyesnocancel"
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:2274
#, no-c-format
msgid ""
"With <guibutton>Yes</guibutton>, <guibutton>No</guibutton> and "
"<guibutton>Cancel</guibutton> button. For example:"
msgstr ""

#. Tag: screen
#: kde-for-admins.docbook:2276
#, no-c-format
msgid ""
"<command>kdialog</command> <option>--warningyesnocancel 'Do you want\n"
"to save the changes?'</option>"
msgstr ""

#. Tag: screen
#: kde-for-admins.docbook:2281
#, no-c-format
msgid ""
"<command>kdialog</command> <option>--inputbox \"Enter your name:\" \"YourName"
"\"</option>"
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:2283
#, no-c-format
msgid ""
"The result is printed to stdout, to put it in a variable you can use "
"<userinput>name=$(kdialog --inputbox \"Enter your name:\" \"YourName\")</"
"userinput>. The last argument is optional, it is used to pre-fill the dialog."
msgstr ""

#. Tag: screen
#: kde-for-admins.docbook:2288
#, no-c-format
msgid ""
"<userinput><varname>password</varname>=$(<command>kdialog</command> "
"<option>--password \"Enter your password:\"</option>)</userinput>"
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:2290
#, no-c-format
msgid ""
"The <option>--dontagain</option> option does not work with <option>--"
"inputbox</option> or <option>--password</option>"
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:2293
#, no-c-format
msgid "There are two dialogs that let the user make a choice from a list:"
msgstr ""

#. Tag: option
#: kde-for-admins.docbook:2298
#, no-c-format
msgid "--menu"
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:2300
#, no-c-format
msgid "Lets the user select a single item from a list."
msgstr ""

#. Tag: option
#: kde-for-admins.docbook:2304
#, no-c-format
msgid "--checklist"
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:2306
#, no-c-format
msgid "Lets the user select one or more items from a list."
msgstr ""

#. Tag: screen
#: kde-for-admins.docbook:2311
#, no-c-format
msgid ""
"<userinput><varname>city</varname>=$(<command>kdialog</command> <option>--"
"menu \"Select a city\" a London b Madrid c Paris d Berlin</option>)</"
"userinput>"
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:2313
#, no-c-format
msgid ""
"<varname>$city</varname> will <returnvalue>a</returnvalue>, <returnvalue>b</"
"returnvalue>, <returnvalue>c</returnvalue> or <returnvalue>d</returnvalue>."
msgstr ""

#. Tag: screen
#: kde-for-admins.docbook:2315
#, no-c-format
msgid ""
"<userinput><varname>city</varname>=$(<command>kdialog</command> <option>--"
"checklist \"Select cities\" a London off b Madrid on c Paris on d Berlin "
"off</option>)</userinput>"
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:2317
#, no-c-format
msgid ""
"Madrid and Paris will be pre-selected. The result with Madrid and Paris "
"selected will be <returnvalue>\"b\"</returnvalue> <returnvalue>\"c\"</"
"returnvalue>."
msgstr ""

#. Tag: para
#: kde-for-admins.docbook:2321
#, no-c-format
msgid ""
"If you add the <option>--separate-output</option> option, it will put "
"<returnvalue>b</returnvalue> and <returnvalue>c</returnvalue> each on a line "
"of its own, making the result easier to process."
msgstr ""

#. Tag: screen
#: kde-for-admins.docbook:2325
#, no-c-format
msgid ""
"file=$(kdialog --getopenfilename $HOME)\n"
"file=$(kdialog --getopenfilename $HOME \"*.png *.jpg|Image Files\")\n"
"file=$(kdialog --getsavefilename $HOME/SaveMe.png)\n"
"file=$(kdialog --getexistingdirectory $HOME)"
msgstr ""

