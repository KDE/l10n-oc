#. Tag: synopsis
#: datadtd.docbook:29
#, no-c-format
msgid ""
"&lt;?xml version=\"1.0\" encoding=\"UTF-8\"?&gt;\n"
"\n"
"&lt;!DOCTYPE KugarData [\n"
"     &lt;!ELEMENT <link linkend=\"kugar-data-element\">KugarData</link> "
"(<link linkend=\"row-element\">Row</link>*)&gt;\n"
"     &lt;!ATTLIST KugarData\n"
"         <link linkend=\"template-att\">Template</link>  CDATA  "
"#REQUIRED&gt;\n"
"\n"
"     &lt;!ELEMENT <link linkend=\"row-element\">Row</link> EMPTY&gt;\n"
"     &lt;!ATTLIST Row\n"
"         <link linkend=\"level-att\">level</link>     CDATA  #REQUIRED\n"
"         <link linkend=\"column-att\">col1</link>      CDATA  #IMPLIED\n"
"         <link linkend=\"column-att\">col2</link>      CDATA  #IMPLIED\n"
"         <link linkend=\"column-att\">...</link>       CDATA  #IMPLIED\n"
"         <link linkend=\"column-att\">coln</link>      CDATA  #IMPLIED&gt;\n"
" ]&gt;"
msgstr ""
