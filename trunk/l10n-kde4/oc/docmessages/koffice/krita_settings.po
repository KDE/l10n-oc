#. Tag: phrase
#: settings.docbook:80
#, no-c-format
msgid "<phrase>The <guilabel>Display</guilabel> section</phrase>"
msgstr ""

#. Tag: para
#: settings.docbook:82
#, no-c-format
msgid "<para>The <guilabel>Display</guilabel> section</para>"
msgstr ""

#. Tag: para
#: settings.docbook:87
#, no-c-format
msgid ""
"This section contains just one option. If your graphics card and driver have "
"OpenGL support, you can enable it here to make drawing faster (the processor "
"of yor graphics card will take over part of the calculations). Be warned, "
"though: there are a few cases where enabling OpenGL is known to introduce "
"erratic behavior."
msgstr ""

