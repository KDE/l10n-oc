#. Tag: title
#: columns.docbook:12
#, no-c-format
msgid "Columns"
msgstr "Colomnas"

#. Tag: primary
#: columns.docbook:13
#, no-c-format
msgid "columns"
msgstr "colomnas"

#. Tag: para
#: columns.docbook:15
#, no-c-format
msgid ""
"You can divide the page into several columns, of equal width, with a user "
"controlled space in between each column."
msgstr ""

#. Tag: para
#: columns.docbook:19
#, no-c-format
msgid "This feature is only available in Text Oriented documents."
msgstr ""

#. Tag: para
#: columns.docbook:21
#, no-c-format
msgid ""
"If you are working in a Page Layout document, you can build up several "
"columns using a different frame for each column."
msgstr ""

#. Tag: para
#: columns.docbook:25
#, no-c-format
msgid ""
"To change the number and width of columns select <menuchoice> "
"<guimenu>Format</guimenu><guimenuitem>Page Layout...</guimenuitem></"
"menuchoice> from the menubar."
msgstr ""

#. Tag: para
#: columns.docbook:29
#, no-c-format
msgid "This will bring up a dialog box."
msgstr ""

#. Tag: para
#: columns.docbook:37
#, no-c-format
msgid "Click on the tab labeled <guilabel>Columns</guilabel>."
msgstr ""

#. Tag: para
#: columns.docbook:39
#, no-c-format
msgid "This will change the dialog box."
msgstr ""

#. Tag: para
#: columns.docbook:47
#, no-c-format
msgid ""
"You can now select the number of columns in the spin box labeled "
"<guilabel>Columns:</guilabel>, and the spacing between columns in the text "
"box labeled <guilabel>Column spacing:</guilabel>."
msgstr ""

#. Tag: para
#: columns.docbook:50
#, no-c-format
msgid "The preview box shows you what your page will look like."
msgstr ""

#. Tag: para
#: columns.docbook:52
#, no-c-format
msgid "Click <guibutton>OK</guibutton> when you are done."
msgstr ""

#. Tag: para
#: columns.docbook:54
#, no-c-format
msgid "Click <guibutton>Cancel</guibutton> to abort changes."
msgstr ""

