#. Tag: author
#: doccomments.docbook:4
#, no-c-format
msgid "<firstname>Mike</firstname> <surname>McBride</surname>"
msgstr ""

#. Tag: trans_comment
#: doccomments.docbook:8
#, no-c-format
msgid "ROLES_OF_TRANSLATORS"
msgstr ""
"<othercredit role=\"translator\"><firstname></firstname><surname></"
"surname><affiliation><address><email>yannig@marchegay.org</email></address></"
