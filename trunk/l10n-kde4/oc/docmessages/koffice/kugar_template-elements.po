#. Tag: para
#: template-elements.docbook:75
#, no-c-format
msgid ""
"The <sgmltag class=\"element\">ReportHeader</sgmltag> and <sgmltag class="
"\"element\">ReportFooter</sgmltag> elements define report sections that are "
"usually printed at the beginning and end of the report."
msgstr ""

#. Tag: synopsis
#: template-elements.docbook:81
#, no-c-format
msgid ""
"&lt;!ELEMENT ReportHeader (<link linkend=\"line-element\">Line</link>*, "
"<link linkend=\"label-element\">Label</link>*, <link linkend=\"special-"
"element\">Special</link>*)&gt;\n"
"&lt;!ATTLIST ReportHeader\n"
"     Height          CDATA #REQUIRED\n"
"     PrintFrequency  CDATA #REQUIRED&gt;"
msgstr ""

#. Tag: synopsis
#: template-elements.docbook:83
#, no-c-format
