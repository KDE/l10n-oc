msgid ""
"<sgmltag class=\"element\">PageHeader</sgmltag> and <sgmltag class=\"element"
"\">PageFooter</sgmltag> sections"
msgstr ""

#. Tag: para
#: template-elements.docbook:144
#, no-c-format
msgid ""
"The <sgmltag class=\"element\">PageHeader</sgmltag> and <sgmltag class="
"\"element\">PageFooter</sgmltag> elements define report sections that are "
"usually printed on every page of the report."
msgstr ""

#. Tag: synopsis
#: template-elements.docbook:150
#, no-c-format
msgid ""
"&lt;!ELEMENT PageHeader (<link linkend=\"line-element\">Line</link>*, <link "
"linkend=\"label-element\">Label</link>*, <link linkend=\"special-element"
"\">Special</link>*)&gt;\n"
"&lt;!ATTLIST PageHeader\n"
"     Height          CDATA #REQUIRED\n"
"     PrintFrequency  CDATA #REQUIRED&gt;"
msgstr ""

#. Tag: synopsis
#: template-elements.docbook:152
#, no-c-format
msgid ""
"&lt;!ELEMENT PageFooter (<link linkend=\"line-element\">Line</link>*, <link "
"linkend=\"label-element\">Label</link>*, <link linkend=\"special-element"
"\">Special</link>*)&gt;\n"
"&lt;!ATTLIST PageFooter\n"
"     Height          CDATA #REQUIRED\n"
"     PrintFrequency  CDATA #REQUIRED&gt;"
msgstr ""

#. Tag: title
#: template-elements.docbook:211
#, no-c-format
msgid ""
"<sgmltag class=\"element\">DetailHeader</sgmltag> and <sgmltag class="
"\"element\">DetailFooter</sgmltag> sections"
msgstr ""

#. Tag: para
#: template-elements.docbook:214
#, no-c-format
msgid ""
"The <sgmltag class=\"element\">DetailHeader</sgmltag> and <sgmltag class="
"\"element\">DetailFooter</sgmltag> elements define report sections that are "
"printed before and after details of a given level and below on the report."
msgstr ""

#. Tag: synopsis
#: template-elements.docbook:220
#, no-c-format
msgid ""
"&lt;!ELEMENT DetailHeader (<link linkend=\"line-element\">Line</link>*, "
"<link linkend=\"label-element\">Label</link>*, <link linkend=\"special-"
"element\">Special</link>*)&gt;\n"
"&lt;!ATTLIST DetailHeader\n"
"     Height          CDATA #REQUIRED\n"
"     Level           CDATA #REQUIRED&gt;"
msgstr ""

#. Tag: synopsis
#: template-elements.docbook:222
#, no-c-format
msgid ""
"&lt;!ELEMENT DetailFooter (<link linkend=\"line-element\">Line</link>*, "
"<link linkend=\"label-element\">Label</link>*, <link linkend=\"special-"
"element\">Special</link>*)&gt;\n"
"&lt;!ATTLIST DetailFooter\n"
"     Height          CDATA #REQUIRED\n"
"     Level           CDATA #REQUIRED&gt;"
msgstr ""

#. Tag: sgmltag
#: template-elements.docbook:241 template-elements.docbook:283
#, no-c-format
msgid "Level"
msgstr "Nivèl"

#. Tag: para
#: template-elements.docbook:243
#, no-c-format
msgid ""
"Set the hierarchy level of the section. Sections with higher levels will be "
"printed before sections with lower ones. Level can be any number beginning "
"from 0."
msgstr ""

#. Tag: title
#: template-elements.docbook:258
#, no-c-format
msgid "<sgmltag class=\"element\">Detail</sgmltag> section"
msgstr ""

#. Tag: para
#: template-elements.docbook:260
#, no-c-format
msgid ""
"The <sgmltag class=\"element\">Detail</sgmltag> element defines the report "
"section that contains the report data. The report can have multiple details, "
"which are accessed by the detail's Level attribute."
msgstr ""

#. Tag: synopsis
#: template-elements.docbook:266
#, no-c-format
msgid ""
"&lt;!ELEMENT Detail (<link linkend=\"line-element\">Line</link>*, <link "
"linkend=\"label-element\">Label</link>*, <link linkend=\"special-element"
"\">Special</link>*, <link linkend=\"field-element\">Field</link>*)&gt;\n"
"&lt;!ATTLIST Detail\n"
"     Height  CDATA   #REQUIRED\n"
"     Level   CDATA   #REQUIRED&gt;"
msgstr ""

#. Tag: para
#: template-elements.docbook:285
#, no-c-format
msgid ""
"Set the hierarchy level of the section. Sections with higher levels will be "
"printed before sections with lower ones. Level can be any number beginning "
"from 0. This is an attribute of a <sgmltag class=\"attribute\">row</sgmltag> "
"element in a data file."
msgstr ""

#. Tag: para
#: template-elements.docbook:303
#, no-c-format
msgid ""
"The <sgmltag class=\"element\">Line</sgmltag> element defines a report "
"object used to draw lines on a report."
msgstr ""

#. Tag: synopsis
#: template-elements.docbook:308
#, no-c-format
msgid ""
"&lt;!ELEMENT Line EMPTY&gt;\n"
"&lt;!ATTLIST Line\n"
"     X1     CDATA #REQUIRED\n"
"     Y1     CDATA #REQUIRED\n"
"     X2     CDATA #REQUIRED\n"
"     Y2     CDATA #REQUIRED\n"
"     Width  CDATA #REQUIRED\n"
"     Color  CDATA #REQUIRED\n"
"     Style  CDATA #REQUIRED&gt;"
msgstr ""

