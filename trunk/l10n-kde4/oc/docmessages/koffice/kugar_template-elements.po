"<link linkend=\"label-element\">Label</link>*, <link linkend=\"special-"
"element\">Special</link>*, <link linkend=\"calculated-field-element"
"\">CalculatedField</link>*)&gt;\n"
"&lt;!ATTLIST ReportFooter\n"
"     Height         CDATA #REQUIRED\n"
"     PrintFrequency CDATA #REQUIRED&gt;"
msgstr ""

