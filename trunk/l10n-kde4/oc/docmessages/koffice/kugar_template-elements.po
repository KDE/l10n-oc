#, no-c-format
msgid "<sgmltag>X1</sgmltag>"
msgstr ""

#. Tag: para
#: template-elements.docbook:319
#, no-c-format
msgid ""
"Sets the starting x coordinate (relative to the section's upper left corner) "
"for the line."
