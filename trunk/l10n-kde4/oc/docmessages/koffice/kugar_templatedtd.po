#. Tag: synopsis
#: templatedtd.docbook:31
#, no-c-format
msgid ""
"&lt;?xml version=\"1.0\" encoding=\"UTF-8\"?&gt;\n"
"\n"
"&lt;!DOCTYPE KugarTemplate [\n"
"     &lt;!ELEMENT <link linkend=\"kugartemplate\">KugarTemplate</link> "
"(<link linkend=\"report-header-and-footer\">ReportHeader</link>, <link "
"linkend=\"page-header-and-footer\">PageHeader</link>, <link linkend=\"detail-"
"header-and-footer\">DetailHeader</link>*, <link linkend=\"detail\">Detail</"
"link>*, <link linkend=\"detail-header-and-footer\">DetailFooter</link>*, "
"<link linkend=\"page-header-and-footer\">PageFooter</link>, <link linkend="
"\"report-header-and-footer\">ReportFooter</link>)&gt;\n"
"      &lt;!ATTLIST KugarTemplate\n"
"         <link linkend=\"kut-pagesize\">PageSize</link>         CDATA "
"#REQUIRED\n"
"         <link linkend=\"kut-pageorient\">PageOrientation</link>  CDATA "
"#REQUIRED\n"
"         <link linkend=\"kut-topmargin\">TopMargin</link>        CDATA "
"#REQUIRED\n"
"         <link linkend=\"kut-botmargin\">BottomMargin</link>     CDATA "
"#REQUIRED\n"
"         <link linkend=\"kut-leftmargin\">LeftMargin</link>       CDATA "
"#REQUIRED\n"
"         <link linkend=\"kut-rightmargin\">RightMargin</link>      CDATA "
"#REQUIRED&gt;\n"
"\n"
"    &lt;!ELEMENT <link linkend=\"report-header-and-footer\">ReportHeader</"
"link> (<link linkend=\"line-element\">Line</link>*, <link linkend=\"label-"
"element\">Label</link>*, <link linkend=\"special-element\">Special</link>*)"
"&gt;\n"
"     &lt;!ATTLIST ReportHeader\n"
"         <link linkend=\"rhf-height\">Height</link>           CDATA "
"#REQUIRED\n"
"         <link linkend=\"rhf-printfrequency\">PrintFrequency</link>   CDATA "
"#REQUIRED&gt;\n"
"\n"
"    &lt;!ELEMENT <link linkend=\"page-header-and-footer\">PageHeader</link> "
"(<link linkend=\"line-element\">Line</link>*, <link linkend=\"label-element"
"\">Label</link>*, <link linkend=\"special-element\">Special</link>*)&gt;\n"
"     &lt;!ATTLIST PageHeader\n"
"         <link linkend=\"phf-height\">Height</link>           CDATA "
"#REQUIRED\n"
"         <link linkend=\"phf-printfrequency\">PrintFrequency</link>   CDATA "
"#REQUIRED&gt;\n"
"\n"
"    &lt;!ELEMENT <link linkend=\"detail-header-and-footer\">DetailHeader</"
"link> (<link linkend=\"line-element\">Line</link>*, <link linkend=\"label-"
"element\">Label</link>*, <link linkend=\"special-element\">Special</link>*)"
"&gt;\n"
"     &lt;!ATTLIST DetailHeader\n"
"         <link linkend=\"dhf-height\">Height</link>           CDATA "
"#REQUIRED\n"
"         <link linkend=\"dhf-level\">Level</link>            CDATA "
"#REQUIRED&gt;\n"
"\n"
"    &lt;!ELEMENT <link linkend=\"detail\">Detail</link> (<link linkend="
"\"line-element\">Line</link>*, <link linkend=\"label-element\">Label</"
"link>*, <link linkend=\"special-element\">Special</link>*, <link linkend="
"\"field-element\">Field</link>*)&gt;\n"
"     &lt;!ATTLIST Detail\n"
"         <link linkend=\"d-height\">Height</link>           CDATA #REQUIRED\n"
"         <link linkend=\"d-level\">Level</link>            CDATA "
"#REQUIRED&gt;\n"
"\n"
"    &lt;!ELEMENT <link linkend=\"detail-header-and-footer\">DetailFooter</"
"link> (<link linkend=\"line-element\">Line</link>*, <link linkend=\"label-"
"element\">Label</link>*, <link linkend=\"special-element\">Special</link>*)"
"&gt;\n"
"     &lt;!ATTLIST DetailFooter\n"
"         <link linkend=\"dhf-height\">Height</link>           CDATA "
"#REQUIRED\n"
"         <link linkend=\"dhf-level\">Level</link>            CDATA "
"#REQUIRED&gt;\n"
"\n"
"    &lt;!ELEMENT <link linkend=\"page-header-and-footer\">PageFooter</link> "
"(<link linkend=\"line-element\">Line</link>*, <link linkend=\"label-element"
"\">Label</link>*, <link linkend=\"special-element\">Special</link>*)&gt;\n"
"     &lt;!ATTLIST PageFooter\n"
"         <link linkend=\"phf-height\">Height</link>           CDATA "
"#REQUIRED\n"
"         <link linkend=\"phf-printfrequency\">PrintFrequency</link>   CDATA "
"#REQUIRED&gt;\n"
"\n"
"    &lt;!ELEMENT <link linkend=\"report-header-and-footer\">ReportFooter</"
