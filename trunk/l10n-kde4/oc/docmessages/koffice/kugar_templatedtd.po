"#REQUIRED\n"
"         <link linkend=\"f-fontweight\">FontWeight</link>       CDATA "
"#REQUIRED\n"
"         <link linkend=\"f-fontitalic\">FontItalic</link>       CDATA "
"#REQUIRED\n"
"         <link linkend=\"f-halignment\">HAlignment</link>       CDATA "
"#REQUIRED\n"
"         <link linkend=\"f-valignment\">VAlignment</link>       CDATA "
"#REQUIRED\n"
"         <link linkend=\"f-wordwrap\">WordWrap</link>         CDATA "
"#REQUIRED\n"
"         <link linkend=\"f-datatype\">DataType</link>         CDATA "
"#REQUIRED\n"
"         <link linkend=\"f-dateformat\">DateFormat</link>       CDATA "
"#REQUIRED\n"
"         <link linkend=\"f-precision\">Precision</link>        CDATA "
"#REQUIRED\n"
