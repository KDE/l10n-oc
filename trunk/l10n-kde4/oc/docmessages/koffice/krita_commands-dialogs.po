#. Tag: title
#: commands-dialogs.docbook:341
#, no-c-format
msgid "<title>The <guilabel>Drop Shadow</guilabel> dialog</title>"
msgstr ""

#. Tag: screeninfo
#: commands-dialogs.docbook:345
