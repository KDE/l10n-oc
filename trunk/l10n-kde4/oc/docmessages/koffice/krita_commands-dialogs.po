#: commands-dialogs.docbook:405
#, no-c-format
msgid "<title>The <guilabel>Layer Properties</guilabel> dialog</title>"
msgstr ""

#. Tag: screeninfo
#: commands-dialogs.docbook:409
#, no-c-format
msgid ""
"<screeninfo>The <guilabel>Layer Properties</guilabel> dialog</screeninfo>"
