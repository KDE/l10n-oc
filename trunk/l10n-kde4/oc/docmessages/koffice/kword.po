#. Tag: emphasis
#: index.docbook:857
#, no-c-format
msgid "Specifying the file name"
msgstr ""

#. Tag: para
#: index.docbook:859
#, no-c-format
msgid ""
"Probably the most common command line option used is to specify the file to "
"edit."
msgstr ""

#. Tag: para
#: index.docbook:862
#, no-c-format
msgid "The format for specifying the file name is:"
msgstr ""

#. Tag: screen
#: index.docbook:864
#, no-c-format
msgid ""
"<prompt>$</prompt> <userinput><command>kword</command> "
"<replaceable>filename</replaceable></userinput>"
msgstr ""

#. Tag: para
#: index.docbook:866 index.docbook:1663 index.docbook:1689
#, no-c-format
msgid "Example:"
msgstr ""

#. Tag: screen
#: index.docbook:867
#, no-c-format
msgid ""
"<prompt>$</prompt> <userinput><command>kword</command> <filename>Resume.kwd</"
"filename></userinput>"
msgstr ""

#. Tag: para
#: index.docbook:868
#, no-c-format
msgid ""
"This will cause &kword; to load <filename>Resume.kwd</filename> for editing."
msgstr ""

