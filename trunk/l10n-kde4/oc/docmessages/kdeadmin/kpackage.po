#: index.docbook:476
#, no-c-format
msgid "<guimenu>File</guimenu> Menu"
msgstr ""

#. Tag: para
#: index.docbook:478
#, no-c-format
msgid "The items in the <guimenu>File</guimenu> menu are:"
msgstr ""

#. Tag: menuchoice
#: index.docbook:483
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"> &Ctrl;<keycap>O</keycap></keycombo></"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Open...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:487
#, no-c-format
msgid "Brings up file selector for local and &FTP; files"
msgstr ""

#. Tag: menuchoice
#: index.docbook:492
#, no-c-format
msgid "<guimenu>File</guimenu> <guisubmenu>Open Recent</guisubmenu>"
msgstr ""

#. Tag: para
#: index.docbook:494
#, no-c-format
msgid "A list of the most recently open package files"
msgstr ""

#. Tag: menuchoice
#: index.docbook:498
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Remote Host...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:501
#, no-c-format
msgid ""
"Starts another copy of &kpackage; to manage another system remotely using ssh"
msgstr ""

#. Tag: menuchoice
#: index.docbook:505
#, no-c-format
msgid "<guimenu>File</guimenu> <guisubmenu>Recent Remote Hosts</guisubmenu>"
msgstr ""

#. Tag: para
#: index.docbook:507
#, no-c-format
msgid "A list of the most recently accessed remote systems"
msgstr ""

#. Tag: menuchoice
#: index.docbook:511
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Update</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:513
#, no-c-format
msgid "Update <command>apt</command> indexes from package repositories."
msgstr ""

#. Tag: menuchoice
#: index.docbook:518
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Upgrade</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:520
#, no-c-format
msgid ""
"Upgrade the Debian installation to the latest versions of all the packages."
msgstr ""

#. Tag: menuchoice
#: index.docbook:525
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Fixup</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:527
#, no-c-format
msgid "Attempt to fixup dependency problems"
msgstr ""

#. Tag: menuchoice
#: index.docbook:531
#, no-c-format
msgid ""
"<shortcut><keycap>F5</keycap></shortcut> <guimenu>File</guimenu> "
"<guimenuitem>Reload</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:534
#, no-c-format
msgid "Reread the package data and rebuild the package tree"
msgstr ""

#. Tag: menuchoice
#: index.docbook:539
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"> &Ctrl;<keycap>Q</keycap></keycombo></"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""

