#. Tag: title
#: index.docbook:72
#, no-c-format
msgid "Introduction"
msgstr "Introduccion"

#. Tag: para
#: index.docbook:74
#, no-c-format
msgid ""
"&kcron; is an application for scheduling programs to run in the background. "
"It is a graphical user interface to <command>cron</command>, the &UNIX; "
"system scheduler."
msgstr ""

#. Tag: title
#: index.docbook:81
#, no-c-format
msgid "Using &kcron;"
msgstr ""

#. Tag: para
#: index.docbook:83
#, no-c-format
msgid ""
"Don't forget to tell your system to start the <filename>crond</filename> "
"cron daemon first, or &kcron; won't work."
msgstr ""

#. Tag: title
#: index.docbook:88
#, no-c-format
msgid "&kcron; Start Up"
msgstr ""

#. Tag: para
#: index.docbook:90
#, no-c-format
msgid ""
"When &kcron; starts you will see a summarized view of existing scheduled "
"tasks and associated environment variables. If you are running as the root "
"user, you will see these items for all users on the computer as well as the "
"system scheduled tasks. Each of the folders can be expanded and contracted."
msgstr ""

#. Tag: screeninfo
#: index.docbook:97
#, no-c-format
msgid "<screeninfo>&kcron; at start up.</screeninfo>"
msgstr ""

#. Tag: phrase
#: index.docbook:101
#, no-c-format
msgid "<phrase>&kcron; at start up.</phrase>"
msgstr ""

#. Tag: title
#: index.docbook:106
#, no-c-format
msgid "Scheduled Tasks"
msgstr ""

#. Tag: para
#: index.docbook:108
#, no-c-format
msgid ""
"Scheduled tasks appear under a <guilabel>Tasks</guilabel> folder. For each "
"scheduled task, the following are displayed:"
msgstr ""

#. Tag: guilabel
#: index.docbook:114 index.docbook:142
#, no-c-format
msgid "Name"
msgstr "Nom"

#. Tag: para
#: index.docbook:115
#, no-c-format
msgid "Name to identify the scheduled task."
msgstr ""

#. Tag: guilabel
#: index.docbook:118 index.docbook:146 index.docbook:459
#, no-c-format
msgid "Value"
msgstr "Valor"

#. Tag: para
#: index.docbook:119
#, no-c-format
msgid "Program file and parameters."
msgstr ""

#. Tag: guilabel
#: index.docbook:122 index.docbook:150
#, no-c-format
msgid "Description"
msgstr "Descripcion"

#. Tag: para
#: index.docbook:123
#, no-c-format
msgid "Natural language description of scheduled task."
msgstr ""

#. Tag: para
#: index.docbook:128
#, no-c-format
msgid ""
"If a task has been disabled, no program file and parameters will appear, and "
"the description will be disabled."
msgstr ""

#. Tag: title
#: index.docbook:134
#, no-c-format
msgid "Environment Variables"
msgstr ""

#. Tag: para
#: index.docbook:136
#, no-c-format
msgid ""
"Environment variables appear under a <guilabel>Variables</guilabel> folder. "
"For each environment variable, the following are displayed:"
msgstr ""

#. Tag: para
#: index.docbook:143
#, no-c-format
msgid "Variable name."
msgstr ""

#. Tag: para
#: index.docbook:147
#, no-c-format
msgid "Variable value."
msgstr ""

#. Tag: para
#: index.docbook:151
#, no-c-format
msgid "Natural language description of variable."
msgstr ""

#. Tag: para
#: index.docbook:155
#, no-c-format
msgid ""
"Environment variables appearing here will override any existing environment "
"variable for all scheduled tasks. If an environment variable has been "
"disabled, no value will appear and the description will be disabled."
msgstr ""

#. Tag: screeninfo
#: index.docbook:161
#, no-c-format
msgid "<screeninfo>&kcron; main window</screeninfo>"
msgstr ""

#. Tag: phrase
#: index.docbook:165
#, no-c-format
msgid "<phrase>&kcron; main window</phrase>"
msgstr ""

#. Tag: title
#: index.docbook:173
#, no-c-format
msgid "Adding Scheduled Tasks"
msgstr ""

#. Tag: para
#: index.docbook:175
#, no-c-format
msgid ""
"To create a new scheduled task, first select the <guilabel>Tasks</guilabel> "
"folder. Then select <menuchoice><guimenu>Edit</guimenu> <guimenuitem>New...</"
"guimenuitem> </menuchoice>. Alternatively, you can use the "
"<mousebutton>right</mousebutton> mouse button menu and choose "
"<menuchoice><guimenuitem>New...</guimenuitem></menuchoice>, or simply press "
"<keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo>."
msgstr ""

#. Tag: title
#: index.docbook:185
#, no-c-format
msgid "The <guilabel>Edit Task</guilabel> Dialog"
msgstr ""

#. Tag: screeninfo
#: index.docbook:188
#, no-c-format
msgid "<guilabel>Edit Task</guilabel> dialog."
msgstr ""

#. Tag: phrase
#: index.docbook:191
#, no-c-format
msgid "<guilabel>Edit Task</guilabel> dialog"
msgstr ""

#. Tag: guilabel
#: index.docbook:197 index.docbook:463
#, no-c-format
msgid "Comment"
msgstr "Comentari"

#. Tag: para
#: index.docbook:198
#, no-c-format
msgid "Enter a description of the task to schedule."
msgstr ""

#. Tag: guilabel
#: index.docbook:202
#, no-c-format
msgid "Program"
msgstr "Programa"

#. Tag: para
#: index.docbook:203
#, no-c-format
msgid ""
"Enter the name of the program. You can specify either a relative path or "
"absolute path. If you want to look up the program, click <guibutton>Browse..."
"</guibutton>."
msgstr ""

#. Tag: guibutton
#: index.docbook:209
#, no-c-format
msgid "<guibutton>Enabled</guibutton>"
msgstr ""

#. Tag: para
#: index.docbook:210
#, no-c-format
msgid ""
"To enable or disable the task, select or de-select <guilabel>Enabled</"
"guilabel>."
msgstr ""

#. Tag: guilabel
#: index.docbook:216
#, no-c-format
msgid "Silent"
msgstr ""

#. Tag: para
#: index.docbook:218
#, no-c-format
msgid "Turns off logging of the command and the output from the command."
msgstr ""

#. Tag: guilabel
#: index.docbook:225
#, no-c-format
msgid "Months"
msgstr "Meses"

#. Tag: para
#: index.docbook:226
#, no-c-format
msgid "Select the months during which the task is to be scheduled."
msgstr ""

#. Tag: guilabel
#: index.docbook:231
#, no-c-format
msgid "Days of the Month"
msgstr ""

#. Tag: para
#: index.docbook:232
#, no-c-format
msgid "Select the days of the month on which the task is to be scheduled."
msgstr ""

#. Tag: guilabel
#: index.docbook:237
#, no-c-format
msgid "Days of the Week"
msgstr ""

#. Tag: para
#: index.docbook:238
#, no-c-format
msgid "Select the days of the week on which the task is to be scheduled."
msgstr ""

#. Tag: guilabel
#: index.docbook:243
#, no-c-format
msgid "Daily"
msgstr "Cada jorn"

#. Tag: para
#: index.docbook:244
#, no-c-format
msgid ""
"If you want to schedule the task to run daily, select <guibutton>Run every "
"day</guibutton>."
msgstr ""

#. Tag: guilabel
#: index.docbook:249
#, no-c-format
msgid "Hours"
msgstr "Oras"

#. Tag: para
#: index.docbook:250
#, no-c-format
msgid "Select the hours on which the task is to be scheduled."
msgstr ""

#. Tag: guilabel
#: index.docbook:254
#, no-c-format
msgid "Minutes"
msgstr "Minutas"

#. Tag: para
#: index.docbook:255
#, no-c-format
msgid ""
"Select the minute at which the task is to be scheduled. &kcron; does not "
"support scheduling tasks at smaller than five minute intervals."
msgstr ""

#. Tag: guibutton
#: index.docbook:260 index.docbook:475
#, no-c-format
msgid "<guibutton>OK</guibutton>"
msgstr ""

#. Tag: para
#: index.docbook:261
#, no-c-format
msgid "Completes the creation of this task."
msgstr ""

#. Tag: guibutton
#: index.docbook:265 index.docbook:481
#, no-c-format
msgid "Cancel"
msgstr "Anullar"

#. Tag: para
#: index.docbook:266
#, no-c-format
msgid "Cancels the creation of this task."
msgstr ""

#. Tag: para
#: index.docbook:271
#, no-c-format
msgid ""
"If you select both days of the month, and days of the week, the task will "
"run when either condition is met. For instance, if you select the 1st and "
"15th, and select Sunday, the program will be run every 1st and 15th of the "
"selected months (regardless of day of week) as well as every Sunday of the "
"selected months (regardless of day of the month)."
msgstr ""

#. Tag: para
#: index.docbook:278
#, no-c-format
msgid ""
"The scheduled task is not actually set up until the <filename>crontab</"
"filename> has been saved."
msgstr ""

#. Tag: title
#: index.docbook:285
#, no-c-format
msgid "Managing Scheduled Tasks"
msgstr ""

#. Tag: para
#: index.docbook:287
#, no-c-format
msgid ""
"As with creating new tasks, changes to tasks will not actually be made until "
"the <filename>crontab</filename> is saved."
msgstr ""

#. Tag: title
#: index.docbook:291
#, no-c-format
msgid "Cutting Scheduled Tasks"
msgstr ""

#. Tag: para
#: index.docbook:293
#, no-c-format
msgid ""
"To cut a scheduled task, first select the task to be cut. Then select "
"<menuchoice><guimenu>Edit</guimenu> <guimenuitem>Cut</guimenuitem></"
"menuchoice>."
msgstr ""

#. Tag: para
#: index.docbook:295 index.docbook:508
#, no-c-format
msgid ""
"Alternatively, you can use the <mousebutton>right</mousebutton> mouse button "
"menu and choose <menuchoice><guimenuitem>Cut</guimenuitem></menuchoice>, or "
"simply press <keycombo action=\"simul\">&Ctrl;<keycap>X</keycap></keycombo>."
msgstr ""

#. Tag: title
#: index.docbook:304
#, no-c-format
msgid "Copying Scheduled Tasks"
msgstr ""

#. Tag: para
#: index.docbook:306
#, no-c-format
msgid ""
"To copy a scheduled task, first select the task to be copied. Then select "
"<menuchoice><guimenu>Edit</guimenu><guimenuitem>Copy</guimenuitem></"
"menuchoice> ."
msgstr ""

#. Tag: para
#: index.docbook:311
#, no-c-format
msgid ""
"Alternatively, you can use the <mousebutton>right</mousebutton> mouse button "
"menu and choose <menuchoice><guimenuitem>Copy</guimenuitem></menuchoice>, or "
"simply press <keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo>."
msgstr ""

#. Tag: title
#: index.docbook:319
#, no-c-format
msgid "Pasting Scheduled Tasks"
msgstr ""

#. Tag: para
#: index.docbook:321
#, no-c-format
msgid ""
"To paste a scheduled task, first a scheduled task must have already been cut "
"or copied to the clipboard. Once a scheduled task has been cut or copied, "
"paste will be enabled. Then select the <guilabel>Tasks</guilabel> folder. "
"Finally, select <menuchoice> <guimenu>Edit</guimenu> <guimenuitem>Paste</"
"guimenuitem> </menuchoice>."
msgstr ""

#. Tag: para
#: index.docbook:328 index.docbook:540
#, no-c-format
msgid ""
"Alternatively, you can use the <mousebutton>right</mousebutton> mouse button "
"menu and choose <menuchoice><guimenuitem>Paste</guimenuitem></menuchoice>, "
"or simply press <keycombo action=\"simul\">&Ctrl;<keycap>V</keycap></"
"keycombo>."
msgstr ""

#. Tag: title
#: index.docbook:337
#, no-c-format
msgid "Modifying Scheduled Tasks"
msgstr ""

#. Tag: para
#: index.docbook:339
#, no-c-format
msgid ""
"To modify a scheduled task, first select the task to be modified. Then "
"select <menuchoice> <guimenu>Edit</guimenu> <guimenuitem>Modify...</"
"guimenuitem> </menuchoice>."
msgstr ""

#. Tag: para
#: index.docbook:345
#, no-c-format
msgid ""
"Alternatively, you can use the <mousebutton>right</mousebutton> mouse button "
"menu and choose <menuchoice><guimenuitem>Modify...</guimenuitem></"
"menuchoice>, or simply press <keycombo action=\"simul\">&Ctrl;<keycap>O</"
"keycap></keycombo>. You will see the <guilabel>Edit Task</guilabel> dialog, "
"with which you would modify the task as described <link linkend=\"new-task"
"\">above</link>."
msgstr ""

#. Tag: title
#: index.docbook:356
#, no-c-format
msgid "Deleting Scheduled Tasks"
msgstr ""

#. Tag: para
#: index.docbook:358
#, no-c-format
msgid ""
"To delete a scheduled task, first select the task to be deleted. Then select "
"<menuchoice> <guimenu>Edit</guimenu> <guimenuitem>Delete</guimenuitem> </"
"menuchoice>."
msgstr ""

#. Tag: para
#: index.docbook:362 index.docbook:569
#, no-c-format
msgid ""
"Alternatively, you can use the <mousebutton>right</mousebutton> mouse button "
"menu and choose <guimenuitem>Delete</guimenuitem>."
msgstr ""

#. Tag: title
#: index.docbook:368
#, no-c-format
msgid "Enabling/Disabling Scheduled Tasks"
msgstr ""

#. Tag: para
#: index.docbook:370
#, no-c-format
msgid ""
"To enable or disable a scheduled task, first select the disabled task. "
"Disabled tasks will have <guilabel>Disabled</guilabel> in their "
"descriptions. Then select <menuchoice> <guimenu>Edit</guimenu> "
"<guimenuitem>Enabled</guimenuitem> </menuchoice>."
msgstr ""

#. Tag: para
#: index.docbook:375
#, no-c-format
msgid ""
"Alternatively, you can use the <mousebutton>right</mousebutton> mouse button "
"menu and choose <menuchoice><guimenuitem>Enabled</guimenuitem></menuchoice>. "
"Confirm that the scheduled task's program name, parameters, and description "
"are correctly displayed."
msgstr ""

#. Tag: title
#: index.docbook:384
#, no-c-format
msgid "Running Scheduled Tasks"
msgstr ""

#. Tag: para
#: index.docbook:386
#, no-c-format
msgid ""
"To run a scheduled task immediately, first select the task. Then select "
"<menuchoice> <guimenu>Edit</guimenu> <guimenuitem>Run Now</guimenuitem> </"
"menuchoice>."
msgstr ""

#. Tag: para
#: index.docbook:390
#, no-c-format
msgid ""
"Alternatively, you can use the <mousebutton>right</mousebutton> mouse button "
"menu and choose <menuchoice><guimenuitem>Run Now</guimenuitem></menuchoice>."
msgstr ""

#. Tag: title
#: index.docbook:398
#, no-c-format
msgid "Adding Environment Variables"
msgstr ""

#. Tag: para
#: index.docbook:400
#, no-c-format
msgid ""
"To create a new environment variable, first select the <guilabel>Variables</"
"guilabel> folder. Then select <menuchoice> <guimenu>Edit</"
"guimenu><guimenuitem>New...</guimenuitem> </menuchoice>."
msgstr ""

#. Tag: para
#: index.docbook:405
#, no-c-format
msgid ""
"Alternatively, you can use the <mousebutton>right</mousebutton> mouse button "
"menu and choose <menuchoice><guimenuitem>New...</guimenuitem></menuchoice>, "
"or simply press <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></"
"keycombo>."
msgstr ""

#. Tag: title
#: index.docbook:412
#, no-c-format
msgid "The <guilabel>Edit Variable</guilabel> dialog"
msgstr ""

#. Tag: screeninfo
#: index.docbook:415
#, no-c-format
msgid "<screeninfo><guilabel>Edit Variable</guilabel> dialog.</screeninfo>"
msgstr ""

#. Tag: phrase
#: index.docbook:418
#, no-c-format
msgid "<phrase><guilabel>Edit Variable</guilabel> dialog.</phrase>"
msgstr ""

#. Tag: guilabel
#: index.docbook:425
#, no-c-format
msgid "Variable"
msgstr "Variable"

#. Tag: para
#: index.docbook:426
#, no-c-format
msgid ""
"Enter the environment variable name. You can use the drop-down list box to "
"select from the most common environment variables used by scheduled tasks. "
"Those include:"
msgstr ""

#. Tag: guimenuitem
#: index.docbook:433
#, no-c-format
msgid "HOME"
msgstr ""

#. Tag: para
#: index.docbook:434
#, no-c-format
msgid "To be used instead of the default user's home folder."
msgstr ""

#. Tag: guimenuitem
#: index.docbook:439
#, no-c-format
msgid "MAILTO"
msgstr ""

#. Tag: para
#: index.docbook:440
#, no-c-format
msgid ""
"To send email output to an email address other than the user's default email "
"address."
msgstr ""

#. Tag: guimenuitem
#: index.docbook:445
#, no-c-format
msgid "PATH"
msgstr "CAMIN"

#. Tag: para
#: index.docbook:446
#, no-c-format
msgid "To be used to search folders for program files."
msgstr ""

#. Tag: guimenuitem
#: index.docbook:451
#, no-c-format
msgid "SHELL"
msgstr ""

#. Tag: para
#: index.docbook:452
#, no-c-format
msgid "To be used instead of the user's default value."
msgstr ""

#. Tag: para
#: index.docbook:460
#, no-c-format
msgid "Enter the environment variable value."
msgstr ""

#. Tag: para
#: index.docbook:464
#, no-c-format
msgid "Enter a description for the environment variable, such as its purpose."
msgstr ""

#. Tag: guilabel
#: index.docbook:468
#, no-c-format
msgid "<guilabel>Enabled</guilabel>"
msgstr ""

#. Tag: para
#: index.docbook:470
#, no-c-format
msgid ""
"To enable or disable the variable, select or de-select <guibutton>Enabled</"
"guibutton>."
msgstr ""

#. Tag: para
#: index.docbook:477
#, no-c-format
msgid "Completes the setting of this variable."
msgstr ""

#. Tag: para
#: index.docbook:483
#, no-c-format
msgid "Cancels the setting of this variable."
msgstr ""

#. Tag: para
#: index.docbook:488
#, no-c-format
msgid ""
"The environment variable is not actually set up until the <filename>crontab</"
"filename> has been saved."
msgstr ""

#. Tag: title
#: index.docbook:495
#, no-c-format
msgid "Managing Environment Variables"
msgstr ""

#. Tag: para
#: index.docbook:497
#, no-c-format
msgid ""
"As with creating new variables, changes to variables will not actually be "
"made until the <filename>crontab</filename> is saved."
msgstr ""

#. Tag: title
#: index.docbook:502
#, no-c-format
msgid "Cutting Environment Variables"
msgstr ""

#. Tag: para
#: index.docbook:504
#, no-c-format
msgid ""
"To cut an environment variable, first select the variable to be cut. Then "
"select <menuchoice><guimenu>Edit</guimenu> <guimenuitem>Cut</guimenuitem> </"
"menuchoice>."
msgstr ""

#. Tag: title
#: index.docbook:517
#, no-c-format
msgid "Copying Environment Variables"
msgstr ""

#. Tag: para
#: index.docbook:519
#, no-c-format
msgid ""
"To copy an environment variable, first select the variable to be copied. "
"Then select <menuchoice> <guimenu>Edit</guimenu> <guimenuitem>Copy</"
"guimenuitem> </menuchoice>."
msgstr ""

#. Tag: para
#: index.docbook:523
#, no-c-format
msgid ""
"Alternatively, you can use the <mousebutton>right</mousebutton> mouse button "
"menu and choose <guimenuitem>Copy</guimenuitem>, or simply press <keycombo "
"action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo>."
msgstr ""

#. Tag: title
#: index.docbook:531
#, no-c-format
msgid "Pasting Environment Variables"
msgstr ""

#. Tag: para
#: index.docbook:533
#, no-c-format
msgid ""
"To paste an environment variable, first an environment variable must have "
"already been cut or copied to the clipboard. Once an environment variable "
"has been cut or copied, paste will be enabled. Then select the "
"<guilabel>Variables</guilabel> folder. Finally, select "
"<menuchoice><guimenu>Edit</guimenu> <guimenuitem>Paste</guimenuitem> </"
"menuchoice>."
msgstr ""

#. Tag: title
#: index.docbook:548
#, no-c-format
msgid "Modifying Environment Variables"
msgstr ""

#. Tag: para
#: index.docbook:550
#, no-c-format
msgid ""
"To modify an environment variable, first select the variable to be modified. "
"Then select <menuchoice> <guimenu>Edit</guimenu> <guimenuitem>Modify...</"
"guimenuitem> </menuchoice>. Alternatively, you can use the "
"<mousebutton>right</mousebutton> mouse button menu and choose "
"<guimenuitem>Modify...</guimenuitem>, or simply press <keycombo action="
"\"simul\">&Ctrl;<keycap>O</keycap></keycombo>. You will see the "
"<guilabel>Edit Variable</guilabel> dialog, in which you would modify the "
"variable as described <link linkend=\"new-variable\">above</link>."
msgstr ""

#. Tag: title
#: index.docbook:562
#, no-c-format
msgid "Deleting Environment Variables"
msgstr ""

#. Tag: para
#: index.docbook:564
#, no-c-format
msgid ""
"To delete an environment variable, first select the variable to be deleted. "
"Then select <menuchoice><guimenu>Edit</guimenu><guimenuitem>Delete</"
"guimenuitem> </menuchoice>"
msgstr ""

#. Tag: title
#: index.docbook:575
#, no-c-format
msgid "Enabling/Disabling Environment Variables"
msgstr ""

#. Tag: para
#: index.docbook:577
#, no-c-format
msgid ""
"To enable or disabled an environment variable, first select the disabled "
"variable. Disabled variables will have <guilabel>Disabled</guilabel> in "
"their descriptions. Then select <menuchoice> <guimenu>Edit</guimenu> "
"<guimenuitem>Enabled</guimenuitem> </menuchoice>."
msgstr ""

#. Tag: para
#: index.docbook:583
#, no-c-format
msgid ""
"Alternatively, you can use the <mousebutton>right</mousebutton> mouse button "
"menu and choose <menuchoice><guimenuitem>Enabled</guimenuitem></menuchoice>. "
"Confirm that the environment variable's name and value are correctly "
"displayed."
msgstr ""

#. Tag: title
#: index.docbook:593
#, no-c-format
msgid "Saving the <filename>crontab</filename>"
msgstr ""

#. Tag: para
#: index.docbook:595
#, no-c-format
msgid ""
"Once all scheduled tasks and environment variables have been created and/or "
"properly modified, save the <filename>crontab</filename> by selecting "
"<menuchoice> <guimenu>File</guimenu> <guimenuitem>Save</guimenuitem> </"
"menuchoice>."
msgstr ""

#. Tag: para
#: index.docbook:601
#, no-c-format
msgid ""
"Alternatively, you can simply press <keycombo action=\"simul\">&Ctrl;"
"<keycap>S</keycap></keycombo>. Additions or changes will not actually be "
"made until this is done."
msgstr ""

#. Tag: title
#: index.docbook:608
#, no-c-format
msgid "Printing the <filename>crontab</filename>"
msgstr ""

#. Tag: para
#: index.docbook:610
#, no-c-format
msgid ""
"To print the <filename>crontab</filename> as it has been saved, select "
"<menuchoice> <guimenu>File</guimenu> <guimenuitem>Print</guimenuitem> </"
"menuchoice>."
msgstr ""

#. Tag: screeninfo
#: index.docbook:618
#, no-c-format
msgid "<screeninfo>Printing the <filename>crontab</filename>.</screeninfo>"
msgstr ""

#. Tag: phrase
#: index.docbook:621
#, no-c-format
msgid "<phrase>Printing the <filename>crontab</filename>.</phrase>"
msgstr ""

#. Tag: para
#: index.docbook:626
#, no-c-format
msgid ""
"The standard &kde; printer dialog will display. If you select "
"<guilabel>Expand</guilabel> you will see that there are two extra &kcron; "
"specific options in the Print Dialog box."
msgstr ""

#. Tag: guilabel
#: index.docbook:632
#, no-c-format
msgid "Print Crontab"
msgstr ""

#. Tag: para
#: index.docbook:634
#, no-c-format
msgid "Prints the <filename>crontab</filename> for the current user."
msgstr ""

#. Tag: guilabel
#: index.docbook:639
#, no-c-format
msgid "Print All Users"
msgstr ""

#. Tag: para
#: index.docbook:641
#, no-c-format
msgid ""
"Prints the <filename>crontab</filename>s for all users. This option is "
"enabled only for users with super-user privileges."
msgstr ""

