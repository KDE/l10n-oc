#. Tag: guiicon
#: index.docbook:886
#, no-c-format
msgid "Print"
msgstr "Estampar"

#. Tag: guiicon
#: index.docbook:887
#, no-c-format
msgid "Find"
msgstr "Recercar"

#. Tag: guiicon
#: index.docbook:888
#, no-c-format
msgid "Find Next"
msgstr "Recercar lo seguent"

#. Tag: guiicon
#: index.docbook:889
#, no-c-format
msgid "Find Previous"
msgstr "Recercar lo precedent"

#. Tag: guiicon
#: index.docbook:890
#, no-c-format
msgid "<guiicon>Cut</guiicon>"
msgstr ""

#. Tag: guiicon
#: index.docbook:891
#, no-c-format
msgid "Copy"
msgstr "Copiar"

#. Tag: guiicon
#: index.docbook:892
#, no-c-format
msgid "Paste"
msgstr "Pegar"

#. Tag: guiicon
#: index.docbook:893
#, no-c-format
msgid "Undo"
msgstr "Anullar"

#. Tag: guiicon
#: index.docbook:894
#, no-c-format
msgid "Redo"
msgstr "Tornar far"

#. Tag: guiicon
#: index.docbook:895
#, no-c-format
msgid "Cancel Operation"
msgstr ""

#. Tag: guiicon
#: index.docbook:896
#, no-c-format
msgid "Help"
msgstr "Ajuda"

#. Tag: para
#: index.docbook:899
#, no-c-format
msgid "..and at the right of the toolbar.."
msgstr ""

#. Tag: para
#: index.docbook:900
#, no-c-format
msgid ""
"<guiicon>Toggle write protection</guiicon> - switch between read-only and "
"read/write modes."
msgstr ""

#. Tag: title
#: index.docbook:904
#, no-c-format
msgid "Search bar"
msgstr ""

#. Tag: para
#: index.docbook:906
#, no-c-format
msgid ""
"The search bar is used to locate a specific value in the document. Enter a "
"value in the box, select the desired representation (hexadecimal, octal, "
"binary, decimal or text) and hit the <guibutton>Find</guibutton> button. "
"Check the <guilabel>Backwards</guilabel> box to search backwards from the "
"cursor point or check <guilabel>Ignore case</guilabel> for a case-"
"insensitive text search. Click the button on the right of the bar "
"(<guiicon>X</guiicon>) to hide the search bar; go to <guimenuitem>Searchbar</"
"guimenuitem> in the <guimenu>Settings</guimenu> menu to restore it."
msgstr ""

#. Tag: title
#: index.docbook:918
#, no-c-format
msgid "Conversion field"
msgstr ""

#. Tag: para
#: index.docbook:920
#, no-c-format
msgid ""
"The conversion field displays the values of various data types at the "
"selected byte. For 8 bit types, it displays the value of the byte under the "
"cursor; for larger types, it displays the value starting at that byte. The "
"rightmost column displays various encodings of the current byte. Options in "
"the conversion field are:"
msgstr ""

#. Tag: guilabel
#: index.docbook:928
#, no-c-format
msgid "Show little endian decoding"
msgstr ""

#. Tag: para
#: index.docbook:929
#, no-c-format
msgid ""
"When checked, causes multibyte types to be calculated using the little-"
"endian method used by x86 and Alpha processors. In this scheme, the first "
"byte represents the least significant part of the value. (0a 4e = 0x4e0a = "
"19978) When unchecked, causes multibyte types to be calculated using the big-"
"endian method used by PowerPC and Sparc processors. (0a 4e = 0x0a4e = 2638)"
msgstr ""

#. Tag: guilabel
#: index.docbook:938
#, no-c-format
msgid "Show unsigned as hexadecimal"
msgstr ""

#. Tag: para
#: index.docbook:939
#, no-c-format
msgid ""
"When checked, causes unsigned types to be displayed in hexadecimal, rather "
"than decimal format."
msgstr ""

#. Tag: guilabel
#: index.docbook:944
#, no-c-format
msgid "Stream length"
msgstr ""

#. Tag: para
#: index.docbook:945
#, no-c-format
msgid ""
"Determines the number of bits used to calculate the values in the fields "
"above it."
msgstr ""

#. Tag: title
#: index.docbook:953
#, no-c-format
msgid "Status Bar"
msgstr "Barra d'estat"

#. Tag: para
#: index.docbook:955
#, no-c-format
msgid "The status bar displays the following information:"
msgstr ""

#. Tag: term
#: index.docbook:959
#, no-c-format
msgid "Encoding/Selection"
msgstr ""

#. Tag: para
#: index.docbook:960
#, no-c-format
msgid ""
"When there is no selection, this field shows the encoding option used. (See "
"<link linkend=\"view-encoding\"><menuchoice> <guimenu>View</guimenu> "
"<guimenuitem>Document Encoding</guimenuitem> </menuchoice></link> for more "
"information on encoding.) The start point and the length of the selection "
"are shown."
msgstr ""

#. Tag: term
#: index.docbook:970
#, no-c-format
msgid "File Modified"
msgstr ""

#. Tag: para
#: index.docbook:971
#, no-c-format
msgid ""
"A <computeroutput>!</computeroutput> in this box indicates the current file "
"was modified."
msgstr ""

#. Tag: term
#: index.docbook:976
#, no-c-format
msgid "Insert/Overwrite"
msgstr ""

#. Tag: para
#: index.docbook:977
#, no-c-format
msgid ""
"Indicates whether values entered at the keyboard are inserted at the cursor "
"point (<guilabel>INS</guilabel>) or overwrite the existing data starting at "
"the cursor(<guilabel>OVR</guilabel>). Use the <keycap>Insert</keycap> key to "
"toggle between the two modes."
msgstr ""

#. Tag: term
#: index.docbook:984
#, no-c-format
msgid "Size"
msgstr "Talha"

#. Tag: para
#: index.docbook:985
#, no-c-format
msgid "Displays the total size of the current document."
msgstr ""

#. Tag: term
#: index.docbook:990
#, no-c-format
msgid "Offset"
msgstr ""

#. Tag: para
#: index.docbook:991
#, no-c-format
msgid "Indicates the position of the cursor within the document."
msgstr ""

#. Tag: term
#: index.docbook:996
#, no-c-format
msgid "Display mode"
msgstr ""

#. Tag: para
#: index.docbook:997
#, no-c-format
msgid ""
"Indicates whether data editor window is displaying values in hexadecimal, "
"octal, binary, decimal or text mode. Switch between modes with the View menu."
msgstr ""

#. Tag: term
#: index.docbook:1003
#, no-c-format
msgid "Write Protection"
msgstr ""

#. Tag: para
#: index.docbook:1004
#, no-c-format
msgid ""
"Indicates whether the document can be edited (<guilabel>RW</guilabel>) or is "
"being viewed read-only (<guilabel>R</guilabel>). Switch between modes with "
"the button on the far-right of the toolbar or the <guimenuitem>Permissions</"
"guimenuitem> command in the <guimenu>File</guimenu> menu."
msgstr ""

