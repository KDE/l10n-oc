#: index.docbook:726
#, no-c-format
msgid "<guimenu>Documents</guimenu> Menu"
msgstr ""

#. Tag: para
#: index.docbook:728
#, no-c-format
msgid "Provides a list of the open documents. Selecting one makes it active."
msgstr ""

