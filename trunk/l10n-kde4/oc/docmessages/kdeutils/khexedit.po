#. Tag: title
#: index.docbook:669
#, no-c-format
msgid "<guimenu>Tools</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: index.docbook:673
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Extract Strings...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:677
#, no-c-format
msgid ""
"Locate <acronym>ASCII</acronym> strings in the data. Minimum string length, "
"case sensitivity and a pattern to match can be specified."
msgstr ""

#. Tag: menuchoice
#: index.docbook:683
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Binary Filter...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:687
#, no-c-format
msgid ""
"<action>Perform a binary operation on the data.</action> The operation (AND, "
"OR, ROTATE..) and an operand can be specified in the dialog box. Check boxes "
"in the dialog allow the operation to be limited to selected bytes or the "
"region before or after the cursor."
msgstr ""

#. Tag: menuchoice
#: index.docbook:694
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Character Table</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:698
#, no-c-format
msgid ""
"Open a list of values and their <acronym>ASCII</acronym> equivalents and "
"<action>insert the selected value at the cursor.</action>"
msgstr ""

#. Tag: menuchoice
#: index.docbook:704
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Converter</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:708
#, no-c-format
msgid ""
"<action>Enter a value in any of the fields and see its equivalent in "
"hexadecimal, decimal, octal, binary or text</action>. A check box allows "
"viewing of the value at the cursor instead."
msgstr ""

#. Tag: menuchoice
#: index.docbook:714
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Statistics</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:718
#, no-c-format
msgid "Display the frequency of occurrence of values in the document."
msgstr ""

