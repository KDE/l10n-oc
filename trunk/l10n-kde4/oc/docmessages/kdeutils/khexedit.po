msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>B</keycap></keycombo> </"
"shortcut> <guimenu>Bookmarks</guimenu> <guimenuitem>Add Bookmark</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:602
#, no-c-format
msgid "Bookmark a location within the document."
msgstr ""

#. Tag: para
#: index.docbook:603
#, no-c-format
msgid ""
"Multiple bookmarks can be set for a single document. Each document has its "
"own set of bookmarks and the appropriate set is displayed at the bottom of "
"the <guimenu>Bookmarks</guimenu> menu when a document is selected. Choose a "
"bookmark from the menu to go to it."
msgstr ""

#. Tag: menuchoice
#: index.docbook:610
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>E</keycap></keycombo> </"
"shortcut> <guimenu>Bookmarks</guimenu> <guimenuitem>Replace Bookmark</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:617
#, no-c-format
msgid ""
"<action>Reset an existing bookmark to the current cursor location.</action> "
"A dialog will be opened with the list of available bookmarks; select the one "
"you wish to change."
msgstr ""

#. Tag: menuchoice
#: index.docbook:623
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>U</keycap></keycombo> </"
"shortcut> <guimenu>Bookmarks</guimenu> <guimenuitem>Remove Bookmark</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:630
#, no-c-format
msgid ""
"<action>Remove an existing bookmark.</action> A dialog will be opened with a "
"list of available bookmarks; select the one you wish to remove."
msgstr ""

#. Tag: menuchoice
#: index.docbook:636
#, no-c-format
msgid "<guimenu>Bookmarks</guimenu> <guimenuitem>Remove All</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:640
#, no-c-format
