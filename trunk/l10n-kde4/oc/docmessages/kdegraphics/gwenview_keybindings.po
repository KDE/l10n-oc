#. Tag: title
#: keybindings.docbook:2
#, no-c-format
msgid "Key bindings"
msgstr ""

#. Tag: para
#: keybindings.docbook:4
#, no-c-format
msgid ""
"&kappname; comes with a range of keyboard shortcuts, all of which can be "
"viewed and remapped by selecting <menuchoice><guimenu>Settings</"
"guimenu><guimenuitem>Configure Shortcuts...</guimenuitem></menuchoice>. Note "
"that in the Files and Folders windows, all the normal KDE shortcuts are "
"functional, unless otherwise remapped."
msgstr ""

#. Tag: para
#: keybindings.docbook:9
#, no-c-format
msgid "A few of the most useful default bindings are:"
msgstr ""

#. Tag: para
#: keybindings.docbook:12
#, no-c-format
msgid "<keycap>Space</keycap>: Displays the next image in the directory."
msgstr ""

#. Tag: para
#: keybindings.docbook:13
#, no-c-format
msgid ""
"<keycap>Backspace</keycap>: Displays the previous image in the directory."
msgstr ""

#. Tag: para
#: keybindings.docbook:14
#, no-c-format
msgid ""
"<keycombo action=\"simul\">&Ctrl;<keycap>Return</keycap></keycombo>: Toggles "
"between Browse and View modes."
msgstr ""

#. Tag: para
#: keybindings.docbook:16
#, no-c-format
msgid ""
"<keycombo action=\"simul\">&Ctrl; &Shift;<keycap>F</keycap></keycombo>: "
"Activates Full Screen mode."
msgstr ""

#. Tag: para
#: keybindings.docbook:18
#, no-c-format
msgid "<keycap>Escape</keycap>: Exits from Full Screen mode."
msgstr ""
