#: index.docbook:1521
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Backends...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1527
#, no-c-format
