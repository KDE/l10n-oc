#, no-c-format
msgid "<link>Presentation</link>"
msgstr ""

#. Tag: link
#: index.docbook:986
#, no-c-format
msgid "<link>Identity</link>"
msgstr ""

#. Tag: screeninfo
#: index.docbook:990
#, no-c-format
msgid "<screeninfo>The configuration dialogue</screeninfo>"
msgstr ""

#. Tag: phrase
#: index.docbook:996
#, no-c-format
msgid "<phrase>The configuration dialogue</phrase>"
msgstr ""

#. Tag: para
#: index.docbook:1000
#, no-c-format
msgid ""
"Depending on the currently installed backends, the <menuchoice><guimenu>"
"Settings</guimenu> <guimenuitem>Configure Backends...</guimenuitem></menuchoice> "
"menu item could be enabled. This particular configuration dialogue holds the "
"configurations of the backends that can actually be configured."
msgstr ""

#. Tag: title
#: index.docbook:1008
#, no-c-format
msgid "<title>General</title>"
msgstr ""

#. Tag: term
#: index.docbook:1011
#, no-c-format
msgid "Show scrollbars"
msgstr ""

#. Tag: para
#: index.docbook:1013
#, no-c-format
msgid "Whether to show scrollbars for the document view."
msgstr ""

#. Tag: term
#: index.docbook:1017
#, no-c-format
msgid "Show search bar in thumbnails list"
msgstr ""

#. Tag: para
#: index.docbook:1019
#, no-c-format
msgid ""
"Whether to the show a search bar in the thumbnails view or not. That search bar "
"is useful for filtering pages that contain a given string."
msgstr ""

#. Tag: term
#: index.docbook:1025
#, no-c-format
msgid "Link thumbnails list with the page"
msgstr ""

#. Tag: para
#: index.docbook:1027
#, no-c-format
msgid "Whether the thumbnails view should always display the current page or not."
msgstr ""

#. Tag: term
#: index.docbook:1032
#, no-c-format
msgid "Show hints and info messages"
msgstr ""

#. Tag: para
#: index.docbook:1034
#, no-c-format
msgid "Whether to show some informative messages on startup, file load, &etc;."
msgstr ""

#. Tag: term
#: index.docbook:1039
#, no-c-format
msgid "Obey DRM limitations"
msgstr ""

#. Tag: para
#: index.docbook:1041
#, no-c-format
msgid ""
"Whether &okular; should obey <firstterm>DRM</firstterm> "
"(Digital Rights Management) restrictions. DRM limitations are used to make it "
"impossible to perform certain actions with &PDF; documents, such as copying "
"content to the clipboard. Note that in some configurations of &okular;, this "
"option is not available."
msgstr ""

#. Tag: term
#: index.docbook:1049
#, no-c-format
msgid "Reload the document on file change"
msgstr ""

#. Tag: para
#: index.docbook:1051
#, no-c-format
msgid ""
"Whether opened files should be automatically checked for changes and updated, "
"if necessary."
msgstr ""

#. Tag: term
#: index.docbook:1056
#, no-c-format
msgid "Show backend selection dialog"
msgstr ""

#. Tag: para
#: index.docbook:1058
#, no-c-format
msgid ""
"Whether &okular; should ask the user which backend to use in case of more than "
"one backend able to open the current file. If unchecked, &okular; will use the "
"backend with the highest priority."
msgstr ""

#. Tag: term
#: index.docbook:1064
#, no-c-format
msgid "Center first page in facing mode"
msgstr ""

#. Tag: para
#: index.docbook:1066
#, no-c-format
msgid ""
"Whether the first page should be centered or aligned to the right when "
"displaying the pages in facing mode."
msgstr ""

#. Tag: term
#: index.docbook:1071
#, no-c-format
msgid "Overview columns"
msgstr ""

#. Tag: para
#: index.docbook:1073
#, no-c-format
msgid "This options represent the number of columns to use in the overview mode."
msgstr ""

#. Tag: title
#: index.docbook:1081
#, no-c-format
msgid "<title>Accessibility</title>"
msgstr ""

#. Tag: term
#: index.docbook:1084
#, no-c-format
msgid "Draw border around images"
msgstr ""

#. Tag: para
#: index.docbook:1086
#, no-c-format
msgid "Whether to draw a border around images."
msgstr ""

#. Tag: term
#: index.docbook:1090
#, no-c-format
msgid "Draw border around links"
msgstr ""

#. Tag: para
#: index.docbook:1092
#, no-c-format
msgid "Whether to draw a border around links."
msgstr ""

#. Tag: term
#: index.docbook:1096
#, no-c-format
msgid "Change colors"
msgstr ""

#. Tag: para
#: index.docbook:1098
#, no-c-format
msgid "<action>Enables</action> the color changing options."
msgstr ""

#. Tag: term
#: index.docbook:1102
#, no-c-format
msgid "Invert colors"
msgstr ""

#. Tag: para
#: index.docbook:1104
#, no-c-format
msgid ""
"<action>Inverts</action> colors on the view, &ie; black objects will be shown "
"white."
msgstr ""

#. Tag: term
#: index.docbook:1108
#, no-c-format
msgid "Change paper color"
msgstr ""

#. Tag: para
#: index.docbook:1110
#, no-c-format
msgid "<action>Changes</action> the paper's color, &ie; the document's background."
msgstr ""

#. Tag: term
#: index.docbook:1114
#, no-c-format
msgid "Change dark and light colors"
msgstr ""

#. Tag: para
#: index.docbook:1116
#, no-c-format
msgid ""
"<action>Changes</action> the dark and light color to your preference, that "
"means black will not be rendered as black but as the selected dark color and "
"white will not be rendered as white but as the selected light color."
msgstr ""

#. Tag: term
#: index.docbook:1122
#, no-c-format
msgid "Convert to black and white"
msgstr ""

#. Tag: para
#: index.docbook:1124
#, no-c-format
msgid ""
"<action>Converts</action> the document to black and white. You can set the "
"threshold and the contrast. Setting the threshold to a higher value will result "
"in darker grays used."
msgstr ""

#. Tag: title
#: index.docbook:1132
#, no-c-format
msgid "<title>Performance</title>"
msgstr ""

#. Tag: term
#: index.docbook:1135
#, no-c-format
msgid "Enable transparency effects"
msgstr ""

#. Tag: para
#: index.docbook:1137
#, no-c-format
msgid ""
"Draw selections and other special graphics using transparency effects. Disable "
"the option to draw them using outline or opaque fill styles and increase speed "
"on selections."
msgstr ""

#. Tag: term
#: index.docbook:1143
#, no-c-format
msgid "Enable background generation"
msgstr ""

#. Tag: para
#: index.docbook:1145
#, no-c-format
msgid ""
"Use a background thread to generate the pages. By disabling this option the "
"user interface will become less reactive (will be blocked if necessary), but "
"pages will be displayed a bit faster."
msgstr ""

#. Tag: term
#: index.docbook:1151
#, no-c-format
msgid "Memory usage profiles"
msgstr ""

#. Tag: para
#: index.docbook:1153
#, no-c-format
msgid ""
"&okular; can achieve best performance by tuning the memory usage, based on your "
"system and your tastes. The more memory you let it to use, the faster the "
"program will behave. The Default profile is good for every system, but you can "
"prevent &okular; from using more memory than necessary by selecting the Low "
"profile, or let it get the most out of your system using Aggressive."
msgstr ""

#. Tag: title
#: index.docbook:1162
#, no-c-format
msgid "<title>Presentation</title>"
msgstr ""

#. Tag: term
#: index.docbook:1165
#, no-c-format
msgid "Advance every"
msgstr ""

#. Tag: para
#: index.docbook:1167
#, no-c-format
msgid "Enables automatic advancing of pages given a time period."
msgstr ""

#. Tag: term
#: index.docbook:1171
#, no-c-format
msgid "Loop after last page"
msgstr ""

#. Tag: para
#: index.docbook:1173
#, no-c-format
msgid ""
"When navigating on presentation mode and going past the last page the first "
"page will appear."
msgstr ""

#. Tag: term
#: index.docbook:1177
#, no-c-format
msgid "Background color"
msgstr "Color de fons"

#. Tag: para
#: index.docbook:1179
#, no-c-format
msgid ""
"The color that will fill the part of the screen not covered by the page when on "
"presentation mode."
msgstr ""

#. Tag: term
#: index.docbook:1183
#, no-c-format
msgid "Default transition"
msgstr ""

#. Tag: para
#: index.docbook:1185
#, no-c-format
msgid ""
"The transition effect between page and page if the document does not specify "
"one. Set this to <guilabel>Random Transition</guilabel> "
"to make &okular; randomly choose one of the available effects."
msgstr ""

#. Tag: term
#: index.docbook:1190
#, no-c-format
msgid "Mouse cursor"
msgstr ""

#. Tag: para
#: index.docbook:1192
#, no-c-format
msgid ""
"Whether the mouse should be always hidden, always shown or hidden after a small "
"time of inactivity."
msgstr ""

#. Tag: term
#: index.docbook:1196
#, no-c-format
msgid "Show progress indicator"
msgstr ""

#. Tag: para
#: index.docbook:1198
#, no-c-format
msgid ""
"Whether to show a progress circle that shows the current page and the total "
"number of pages on the upper right corner of the presentation screen everytime "
"you change the page."
msgstr ""

#. Tag: term
#: index.docbook:1203
#, no-c-format
msgid "Show summary page"
msgstr ""

#. Tag: para
#: index.docbook:1205
#, no-c-format
msgid ""
"Whether to show a summary page at the beginning of the presentation with the "
"title, author and number of pages of the document."
msgstr ""

#. Tag: term
#: index.docbook:1209
#, no-c-format
msgid "Pencil color"
msgstr ""

#. Tag: para
#: index.docbook:1211
#, no-c-format
msgid ""
"The color of the pencil used when drawing on the pages during the presentation "
"mode."
msgstr ""

#. Tag: title
#: index.docbook:1217
#, no-c-format
msgid "<title>Identity</title>"
msgstr ""

#. Tag: term
#: index.docbook:1220
#, no-c-format
msgid "Author"
msgstr "Autor"

#. Tag: para
#: index.docbook:1222
#, no-c-format
msgid "The author of the contents added on a document."
msgstr ""

