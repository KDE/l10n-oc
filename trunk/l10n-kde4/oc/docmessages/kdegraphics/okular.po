msgstr ""

#. Tag: menuchoice
#: index.docbook:1533
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure &okular;...</guimenuitem>"
msgstr ""

#. Tag: para
