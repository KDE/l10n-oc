#. Tag: term
#: dcop.docbook:239
#, no-c-format
msgid "Parser addFunction f_str"
msgstr ""

#. Tag: para
#: dcop.docbook:243
#, no-c-format
msgid ""
"Adds a new function with the expression <parameter>f_str</parameter>. If the "
"expression does not contain a function name, it will be auto-generated. The "
"id number of the new function is returned, or -1 if the function couln't be "
"defined."
msgstr ""

#. Tag: term
#: dcop.docbook:247
#, no-c-format
msgid "Parser delfkt id"
msgstr ""

#. Tag: para
#: dcop.docbook:251
#, no-c-format
msgid ""
"Removes the function with the id number <parameter>id</parameter>. If the "
"function could not be deleted, false is returned, otherwise true."
msgstr ""

#. Tag: term
#: dcop.docbook:255
#, no-c-format
msgid "Parser setFunctionExpression f_str id"
msgstr ""

#. Tag: para
#: dcop.docbook:259
#, no-c-format
msgid ""
"Sets the expression for the function with the id number <parameter>id</"
"parameter> to <parameter>f_str</parameter>. Returns true if it succeed, "
"otherwise false."
msgstr ""

#. Tag: term
#: dcop.docbook:263
#, no-c-format
msgid "Parser countFunctions"
msgstr ""

#. Tag: para
#: dcop.docbook:267
#, no-c-format
msgid ""
"Returns the number of functions (parametric functions are calculated as two)."
msgstr ""

#. Tag: term
#: dcop.docbook:271
#, no-c-format
msgid "Parser listFunctionNames"
msgstr ""

