"<shortcut> <keycombo>&Ctrl;<keycap>E</keycap></keycombo> </shortcut> "
"<guimenu>File</guimenu> <guimenuitem>Open Examples</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:107
#, no-c-format
msgid ""
"Show the folder with examples &logo; programs. The examples should be in "
"your favorite language that you can choose in <menuchoice><guimenu>Settings</"
"guimenu><guimenuitem>Configure &kturtle;...</guimenuitem> </menuchoice>."
msgstr ""

