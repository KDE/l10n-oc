#, no-c-format
msgid "Creates a new, empty &turtlelang; file."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:95
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Ctrl;<keycap>O</keycap></keycombo> </shortcut> "
"<guimenu>File</guimenu> <guimenuitem>Open...</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:102
#, no-c-format
msgid "Opens a &turtlelang; file."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:108
#, no-c-format
