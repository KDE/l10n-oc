"<guimenu>View</guimenu> <guimenuitem>Full Screen Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:360
#, no-c-format
msgid "With this action you toggle the full screen mode."
msgstr ""

#. Tag: para
#: using-kturtle.docbook:361
#, no-c-format
msgid ""
"Note: When code is executed while in full screen mode everything but the "
"canvas is hidden. This makes it possible to write <quote>full screen</quote> "
"programs in &kturtle;."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:367
#, no-c-format
msgid ""
"<shortcut> <keycombo><keysym>F11</keysym></keycombo> </shortcut> "
"<guimenu>View</guimenu> <guimenuitem>Show Line Numbers</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:374
#, no-c-format
msgid ""
"With this action you can show the line numbers in the code editor. This can "
"be handy for finding errors."
msgstr ""

#. Tag: title
#: using-kturtle.docbook:380
#, no-c-format
msgid "The <guimenu>Tools</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:384
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Alt;<keycap>C</keycap></keycombo> </shortcut> "
"<guimenu>Tools</guimenu> <guimenuitem>Color Picker</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:391
#, no-c-format
msgid ""
"This action opens the color picker. Using the color picker you can easily "
"select a <glossterm linkend=\"rgb\">color code</glossterm> and insert it in "
"<link linkend=\"the-code-editor\">the code editor</link>."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:397
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Ctrl;<keycap>I</keycap></keycombo> </shortcut> "
"<guimenu>Tools</guimenu> <guimenuitem>Indent</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:404
#, no-c-format
msgid ""
"This action <quote>indents</quote> (adds white space at the beginning of) "
"the lines that are selected. When <quote>indentation</quote> is used "
"properly this can make code much easier to read. All examples use "
"indentation, please check them out."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:410
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Ctrl;&Shift;<keycap>I</keycap></keycombo> </shortcut> "
"<guimenu>Tools</guimenu> <guimenuitem>Unindent</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:417
#, no-c-format
msgid ""
"This action <quote>unindents</quote> (removes the white space at the "
"beginning of) the lines that are selected."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:423
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Clean Indentation</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:427
#, no-c-format
msgid ""
"This action cleans <quote>indentation</quote> (removes all the white space "
"at the beginning of) the lines that are selected."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:433
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Ctrl;<keycap>D</keycap></keycombo> </shortcut> "
"<guimenu>Tools</guimenu> <guimenuitem>Comment</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:440
#, no-c-format
msgid ""
"This action add comment characters (#) in from of the lines that are "
"selected. Lines that start with a comment character are ignored when the "
"code is executed. Comments allow the programmer to explain a bit about his "
"code or they can be used to temporarily prevent a certain piece of code from "
"being executed."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:446
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Ctrl;&Shift;<keycap>D</keycap></keycombo> </shortcut> "
"<guimenu>Tools</guimenu> <guimenuitem>Uncomment</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:453
#, no-c-format
msgid "This action removes the comment characters from the selected lines."
msgstr ""

