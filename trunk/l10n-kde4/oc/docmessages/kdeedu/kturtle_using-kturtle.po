"<guimenu>File</guimenu> <guimenuitem>Save</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:140
#, no-c-format
msgid "Saves the currently opened &logo; file."
msgstr ""

#. Tag: title
#: using-kturtle.docbook:145
#, no-c-format
msgid "Save As"
msgstr "Enregistrar coma :"

#. Tag: menuchoice
#: using-kturtle.docbook:148
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Save As...</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:152
#, no-c-format
msgid "Saves the currently opened &logo; file on a specified location."
msgstr ""

#. Tag: title
#: using-kturtle.docbook:158
#, no-c-format
msgid "Examples"
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:161
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Examples</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:165
#, no-c-format
msgid ""
"Show the folder with examples &logo; programs. The examples should be in "
"your favorite language that you can choose in <menuchoice><guimenu>Settings</"
"guimenu><guimenuitem>Script Language</guimenuitem> </menuchoice>."
msgstr ""

#. Tag: title
#: using-kturtle.docbook:174
#, no-c-format
msgid "Execution Speed"
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:177
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Execution Speed</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:181
#, no-c-format
msgid ""
"Present a list of possible execution speeds, consisting of: Full Speed, "
"Slow, Slower, Slowest and Step-by-Step. When the execution speed is set to "
"'Full Speed' (default) we can barely keep up with what is happening. "
"Sometimes this behavior is wanted, but sometimes we want to keep track of "
"the execution. In the latter case you want to set the execution speed to "
"'Slow', 'Slower' or 'Slowest'. When one of the slow modes is selected the "
"current position of the executor will be shown in the editor."
msgstr ""

#. Tag: title
#: using-kturtle.docbook:192
#, no-c-format
msgid "<title>Run</title>"
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:195
#, no-c-format
msgid ""
"<shortcut> <keycombo><keysym>F5</keysym></keycombo> </shortcut> "
"<guimenu>File</guimenu> <guimenuitem>Run</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:202
#, no-c-format
msgid "Starts the execution of the commands in the code editor."
msgstr ""

#. Tag: title
#: using-kturtle.docbook:207
#, no-c-format
msgid "Pause"
msgstr "Pausa"

#. Tag: menuchoice
#: using-kturtle.docbook:210
#, no-c-format
msgid ""
"<shortcut> <keycombo><keysym>Pause</keysym></keycombo> </shortcut> "
"<guimenu>File</guimenu> <guimenuitem>Pause Execution</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:217
#, no-c-format
msgid ""
"Pauses the execution. This action is only enabled when the commands are "
"actually executing."
msgstr ""

#. Tag: title
#: using-kturtle.docbook:222
#, no-c-format
msgid "Stop"
msgstr "Arrêter"

#. Tag: menuchoice
#: using-kturtle.docbook:225
#, no-c-format
msgid ""
"<shortcut> <keycombo><keysym>Escape</keysym></keycombo> </shortcut> "
"<guimenu>File</guimenu> <guimenuitem>Stop Execution</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:232
#, no-c-format
msgid ""
"Stops the execution. This action is only enabled when the commands are "
"actually executing."
msgstr ""

#. Tag: title
#: using-kturtle.docbook:237
#, no-c-format
msgid "Print"
msgstr "Estampar"

#. Tag: menuchoice
#: using-kturtle.docbook:240
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Ctrl;<keycap>P</keycap></keycombo> </shortcut> "
"<guimenu>File</guimenu> <guimenuitem>Print...</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:247
#, no-c-format
msgid ""
"Prints either the current code in the editor or the current drawing on the "
"canvas."
msgstr ""

#. Tag: title
#: using-kturtle.docbook:252
#, no-c-format
msgid "Quit"
msgstr "Quitar"

#. Tag: menuchoice
#: using-kturtle.docbook:255
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Ctrl;<keycap>Q</keycap></keycombo> </shortcut> "
"<guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:262
#, no-c-format
msgid "Quits &kturtle;."
msgstr ""

#. Tag: title
#: using-kturtle.docbook:269
#, no-c-format
msgid "The <guimenu>Edit</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:273
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Ctrl;<keycap>Z</keycap></keycombo> </shortcut> "
"<guimenu>Edit</guimenu> <guimenuitem>Undo</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:280
#, no-c-format
msgid "Undoes the last change to code. &kturtle; has unlimited undos."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:286
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Ctrl;&Shift;<keycap>Z</keycap></keycombo> </shortcut> "
"<guimenu>Edit</guimenu> <guimenuitem>Redo</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:293
#, no-c-format
msgid "Redoes an undone change to the code."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:299
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Ctrl;<keycap>X</keycap></keycombo> </shortcut> "
"<guimenu>Edit</guimenu> <guimenuitem>Cut</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:306
#, no-c-format
msgid "Cuts the selected text from the code editor to the clipboard."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:312
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Ctrl;<keycap>C</keycap></keycombo> </shortcut> "
"<guimenu>Edit</guimenu> <guimenuitem>Copy</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:319
#, no-c-format
msgid "Copies the selected text from the code editor to the clipboard."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:325
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Ctrl;<keycap>V</keycap></keycombo> </shortcut> "
"<guimenu>Edit</guimenu> <guimenuitem>Paste</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:332
#, no-c-format
msgid "Pastes the text from the clipboard to the editor."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:338
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Ctrl;<keycap>F</keycap></keycombo> </shortcut> "
"<guimenu>Edit</guimenu> <guimenuitem>Find...</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:345
#, no-c-format
msgid "With this action you can find phrases in the code."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:351
#, no-c-format
msgid ""
"<shortcut> <keycombo><keysym>F3</keysym></keycombo> </shortcut> "
"<guimenu>Edit</guimenu> <guimenuitem>Find Next</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:358
#, no-c-format
msgid "Use this to find the next occurrence of the phrase."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:364
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Ctrl;<keycap>R</keycap></keycombo> </shortcut> "
"<guimenu>Edit</guimenu> <guimenuitem>Replace...</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:371
#, no-c-format
msgid "With this action you can replace phrases in the code."
msgstr ""

#. Tag: title
#: using-kturtle.docbook:377
#, no-c-format
msgid "The <guimenu>View</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:381
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Ctrl;&Shift;<keycap>F</keycap></keycombo> </shortcut> "
"<guimenu>View</guimenu> <guimenuitem>Full Screen Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:388
#, no-c-format
msgid "With this action you toggle the full screen mode."
msgstr ""

#. Tag: para
#: using-kturtle.docbook:389
#, no-c-format
msgid ""
"Note: When code is executed while in full screen mode everything but the "
"canvas is hidden. This makes it possible to write <quote>full screen</quote> "
"programs in &kturtle;."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:395
#, no-c-format
msgid ""
"<shortcut> <keycombo><keysym>F11</keysym></keycombo> </shortcut> "
"<guimenu>View</guimenu> <guimenuitem>Show Line Numbers</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:402
#, no-c-format
msgid ""
"With this action you can show the line numbers in the code editor. This can "
"be handy for finding errors."
msgstr ""

#. Tag: title
#: using-kturtle.docbook:408
#, no-c-format
msgid "The <guimenu>Tools</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:412
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Alt;<keycap>C</keycap></keycombo> </shortcut> "
"<guimenu>Tools</guimenu> <guimenuitem>Color Picker</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:419
#, no-c-format
msgid ""
"This action opens the color picker. Using the color picker you can easily "
"select a <glossterm linkend=\"rgb\">color code</glossterm> and insert it in "
"<link linkend=\"the-code-editor\">the code editor</link>."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:425
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Ctrl;<keycap>I</keycap></keycombo> </shortcut> "
"<guimenu>Tools</guimenu> <guimenuitem>Indent</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:432
#, no-c-format
msgid ""
"This action <quote>indents</quote> (adds white space at the beginning of) "
"the lines that are selected. When <quote>indentation</quote> is used "
"properly this can make code much easier to read. All examples use "
"indentation, please check them out."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:438
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Ctrl;&Shift;<keycap>I</keycap></keycombo> </shortcut> "
"<guimenu>Tools</guimenu> <guimenuitem>Unindent</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:445
#, no-c-format
msgid ""
"This action <quote>unindents</quote> (removes the white space at the "
"beginning of) the lines that are selected."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:451
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Clean Indentation</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:455
#, no-c-format
msgid ""
"This action cleans <quote>indentation</quote> (removes all the white space "
"at the beginning of) the lines that are selected."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:461
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Ctrl;<keycap>D</keycap></keycombo> </shortcut> "
"<guimenu>Tools</guimenu> <guimenuitem>Comment</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:468
#, no-c-format
msgid ""
"This action add comment characters (#) in from of the lines that are "
"selected. Lines that start with a comment character are ignored when the "
"code is executed. Comments allow the programmer to explain a bit about his "
"code or they can be used to temporarily prevent a certain piece of code from "
"being executed."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:474
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Ctrl;&Shift;<keycap>D</keycap></keycombo> </shortcut> "
"<guimenu>Tools</guimenu> <guimenuitem>Uncomment</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:481
#, no-c-format
msgid "This action removes the comment characters from the selected lines."
msgstr ""

#. Tag: title
#: using-kturtle.docbook:487
#, no-c-format
msgid "The <guimenu>Settings</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:491
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Show/Hide Toolbar</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:495
#, no-c-format
msgid "<action>Toggle</action> the Main Toolbar"
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:501
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Show/Hide Statusbar</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:505
#, no-c-format
msgid "<action>Toggle</action> the Statusbar"
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:511
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guisubmenu>Advanced Settings</guisubmenu>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:515
#, no-c-format
msgid ""
"Here you can change things you normally do not need to change. The "
"<guisubmenu>Advanced Settings</guisubmenu> submenu has three items: "
"<guimenuitem>Configure Editor...</guimenuitem> (the standard &kate; editor "
"settings dialog), <guimenuitem>Configure Shortcuts...</guimenuitem> (the "
"standard &kde; shortcut settings dialog), and <guimenuitem>Configure "
"Toolbars...</guimenuitem> (the standard &kde; toolbars setting dialog)."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:521
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure &kturtle;...</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:525
#, no-c-format
msgid ""
"This is used to configure &kturtle;. Here you can change the language of the "
"&logo; commands or set a new initial canvas size."
msgstr ""

#. Tag: title
#: using-kturtle.docbook:532
#, no-c-format
msgid "The <guimenu>Help</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:536
#, no-c-format
msgid ""
"<shortcut> <keycombo><keysym>F1</keysym></keycombo> </shortcut> "
"<guimenu>Help</guimenu> <guimenuitem>&kturtle; Handbook</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:543
#, no-c-format
msgid "This action shows the handbook that you are currently reading."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:549
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Shift;<keysym>F1</keysym></keycombo> </shortcut> "
"<guimenu>Help</guimenu> <guimenuitem>What's This?</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:556
#, no-c-format
msgid ""
"After activating this action the mouse arrow will be changed into a "
"<quote>question mark arrow</quote>. When this arrow is used to click on "
"parts of &kturtle; main window, a description of the particular part pops-up."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:562
#, no-c-format
msgid ""
"<shortcut> <keycombo><keysym>F2</keysym></keycombo> </shortcut> "
"<guimenu>Help</guimenu> <guimenuitem>Help on: ...</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:569
#, no-c-format
msgid ""
"This is a very useful function: it provides help on the code where the "
"cursor in the code editor is at. So, &eg;, you have used the "
"<userinput>print</userinput> command in your code, and you want to read and "
"to know what the handbook says on this command. You just move your cursor so "
"it is in the <userinput>print</userinput> command and you press <keysym>F2</"
"keysym>. The handbook will then show all info on the <userinput>print</"
"userinput> command."
msgstr ""

#. Tag: para
#: using-kturtle.docbook:570
#, no-c-format
msgid "This function is very important while learning programming."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:576
#, no-c-format
msgid "<guimenu>Help</guimenu> <guimenuitem>Report Bug...</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:580
#, no-c-format
msgid ""
"Use this to report a problem with &kturtle; to the developers. These reports "
"can be used to make future versions of &kturtle; even better."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:586
#, no-c-format
msgid "<guimenu>Help</guimenu> <guimenuitem>About &kturtle;</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:590
#, no-c-format
msgid ""
"Here you find information on &kturtle;, like the authors and the license it "
"comes with."
msgstr ""

#. Tag: menuchoice
#: using-kturtle.docbook:596
#, no-c-format
msgid "<guimenu>Help</guimenu> <guimenuitem>About &kde;</guimenuitem>"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:600
#, no-c-format
msgid ""
"Here you can find information on &kde;. If you do not know yet what &kde; "
"is, this is a place you should not miss."
msgstr ""

#. Tag: title
#: using-kturtle.docbook:608
#, no-c-format
msgid "The Toolbar"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:609
#, no-c-format
msgid ""
"Here you can quickly reach the most used actions. By default, you will find "
"here all main useful commands ending with the <guiicon>Execute Commands</"
"guiicon> and <guiicon>Stop Execution</guiicon> icons."
msgstr ""

#. Tag: para
#: using-kturtle.docbook:610
#, no-c-format
msgid ""
"You can configure the toolbar using <menuchoice><guimenu>Settings</"
"guimenu><guimenuitem>Advanced Settings</guimenuitem><guimenuitem>Configure "
"Toolbars...</guimenuitem></menuchoice>"
msgstr ""

#. Tag: title
#: using-kturtle.docbook:614
#, no-c-format
msgid "The Statusbar"
msgstr ""

#. Tag: para
#: using-kturtle.docbook:615
#, no-c-format
msgid ""
"On the status bar you get feedback of the state of &kturtle;. On the left "
"side it shows the feedback on the last action. On the right side you find "
"the current location of the cursor (line and column numbers). In the middle "
"of the Status bar is indicated the current language used for the commands."
msgstr ""

#~ msgid "Execute"
#~ msgstr "Executar"
