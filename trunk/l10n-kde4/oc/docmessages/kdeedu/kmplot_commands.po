#. Tag: title
#: commands.docbook:2
#, no-c-format
msgid "Command Reference"
msgstr ""

#. Tag: title
#: commands.docbook:5
#, no-c-format
msgid "The <guimenu>File</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: commands.docbook:11
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>New</guimenuitem>"
msgstr ""

#. Tag: action
#: commands.docbook:20
#, no-c-format
msgid ""
"Starts a new Plot by clearing the coordinate system and resetting the "
"function parser."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:27
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>O</keycap></keycombo></"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Open...</guimenuitem>"
msgstr ""

#. Tag: action
#: commands.docbook:31
#, no-c-format
msgid "Opens an existing document."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:36
#, no-c-format
msgid "<guimenu>File</guimenu> <guisubmenu>Open Recent</guisubmenu>"
msgstr ""

#. Tag: para
#: commands.docbook:40
#, no-c-format
msgid ""
"<action>Displays a list of recently opened files.</action> Selecting one "
"from this list plots the functions in the file."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:46
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo></"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Save</guimenuitem>"
msgstr ""

#. Tag: action
#: commands.docbook:51
#, no-c-format
msgid "Saves the document."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:56
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Save As...</guimenuitem>"
msgstr ""

#. Tag: action
#: commands.docbook:59
#, no-c-format
msgid "Saves the document under another name."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:65
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Print...</guimenuitem>"
msgstr ""

#. Tag: action
#: commands.docbook:74
#, no-c-format
msgid "Sends the plot to a printer or file."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:80
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Export...</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:83
#, no-c-format
msgid "<action>Exports</action> the plotted graphs to an image file."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:88
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"> &Ctrl;<keycap>Q</keycap> </keycombo></"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:94
#, no-c-format
msgid "<action>Exits</action> &kmplot;."
msgstr ""

#. Tag: title
#: commands.docbook:100
#, no-c-format
msgid "The <guimenu>Edit</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: commands.docbook:104
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu><guimenuitem>Undo</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:110
#, no-c-format
msgid "Undo the last command."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:114
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>Z</keycap></"
"keycombo> </shortcut> <guimenu>Edit</guimenu><guimenuitem>Redo</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:120
#, no-c-format
msgid "Redo the last command that was undone."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:125
#, no-c-format
msgid "<guimenu>Edit</guimenu><guimenuitem>Constants...</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:127
#, no-c-format
msgid ""
"Displays the <guilabel>Constants</guilabel> dialog box. See <xref linkend="
"\"constants-config\"/>."
msgstr ""

#. Tag: title
#: commands.docbook:135
#, no-c-format
msgid "The <guimenu>View</guimenu> Menu"
msgstr ""

#. Tag: para
#: commands.docbook:136
#, no-c-format
msgid "The first three items in the menu are related to zooming."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:141
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>1</keycap></keycombo> </"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Zoom In</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:150
#, no-c-format
msgid ""
"This tool can be operator in two different manners. To zoom in on a point on "
"the graph, click on it. To zoom in on a specific section of the graph, hold "
"and drag the mouse to form a rectangle, which will be the new axes ranges "
"when the mouse button is released."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:156
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>2</keycap></keycombo> </"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Zoom Out</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:165
#, no-c-format
msgid ""
"The tool can also be used in two different manners. To zoom out and center "
"on a point, click on that point. To fit the existing view into a rectangle, "
"hold and drag the mouse to form that rectangle."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:170
#, no-c-format
msgid ""
"<guimenu>View</guimenu> <guimenuitem>Fit Widget to Trigonometric Functions</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:175
#, no-c-format
msgid ""
"The scale will be adapted to trigonometric functions. This works both for "
"radians and degrees."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:179
#, no-c-format
msgid "<guimenu>View</guimenu><guimenuitem>Reset View</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:181
#, no-c-format
msgid "Resets the view."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:187
#, no-c-format
msgid "<guimenu>View</guimenu><guimenuitem>Coordinate System...</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:189
#, no-c-format
msgid ""
"Displays the <guilabel>Coordinate System</guilabel> dialog box. See <xref "
"linkend=\"coords-config\"/>."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:195
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Show Sliders</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:199
#, no-c-format
msgid "<action>Toggles</action> the visibility of the slider dialog."
msgstr ""

#. Tag: title
#: commands.docbook:207
#, no-c-format
msgid "The <guimenu>Tools</guimenu> Menu"
msgstr ""

#. Tag: para
#: commands.docbook:209
#, no-c-format
msgid "This menu contains some tools for the functions that can be useful:"
msgstr ""

#. Tag: menuchoice
#: commands.docbook:214
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Calculator</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:218
#, no-c-format
msgid "Opens the <guilabel>Calculator</guilabel> dialog."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:223
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Plot Area...</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:227
#, no-c-format
msgid ""
"Select a graph and the x-values in the new dialog that appears. Calulates "
"the integral and draws the area between the graph and the x-axis in the "
"range of the selected x-values in the color of the graph."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:234
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Find Minimum...</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:238
#, no-c-format
msgid "Find the minimum value of the graph in a specified range."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:243
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Find Maximum...</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:247
#, no-c-format
msgid "Find the maximum value of the graph in a specified range."
msgstr ""

#. Tag: title
#: commands.docbook:255
#, no-c-format
msgid "The <guimenu>Settings</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: commands.docbook:259
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Toolbar</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:263
#, no-c-format
msgid ""
"<action>Toggle on and off the display of the toolbar.</action> The default "
"is on."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:269
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Statusbar</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:273
#, no-c-format
msgid ""
"<action>Toggle on and off the display of the status bar at the bottom of the "
"&kmplot; main window.</action> The default is on."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:284
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Ctrl;&Shift;<keycap>F</keycap></keycombo> </shortcut> "
"<guimenu>Settings</guimenu> <guimenuitem>Full Screen Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:291
#, no-c-format
msgid "With this action you toggle the full screen mode."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:296
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:300
#, no-c-format
msgid "<action>Personalize the keybindings</action> for &kmplot;."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:305
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Toolbars...</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:309
#, no-c-format
msgid "<action>Personalize the toolbars</action> for &kmplot;."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:314
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure &kmplot;...</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:318
#, no-c-format
msgid ""
"<action>Customize</action> &kmplot;. The options available to you are "
"described in <xref linkend=\"configuration\"/>."
msgstr ""

#. Tag: title
#: commands.docbook:328
#, no-c-format
msgid "The <guimenu>Help</guimenu> Menu"
msgstr ""

#. Tag: para
#: commands.docbook:330
#, no-c-format
msgid ""
"&kmplot; has a standard &kde; <guimenu>Help</guimenu> as described below, "
"with one addition:"
msgstr ""

#. Tag: menuchoice
#: commands.docbook:335
#, no-c-format
msgid ""
"<guimenu>Help</guimenu> <guimenuitem>Predefined Math Functions...</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:339
#, no-c-format
msgid ""
"Opens this handbook with a list of the predefined function names and "
"constants that &kmplot; knows."
msgstr ""

