msgstr ""

#. Tag: para
#: index.docbook:438
#, no-c-format
msgid "<action>Toggle</action> full screen mode of &i18n-ktouch; on and off"
msgstr ""

#. Tag: guimenuitem
#: index.docbook:443
#, no-c-format
