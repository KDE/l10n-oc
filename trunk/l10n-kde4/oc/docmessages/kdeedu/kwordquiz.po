#. Tag: title
#: index.docbook:1406
#, no-c-format
msgid "<title>Rows/Columns</title>"
msgstr ""

#. Tag: screeninfo
#: index.docbook:1408
#, no-c-format
msgid "<screeninfo>Rows/Columns</screeninfo>"
msgstr ""

#. Tag: phrase
#: index.docbook:1414
#, no-c-format
msgid "<phrase>Rows/Columns</phrase>"
msgstr ""

#. Tag: para
#: index.docbook:1418
#, no-c-format
msgid ""
"Use this dialog to specify the number of rows you want in the vocabulary. "
"You can also adjust the width (in pixels) of the selected columns and the "
"height (in pixels) of the selected rows. Select <guibutton>OK</guibutton> to "
"make your changes or <guibutton>Cancel</guibutton> to discard any changes."
msgstr ""

#. Tag: para
#: index.docbook:1422
#, no-c-format
msgid ""
"Specifying a number of rows lower than what currently is in the vocabulary "
"may lead to loss of data."
msgstr ""

