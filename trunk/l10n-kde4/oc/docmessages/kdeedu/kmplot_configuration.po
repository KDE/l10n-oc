#. Tag: guilabel
#: configuration.docbook:177
#, no-c-format
msgid "Axis font"
msgstr ""

#. Tag: para
#: configuration.docbook:179
#, no-c-format
msgid "The font used for drawing the axis numbers and x/y labels."
msgstr ""

#. Tag: guilabel
#: configuration.docbook:184
#, no-c-format
msgid "Label font"
msgstr ""

#. Tag: para
#: configuration.docbook:186
#, no-c-format
msgid ""
"The font used for drawing diagram labels (&eg;, those showing the plot name "
"or extreme points."
msgstr ""

