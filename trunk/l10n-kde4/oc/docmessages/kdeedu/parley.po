msgstr ""

#. Tag: guilabel
#: index.docbook:1287
#, no-c-format
msgid "Save"
msgstr "Enregistrar"

#. Tag: para
#: index.docbook:1288
#, no-c-format
msgid "Saves the current query settings under the current name."
msgstr ""

#. Tag: guilabel
#: index.docbook:1294
#, no-c-format
msgid "Load"
msgstr "Carga"

#. Tag: para
#: index.docbook:1295
#, no-c-format
msgid "Load the settings from the profile in the listbox."
