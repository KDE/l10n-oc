msgstr ""

#. Tag: guilabel
#: index.docbook:1556
#, no-c-format
msgid "False friend"
msgstr ""

#. Tag: para
#: index.docbook:1557
#, no-c-format
msgid ""
"Sometimes there is a word in a foreign language that looks like a word in "
"your native language so you think it must have the same meaning. But in "
"fact, it is not."
msgstr ""

#. Tag: para
#: index.docbook:1560
#, no-c-format
msgid "Enter such words in this field."
msgstr ""

#. Tag: guilabel
#: index.docbook:1564
#, no-c-format
msgid "Last Query Date"
msgstr ""

#. Tag: para
#: index.docbook:1565
#, no-c-format
msgid ""
"This is the date when this entry was last queried. If it was never queried "
"yet you only see <computeroutput>&#150;&#150;</computeroutput>."
msgstr ""

#. Tag: para
