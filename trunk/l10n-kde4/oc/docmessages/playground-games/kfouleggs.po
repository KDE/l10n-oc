#. Tag: guilabel
#: index.docbook:326
#, no-c-format
msgid "Key:"
msgstr "Clau :"

#. Tag: para
#: index.docbook:327
#, no-c-format
msgid ""
"This key was generated when you registered on kfouleggs.sf.net by selecting "
"<guilabel>World-wide highscores enabled</guilabel> the first time. The "
"registration key is used in conjunction with the nickname to identify "
"uniquely users, but users cannot have the same nickname. Click on the "
"<guibutton>Remove</guibutton> button to delete you from the world highscores "
"list."
