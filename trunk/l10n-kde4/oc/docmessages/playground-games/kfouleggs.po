#, no-c-format
msgid "World-wide highscores enabled"
msgstr ""

#. Tag: para
#: index.docbook:304
#, no-c-format
msgid ""
"If checked and if you are connected to the Internet, &kfouleggs; will send "
"your score automatically at the end of the game to the highscore web server "
"(kfouleggs.sf.net)."
msgstr ""

#. Tag: title
#: index.docbook:313
#, no-c-format
msgid "The <guilabel>Advanced</guilabel> Tab"
msgstr ""

