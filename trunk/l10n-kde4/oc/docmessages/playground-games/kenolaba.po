#. Tag: title
#: index.docbook:790
#, no-c-format
msgid "Command line options"
msgstr ""

#. Tag: cmdsynopsis
#: index.docbook:792
#, no-c-format
msgid ""
"<command>kenolaba</command> <group> <option>-p</option> "
"<replaceable>MyPortNumber</replaceable> </group> <group> <option>-h</option> "
"<replaceable>host:port</replaceable> </group>"
msgstr ""

#. Tag: para
#: index.docbook:804
#, no-c-format
msgid ""
"With <option>-p</option> you specify the port number of the listening TCP "
"socket when in Network Mode."
msgstr ""

#. Tag: para
#: index.docbook:807
#, no-c-format
msgid ""
"With <option>-h</option> you specify a remote &kenolaba; process (with "
"optional port number, when not using the default port on the remote machine) "
"to communicate with when in Network mode. You can specify multiple remote "
"processes."
msgstr ""

