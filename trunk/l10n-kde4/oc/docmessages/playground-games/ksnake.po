#. Tag: title
#: index.docbook:47
#, no-c-format
msgid "Introduction"
msgstr "Introduccion"

#. Tag: para
#: index.docbook:49
#, no-c-format
msgid ""
"&ksnake; is a game of speed and agility. You are a hungry snake and are "
"trying to eat all the apples in the room before getting out!"
msgstr ""

#. Tag: title
#: index.docbook:57
#, no-c-format
msgid "Rules of the Game"
msgstr ""

#. Tag: title
#: index.docbook:60
#, no-c-format
msgid "To Win"
msgstr ""

#. Tag: para
#: index.docbook:62
#, no-c-format
msgid ""
"To win &ksnake; you must eat all the apples in the room and leave through "
"the exit that opens at the top."
msgstr ""

#. Tag: para
#: index.docbook:69
#, no-c-format
msgid "Each apple you eat makes you grow longer."
msgstr ""

#. Tag: para
#: index.docbook:74
#, no-c-format
msgid "If you hit a wall, you die."
msgstr ""

#. Tag: para
#: index.docbook:79
#, no-c-format
msgid "If you hit yourself, you die."
msgstr ""

#. Tag: para
#: index.docbook:84
#, no-c-format
msgid "If you are hit in the head by a bouncing ball, you die."
msgstr ""

#. Tag: para
#: index.docbook:89
#, no-c-format
msgid "If you take too long to eat the apples, more of them appear."
msgstr ""

#. Tag: title
#: index.docbook:98
#, no-c-format
msgid "Scoring"
msgstr ""

#. Tag: title
#: index.docbook:101
#, no-c-format
msgid "Before the timer has run out"
msgstr ""

#. Tag: para
#: index.docbook:104
#, no-c-format
msgid "Before the timer has run out, you score:"
msgstr ""

#. Tag: para
#: index.docbook:110
#, no-c-format
msgid "1 point for a red apple + a bonus depending on your skill level."
msgstr ""

#. Tag: para
#: index.docbook:115
#, no-c-format
msgid ""
"5 points for a gold apple + a bonus for your skill level + 2 points for each "
"computer snake + 2 points for each bouncing ball."
msgstr ""

#. Tag: para
#: index.docbook:121
#, no-c-format
msgid ""
"Twice your level number when you exit the room + a bonus depending on your "
"skill level."
msgstr ""

#. Tag: title
#: index.docbook:131
#, no-c-format
msgid "After the timer has run out"
msgstr ""

#. Tag: para
#: index.docbook:133
#, no-c-format
msgid "After the timer has run out, you score:"
msgstr ""

#. Tag: para
#: index.docbook:139
#, no-c-format
msgid "1 point for a red apple."
msgstr ""

#. Tag: para
#: index.docbook:144
#, no-c-format
msgid "2 points for a gold apple."
msgstr ""

#. Tag: para
#: index.docbook:149
#, no-c-format
msgid ""
"Points equal to your level number when you exit the room + a bonus depending "
"on your skill level."
msgstr ""

#. Tag: title
#: index.docbook:159
#, no-c-format
msgid "When the computer snake eats an object"
msgstr ""

#. Tag: para
#: index.docbook:161
#, no-c-format
msgid "When the computer snake eats an object you lose:"
msgstr ""

#. Tag: para
#: index.docbook:167
#, no-c-format
msgid "2 points for a red apple."
msgstr ""

#. Tag: para
#: index.docbook:172
#, no-c-format
msgid "5 points for a gold apple."
msgstr ""

#. Tag: title
#: index.docbook:181
#, no-c-format
msgid "Other points"
msgstr ""

#. Tag: para
#: index.docbook:183
#, no-c-format
msgid "You score 20 points for killing a computer snake."
msgstr ""

#. Tag: title
#: index.docbook:193
#, no-c-format
msgid "Customization"
msgstr "Personalisacion"

#. Tag: title
#: index.docbook:196
#, no-c-format
msgid "Create Your Own Levels"
msgstr ""

#. Tag: para
#: index.docbook:198
#, no-c-format
msgid ""
"To create your own level, copy one of the levels from <filename class="
"\"directory\">$<envar>KDEDIR</envar>/share/apps/ksnake/levels</filename> to "
"<filename class=\"directory\">$<envar>HOME</envar>/.kde/share/apps/ksnake</"
"filename> and edit it with a bitmap editor. You can then select it in "
"<menuchoice><guimenu>Settings</guimenu> <guimenuitem>Configure &ksnake;...</"
"guimenuitem> </menuchoice> in the <guilabel>First Level</guilabel> tab."
msgstr ""

