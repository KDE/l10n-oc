msgid "The <guimenu>Game</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: index.docbook:220
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo> </"
"shortcut> <guimenu>Game</guimenu> <guimenuitem>New</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:228
#, no-c-format
msgid "Start a new game"
msgstr "Començar una partida nova"

#. Tag: menuchoice
#: index.docbook:233
#, no-c-format
msgid ""
"<shortcut> <keycap>P</keycap> </shortcut> <guimenu>Game</guimenu> "
"<guimenuitem>Pause</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:241
#, no-c-format
msgid "Pause the game."
msgstr ""

#. Tag: menuchoice
#: index.docbook:246
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>H</keycap></keycombo> </"
"shortcut> <guimenu>Game</guimenu> <guimenuitem>Show Highscores...</"
"guimenuitem>"
msgstr ""

