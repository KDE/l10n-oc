#: index.docbook:291
#, no-c-format
msgid ""
"Select this to open a dialog which lets you define shortcuts for all menu "
"items in &ksnake;."
msgstr ""

#. Tag: menuchoice
#: index.docbook:296
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu><guimenuitem>Configure &ksnake;...</guimenuitem>"
