#: index.docbook:283
#, no-c-format
msgid "Shows or hides the &ksnake; status bar at the bottom of the screen."
msgstr ""

#. Tag: menuchoice
#: index.docbook:288
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""

