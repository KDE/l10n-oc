#. Tag: title
#: index.docbook:410
#, no-c-format
msgid "Frequently asked questions"
msgstr ""

#. Tag: para
#: index.docbook:415
#, no-c-format
msgid "Who made this game?"
msgstr ""

#. Tag: para
#: index.docbook:416
#, no-c-format
msgid "The kdegames team. You can find their website here."
msgstr ""

#. Tag: para
#: index.docbook:419
#, no-c-format
msgid "Where can I get cheatcodes?"
msgstr ""

#. Tag: para
#: index.docbook:420
#, no-c-format
msgid "You can't get cheatcodes for KDE games."
msgstr ""

#. Tag: para
#: index.docbook:423
#, no-c-format
msgid "How do I start a new game?"
msgstr ""

#. Tag: para
#: index.docbook:424
#, no-c-format
msgid ""
"&kapp-name; will load a default layout automaticly one once you start the "
"application and you can start playing right away."
msgstr ""

#. Tag: para
#: index.docbook:427
#, no-c-format
msgid "Can I start a totaly new game?"
msgstr ""

#. Tag: para
#: index.docbook:428
#, no-c-format
msgid ""
"Yes. To start a new game you can either use a <link linkend=\"game-menu-new"
"\">shortcut key</link>, or a <link linkend=\"game-menu-new\">menubar</link> "
"option."
msgstr ""

#. Tag: para
#: index.docbook:431
#, no-c-format
msgid "I did something very wrong! Can I restart the game?"
msgstr ""

#. Tag: para
#: index.docbook:432
#, no-c-format
msgid ""
"Yes. To restart the current game you can either use a <link linkend=\"game-"
"menu-restart\">shortcut key</link>, or a <link linkend=\"game-menu-restart"
"\">menubar</link> option."
msgstr ""

#. Tag: para
#: index.docbook:435
#, no-c-format
msgid "How do I pause the game?"
msgstr ""

#. Tag: para
#: index.docbook:436
#, no-c-format
msgid ""
"To pause the current game you may either use the <link linkend=\"game-menu-"
"pause\">toolbar</link>, a <link linkend=\"game-menu-pause\">shortcut key</"
"link>, or a <link linkend=\"game-menu-pause\">menubar</link> option."
msgstr ""

#. Tag: para
#: index.docbook:439
#, no-c-format
msgid "I want to change the way this game looks. Can I?"
msgstr ""

#. Tag: para
#: index.docbook:440
#, no-c-format
msgid ""
"Yes. To change the way &kapp-name; looks use the <link linkend=\"settings-"
"menu-settings\">menubar</link> to open the <link linkend=\"configuration"
"\">configuration utility</link>."
msgstr ""

#. Tag: para
#: index.docbook:443
#, no-c-format
msgid "I have made a mistake. Can I undo?"
msgstr ""

#. Tag: para
#: index.docbook:444
#, no-c-format
msgid ""
"Yes. To undo your move you can either use a <link linkend=\"move-menu-undo"
"\">shortcut key</link>, or a <link linkend=\"move-menu-undo\">menubar</link> "
"option."
msgstr ""

#. Tag: para
#: index.docbook:447
#, no-c-format
msgid "I have mistakenly undone a good move, can I redo it?"
msgstr ""

#. Tag: para
#: index.docbook:448
#, no-c-format
msgid ""
"Yes. To Redo your move you can either use a <link linkend=\"move-menu-redo"
"\">shortcut key</link>, or a <link linkend=\"move-menu-redo\">menubar</link> "
"option."
msgstr ""

#. Tag: para
#: index.docbook:451
#, no-c-format
msgid "Can I use keyboard?"
msgstr ""

#. Tag: para
#: index.docbook:452
#, no-c-format
msgid "No. This game does not feature a keyboard play mode."
msgstr ""

#. Tag: para
#: index.docbook:455
#, no-c-format
msgid "I can't figure out what to do here! Are there hints?"
msgstr ""

#. Tag: para
#: index.docbook:456
#, no-c-format
msgid ""
"Yes. To use &kapp-name; hint feature can either use a <link linkend=\"move-"
"menu-hint\">shortcut key</link>, or a <link linkend=\"move-menu-hint"
"\">menubar</link> option."
msgstr ""

#. Tag: para
#: index.docbook:459
#, no-c-format
msgid ""
"I have to quit the game now, but I'm not finished yet. Can I save my "
"progress?"
msgstr ""

#. Tag: para
#: index.docbook:460
#, no-c-format
msgid ""
"Yes. To save your game progress either use a <link linkend=\"game-menu-save"
"\">shortcut key</link>, or a <link linkend=\"game-menu-save\">menubar</link> "
"option."
msgstr ""

#. Tag: para
#: index.docbook:463
#, no-c-format
msgid "Where are the highscores?"
msgstr ""

#. Tag: para
#: index.docbook:464
#, no-c-format
msgid ""
"To open the highscores dialog you can either use a <link linkend=\"game-menu-"
"highscores\">shortcut key</link>, or a <link linkend=\"game-menu-highscores"
"\">menubar</link> option."
msgstr ""

#. Tag: para
#: index.docbook:467
#, no-c-format
msgid "I want to change the game configuration. Where do I go?"
msgstr ""

#. Tag: para
#: index.docbook:468
#, no-c-format
msgid ""
"To open the <link linkend=\"configuration\">configuration utility</link> use "
"the <link linkend=\"settings-menu-settings\">menubar->Settings</link> menu."
msgstr ""

#. Tag: para
#: index.docbook:471
#, no-c-format
msgid "I want to change the toolbar layout. What do I do?"
msgstr ""

#. Tag: para
#: index.docbook:472
#, no-c-format
msgid ""
"To change the default toolbat layout use the <link linkend=\"settings-menu-"
"toolbar\">menubar->Settings->Configure Toolbars...</link> menu."
msgstr ""

