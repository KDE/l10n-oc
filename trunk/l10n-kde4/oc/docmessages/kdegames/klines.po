msgstr ""

#. Tag: title
#: index.docbook:148
#, no-c-format
msgid "The <guimenu>Move</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: index.docbook:152
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo> </"
"shortcut> <guimenu>Move</guimenu> <guimenuitem>Undo</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:159
#, no-c-format
msgid "This will undo the last move."
msgstr ""

#. Tag: menuchoice
#: index.docbook:163
#, no-c-format
msgid "<guimenu>Move</guimenu><guimenuitem>End Turn</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:167
#, no-c-format
msgid ""
"Skip your move, immediately play the next marbles without you moving any."
msgstr ""

#. Tag: title
#: index.docbook:175
#, no-c-format
msgid "The <guimenu>Settings</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: index.docbook:179
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Statusbar</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:183
#, no-c-format
msgid "Toggles the display of the statusbar."
msgstr ""

#. Tag: menuchoice
#: index.docbook:186
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo> </"
"shortcut> <guimenu>Settings</guimenu> <guimenuitem>Show Next</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:193
#, no-c-format
msgid "Toggles the information on next marbles."
msgstr ""

#. Tag: menuchoice
#: index.docbook:197
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu><guimenuitem>Use Numbered Balls</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:201
#, no-c-format
msgid ""
"Number the balls according to color. This may be of assistance to players "
"who are color blind, have other vision impairments that make the colors hard "
"to distinguish, or those of you who simply like the look."
msgstr ""

#. Tag: menuchoice
#: index.docbook:207
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu><guimenuitem>Configure Shortcuts</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:210
#, no-c-format
msgid ""
"Displays a standard &kde; shortcut configuration dialog, allowing you to "
"customize the keys used in the game."
msgstr ""

