#, no-c-format
msgid "The Main &ksame; Window"
msgstr ""

#. Tag: para
#: index.docbook:103
#, no-c-format
msgid ""
"There is a large area with lots of marbles. Underneath is the status bar. "
"Above is the menu bar."
msgstr ""

#. Tag: title
#: index.docbook:107
#, no-c-format
msgid "The <guimenu>Game</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: index.docbook:111
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo> </"
"shortcut> <guimenu>Game</guimenu> <guimenuitem>New</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:118
#, no-c-format
msgid ""
"Starts a new game. If <menuchoice><guimenu>Settings</guimenu> "
"<guimenuitem>Random Board</guimenuitem></menuchoice> is enabled, a random "
"game is started. Otherwise you are presented a dialog in which you can "
"choose a specific board."
msgstr ""

#. Tag: menuchoice
#: index.docbook:125
#, no-c-format
msgid ""
"<shortcut> <keycap>F5</keycap> </shortcut> <guimenu>Game</guimenu> "
"<guimenuitem>Restart Game</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:132
#, no-c-format
msgid "Restarts the current board."
msgstr ""

#. Tag: menuchoice
#: index.docbook:136
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>H</keycap></keycombo> </"
"shortcut> <guimenu>Game</guimenu> <guimenuitem>Show High Scores...</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:143
#, no-c-format
msgid "Displays the high score table."
msgstr ""

#. Tag: menuchoice
#: index.docbook:147
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> </"
"shortcut> <guimenu>Game</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:154
#, no-c-format
msgid "Quits &ksame;."
msgstr ""

#. Tag: title
#: index.docbook:161
#, no-c-format
msgid "The <guimenu>Move</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: index.docbook:165
#, no-c-format
