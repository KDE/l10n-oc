#. Tag: para
#: index.docbook:70
#, no-c-format
msgid "Board"
msgstr ""

#. Tag: title
#: index.docbook:71
#, no-c-format
msgid "Number of possible players:"
msgstr ""

#. Tag: para
#: index.docbook:71
#, no-c-format
msgid "Four"
