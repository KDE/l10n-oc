#: index.docbook:477
#, no-c-format
msgid "Starts a new game of &kspaceduel;."
msgstr ""

#. Tag: menuchoice
#: index.docbook:481
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"> &Ctrl;<keycap>N</keycap></keycombo></"
"shortcut> <guimenu>Game</guimenu><guimenuitem>New Round</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:485
#, no-c-format
msgid "Starts a new round, at the current level."
msgstr ""

