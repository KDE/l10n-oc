#: index.docbook:176
#, no-c-format
msgid "Interface Overview"
msgstr ""

#. Tag: title
#: index.docbook:180
#, no-c-format
msgid "The <guimenu>Game</guimenu> Menu"
msgstr ""

#. Tag: para
#: index.docbook:182
#, no-c-format
msgid "The <guimenu>Game</guimenu> menu is used to start and pause the game."
msgstr ""

#. Tag: menuchoice
#: index.docbook:186
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"> &Ctrl;<keycap>N</keycap></keycombo></"
"shortcut> <guimenu>Game</guimenu><guimenuitem>New</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:190
#, no-c-format
msgid "Starts a new game of &kappname;."
msgstr ""

#. Tag: menuchoice
#: index.docbook:194
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"> &Ctrl;<keycap>R</keycap></keycombo></"
"shortcut> <guimenu>Game</guimenu><guimenuitem>New Round</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:198
#, no-c-format
msgid "Starts a new round, at the current level."
msgstr ""

#. Tag: menuchoice
#: index.docbook:202
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>P</keycap></keycombo></"
"shortcut> <guimenu>Game</guimenu><guimenuitem>Pause</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:205
#, no-c-format
msgid "Pauses and unpauses the game."
msgstr ""

#. Tag: menuchoice
#: index.docbook:208
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl; <keycap>Q</keycap></keycombo></"
