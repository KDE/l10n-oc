#, no-c-format
msgid "Show Highlights"
msgstr ""

#. Tag: para
#: index.docbook:355
#, no-c-format
msgid "Toggle the &kappname; highlight option."
msgstr ""

#. Tag: para
#: index.docbook:356
#, no-c-format
msgid ""
"Having this option enabled is recommended even for the most experienced "
"players, as it helps to see the actual game board constraints."
msgstr ""

