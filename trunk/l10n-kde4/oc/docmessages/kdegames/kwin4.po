msgid ""
"Choose a graphical theme for the game. Which themes are available depends on "
"the current installation."
msgstr ""

#. Tag: menuchoice
#: index.docbook:375
#, no-c-format
msgid "<guimenu>Game</guimenu> <guimenuitem>Network Configuration...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:379
#, no-c-format
msgid ""
"Pops up a dialog for the network configuration. You can choose to be server or "
"client. If you are server you can also choose what color the remote player "
"should take over. If a network game is running you can also disconnect it in "
"this menu."
msgstr ""

#. Tag: menuchoice
#: index.docbook:389
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:394
#, no-c-format
msgid "Open a dialog which lets you redefine all the keyboard shortcuts."
msgstr ""

#. Tag: menuchoice
#: index.docbook:399
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Configure Toolbars...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:403
#, no-c-format
msgid "Displays a &kde; standard dialog where you can configure the toolbar icons."
msgstr ""

#. Tag: menuchoice
#: index.docbook:407
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Configure &k4wins;...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:411
#, no-c-format
msgid "<action>Displays</action> the &k4wins; configuration dialog with these options:"
msgstr ""

#. Tag: para
#: index.docbook:413
#, no-c-format
msgid ""
"<guilabel>Starting Player Color</guilabel>: Determine which player color has "
"the first move in the next game."
msgstr ""

#. Tag: para
#: index.docbook:414
#, no-c-format
msgid "<guilabel>Player Names</guilabel>: Change the names of the players."
msgstr ""

#. Tag: para
#: index.docbook:415
#, no-c-format
msgid ""
"<guilabel>Black Plays With</guilabel>: Choose who should play for player 1 "
"(black, yellowm white, ...). It can be either <guilabel>Mouse</guilabel> "
"or <guilabel>Keyboard</guilabel>, &ie; a local player using the mouse or "
"keyboard as input device or <guilabel>Computer</guilabel>"
", &ie; the computer plays for this player."
msgstr ""

#. Tag: para
#: index.docbook:421
#, no-c-format
msgid ""
"<guilabel>Red Plays With</guilabel>: Same as <guilabel>"
"Yellow Playes With</guilabel> but for player 2 (red)."
msgstr ""

#. Tag: para
#: index.docbook:423
#, no-c-format
msgid ""
"<guilabel>Computer Difficulty</guilabel>: Select the level of the computer "
"player."
msgstr ""

#. Tag: para
#: index.docbook:424
#, no-c-format
msgid ""
"<guilabel>Use AI learning</guilabel>: The computer AI can learn from mistakes "
"made in one game."
msgstr ""

