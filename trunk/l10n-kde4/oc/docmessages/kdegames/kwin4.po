#. Tag: para
#: index.docbook:579
#, no-c-format
msgid ""
"<guilabel>Starting Player Color</guilabel>: Determine which player color has "
"the first move in the next game."
msgstr ""

#. Tag: para
#: index.docbook:580
#, no-c-format
msgid "<guilabel>Player Names</guilabel>: Change the names of the players."
msgstr ""

#. Tag: para
#: index.docbook:581
#, no-c-format
msgid ""
"<guilabel>Black Plays With</guilabel>: Choose who should play for player 1 "
"(black, yellowm white, ...). It can be either <guilabel>Mouse</guilabel> or "
"<guilabel>Keyboard</guilabel>, &ie; a local player using the mouse or "
"keyboard as input device or <guilabel>Computer</guilabel>, &ie; the computer "
"plays for this player."
msgstr ""

#. Tag: para
#: index.docbook:587
#, no-c-format
msgid ""
"<guilabel>Red Plays With</guilabel>: Same as <guilabel>Yellow Playes With</"
"guilabel> but for player 2 (red)."
msgstr ""

#. Tag: para
#: index.docbook:589
#, no-c-format
msgid ""
"<guilabel>Computer Difficulty</guilabel>: Select the level of the computer "
"player."
msgstr ""

#. Tag: para
#: index.docbook:590
#, no-c-format
msgid ""
"<guilabel>Use AI learning</guilabel>: The computer AI can learn from "
"mistakes made in one game."
msgstr ""

