#. Tag: para
#: index.docbook:525
#, no-c-format
msgid ""
"Pops up a dialog for the network configuration. You can choose to be server "
"or client. If you are server you can also choose what color the remote "
"player should take over. If a network game is running you can also "
"disconnect it in this menu."
msgstr ""

#. Tag: menuchoice
#: index.docbook:535
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:540
#, no-c-format
msgid "Open a dialog which lets you redefine all the keyboard shortcuts."
msgstr ""

#. Tag: menuchoice
#: index.docbook:545
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Toolbars...</guimenuitem>"
