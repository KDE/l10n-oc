#, no-c-format
msgid "<guimenu>Game</guimenu><guimenuitem>About Course</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:331
#, no-c-format
msgid "Show name, author, and par of course."
msgstr ""

#. Tag: menuchoice
#: index.docbook:336
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> </"
"shortcut> <guimenu>Game</guimenu><guimenuitem>Quit</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:341
#, no-c-format
msgid "<action>Quit</action> &kappname;"
msgstr ""

#. Tag: title
#: index.docbook:348
#, no-c-format
msgid "The <guimenu>Hole</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: index.docbook:352
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>E</keycap> </keycombo></"
"shortcut> <guimenu>Hole</guimenu> <guimenuitem>Edit</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:359
#, no-c-format
msgid "<action>Switch to editing mode</action> to edit the current hole."
msgstr ""

#. Tag: menuchoice
#: index.docbook:364
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>N</keycap></"
"keycombo> </shortcut> <guimenu>Hole</guimenu> <guimenuitem>New</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:371
#, no-c-format
msgid "<action>Create a new hole.</action> (Only while editing.)"
msgstr ""

#. Tag: menuchoice
#: index.docbook:376
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Del</keycap> </"
"keycombo></shortcut> <guimenu>Hole</guimenu> <guimenuitem>Clear</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:383
#, no-c-format
msgid ""
"<action>Remove all objects from the current hole.</action> (Only while "
"editing.)"
msgstr ""

#. Tag: menuchoice
#: index.docbook:389
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>R</keycap></keycombo></"
"shortcut> <guimenu>Hole</guimenu> <guimenuitem>Reset</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:396
#, no-c-format
msgid ""
"<action>Reset the current hole to its starting position</action>, so that "
"you can start over."
msgstr ""

#. Tag: menuchoice
#: index.docbook:402
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>I</keycap></keycombo> </"
"shortcut> <guimenu>Hole</guimenu> <guimenuitem>Show Info</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:409
#, no-c-format
msgid "Show information about objects on the current hole."
msgstr ""

#. Tag: menuchoice
#: index.docbook:414
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo> </"
"shortcut> <guimenu>Hole</guimenu> <guimenuitem>Undo Shot</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:421
#, no-c-format
msgid "Undo the last shot you made."
msgstr ""

#. Tag: title
#: index.docbook:429
#, no-c-format
msgid "The <guimenu>Go</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: index.docbook:433
#, no-c-format
msgid "<guimenu>Go</guimenu> <guisubmenu>Switch to Hole</guisubmenu>"
msgstr ""

#. Tag: para
#: index.docbook:438
#, no-c-format
msgid ""
"<action>Go directly to another hole within the course.</action> A list of "
"the hole numbers allows you to choose which hole you wish to go to."
msgstr ""

#. Tag: menuchoice
#: index.docbook:445
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"> &Alt;<keycap>Right Arrow</keycap></"
"keycombo></shortcut> <guimenu>Go</guimenu> <guimenuitem>Next Hole</"
"guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:451
#, no-c-format
msgid "Go the the next hole."
msgstr ""

#. Tag: menuchoice
#: index.docbook:456
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"> &Alt;<keycap>Left Arrow</keycap></"
"keycombo></shortcut> <guimenu>Go</guimenu> <guimenuitem>Previous Hole</"
"guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:462
#, no-c-format
msgid "Go to the previous hole."
msgstr ""

#. Tag: menuchoice
#: index.docbook:467
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"> &Ctrl;<keycap>Home</keycap></"
"keycombo></shortcut> <guimenu>Go</guimenu> <guimenuitem>First Hole</"
"guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:473
#, no-c-format
msgid "Go to the first hole in the course."
msgstr ""

#. Tag: menuchoice
#: index.docbook:478
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>End</keycap> </"
"keycombo> </shortcut> <guimenu>Go</guimenu> <guimenuitem>Last Hole</"
"guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:488
#, no-c-format
msgid "Go to the last hole in the course."
msgstr ""

#. Tag: menuchoice
#: index.docbook:493
#, no-c-format
msgid "<guimenu>Go</guimenu> <guimenuitem>Random Hole</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:498
#, no-c-format
msgid "Go to a random hole from the current course."
msgstr ""

#. Tag: title
#: index.docbook:505
#, no-c-format
msgid "The <guimenu>Settings</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: index.docbook:509
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Toolbar</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:514
#, no-c-format
msgid "Toggle on and off the main toolbar."
msgstr ""

#. Tag: menuchoice
#: index.docbook:519
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Statusbar</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:524
#, no-c-format
msgid "Toggle on and off the statusbar."
msgstr ""

#. Tag: menuchoice
#: index.docbook:529
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Enable Mouse for Moving Putter</"
"guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:534
#, no-c-format
msgid "Allow the use of the mouse to move the putter."
msgstr ""

#. Tag: menuchoice
#: index.docbook:540
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Enable Advanced Putting</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:544
#, no-c-format
msgid ""
"<action>Enable the advanced putting mode</action>, as described in <link "
"linkend=\"advanced-putting\">its own section</link>."
msgstr ""

#. Tag: menuchoice
#: index.docbook:551
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Show Putter Guideline</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:556
#, no-c-format
msgid "Toggle on and off the putter guideline."
msgstr ""

#. Tag: menuchoice
#: index.docbook:561
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Play Sounds</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:566
#, no-c-format
msgid "Toggle on and off the sound effects."
msgstr ""

#. Tag: menuchoice
#: index.docbook:571
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Enable All Dialog Boxes</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:576
#, no-c-format
msgid ""
"<action>Re-enables any dialog boxes that you disabled by clicking on "
"<guilabel>Do not show this message again</guilabel> or similar</action>."
msgstr ""

#. Tag: menuchoice
#: index.docbook:582
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Reload Plugins</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:587
#, no-c-format
msgid "Reload plugins."
msgstr ""

#. Tag: menuchoice
#: index.docbook:592
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Plugins</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:597
#, no-c-format
msgid "Display the currently loaded plugins."
msgstr ""

#. Tag: menuchoice
#: index.docbook:602
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:607
#, no-c-format
msgid "Customize the keyboard shortcuts."
msgstr ""

#. Tag: menuchoice
#: index.docbook:612
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Toolbars...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:617
#, no-c-format
msgid ""
"<action>Open a dialog where you can configure the toolbars</action> for "
"&kappname;."
msgstr ""

#. Tag: title
#: index.docbook:624
#, no-c-format
msgid "The <guimenuitem>Help</guimenuitem> Menu"
msgstr ""

#. Tag: para
#: index.docbook:625
#, no-c-format
msgid ""
"&kappname; has a default &kde; <guimenu>Help</guimenu> menu as described "
"below, with one addition:"
msgstr ""

#. Tag: menuchoice
#: index.docbook:630
#, no-c-format
msgid "<guimenu>Help</guimenu> <guimenuitem>Tutorial</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:634
#, no-c-format
msgid "Start the tutorial course of &kappname;."
msgstr ""

#. Tag: para
#: index.docbook:639
#, no-c-format
msgid "The default &kde; <guimenu>Help</guimenu> entries are:"
msgstr ""

#. Tag: sect1
#: index.docbook:639
#, no-c-format
msgid "&help.menu.documentation;"
msgstr ""

#. Tag: title
#: index.docbook:645
#, no-c-format
msgid "Frequently asked questions"
msgstr ""

#. Tag: para
#: index.docbook:650
#, no-c-format
msgid "Who made this game?"
msgstr ""

#. Tag: para
#: index.docbook:651
#, no-c-format
msgid ""
"The kdegames team. You can find their website <ulink url=\"http://games.kde."
"org\">here</ulink>."
msgstr ""

#. Tag: para
#: index.docbook:654
#, no-c-format
msgid "Where can I get cheatcodes?"
msgstr ""

#. Tag: para
#: index.docbook:655
#, no-c-format
msgid "You cannot get cheatcodes for &kde; games."
msgstr ""

#. Tag: para
#: index.docbook:658
#, no-c-format
msgid "How do I start a new game?"
msgstr ""

#. Tag: para
#: index.docbook:659
#, no-c-format
msgid ""
"To start a new game use <menuchoice><shortcut><keycombo action=\"simul"
"\">&Ctrl;<keycap>N</keycap></keycombo></shortcut><guimenu>Game</"
"guimenu><guimenuitem>New...</guimenuitem></menuchoice> on the menubar. This "
"will open the new game dialog where you will be able to set the number of "
"players, the course to play, and the game options."
msgstr ""

#. Tag: para
#: index.docbook:662
#, no-c-format
msgid "How do I pause the game?"
msgstr ""

#. Tag: para
#: index.docbook:663
#, no-c-format
msgid "&kappname; does not need to be paused."
msgstr ""

#. Tag: para
#: index.docbook:666
#, no-c-format
msgid "I want to change the way this game looks. Can I?"
msgstr ""

#. Tag: para
#: index.docbook:667
#, no-c-format
msgid "No. At this moment &kappname; features only one theme."
msgstr ""

#. Tag: para
#: index.docbook:670
#, no-c-format
msgid "I have made a mistake. Can I undo?"
msgstr ""

#. Tag: para
#: index.docbook:671
#, no-c-format
msgid ""
"Yes. To undo your last move use <menuchoice><shortcut><keycombo action="
"\"simul\">&Ctrl;<keycap>Z</keycap></keycombo></shortcut><guimenu>Hole</"
"guimenu><guimenuitem>Undo Shot</guimenuitem></menuchoice> on the menubar."
msgstr ""

#. Tag: para
#: index.docbook:674
#, no-c-format
msgid "Can I use keyboard?"
msgstr ""

#. Tag: para
#: index.docbook:675
#, no-c-format
msgid "Yes. Use the directional keys to control the putter."
msgstr ""

#. Tag: para
#: index.docbook:678
#, no-c-format
msgid "I cannot figure out what to do here! Are there hints?"
msgstr ""

#. Tag: para
#: index.docbook:679
#, no-c-format
msgid "No. &kappname; does not have a hint feature."
msgstr ""

#. Tag: para
#: index.docbook:682
#, no-c-format
msgid ""
"I have to quit the game now, but I am not finished yet. Can I save my "
"progress?"
msgstr ""

#. Tag: para
#: index.docbook:683
#, no-c-format
msgid ""
"Yes. To save your current game progress use <menuchoice><guimenu>Game</"
"guimenu><guimenuitem>Save Game</guimenuitem></menuchoice> on the menubar."
msgstr ""

#. Tag: para
#: index.docbook:686
#, no-c-format
msgid "Where are the high scores?"
msgstr ""

#. Tag: para
#: index.docbook:687
#, no-c-format
msgid ""
"To view the high score board use <menuchoice><shortcut><keycombo action="
"\"simul\">&Ctrl;<keycap>H</keycap></keycombo></shortcut><guimenu>Game</"
"guimenu><guimenuitem>Show Highscores</guimenuitem></menuchoice> on the "
"menubar."
msgstr ""

#. Tag: para
#: index.docbook:690
#, no-c-format
msgid "I want to change the game configuration. Where do I go?"
msgstr ""

#. Tag: para
#: index.docbook:691
#, no-c-format
msgid ""
"You can change the game configuration every time you start a new game. Use "
"the new game dialog to change settings."
msgstr ""

#. Tag: para
#: index.docbook:694
#, no-c-format
msgid "I want to design my own golfcourse. Can I?"
msgstr ""

#. Tag: para
#: index.docbook:695
#, no-c-format
msgid ""
"Yes, you can. To enter the edit mode use <menuchoice><shortcut><keycombo "
"action=\"simul\">&Ctrl;<keycap>E</keycap></keycombo></"
"shortcut><guimenu>Hole</guimenu><guimenuitem>Edit</guimenuitem></menuchoice> "
"on the menubar. Click <link linkend=\"creating\">here</link> for more "
"details."
msgstr ""

#. Tag: title
#: index.docbook:701
#, no-c-format
msgid "Course Editor"
msgstr ""

#. Tag: para
#: index.docbook:703
#, no-c-format
msgid ""
"&kappname; comes with a versatile editor for its course file format. Courses "
"can have any number of holes, and there is no limiting the creativity of the "
"course designer."
msgstr ""

#. Tag: title
#: index.docbook:705
#, no-c-format
msgid "Creating a New Course"
msgstr ""

#. Tag: para
#: index.docbook:706
#, no-c-format
msgid ""
"To create a new course, choose <menuchoice><guimenu>Game</"
"guimenu><guimenuitem>New</guimenuitem></menuchoice>. Go to the "
"<guilabel>Course</guilabel> page of the dialog, and choose the "
"<guilabel>Create New</guilabel> course. Make sure that, under the "
"<guilabel>Options</guilabel> page of the dialog, <guilabel>Strict mode</"
"guilabel> is unchecked."
msgstr ""

#. Tag: para
#: index.docbook:709
#, no-c-format
msgid ""
"To play this new course later, click the <guibutton>Add...</guibutton> "
"button to add the course to your list of courses."
msgstr ""

#. Tag: title
#: index.docbook:713
#, no-c-format
msgid "Adding Holes"
msgstr ""

#. Tag: para
#: index.docbook:714
#, no-c-format
msgid ""
"Choose <menuchoice><guimenu>Hole</guimenu><guimenuitem>New</guimenuitem></"
"menuchoice> to add a new hole at the end of the course."
msgstr ""

#. Tag: para
#: index.docbook:716
#, no-c-format
msgid ""
"You can restore a hole to a blank state, similar to when it was first "
"created, by choosing <menuchoice><guimenu>Hole</guimenu><guimenuitem>Clear</"
"guimenuitem></menuchoice>."
msgstr ""

#. Tag: para
#: index.docbook:718
#, no-c-format
msgid ""
"Two items will appear on new holes: a cup, and a white ball. The white ball "
"marks where players' balls start the hole."
msgstr ""

#. Tag: title
#: index.docbook:721
#, no-c-format
msgid "Editing Basics"
msgstr ""

#. Tag: para
#: index.docbook:722
#, no-c-format
msgid ""
"The basic building block of &kappname; courses is the <quote>object</quote>. "
"Holes are made up of a bunch of objects. Objects can be moved to any "
"location, and the different kinds of objects each have different properties "
"you can set."
msgstr ""

#. Tag: para
#: index.docbook:723
#, no-c-format
msgid ""
"To start editing a hole, toggle the <menuchoice><guimenu>Hole</"
"guimenu><guimenuitem>Edit</guimenuitem></menuchoice> menu item, or press the "
"pencil icon on the toolbar. To leave editing mode, uncheck this menu item "
"(or the toolbar icon)."
msgstr ""

#. Tag: title
#: index.docbook:725
#, no-c-format
msgid "Adding Objects"
msgstr ""

#. Tag: para
#: index.docbook:726
#, no-c-format
msgid ""
"To add a new object to the course, choose its name in the list box labeled "
"<guilabel>Add object:</guilabel>. The object will appear in the center of "
"the course."
msgstr ""

#. Tag: para
#: index.docbook:728
#, no-c-format
msgid ""
"Bridges and signs will cover up new objects if they were already in the "
"center of the hole."
msgstr ""

#. Tag: para
#: index.docbook:731
#, no-c-format
msgid ""
"You can add more than one cup to a hole! Doing so can create interesting "
"hole designs."
msgstr ""

#. Tag: para
#: index.docbook:733
#, no-c-format
msgid ""
"Some &kappname; objects are available as plugins. If you add these objects "
"to your course, course players will need to download the plugin."
msgstr ""

#. Tag: para
#: index.docbook:734
#, no-c-format
msgid ""
"Third-party &kappname; plugins are available at the &kappname; website. See "
"<ulink url=\"http://web.mit.edu/jasonkb/www/kolf/\">the &kappname; plugins "
"download page</ulink>."
msgstr ""

#. Tag: title
#: index.docbook:737
#, no-c-format
msgid "Moving and Resizing Objects"
msgstr ""

#. Tag: para
#: index.docbook:738
#, no-c-format
msgid ""
"Move your mouse cursor over the object that you want to move, and the mouse "
"cursor will change to a hand cursor. Then click and drag the object to where "
"you want it."
msgstr ""

#. Tag: para
#: index.docbook:739
#, no-c-format
msgid ""
"Puddles, sand, floaters, bridges, and signs can be resized by dragging the "
"small circle at their lower-right corner."
msgstr ""

#. Tag: para
#: index.docbook:742
#, no-c-format
msgid ""
"Walls can be moved by clicking and dragging their endpoints, or you can move "
"the whole wall by clicking and dragging on the middle part of the wall as "
"normal."
msgstr ""

#. Tag: title
#: index.docbook:746
#, no-c-format
msgid "Objects' Settings"
msgstr ""

#. Tag: para
#: index.docbook:747
#, no-c-format
msgid ""
"Objects' properties can be changed in the area at the lower-right corner of "
"the &kappname; window. To edit an object, move your mouse cursor over it "
"until the cursor changes to the hand cursor. Then click. Various controls "
"for that object will appear in the lower-right corner of the &kappname; "
"window."
msgstr ""

#. Tag: title
#: index.docbook:748
#, no-c-format
msgid "General Hole Settings"
msgstr ""

#. Tag: para
#: index.docbook:749
#, no-c-format
msgid ""
"To edit general hole settings, click an area of the hole that is not covered "
"by an object. When this is possible, the cursor will be the normal pointer "
"cursor."
msgstr ""

#. Tag: guilabel
#: index.docbook:752
#, no-c-format
msgid "Course name:"
msgstr ""

#. Tag: para
#: index.docbook:754
#, no-c-format
msgid ""
"This is the name that is shown in the new game dialog and in the "
"<guimenuitem>About Course</guimenuitem> dialog."
msgstr ""

#. Tag: guilabel
#: index.docbook:757
#, no-c-format
msgid "Course author:"
msgstr ""

#. Tag: para
#: index.docbook:759
#, no-c-format
msgid ""
"This is the author name that is shown in the <guimenuitem>About Course</"
"guimenuitem> dialog."
msgstr ""

#. Tag: guilabel
#: index.docbook:762
#, no-c-format
msgid "Par:"
msgstr ""

#. Tag: para
#: index.docbook:764
#, no-c-format
msgid "The par of the hole."
msgstr ""

#. Tag: guilabel
#: index.docbook:767
#, no-c-format
msgid "Maximum:"
msgstr "Maximum :"

#. Tag: para
#: index.docbook:769
#, no-c-format
msgid "The maximum number of strokes a player can take on the hole."
msgstr ""

#. Tag: guilabel
#: index.docbook:772
#, no-c-format
msgid "Show border walls"
msgstr ""

#. Tag: para
#: index.docbook:774
#, no-c-format
msgid "Whether or not to show walls around the border of the hole."
msgstr ""

#. Tag: term
#: index.docbook:783
#, no-c-format
msgid "Type"
msgstr "Tipe"

#. Tag: para
#: index.docbook:785
#, no-c-format
msgid ""
"Choose the type of the slope - <guilabel>Vertical</guilabel>, "
"<guilabel>Horizontal</guilabel>, <guilabel>Diagonal</guilabel>, "
"<guilabel>Opposite Diagonal</guilabel>, <guilabel>Circular</guilabel>. "
"Diagonal and opposite diagonal slopes are triangles, while circular slopes "
"are circles. Vertical and horizontal slopes are rectangles of course."
msgstr ""

#. Tag: guilabel
#: index.docbook:788
#, no-c-format
msgid "Reverse direction"
msgstr ""

#. Tag: para
#: index.docbook:790
#, no-c-format
msgid ""
"Whether or not to reverse the slant of the slope. For example, consider an "
"elliptical slope (a circular slope). When it is not reversed, it pushes "
"balls outward like a mound. When it is reversed, it sucks balls inward like "
"a hole."
msgstr ""

#. Tag: guilabel
#: index.docbook:793
#, no-c-format
msgid "Grade:"
msgstr ""

#. Tag: para
#: index.docbook:795
#, no-c-format
msgid ""
"Choose the grade (steepness) of the slope by moving the slider so the grade "
"moves towards 0 or 8, where 8 is steepest and 0 is flat. Steeper slopes push "
"the ball more."
msgstr ""

#. Tag: guilabel
#: index.docbook:798
#, no-c-format
msgid "Unmovable"
msgstr ""

#. Tag: para
#: index.docbook:800
#, no-c-format
msgid "Whether or not this can be moved by other objects, like floaters."
msgstr ""

#. Tag: para
#: index.docbook:802
#, no-c-format
msgid ""
"If a floater overlaps with this object at any point on this path, and the "
"slope is large and thus won't move the floater, you <emphasis>must</"
"emphasis> make the slope <guilabel>Unmovable</guilabel>, or &kappname; will "
"suffer poor performance!"
msgstr ""

#. Tag: para
#: index.docbook:810
#, no-c-format
msgid "Puddles and Sand have the same configuration options as each other."
msgstr ""

#. Tag: guilabel
#: index.docbook:813
#, no-c-format
msgid "Enable show/hide"
msgstr ""

#. Tag: para
#: index.docbook:815
#, no-c-format
msgid "Checking this enables the flashing of this puddle or sand."
msgstr ""

#. Tag: term
#: index.docbook:818
#, no-c-format
msgid "Show/Hide speed"
msgstr ""

#. Tag: para
#: index.docbook:820
#, no-c-format
msgid ""
"The more towards <guilabel>Fast</guilabel> the slider is, the faster the "
"puddle or sand flashes."
msgstr ""

#. Tag: title
#: index.docbook:826
#, no-c-format
msgid "Bridges, Windmills, Floaters, and Signs"
msgstr ""

#. Tag: para
#: index.docbook:827
#, no-c-format
msgid ""
"Bridges, windmills, floaters, and signs all have similar settings for "
"configuring on which sides there are border walls. To show the wall on a "
"side, check the check box for that side."
msgstr ""

#. Tag: para
#: index.docbook:828
#, no-c-format
msgid ""
"There are also some more specific options for windmills, floaters, and signs."
msgstr ""

#. Tag: guilabel
#: index.docbook:832
#, no-c-format
msgid "Windmill on bottom"
msgstr ""

#. Tag: para
#: index.docbook:834
#, no-c-format
msgid ""
"Whether or not the black windmill arm is on bottom or top - the default is "
"that it is on the bottom. The two half-walls will always be with the arm. "
"Note that you cannot enable a border wall on the side that the arm is."
msgstr ""

#. Tag: term
#: index.docbook:837
#, no-c-format
msgid "Speed"
msgstr "Velocitat"

#. Tag: para
#: index.docbook:839
#, no-c-format
msgid ""
"The more towards <guilabel>Fast</guilabel> the slider is, the faster the "
"black windmill arm moves."
msgstr ""

#. Tag: para
#: index.docbook:846
#, no-c-format
msgid ""
"The path the floater moves along is shown by the wall it's connected to."
msgstr ""

#. Tag: guilabel
#: index.docbook:848
#, no-c-format
msgid "Moving speed"
msgstr ""

#. Tag: para
#: index.docbook:850
#, no-c-format
msgid ""
