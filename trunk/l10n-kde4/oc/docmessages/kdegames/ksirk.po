#. Tag: para
#: index.docbook:231
#, no-c-format
msgid ""
"To start a network game, check the \"Network game\" check box on the right "
"of the number of players spin box. After clicking OK, you will be able to "
"chose the network parameters: number of network players and TCP port on "
"which waiting for connections."
msgstr ""

#. Tag: screeninfo
#: index.docbook:234
#, no-c-format
msgid "<screeninfo>Network game parameters dialog</screeninfo>"
msgstr ""

#. Tag: phrase
#: index.docbook:240
#, no-c-format
