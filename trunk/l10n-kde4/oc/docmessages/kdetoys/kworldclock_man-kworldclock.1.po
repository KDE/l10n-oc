#. Tag: title
#: man-kworldclock.1.docbook:39
#, no-c-format
msgid "Description"
msgstr "Descripcion"

#. Tag: para
#: man-kworldclock.1.docbook:41
#, no-c-format
msgid ""
"&kworldclock; displays where in the world it is light and dark depending on "
"time, as well as offering the time in all of the major cities of the world. "
"This can be run standalone, as an applet in the &kde; panel, or configured "
"to draw the desktop background."
msgstr ""

#. Tag: para
#: man-kworldclock.1.docbook:46
#, no-c-format
msgid "&kworldclock; is part of the official &kde; kdetoys package."
msgstr ""

