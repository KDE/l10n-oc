#, no-c-format
msgid "Synopsis"
msgstr ""

#. Tag: cmdsynopsis
#: man-kbuildsycoca4.8.docbook:36
#, no-c-format
msgid ""
"<command>kbuildsycoca4</command> <group> <arg choice=\"opt\">--nosignal</"
"arg> <arg choice=\"opt\">--incremental</arg> <arg choice=\"opt\">--help</"
"arg> <arg choice=\"opt\">--help-qt</arg> <arg choice=\"opt\">--help-kde</"
"arg> <arg choice=\"opt\">--help-all</arg> <arg choice=\"opt\">--author</arg> "
"<arg choice=\"opt\">-v, --version</arg> <arg choice=\"opt\">--license</arg> "
"</group>"
msgstr ""

#. Tag: title
#: man-kbuildsycoca4.8.docbook:55
#, no-c-format
msgid "Description"
msgstr "Descripcion"

#. Tag: para
#: man-kbuildsycoca4.8.docbook:57
#, no-c-format
msgid ""
"<command>kbuildsycoca4</command>, as part of the &kde; command line tools "
"ensures the proper operation of &kde; by reading in all the <literal role="
"\"extension\">.desktop</literal>, <literal role=\"extension\">.directory</"
"literal>, <literal role=\"extension\">.kimgio</literal> and <literal role="
"\"extension\">.protocol</literal> files to constructs a binary database."
msgstr ""

#. Tag: para
#: man-kbuildsycoca4.8.docbook:67
#, no-c-format
msgid ""
"&kde; itself accesses this database during operation to provide "
"configuration information a program needs to run."
msgstr ""

#. Tag: para
#: man-kbuildsycoca4.8.docbook:72
#, no-c-format
msgid ""
"This tool is part of ksycoca, which stands for &kde; System Configuration "
"Cache"
msgstr ""

