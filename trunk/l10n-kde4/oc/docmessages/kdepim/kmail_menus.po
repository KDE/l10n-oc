#. Tag: title
#: menus.docbook:47
#, no-c-format
msgid "Command and Menu Reference"
msgstr ""

#. Tag: para
#: menus.docbook:48
#, no-c-format
msgid ""
"Each &kmail; specific menu item is discussed below. When there is a keyboard "
"shortcut that performs a menu item function, the default shortcut is listed "
"with the menu item."
msgstr ""

#. Tag: title
#: menus.docbook:52
#, no-c-format
msgid "The &kmail; Reader Window"
msgstr ""

#. Tag: title
#: menus.docbook:55
#, no-c-format
msgid "File Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:58
#, no-c-format
msgid "<guimenu>File</guimenu> <guisubmenu>New</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:62
#, no-c-format
msgid "Here you can create several new items as follows:"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:65
#, no-c-format
msgid ""
"<guimenu>File</guimenu> <guisubmenu>New</guisubmenu> <guimenuitem>New "
"Message...</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:70
#, no-c-format
msgid "Compose a new message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:73
#, no-c-format
msgid ""
"<guimenu>File</guimenu> <guisubmenu>New</guisubmenu> <guisubmenu>Message "
"from Template</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:78
#, no-c-format
msgid ""
"<action>Creates a new message from a selected template.</action> Please see "
"<link linkend=\"new-compose-from-templates\">Compose From Templates</link> "
"for additional information on creating templates."
msgstr ""

#. Tag: para
#: menus.docbook:79
#, no-c-format
msgid ""
"If you do not have any templates saved, you will see "
"<menuchoice><guimenu>Message</guimenu><guisubmenu>Message from Template</"
"guisubmenu><guimenuitem>(no templates)</guimenuitem></menuchoice>"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:82
#, no-c-format
msgid ""
"<guimenu>File</guimenu> <guisubmenu>New</guisubmenu> <guimenuitem>Add "
"Folder...</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:87
#, no-c-format
msgid "Create a new folder"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:90
#, no-c-format
msgid ""
"<guimenu>File</guimenu> <guisubmenu>New</guisubmenu> <guimenuitem>New "
"AddressBook Contact...</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:95
#, no-c-format
msgid "Brings up the new contact dialog"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:98
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>O</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Open...</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:105
#, no-c-format
msgid "Open email messages or mailboxes."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:108
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Open Recent</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:112
#, no-c-format
msgid ""
"<action>Opens recently used messages.</action> Only messages that have been "
"saved and then opened will show up on this list."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:115
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Save As...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:122
#, no-c-format
msgid ""
"<action>Saves the currently displayed message to a <filename role=\"extension"
"\">.mbox</filename>.</action> This includes all the headers and attachments."
msgstr ""

#. Tag: para
#: menus.docbook:123
#, no-c-format
msgid ""
"If you would like to save it to a different format &eg; <filename role="
"\"extension\">.txt</filename>, deselect <guilabel>Automatically select "
"filename extension (.mbox)</guilabel>, and be sure to change the file "
"extension while naming the file."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:126
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Import Messages...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:130
#, no-c-format
msgid ""
"<action>Starts up <application>kmailcvt</application></action>. This "
"application lets you import messages from several email clients into &kmail;."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:133
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Print Preview...</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:137
#, no-c-format
msgid "Display a dialog which shows how your email will be printed."
msgstr ""

#. Tag: para
#: menus.docbook:138
#, no-c-format
msgid "This will only be enabled if a printer is available."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:141
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Print...</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:148
#, no-c-format
msgid "Display a dialog that lets you print the currently displayed message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:151
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Expire All Folders</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:155
#, no-c-format
msgid ""
"<action>Delete old messages from all folders.</action> Deletion will occur "
"according to the rules in each folder's <link linkend=\"folders-properties-"
"window\">Properties dialog</link> (the default is not to delete old messages "
"at all)."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:160
#, no-c-format
msgid ""
"<guimenu>File</guimenu> <guimenuitem>Empty All Trash Folders</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:164
#, no-c-format
msgid ""
"<action>Use this to empty all trash folders,</action> &ie; the local trash "
"folder and all trash folders that you might have on &imap; servers."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:167
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Work Offline</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:171
#, no-c-format
msgid ""
"<action>Sets &kmail; to offline mode.</action> This turns off all network "
"jobs. This is useful when working with messages without a network "
"connection. This selection will become <menuchoice><guimenu>File</"
"guimenu><guimenuitem>Work Online</guimenuitem></menuchoice>, which needs to "
"be selected to go back online (required to send and receive)."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:177
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>L</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Check Mail</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:184
#, no-c-format
msgid "Checks for new messages in all your accounts."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:187
#, no-c-format
msgid "<guimenu>File</guimenu> <guisubmenu>Check Mail In</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:191
#, no-c-format
msgid ""
"<action>Check for new messages from a particular account,</action> these "
"accounts will be listed in the submenu."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:194
#, no-c-format
msgid ""
"<shortcut> <keycap>F5</keycap> </shortcut> <guimenu>File</guimenu> "
"<guimenuitem>Update Folder</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:201 menus.docbook:630
#, no-c-format
msgid "Checks whether new mail arrived in the currently selected folder."
msgstr ""

#. Tag: para
#: menus.docbook:202 menus.docbook:214 menus.docbook:631 menus.docbook:642
#, no-c-format
msgid "This is only available for &imap; folders."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:205
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>F5</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Update This Folder and All "
"Its Subfolders</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:212 menus.docbook:641
#, no-c-format
msgid ""
"Checks whether new mail arrived in the currently selected folder and all of "
"its subfolders."
msgstr ""

#. Tag: para
#: menus.docbook:213
#, no-c-format
msgid ""
"You can also select multiple folders and the menu item will turn into "
"<menuchoice><guimenu>File</guimenu><guimenuitem>Update These Folders and All "
"Their Subfolders</guimenuitem></menuchoice>"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:217
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Send Queued Messages</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:221
#, no-c-format
msgid ""
"<action>Sends the messages that are in your outbox.</action> Messages can "
"end up in your outbox by selecting <guibutton>Queue</guibutton> in the "
"composer menu, composing a message in offline mode, and sending while you "
"have no Internet connection."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:225
#, no-c-format
msgid ""
"<guimenu>File</guimenu> <guimenuitem>Send Queued Messages Via</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:229
#, no-c-format
msgid ""
"<action>Sends the messages that are in your outbox via a specific outgoing "
"account.</action> This allows you to choose which server to send your queued "
"messages from. They must be configured in Configure &kmail; dialog, under "
"the <menuchoice><guiicon>Accounts</guiicon><guilabel>Sending</guilabel></"
"menuchoice> tab to show up here."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:240
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:247
#, no-c-format
msgid "Exits &kmail;"
msgstr ""

#. Tag: title
#: menus.docbook:255 menus.docbook:1395
#, no-c-format
msgid "Edit Menu"
msgstr ""

#. Tag: para
#: menus.docbook:256 menus.docbook:1396
#, no-c-format
msgid ""
"If the menu item you are looking for is missing, please see <ulink url="
"\"help:/fundamentals/ui.html#menus-edit\">Edit Menu</ulink> of the &kde; "
"Fundamentals. The items listed here are &kmail; specific."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:260
#, no-c-format
msgid ""
"<shortcut> <keycap>Del</keycap> </shortcut> <guimenu>Edit</guimenu> "
"<guimenuitem>Move to Trash</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:267
#, no-c-format
msgid ""
"<action>Moves the selected messages to the trash folder.</action> If the "
"selected messages are already in the trash folder, they will be permanently "
"deleted."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:271
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Del</keycap></keycombo> "
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Move Thread to Trash</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:278
#, no-c-format
msgid ""
"<action>Moves the selected thread to the trash folder,</action> &eg; a "
"conversation in a mailing list."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:281
#, no-c-format
msgid ""
"<shortcut> <keycap>S</keycap></shortcut> <guimenu>Edit</guimenu> "
"<guimenuitem>Find Messages...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:287 menus.docbook:1118
#, no-c-format
msgid ""
"<action>Opens up a search window</action> that lets you search for messages "
"with certain characteristics, &eg; a certain subject. Please see <link "
"linkend=\"filter-criteria\">Filter Criteria</link> for details on search "
"options."
msgstr ""

#. Tag: para
#: menus.docbook:289 menus.docbook:1120
#, no-c-format
msgid ""
"Your search results will display in the text area, at which point you can "
"open the <guibutton>Open Search Folder</guibutton> or highlight the desired "
"message and select <guibutton>Open Message</guibutton>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:292
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>F</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find in Message...</"
"guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:299
#, no-c-format
msgid ""
"Searches the current message text for a string entered into the "
"<guilabel>Find:</guilabel> textbox."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:302
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>A</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Select All Messages</"
"guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:309
#, no-c-format
msgid "Selects all messages in the current folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:312
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>T</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Select All Text</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:319
#, no-c-format
msgid "Selects the text of the currently displayed message."
msgstr ""

#. Tag: title
#: menus.docbook:326
#, no-c-format
msgid "View Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:330
#, no-c-format
msgid "<guimenu>View</guimenu> <guisubmenu>Message List</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:334
#, no-c-format
msgid ""
"This menu has the following options to change the view of your message list."
msgstr ""

#. Tag: guisubmenu
#: menus.docbook:338
#, no-c-format
msgid "Sorting"
msgstr ""

#. Tag: para
#: menus.docbook:340
#, no-c-format
msgid "Contains options to customize your sort order as follows:"
msgstr ""

#. Tag: para
#: menus.docbook:342
#, no-c-format
msgid ""
"<guilabel>Message Sort Order</guilabel> has several options, most are self "
"explanatory. The following options may not be immediately obvious, therefore "
"deserve an explanation."
msgstr ""

#. Tag: para
#: menus.docbook:345
#, no-c-format
msgid ""
"<guilabel>Smart Sender/Receiver</guilabel> will display the sender when you "
"are reading in your outbox folder/template folder, and display the receiver "
"when you are in your inbox/inbox subfolders."
msgstr ""

#. Tag: para
#: menus.docbook:346
#, no-c-format
msgid ""
"<guilabel>By Action Item Status</guilabel> and <guilabel>By Important "
"Status</guilabel> need to be set before they can be sorted. Please see <link "
"linkend=\"mark-messages\">Mark Messages</link> for more information on "
"marking your messages."
msgstr ""

#. Tag: para
#: menus.docbook:348
#, no-c-format
msgid ""
"<guilabel>Message Sort Direction</guilabel> and <guilabel>Group Sort "
"Direction</guilabel> allow you to change the direction of your message/group "
"sort respectively."
msgstr ""

#. Tag: para
#: menus.docbook:349
#, no-c-format
msgid ""
"<guilabel>Folder always Uses this Sort Order</guilabel> allows you to keep "
"your sort settings per folder."
msgstr ""

#. Tag: guisubmenu
#: menus.docbook:354
#, no-c-format
msgid "Aggregation"
msgstr ""

#. Tag: para
#: menus.docbook:356
#, no-c-format
msgid "Allows you to set your aggregation view."
msgstr ""

#. Tag: para
#: menus.docbook:357
#, no-c-format
msgid ""
"<guilabel>Configure...</guilabel> Allows you to configure aggregation, "
"please see <link linkend=\"configure-appearance-message-list\">Configure "
"Appearance Message List</link> for more information on aggregation."
msgstr ""

#. Tag: guisubmenu
#: menus.docbook:361
#, no-c-format
msgid "Theme"
msgstr ""

#. Tag: para
#: menus.docbook:363
#, no-c-format
msgid "Allows you to select a theme."
msgstr ""

#. Tag: para
#: menus.docbook:364
#, no-c-format
msgid ""
"<guilabel>Configure...</guilabel> Allows you to configure themes, please see "
"<link linkend=\"configure-appearance-message-list\">Configure Appearance "
"Message List</link> for more information on themes."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:367
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>T</keycap></"
"keycombo> </shortcut> <guisubmenu>Create New Tab</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:373
#, no-c-format
msgid ""
"<action>Creates a new tab,</action> then select the folder you would like to "
"display in the tab."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:376
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>W</keycap></"
"keycombo> </shortcut> <guisubmenu>Close Tab</guisubmenu>"
msgstr ""

#. Tag: action
#: menus.docbook:382
#, no-c-format
msgid "Closes the currently selected tab."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:387
#, no-c-format
msgid "<guimenu>View</guimenu> <guisubmenu>Headers</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:391
#, no-c-format
msgid "<action>Select your headers view.</action> Your choices are as follows:"
msgstr ""

#. Tag: para
#: menus.docbook:393
#, no-c-format
msgid ""
"<guilabel>Enterprise Headers</guilabel> A minimal header with title, From, "
"and To, with a graphical design."
msgstr ""

#. Tag: para
#: menus.docbook:394
#, no-c-format
msgid ""
"<guilabel>Fancy Headers</guilabel> Minimal header with a spam status "
"notification."
msgstr ""

#. Tag: para
#: menus.docbook:395
#, no-c-format
msgid ""
"<guilabel>Brief Headers</guilabel> Title, and in parentheses you will find "
"From and the date."
msgstr ""

#. Tag: para
#: menus.docbook:396
#, no-c-format
msgid "<guilabel>Standard Headers</guilabel> Title, From, and To."
msgstr ""

#. Tag: para
#: menus.docbook:397
#, no-c-format
msgid "<guilabel>Long Headers</guilabel> Title, Date, From, and To."
msgstr ""

#. Tag: para
#: menus.docbook:398
#, no-c-format
msgid ""
"<guilabel>All Headers</guilabel> List everything you ever wanted to know "
"about the email, including every server it went through, virus/spam scanners "
"it went through &etc;"
msgstr ""

#. Tag: para
#: menus.docbook:399
#, no-c-format
msgid ""
"<guilabel>Custom Headers</guilabel> See <link linkend=\"configure-appearance-"
"message-window\">Message Window configuration</link> <guilabel>Headers:</"
"guilabel> to set up custom headers that can be selected here."
msgstr ""

#. Tag: para
#: menus.docbook:400
#, no-c-format
msgid ""
"<guilabel>Example</guilabel> An example header from the <guilabel>Download "
"New Themes</guilabel>"
msgstr ""

#. Tag: para
#: menus.docbook:401
#, no-c-format
msgid ""
"<guilabel>Example Fancy</guilabel> An example fancy header from the "
"<guilabel>Download New Themes</guilabel>"
msgstr ""

#. Tag: para
#: menus.docbook:402
#, no-c-format
msgid ""
"<guilabel>Download New Themes</guilabel> Allows you to download custom "
"themes created by other &kmail; users."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:406
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Attachments</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:410
#, no-c-format
msgid ""
"<action>Changes the way attachments appear in the <guilabel>Message Preview "
"Pane</guilabel></action> (independent of the &MIME; Tree) as follows:"
msgstr ""

#. Tag: para
#: menus.docbook:413
#, no-c-format
msgid ""
"<guimenuitem>As Icons</guimenuitem>, all attachments appear as icons at the "
"bottom of the message."
msgstr ""

#. Tag: para
#: menus.docbook:414
#, no-c-format
msgid ""
"<guimenuitem>Smart</guimenuitem> will show attachments as icons, unless the "
"message suggests that they should be displayed inline. You can suggest that "
"certain attachments should be shown inline in your own messages when you "
"select <guilabel>Suggest automatic display</guilabel> in the attachment's "
"properties dialog."
msgstr ""

#. Tag: para
#: menus.docbook:417
#, no-c-format
msgid ""
"<guimenuitem>Inline</guimenuitem> shows the contents of the attachments at "
"the bottom of the message. Attachments that cannot be displayed, &eg; "
"compressed files, will still be shown as an icon."
msgstr ""

#. Tag: para
#: menus.docbook:419
#, no-c-format
msgid "<guimenuitem>Hide</guimenuitem> will not show attachments."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:423
#, no-c-format
msgid ""
"<shortcut> <keycap>.</keycap></shortcut> <guimenu>View</guimenu> "
"<guimenuitem>Expand Thread / Group</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:429
#, no-c-format
msgid ""
"<action>This will display the thread of the current message,</action> &ie; "
"all messages that are replies to the current message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:432
#, no-c-format
msgid ""
"<shortcut> <keycap>,</keycap> </shortcut> <guimenu>View</guimenu> "
"<guimenuitem>Collapse Thread / Group</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:439
#, no-c-format
msgid ""
"<action>This will hide the thread of the current message,</action> &ie; it "
"will hide all messages that are replies to the current message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:442
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>.</keycap></keycombo> </"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Expand All Threads</"
"guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:449
#, no-c-format
msgid "Expands all threads in the current folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:452
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>,</keycap></keycombo> </"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Collapse All Threads</"
"guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:459
#, no-c-format
msgid "Collapses all threads in the current folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:462
#, no-c-format
msgid ""
"<shortcut> <keycap>V</keycap> </shortcut> <guimenu>View</guimenu> "
"<guimenuitem>View Source</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:469
#, no-c-format
msgid ""
"<action>Shows the message and its complete headers in plain text format in a "
"new window.</action> This can be useful to find out the origin of a mail."
msgstr ""

#. Tag: para
#: menus.docbook:471
#, no-c-format
msgid ""
"You should know that it is easy to fake the <literal>From:</literal> header "
"of a mail, but one can still find out which mail servers have been used to "
"send the message by looking at the <literal>Received:</literal> lines in the "
"header."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:475
#, no-c-format
msgid ""
"<guimenu>View</guimenu> <guimenuitem>Show Message Structure</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:479
#, no-c-format
msgid ""
"<action>Display the structure viewer,</action> which is a part of the main "
"window that lets you access all parts of a message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:482
#, no-c-format
msgid ""
"<shortcut> <keycap>X</keycap> </shortcut> <guimenu>View</guimenu> "
"<guimenuitem>Use Fixed Font</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:489
#, no-c-format
msgid ""
"<action>Uses a fixed width (Monospace) font to display the messages in the "
"current folder.</action> The font to be used can be configured in the <link "
"linkend=\"configure-appearance-fonts\">Configure Appearance Fonts</link> tab "
"of the configuration dialog."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:493
#, no-c-format
msgid "<guimenu>View</guimenu> <guisubmenu>Set Encoding</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:497
#, no-c-format
msgid ""
"<action>Lets you choose the character encoding to be used in the Message "
"Pane.</action> The default, <guilabel>Auto</guilabel>, should work in almost "
"all cases."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:501
#, no-c-format
msgid "<guimenu>View</guimenu> <guisubmenu>Zoom</guisubmenu>"
msgstr ""

#. Tag: action
#: menus.docbook:505
#, no-c-format
msgid "Allows to zoom message in the Message Pane."
msgstr ""

#. Tag: title
#: menus.docbook:513
#, no-c-format
msgid "Go Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:517
#, no-c-format
msgid ""
"<shortcut> <keycap>J</keycap> </shortcut> <guimenu>Go</guimenu> "
"<guimenuitem>Jump to Folder...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:524
#, no-c-format
msgid ""
"<action>Show a dialog box with a list of all your folders.</action> Click on "
"the folder you wish to view and it will display it in the message view pane."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:528
#, no-c-format
msgid ""
"<shortcut> <keycap>N</keycap> </shortcut> <guimenu>Go</guimenu> "
"<guimenuitem>Next Message</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:535
#, no-c-format
msgid ""
"<action>Selects the next message in the message list.</action> The keyboard "
"shortcut <keycap>Right Arrow</keycap> also performs this action."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:539
#, no-c-format
msgid ""
"<shortcut> <keycap>+</keycap> </shortcut> <guimenu>Go</guimenu> "
"<guimenuitem>Next Unread Message</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:546
#, no-c-format
msgid ""
"<action>Selects the next unread message in the message list.</action> If "
"there are not any unread messages below the currently selected message, then "
"the behavior depends on the value of the <xref linkend=\"configure-misc-"
"folders-go-unread\"/> option."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:550
#, no-c-format
msgid ""
"<shortcut> <keycap>P</keycap> </shortcut> <guimenu>Go</guimenu> "
"<guimenuitem>Previous Message</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:557
#, no-c-format
msgid "Selects the previous message in the message list."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:560
#, no-c-format
msgid ""
"<shortcut> <keycap>-</keycap> </shortcut> <guimenu>Go</guimenu> "
"<guimenuitem>Previous Unread Message</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:567
#, no-c-format
msgid ""
"<action>Selects the previous unread message in the message list.</action> If "
"there is not an unread message above the currently selected message, then "
"the behavior depends on the value of the <xref linkend=\"configure-misc-"
"folders-go-unread\"/> option."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:572
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Alt;<keycap>+</keycap></keycombo> </"
"shortcut> <guimenu>Go</guimenu> <guimenuitem>Next Unread Folder</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:579
#, no-c-format
msgid "Jumps to the next folder with unread messages."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:582
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Alt;<keycap>-</keycap></keycombo> </"
"shortcut> <guimenu>Go</guimenu> <guimenuitem>Previous Unread Folder</"
"guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:589
#, no-c-format
msgid "Jumps to the previous folder with unread messages."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:592
#, no-c-format
msgid ""
"<shortcut> <keycap>Space</keycap> </shortcut> <guimenu>Go</guimenu> "
"<guimenuitem>Next Unread Text</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:599
#, no-c-format
msgid ""
"Scrolls down if you are not yet at the bottom of a message, otherwise jumps "
"to the next unread message."
msgstr ""

#. Tag: title
#: menus.docbook:606
#, no-c-format
msgid "Folder Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:609
#, no-c-format
msgid "<guimenu>Folder</guimenu> <guimenuitem>Add Folder...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:613
#, no-c-format
msgid ""
"<action>Opens the <link linkend=\"folders-properties-window\">Folder "
"Properties</link> dialog</action> that lets you create a new folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:616
#, no-c-format
msgid ""
"<guimenu>Folder</guimenu> <guimenuitem>Mark All Messages as Read</"
"guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:620
#, no-c-format
msgid ""
"Sets the status of all new and unread messages in the current folder to read."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:623
#, no-c-format
msgid ""
"<shortcut> <keycap>F5</keycap> </shortcut> <guimenu>Folder</guimenu> "
"<guimenuitem>Update Folder</guimenuitem>"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:634
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>F5</keycap></keycombo> </"
"shortcut> <guimenu>Folder</guimenu> <guimenuitem>Update Folder and All Its "
"Subfolders</guimenuitem>"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:645
#, no-c-format
msgid "<guimenu>Folder</guimenu> <guimenuitem>Move All to Trash</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:649
#, no-c-format
msgid "Moves all of the messages in the selected folder into the trash folder."
msgstr ""

#. Tag: para
#: menus.docbook:650
#, no-c-format
msgid ""
"This is only available if the currently selected folder is not a trash "
"folder. If the currently selected folder is a trash folder, you will see "
"<guilabel>Empty Trash</guilabel>. Please see next section for details."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:654
#, no-c-format
msgid "<guimenu>Folder</guimenu> <guimenuitem>Empty Trash</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:658
#, no-c-format
msgid "Permanently deletes all messages."
msgstr ""

#. Tag: para
#: menus.docbook:659
#, no-c-format
msgid ""
"This is only available if the currently selected folder is a trash folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:662
#, no-c-format
msgid "<guimenu>Folder</guimenu> <guimenuitem>Archive Folder...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:666
#, no-c-format
msgid ""
"<action>Brings up a dialog to allow you to create an archive of the "
"currently selected folder.</action> In the dialog select a format (choices "
"are: zip, tar, tar.bz2, and tar.gz). If you would like to change the default "
"name or location, click the folder at the end of <guilabel>Archive File</"
"guilabel>. Check the <guilabel>Delete folder and subfolders after "
"completion</guilabel> if you would like everything you archived deleted. By "
"default all subfolders will be archived, uncheck <guilabel>Archive all "
"subfolders</guilabel> if you only want to archive the parent folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:673
#, no-c-format
msgid "<guimenu>Folder</guimenu> <guimenuitem>Delete Folder</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:677
#, no-c-format
msgid "Removes the selected folder and all its contents, including subfolders."
msgstr ""

#. Tag: para
#: menus.docbook:678
#, no-c-format
msgid ""
"Please note that there is no way to access the contents of a folder after it "
"has been removed."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:681
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>*</keycap></keycombo> </"
"shortcut> <guimenu>Folder</guimenu> <guimenuitem>Remove Duplicate Messages</"
"guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:688
#, no-c-format
msgid "Searches the folder for duplicate messages and deletes them."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:691
#, no-c-format
msgid ""
"<guimenu>Folder</guimenu> <guimenuitem>Apply All Filters On Folder</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:695
#, no-c-format
msgid ""
"<action>Applies all configured filters on the currently selected folder.</"
"action> Please see <link linkend=\"filter-dialog-id\">Filter dialog</link> "
"for more information on filters."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:699
#, no-c-format
msgid ""
"<guimenu>Folder</guimenu> <guimenuitem>Prefer HTML to Plain Text</"
"guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:703
#, no-c-format
msgid ""
"If enabled then &html; messages in this folder will be shown using &html; "
"rendering."
msgstr ""

#. Tag: para
#: menus.docbook:704 menus.docbook:712
#, no-c-format
msgid ""
"For security reasons, we recommend to only activate this for folders which "
"only contain trusted messages."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:707
#, no-c-format
msgid ""
"<guimenu>Folder</guimenu> <guimenuitem>Load External References</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:711
#, no-c-format
msgid ""
"If you have &html; messages enabled (see above), then you have the option to "
"enable this to have <action>images and resources linked from the web will "
"load automatically.</action>"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:715
#, no-c-format
msgid ""
"<guimenu>Folder</guimenu> <guimenuitem>Mailing List Management...</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:719
#, no-c-format
msgid ""
"<action>This opens up the mailing list management dialog.</action> Please "
"see <link linkend=\"folders-properties-mailinglist\">Mailing List dialog</"
"link> for more information on mailing lists."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:723
#, no-c-format
msgid "<guimenu>Folder</guimenu> <guimenuitem>Assign Shortcut...</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:727
#, no-c-format
msgid ""
"This allows you to assign a keyboard shortcut to the currently selected "
"folder."
msgstr ""

#. Tag: title
#: menus.docbook:734 menus.docbook:1270
#, no-c-format
msgid "Message Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:738
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo> </"
"shortcut> <guimenu>Message</guimenu> <guimenuitem>New Message...</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:745
#, no-c-format
msgid ""
"<action>Opens the <link linkend=\"the-composer-window\">composer window</"
"link></action> so you can write a new message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:749
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>N</keycap></"
"keycombo> </shortcut> <guimenu>Message</guimenu> <guimenuitem>New Message to "
"Mailing-List...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:756
#, no-c-format
msgid ""
"<action>Opens the composer window so you can write a new mail.</action> If "
"the current folder holds a mailing list and has a posting address defined, "
"this address will be the default <guilabel>To:</guilabel> address."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:761
#, no-c-format
msgid ""
"<shortcut> <keycap>R</keycap></shortcut> <guimenu>Message</guimenu> "
"<guimenuitem>Reply...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:767
#, no-c-format
msgid ""
"<action>Opens up the composer window, inserts the quoted text of the "
"currently selected message and presets the <guilabel>To:</guilabel> field "
"either with the mailing-list address (if you reply to a mailing-list "
"message) or with the preferred reply address of the sender.</action> If you "
"want to control which address the <guilabel>To:</guilabel> field is preset "
"with then you should use <link linkend=\"message-reply-special\">Reply "
"Special</link>. Your identity will automatically be set to the identity this "
"message was originally sent to."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:773
#, no-c-format
msgid ""
"<shortcut> <keycap>A</keycap> </shortcut> <guimenu>Message</guimenu> "
"<guimenuitem>Reply to All...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:780
#, no-c-format
msgid ""
"<action>Opens up the composer window, inserts the quoted text of the "
"currently selected message and presets the <guilabel>To:</guilabel> field "
"either with the mailing-list address (if you reply to a mailing-list "
"message) or with the preferred reply address of the sender. The "
"<guilabel>Copy to (CC):</guilabel> field is preset with the addresses of all "
"other recipients of the currently selected message excluding your own "
"address.</action> Your identity will automatically be set to the identity "
"this message was originally sent to."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:789
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Shift;<keycap>A</keycap></keycombo> </"
"shortcut><guimenu>Message</guimenu> <guisubmenu>Reply Special</guisubmenu> "
"<guimenuitem>Reply to Author...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:796
#, no-c-format
msgid ""
"<action>Opens up the composer window, inserts the quoted text of the "
"currently selected message and presets the <guilabel>To:</guilabel> field "
"with the preferred reply address of the sender.</action> Your identity will "
"automatically be set to the identity this message was originally sent to."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:801
#, no-c-format
msgid ""
"<shortcut> <keycap>L</keycap> </shortcut> <guimenu>Message</guimenu> "
"<guisubmenu>Reply Special</guisubmenu> <guimenuitem>Reply to Mailing-List..."
"</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:809
#, no-c-format
msgid ""
"<action>Opens up the composer window, inserts the quoted text of the "
"currently selected message and presets the <guilabel>To:</guilabel> field "
"with the mailing-list address.</action> If you did not specify a mailing-"
"list address for the currently selected folder and &kmail; cannot determine "
"the posting address from the currently selected message then the "
"<guilabel>To:</guilabel> field will be empty. Your identity will "
"automatically be set to the identity this message was originally sent to."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:815
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Shift;<keycap>R</keycap></keycombo> </"
"shortcut> <guimenu>Message</guimenu> <guisubmenu>Reply Special</guisubmenu> "
"<guimenuitem>Reply Without Quote...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:823
#, no-c-format
msgid ""
"Works just like <guimenuitem>Reply...</guimenuitem> except that the text of "
"the currently selected message is not quoted."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:826
#, no-c-format
msgid ""
"<guimenu>Message</guimenu> <guisubmenu>Reply Special</guisubmenu> "
"<guimenuitem>Reply With Custom Template</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:831
#, no-c-format
msgid ""
"Works just like <guimenuitem>Reply...</guimenuitem> with the option to "
"select a custom template that has been configured in <link linkend="
"\"configure-composer-custom-templates\">Custom Templates</link>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:834
#, no-c-format
msgid ""
"<guimenu>Message</guimenu> <guisubmenu>Reply Special</guisubmenu> "
"<guimenuitem>Reply to All With Custom Template</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:839
#, no-c-format
msgid ""
"Works just like <guimenuitem>Reply to All...</guimenuitem> with the option "
"to select a custom template that has been configured in <link linkend="
"\"configure-composer-custom-templates\">Custom Templates</link>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:843
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Shift;<keycap>F</keycap></keycombo> </"
"shortcut> <guimenu>Message</guimenu> <guisubmenu>Forward</guisubmenu> "
"<guimenuitem>As Attachment</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:851
#, no-c-format
msgid ""
"<action>Forwards the message to a new recipient.</action> The message and "
"its attachments will become an attachment of the new message. The original "
"message headers will be included in the forwarded message as well."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:855
#, no-c-format
msgid ""
"<shortcut> <keycap>F</keycap></shortcut> <guimenu>Message</guimenu> "
"<guisubmenu>Forward</guisubmenu> <guimenuitem>Inline</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:862
#, no-c-format
msgid ""
"<action>The message's text and some important header fields will be copied "
"to the body of the new message with text marking the forwarded part.</"
"action> Attachments will be forwarded as attachments of the new message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:866
#, no-c-format
msgid ""
"<shortcut> <keycap>E</keycap> </shortcut> <guimenu>Message</guimenu> "
"<guisubmenu>Forward</guisubmenu> <guimenuitem>Redirect</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:874
#, no-c-format
msgid ""
"This works like forward, except that the message stays the same (even the "
"<guilabel>From:</guilabel> field). The user who redirected the message is "
"added in special header fields (<literal>Redirect-From</literal>, "
"<literal>Redirect-Date</literal>, <literal>Redirect-To</literal>, &etc;)."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:878
#, no-c-format
msgid ""
"<guimenu>Message</guimenu> <guisubmenu>Forward</guisubmenu> "
"<guimenuitem>With Custom Template</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:883
#, no-c-format
msgid ""
"Works just like forward with the option to select a custom template that has "
"been configured in the composer custom templates tab in <link linkend="
"\"configure-composer-custom-templates\">Custom Templates</link>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:886
#, no-c-format
msgid "<guimenu>Message</guimenu> <guimenuitem>Send Again...</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:890
#, no-c-format
msgid ""
"Opens a composer window with the currently selected message so it can be "
"sent again."
msgstr ""

#. Tag: para
#: menus.docbook:891
#, no-c-format
msgid ""
"This is only available for messages which you have sent or, more precisely, "
"for messages which have the <guilabel>sent</guilabel> status."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:894
#, no-c-format
msgid ""
"<shortcut> <keycap>T</keycap> </shortcut> <guimenu>Message</guimenu> "
"<guimenuitem>Edit Message</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:901
#, no-c-format
msgid "Edits the selected message if it is editable."
msgstr ""

#. Tag: para
#: menus.docbook:902
#, no-c-format
msgid ""
