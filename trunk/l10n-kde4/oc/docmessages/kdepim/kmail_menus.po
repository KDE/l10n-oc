msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>Z</keycap></"
"keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Redo</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1700
#, no-c-format
msgid "Redo your steps in editing the current message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1706
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>X</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Cut</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1713
#, no-c-format
msgid ""
"Cutting text works as with most editors: the selected text is removed and "
"put into the clipboard. Note that you can also select text and drag it to a "
"new position."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1721
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Copy</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1729
#, no-c-format
msgid ""
"Copying text works as with most editors: the selected text is copied to the "
"clipboard. Note that you can also select text while holding the &Ctrl; key, "
"and drag it to a new position to copy it."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1737
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>V</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Paste</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1744
#, no-c-format
msgid ""
"Pasting works the same as with most editors: the text from the clipboard is "
"pasted at the current cursor position."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1751
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>A</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Select All</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1758
#, no-c-format
msgid "Selects all of the text in your message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1764
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>F</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1771
#, no-c-format
msgid "Opens a dialog to search for strings in the current message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1777
#, no-c-format
msgid ""
"<shortcut><keycap>F3</keycap></shortcut> <guimenu>Edit</guimenu> "
"<guimenuitem>Find Next</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1784
#, no-c-format
msgid "Goes to the next occurrence of the previously searched string."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1790
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>R</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Replace...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1797
#, no-c-format
msgid ""
"Opens a dialog that lets you replace strings in your message with other "
"strings."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1803
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Clean Spaces</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1809
#, no-c-format
msgid ""
"This replaces multiple line breaks or spaces with single line breaks or "
"spaces. It works on the current selection or on the complete message if "
"there is no selection."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1816
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Add Quote Characters</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1822
#, no-c-format
msgid "Prepends the selected text with quotation marks."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1828
#, no-c-format
msgid ""
"<guimenu>Edit</guimenu> <guimenuitem>Remove Quote Characters</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1834
#, no-c-format
msgid "Removes the left-most quotation marks from the selected text."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1840
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Uppercase</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1846
#, no-c-format
msgid "Uppercase selected text."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1852
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Lowercase</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1858
#, no-c-format
msgid "Lowercase selected text."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1864
#, no-c-format
msgid ""
"<guimenu>Edit</guimenu> <guimenuitem>Insert Special Characters</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1870
#, no-c-format
msgid "It allows to insert special character in composer."
msgstr ""

#. Tag: para
#: menus.docbook:1883
#, no-c-format
msgid ""
"This menu lets you toggle the display of the header fields and other options "
"in this composer window."
msgstr ""

#. Tag: para
#: menus.docbook:1886
#, no-c-format
msgid "Options available are:"
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1890
#, no-c-format
msgid "All Fields"
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1893
#, no-c-format
msgid "Identity"
msgstr "Identitat"

#. Tag: guimenuitem
#: menus.docbook:1896
#, no-c-format
msgid "Dictionary"
msgstr "Diccionari"

#. Tag: guimenuitem
#: menus.docbook:1899
#, no-c-format
msgid "Sent-Mail folder"
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1902
#, no-c-format
msgid "Mail Transport"
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1905
#, no-c-format
msgid "From"
msgstr "De"

#. Tag: guimenuitem
#: menus.docbook:1908
#, no-c-format
msgid "Reply To"
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1911
#, no-c-format
msgid "Subject"
msgstr "Subjècte"

#. Tag: para
#: menus.docbook:1915
#, no-c-format
msgid ""
"Currently visible items have a checkmark shown next to their name in the "
"menu."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1921
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Use Fixed Font</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1927
#, no-c-format
msgid ""
"Uses a fixed width (monospaced) font to display the currently edited "
"message. The font to be used can be configured in the <guilabel>Appearance</"
"guilabel> section of &kmail;'s configuration dialog."
msgstr ""

#. Tag: title
#: menus.docbook:1942
#, no-c-format
msgid "<guimenu>Options</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1948
#, no-c-format
msgid "<guimenu>Options</guimenu> <guimenuitem>Urgent</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1954
#, no-c-format
msgid ""
"Sets the priority of the message to Urgent. The receiver's email client has "
"to support this or it will have no effect. &kmail; itself does not support "
"priorities for incoming messages."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1962
#, no-c-format
msgid ""
"<guimenu>Options</guimenu> <guimenuitem>Request Disposition Notification</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1968
#, no-c-format
msgid ""
"If you choose this option, you request a confirmation email once your "
"message is downloaded and read by its recipient. This has to be supported "
"and enabled by the receiver's email client in order to work."
msgstr ""

#. Tag: para
#: menus.docbook:1974
#, no-c-format
msgid ""
"See <xref linkend=\"configure-security-reading-mdns\"/> for background "
"information and ways to customize the read receipts that &kmail; itself "
"sends."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1984
#, no-c-format
msgid "<guimenu>Options</guimenu> <guisubmenu>Sign Message</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1990
#, no-c-format
msgid ""
"Digitally sign the message using <application>OpenPGP</application>. You can "
"learn more about this in the <link linkend=\"pgp\">chapter on OpenPGP</link>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1997
#, no-c-format
msgid "<guimenu>Options</guimenu> <guisubmenu>Encrypt Message</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:2003
#, no-c-format
msgid ""
"Encrypt the message using <application>OpenPGP</application>. You can learn "
"more about this in the <link linkend=\"pgp\">chapter on OpenPGP</link>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2010
#, no-c-format
msgid ""
"<guimenu>Options</guimenu> <guisubmenu>Cryptographic Message Format</"
"guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:2016
#, no-c-format
msgid ""
"Choose the cryptographic message format to use to digitally sign and/or "
"encrypt the message in. See <link linkend=\"cryptographic-message-formats"
"\">the previous description of each option</link> for more information."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2027
#, no-c-format
msgid "<guimenu>Options</guimenu> <guisubmenu>Formatting (HTML)</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:2033
#, no-c-format
msgid "Enables &html; editing."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2039
#, no-c-format
msgid "<guimenu>Options</guimenu> <guisubmenu>Encoding</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:2045
#, no-c-format
msgid ""
"Set the charset encoding of this message. The chosen encoding will appear in "
"the header of the outgoing mail. You can use <guilabel>Auto</guilabel> for "
"almost all cases, &kmail; will tell you if you need to select a different "
"encoding manually."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2053
#, no-c-format
msgid "<guimenu>Options</guimenu> <guimenuitem>Wordwrap</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2059
#, no-c-format
msgid ""
"Toggles the automatic wordwrap. It may be useful to turn it off if you want "
"to paste long lines that should not wrap."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2066
#, no-c-format
msgid ""
"<guimenu>Options</guimenu> <guimenuitem>Automatic Spellchecking</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2072
#, no-c-format
msgid "Toggles automatic spellchecking."
msgstr ""

#. Tag: title
#: menus.docbook:2082
#, no-c-format
msgid "<guimenu>Attach</guimenu> Menu"
msgstr ""

#. Tag: para
#: menus.docbook:2084
#, no-c-format
msgid "This menu lets you select attachment options."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2090
#, no-c-format
msgid "<guimenu>Attach</guimenu> <guimenuitem>Append Signature</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2096
#, no-c-format
msgid ""
"Appends your signature (<quote>footer</quote>) to the end of the message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2103
#, no-c-format
msgid ""
"<guimenu>Attach</guimenu> <guimenuitem>Attach Public Key...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2109
#, no-c-format
msgid ""
"Attaches the corresponding <application>GnuPG</application> key to your "
"message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2116
#, no-c-format
msgid ""
"<guimenu>Attach</guimenu> <guimenuitem>Attach My Public Key</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2122
#, no-c-format
msgid ""
"Attaches your <application>GnuPG</application> public key to your message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2129
#, no-c-format
msgid "<guimenu>Attach</guimenu> <guimenuitem>Attach File...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2135
#, no-c-format
msgid "Attaches one or more files to the current message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2142
#, no-c-format
msgid "<guimenu>Attach</guimenu> <guimenuitem>Remove Attachment</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2148
#, no-c-format
msgid ""
"Removes the attachment that is selected in the attachment part of the "
"composer."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2154
#, no-c-format
msgid ""
"<guimenu>Attach</guimenu> <guimenuitem>Save Attachment As...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2160
#, no-c-format
msgid ""
"Saves the attachment that is selected in the attachment window to a file."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2167
#, no-c-format
msgid ""
"<guimenu>Attach</guimenu> <guimenuitem>Attachment Properties</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2173
#, no-c-format
msgid ""
"Displays the <link linkend=\"attachments\">properties of the attachment</"
"link> that is selected in the attachment window."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2189
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Spelling...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2195
#, no-c-format
msgid ""
"Uses <ulink url=\"help:/sonnet/\">&sonnet;</ulink> to check the spelling in "
"the body of your message. Note that you have to configure &sonnet; with "
"<menuchoice><guimenu>Settings</guimenu> <guimenuitem>Spellchecker...</"
"guimenuitem></menuchoice> if you use it for the first time."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2205
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Addressbook...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2211
#, no-c-format
msgid "Opens up <ulink url=\"help:/kaddressbook\">&kaddressbook;</ulink>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2226
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Toolbars Shown</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2232
#, no-c-format
msgid ""
"Enables and disables the Main Toolbar, &ie; the one with the icon to send "
"the message &etc; and the &html; Toolbar, &ie; the one which with the tools "
"to change certain properties of the composed text."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2240
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Spellchecker...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2246
#, no-c-format
msgid ""
"Allows you to configure <ulink url=\"help:/sonnet/\">&sonnet;</ulink>, "
"&kde;'s spellchecker."
msgstr ""

#. Tag: para
#: menus.docbook:2271
#, no-c-format
msgid ""
"Opens a window that allows you to decide which icons appear in the toolbar."
msgstr ""

#. Tag: para
#: menus.docbook:2284
#, no-c-format
msgid ""
"Opens &kmail;'s <link linkend=\"configure\">configuration dialog</link>."
msgstr ""

#. Tag: para
#: menus.docbook:2295
#, no-c-format
msgid ""
"The entries in this menu have the same meaning as <link linkend=\"reader-"
"help-menu\">the entries in the main window's help menu</link>."
msgstr ""
