msgstr ""

#. Tag: para
#: menus.docbook:1674
#, no-c-format
msgid "Pastes the text from the clipboard marked as quotation."
msgstr ""

#. Tag: para
#: menus.docbook:1687
#, no-c-format
msgid "Undo your steps in editing the current message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1693
