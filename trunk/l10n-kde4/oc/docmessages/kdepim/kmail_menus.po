msgstr ""

#. Tag: menuchoice
#: menus.docbook:1442
#, no-c-format
msgid ""
"<guimenu>Edit</guimenu> <guimenuitem>Remove Quote Characters</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1446
#, no-c-format
msgid "Removes the left-most quotation marks from the selected text."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1449
#, no-c-format
