#: menus.docbook:1072
#, no-c-format
msgid "Symbol"
msgstr "Simbòl"

#. Tag: entry
#: menus.docbook:1073
#, no-c-format
msgid "Meaning"
msgstr "Significacion"

#. Tag: guimenuitem
#: menus.docbook:1078
#, no-c-format
msgid "Read"
msgstr "Lectura"

#. Tag: entry
#: menus.docbook:1079
#, no-c-format
msgid "Sheet of paper before an envelope"
msgstr ""

#. Tag: entry
#: menus.docbook:1080
#, no-c-format
msgid "The message has been read."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1083
#, no-c-format
msgid "<guimenuitem>New</guimenuitem>"
msgstr ""

#. Tag: entry
#: menus.docbook:1084
#, no-c-format
msgid "Closed envelope with a star"
msgstr ""

#. Tag: entry
#: menus.docbook:1085
#, no-c-format
msgid "The message is new to &kmail; and you."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1088
#, no-c-format
msgid "Unread"
msgstr "Pas legit"

#. Tag: entry
#: menus.docbook:1089
#, no-c-format
msgid "Close envelope"
msgstr ""

#. Tag: entry
#: menus.docbook:1090
#, no-c-format
msgid "The message is not new to &kmail; but has not been read yet."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1093
#, no-c-format
msgid "Important"
msgstr "Important"

#. Tag: entry
#: menus.docbook:1094
#, no-c-format
msgid "Flag"
msgstr ""

#. Tag: entry
#: menus.docbook:1095
#, no-c-format
msgid ""
"This status will not automatically be set by &kmail;. You can use it freely "
"to mark messages that are in some way important to you."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1099
#, no-c-format
msgid "Replied"
msgstr ""

#. Tag: entry
#: menus.docbook:1100
#, no-c-format
msgid "Blue u-turn arrow"
msgstr ""

#. Tag: entry
#: menus.docbook:1101
#, no-c-format
msgid "A reply to this message has been sent."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1104
#, no-c-format
msgid "Forwarded"
msgstr "Trasmes"

#. Tag: entry
#: menus.docbook:1105
#, no-c-format
msgid "Blue arrow"
msgstr ""

#. Tag: entry
#: menus.docbook:1106
#, no-c-format
msgid "The message has been forwarded to someone else."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1109
#, no-c-format
msgid "Queued"
msgstr ""

#. Tag: entry
#: menus.docbook:1110
#, no-c-format
msgid "Envelope"
msgstr "Envolopa"

#. Tag: entry
#: menus.docbook:1111
#, no-c-format
msgid "The message has been queued in the outbox to be sent later."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1114
#, no-c-format
msgid "Sent"
msgstr "Enviat"

#. Tag: entry
#: menus.docbook:1115
#, no-c-format
msgid "Angled envelope"
msgstr ""

#. Tag: entry
#: menus.docbook:1116
#, no-c-format
msgid "The message has been sent."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1119
#, no-c-format
msgid "Spam"
msgstr ""

#. Tag: entry
#: menus.docbook:1120
#, no-c-format
msgid "Round recycle symbol"
msgstr ""

#. Tag: entry
#: menus.docbook:1121
#, no-c-format
msgid ""
"This status will not be set automatically by &kmail;. You can use it to mark "
"spam messages."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1125
#, no-c-format
msgid "<guimenuitem>Ham</guimenuitem>"
msgstr ""

#. Tag: entry
#: menus.docbook:1126
#, no-c-format
msgid "Green check mark"
msgstr ""

#. Tag: entry
#: menus.docbook:1127
#, no-c-format
msgid ""
"This status will not be set automatically by &kmail;. You can use it to mark "
"messages which are not spam."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1139
#, no-c-format
msgid "<guimenu>Message</guimenu> <guisubmenu>Mark Thread</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1145
#, no-c-format
msgid ""
"Allows you to change the status of all messages in a thread. The possible "
"states are the same as for <menuchoice><guimenu>Message</guimenu> "
"<guimenuitem>Mark Message</guimenuitem></menuchoice>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1179
#, no-c-format
msgid "<guimenu>Message</guimenu> <guisubmenu>Create Filter</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1185
#, no-c-format
msgid ""
"Opens up the <link linkend=\"filter-dialog-id\">Filter dialog</link> with a "
"new filter added. This new filter is based on fields of the current mail, "
"depending on which sub menu item you select."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1193
#, no-c-format
msgid "<guimenu>Message</guimenu> <guimenuitem>Apply Filter</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1199
#, no-c-format
msgid ""
"Allows you to apply an individual filter or all filters to the selected "
"messages. Only filters for which you enabled the <guilabel>Add this filter "
"to the Apply Filter menu</guilabel> option will be available."
msgstr ""

#. Tag: title
#: menus.docbook:1215 menus.docbook:2145
#, no-c-format
msgid "<guimenu>Tools</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1221
#, no-c-format
msgid ""
"<shortcut><keycap>S</keycap></shortcut> <guimenu>Tools</guimenu> "
"<guimenuitem>Find Messages...</guimenuitem>"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1238
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Address Book</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1244
#, no-c-format
msgid ""
"Starts up &kaddressbook;, the &kde; address book. If this menu item is "
"disabled and greyed out either &kaddressbook; is not installed or the "
"program was not found."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1252
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Certificate Manager...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1258
#, no-c-format
msgid ""
"Starts <ulink url=\"help:kleopatra\">&kleopatra;</ulink>, the &kde; "
"certificate manager."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1268
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>GnuPG Log Viewer</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1274
#, no-c-format
msgid ""
"Starts <ulink url=\"help:kwatchgnupg\"><application>KWatchGnuPG</"
"application></ulink>, a tool to present the debug output of "
"<application>GnuPG</application> application. If signing, encryption, or "
"verification mysteriously stop working, you might find out why by looking at "
"the log."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1287
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guisubmenu>Edit \"Out of Office\" Replies...</"
"guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1293
#, no-c-format
msgid ""
"Launch the <guilabel>Configure \"Out of Office\" Replies</guilabel> dialog, "
"which allow you to set-up vacation notifications."
msgstr ""

#. Tag: para
#: menus.docbook:1295
#, no-c-format
msgid ""
"<guilabel>Out of Office reply</guilabel> functionality relies on server-side "
"filtering. To be able to use it you need to configure the <link linkend="
"\"receiving-mail\">Filtering tab</link> (see option relevant to kolab "
"server) of your <guilabel>IMAP</guilabel> account set-up."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1303
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guisubmenu>Filter Log Viewer...</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1309
#, no-c-format
msgid ""
"Opens up the viewer window for the filter log; there you find some options "
"to control the logging of the filtering process. In the log you will find "
"valuable information about what filter rules were used, what was the result "
"of the evaluation of those rules, and which filter actions were applied to a "
"message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1318
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Anti-Spam Wizard...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1324
#, no-c-format
msgid ""
"It starts a <link linkend=\"the-anti-spam-wizard\">wizard</link> which can "
"help you to set up spam filtering."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1331
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Anti-Virus Wizard...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1337
#, no-c-format
msgid ""
"It starts a <link linkend=\"the-anti-virus-wizard\">wizard</link> which can "
"help you to set up scanning messages for viruses."
msgstr ""

#. Tag: title
#: menus.docbook:1348 menus.docbook:2182
#, no-c-format
msgid "<guimenu>Settings</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1354
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Toolbar</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1360
#, no-c-format
msgid ""
"If enabled, the Toolbar is visible (the Toolbar is the one with the icon to "
"compose a new message &etc;)."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1367
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>H</keycap></keycombo></"
"shortcut> <guimenu>Settings</guimenu> <guimenuitem>Show Quick Search bar</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1374
#, no-c-format
msgid ""
"If enabled, the Quick Search bar which allows you to quickly search for "
"messages matching a search text is visible."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1381
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Filters...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1387
#, no-c-format
msgid "Opens the <link linkend=\"filters\">Message Filters</link> window."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1395 menus.docbook:2214
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1401 menus.docbook:2220
#, no-c-format
msgid ""
"Opens a window that lets you configure the keyboard shortcuts for many menu "
"commands."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1408
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Notifications...</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1414
#, no-c-format
msgid ""
"Opens a window that lets you configure what happens when new mail arrives, "
"like playing a sound."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1421 menus.docbook:2227
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Toolbars...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1427
#, no-c-format
msgid ""
"Opens a window that lets you choose which icons are visible in the toolbar."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1434 menus.docbook:2240
#, no-c-format
msgid ""
