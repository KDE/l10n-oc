#. Tag: title
#: menus.docbook:47
#, no-c-format
msgid "Menu Entries"
msgstr ""

#. Tag: para
#: menus.docbook:48
#, no-c-format
msgid ""
"&kmail; has common &kde; <guimenu>Edit</guimenu>, <guimenu>Settings</"
"guimenu>, and <guimenu>Help</guimenu> menu items, for more information read "
"the sections about the <ulink url=\"help:/fundamentals/ui.html#menus-edit"
"\">Edit Menu</ulink>, <ulink url=\"help:/fundamentals/ui.html#menus-settings"
"\">Settings Menu</ulink>, and <ulink url=\"help:/fundamentals/ui.html#menus-"
"help\">Help Menu</ulink> of the &kde; Fundamentals."
msgstr ""

#. Tag: para
#: menus.docbook:54
#, no-c-format
msgid ""
"Each &kmail; specific menu item is discussed below. When there is a keyboard "
"shortcut that performs a menu item function, the default shortcut is listed "
"with the menu item."
msgstr ""

#. Tag: title
#: menus.docbook:58
#, no-c-format
msgid "The Main Window"
msgstr ""

#. Tag: title
#: menus.docbook:61
#, no-c-format
msgid "File Menu"
msgstr ""

#. Tag: guimenu
#: menus.docbook:63
#, no-c-format
msgid "File"
msgstr ""

#. Tag: para
#: menus.docbook:65
#, no-c-format
msgid "The main file menu to work with the current message/folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:68
#, no-c-format
msgid "<guimenu>File</guimenu><guisubmenu>New</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:70
#, no-c-format
msgid "Here you can create several new items as follows:"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:73
#, no-c-format
msgid ""
"<guimenu>File</guimenu><guisubmenu>New</guisubmenu><guimenuitem>New "
"Message...</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:75
#, no-c-format
msgid "Compose a new message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:78
#, no-c-format
msgid ""
"<guimenu>File</guimenu><guisubmenu>New</guisubmenu><guisubmenu>Message from "
"Template</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:80
#, no-c-format
msgid ""
"If you have any saved templates, they will be listed on the submenu, select "
"the one you wish to use. To save messages to a template, select "
"<menuchoice><shortcut><keycap>T</keycap></shortcut><guimenu>Message</"
"guimenu><guimenuitem>Edit Message</guimenuitem></menuchoice>, and in the "
"message edit window, select <menuchoice><guimenu>Message</"
"guimenu><guimenuitem>Save as Template</guimenuitem></menuchoice>"
msgstr ""

#. Tag: para
#: menus.docbook:83
#, no-c-format
msgid ""
"If you do not have any templates saved, you will see "
"<menuchoice><guimenu>Message</guimenu><guisubmenu>Message from Template</"
"guisubmenu><guimenuitem>(no templates)</guimenuitem></menuchoice>"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:86
#, no-c-format
msgid ""
"<guimenu>File</guimenu><guisubmenu>New</guisubmenu><guimenuitem>Add Folder..."
"</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:88
#, no-c-format
msgid "Create a new folder"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:91
#, no-c-format
msgid ""
"<guimenu>File</guimenu><guisubmenu>New</guisubmenu><guimenuitem>New "
"AddressBook Contact...</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:93
#, no-c-format
msgid "Brings up the new contact dialog"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:96
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>O</keycap></keycombo></"
"shortcut> <guimenu>File</guimenu><guimenuitem>Open...</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:98
#, no-c-format
msgid "Open email messages or mailboxes."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:100
#, no-c-format
msgid "<guimenu>File</guimenu><guimenuitem>Open Recent</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:102
#, no-c-format
msgid ""
"<action>Opens recently used messages.</action> Only messages that have been "
"saved and then opened will show up on this list."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:105
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo></"
"shortcut> <guimenu>File</guimenu><guimenuitem>Save As...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:108
#, no-c-format
msgid ""
"<action>Saves the currently displayed message to a .mbox file.</action> This "
"includes all the headers and attachments."
msgstr ""

#. Tag: para
#: menus.docbook:109
#, no-c-format
msgid ""
"If you would like to save it to a different format &eg; text, deselect "
"<guilabel>Automatically select filename extension (.mbox)</guilabel> and be "
"sure to change the file extension."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:113
#, no-c-format
msgid "<guimenu>File</guimenu><guimenuitem>Import Messages...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:114
#, no-c-format
msgid ""
"<action>Starts up <application>kmailcvt</application></action>. This "
"application lets you import messages from several email clients into &kmail;."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:118
#, no-c-format
msgid "<guimenu>File</guimenu><guimenuitem>Print Preview...</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:120
#, no-c-format
msgid ""
"Display a dialog which shows how your email will be printed. Note: This will "
"only be available if a printer is available."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:123
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo></"
"shortcut> <guimenu>File</guimenu><guimenuitem>Print...</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:126
#, no-c-format
msgid "Display a dialog that lets you print the currently displayed message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:129
#, no-c-format
msgid "<guimenu>File</guimenu><guimenuitem>Expire All Folders</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:131
#, no-c-format
msgid ""
"Delete old messages from all folders, according to the rules in each "
"folder's <link linkend=\"folders-properties-window\">Properties dialog</"
"link> (the default is not to delete old messages at all)."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:135
#, no-c-format
msgid ""
"<guimenu>File</guimenu><guimenuitem>Empty All Trash Folders</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:137
#, no-c-format
msgid ""
"Use this to empty all trash folders, &ie; the local trash folder and all "
"trash folders that you might have on &imap; servers."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:141
#, no-c-format
msgid "<guimenu>File</guimenu><guimenuitem>Work Offline</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:143
#, no-c-format
msgid ""
"<action>Sets &kmail; to offline mode.</action> This turns off all network "
"jobs. This is useful when working with messages without a network "
"connection. This selection will become <menuchoice><guimenu>File</"
"guimenu><guimenuitem>Work Online</guimenuitem></menuchoice>, which needs to "
"be selected to go back online (required to send and receive)."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:148
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>L</keycap></keycombo></"
"shortcut> <guimenu>File</guimenu><guimenuitem>Check Mail</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:151
#, no-c-format
msgid "Checks for new messages in all your accounts."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:154
#, no-c-format
msgid "<guimenu>File</guimenu><guisubmenu>Check Mail In</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:156
#, no-c-format
msgid "Submenu that lets you check for new messages from a particular account."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:159
#, no-c-format
msgid ""
"<shortcut><keycap>F5</keycap></shortcut> <guimenu>File</"
"guimenu><guimenuitem>Update Folder</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:162 menus.docbook:506 menus.docbook:513
#, no-c-format
msgid ""
"Checks whether new mail arrived in the currently selected folder. This is "
"only available for &imap; folders."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:165
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>F5</keycap></keycombo></"
"shortcut> <guimenu>File</guimenu><guimenuitem>Update This Folder and All Its "
"Subfolders</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:168
#, no-c-format
msgid ""
"Checks whether new mail arrived in the currently selected folder and all of "
"its subfolders. This is only available for &imap; folders. You can also "
"select multiple folders and the menu item will turn into "
"<menuchoice><guimenu>File</guimenu><guimenuitem>Update These Folders and All "
"Their Subfolders</guimenuitem></menuchoice>"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:172
#, no-c-format
msgid "<guimenu>File</guimenu><guimenuitem>Send Queued Messages</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:174
#, no-c-format
msgid ""
"<action>Sends the messages that are in your outbox.</action> Messages can "
"end up in your outbox by selecting Queue in the composer menu, Composing a "
"message in offline mode, and sending while you have no Internet connection."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:178
#, no-c-format
msgid ""
"<guimenu>File</guimenu><guimenuitem>Send Queued Messages via</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:180
#, no-c-format
msgid ""
"<action>Sends the messages that are in your outbox via a specific outgoing "
"account.</action> This allows you to choose which server to send your queued "
"messages from. They must be configured in <menuchoice><guimenu>Settings</"
"guimenu> <guimenuitem>Configure &kmail;...</guimenuitem></menuchoice> in the "
"<menuchoice><guiicon>Accounts</guiicon><guilabel>Sending</guilabel></"
"menuchoice> tab to show up here."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:192
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo></"
"shortcut> <guimenu>File</guimenu><guimenuitem>Quit</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:195
#, no-c-format
msgid "Exits &kmail;"
msgstr ""

#. Tag: title
#: menus.docbook:204
#, no-c-format
msgid "Edit Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:207
#, no-c-format
msgid ""
"<shortcut><keycap>Del</keycap></shortcut><guimenu>Edit</"
"guimenu><guimenuitem>Move to Trash</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:209
#, no-c-format
msgid ""
"Moves the selected messages to the trash folder. If the selected messages "
"are already in the trash folder, they will be permanently deleted."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:213
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Del</keycap></keycombo></"
"shortcut><guimenu>Edit</guimenu><guimenuitem>Move Thread to Trash</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:215
#, no-c-format
msgid ""
"Moves the selected thread to the trash folder, &eg; a conversation in a "
"mailing list."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:218
#, no-c-format
msgid ""
"<shortcut><keycap>S</keycap></shortcut><guimenu>Edit</"
"guimenu><guimenuitem>Find Messages...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:220
#, no-c-format
msgid ""
"Opens up a search window that lets you search for messages with certain "
"characteristics, &eg; a certain subject. Start the search by entering some "
"values and press <guibutton>Search</guibutton>."
msgstr ""

#. Tag: para
#: menus.docbook:223
#, no-c-format
msgid ""
"Your search results will display in the text area, at which point you can "
"open the <guibutton>Open Search Folder</guibutton> or highlight the desired "
"message and select <guibutton>Open Message</guibutton>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:227
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>F</keycap></keycombo></"
"shortcut><guimenu>Edit</guimenu><guimenuitem>Find in Message...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:229
#, no-c-format
msgid "Lets you search for a string in the currently displayed message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:232
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>A</keycap></keycombo></"
"shortcut><guimenu>Edit</guimenu><guimenuitem>Select All Messages</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:234
#, no-c-format
msgid "Selects all messages in the current folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:238
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>T</keycap></keycombo></"
"shortcut><guimenu>Edit</guimenu><guimenuitem>Select All Text</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:240
#, no-c-format
msgid "Selects the text of the currently displayed message."
msgstr ""

#. Tag: title
#: menus.docbook:248
#, no-c-format
msgid "View Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:251
#, no-c-format
msgid "<guimenu>View</guimenu><guisubmenu>Message List</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:253
#, no-c-format
msgid ""
"This menu has the following options to change the view of your message list."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:255
#, no-c-format
msgid "<guimenu>Message List</guimenu><guisubmenu>Sorting</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:257
#, no-c-format
msgid "Contains options to customize your sort order as follows:"
msgstr ""

#. Tag: para
#: menus.docbook:260
#, no-c-format
msgid ""
"<guilabel>Message Sort Order</guilabel> has several options, most are self "
"explanatory. The following options may not be immediately obvious, therefore "
"deserve an explanation."
msgstr ""

#. Tag: para
#: menus.docbook:264
#, no-c-format
msgid ""
"<guilabel>Smart Sender/Receiver</guilabel> will display the sender when you "
"are reading in your outbox folder/template folder, and display the receiver "
"when you are in your inbox/inbox subfolders."
msgstr ""

#. Tag: para
#: menus.docbook:268
#, no-c-format
msgid ""
"<guilabel>By Action Item Status</guilabel> and <guilabel>By Important "
"Status</guilabel> need to be set before they can be sorted. Please see <link "
"linkend=\"mark-messages\">Mark Messages</link> for more information on "
"marking your messages."
msgstr ""

#. Tag: para
#: menus.docbook:274
#, no-c-format
msgid ""
"<guilabel>Message Sort Direction</guilabel> and <guilabel>Group Sort "
"Direction</guilabel> allow you to change the direction of your message/group "
"sort respectively."
msgstr ""

#. Tag: para
#: menus.docbook:278
#, no-c-format
msgid ""
"<guilabel>Folder always Uses this Sort Order</guilabel> allows you to keep "
"your sort settings per folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:283
#, no-c-format
msgid "<guimenu>Message List</guimenu><guisubmenu>Aggregation</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:285
#, no-c-format
msgid "Allows you to set your aggregation view."
msgstr ""

#. Tag: para
#: menus.docbook:286
#, no-c-format
msgid ""
"<guilabel>Configure...</guilabel> Allows you to configure aggregation, "
"please see <link linkend=\"configure-appearance-message-list\">Configure "
"Appearance Message List</link> for more information on aggregation."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:289
#, no-c-format
msgid "<guimenu>Message List</guimenu><guisubmenu>Theme</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:291
#, no-c-format
msgid "Allows you to select a theme."
msgstr ""

#. Tag: para
#: menus.docbook:292
#, no-c-format
msgid ""
"<guilabel>Configure...</guilabel> Allows you to configure themes, please see "
"<link linkend=\"configure-appearance-message-list\">Configure Appearance "
"Message List</link> for more information on themes."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:295
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>T</keycap></"
"keycombo></shortcut><guimenu>Message List</guimenu><guisubmenu>Create New "
"Tab</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:297
#, no-c-format
msgid ""
"Allows you to create a tab, then select the folder you would like to display "
"in the tab."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:300
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>W</keycap></"
"keycombo></shortcut><guimenu>Message List</guimenu><guisubmenu>Close Tab</"
"guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:301
#, no-c-format
msgid "Closes the currently selected tab."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:306
#, no-c-format
msgid "<guimenu>View</guimenu><guisubmenu>Headers</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:308
#, no-c-format
msgid ""
"This allows you to select your headers view. Your choices are as follows:"
msgstr ""

#. Tag: para
#: menus.docbook:310
#, no-c-format
msgid ""
"<guilabel>Enterprise Headers</guilabel> A minimal header with title, From, "
"and To, with a graphical design."
msgstr ""

#. Tag: para
#: menus.docbook:313
#, no-c-format
msgid ""
"<guilabel>Fancy Headers</guilabel> Minimal header with a spam status "
"notification."
msgstr ""

#. Tag: para
#: menus.docbook:316
#, no-c-format
msgid ""
"<guilabel>Brief Headers</guilabel> Title, and in parentheses you will find "
"From and the date."
msgstr ""

#. Tag: para
#: menus.docbook:319
#, no-c-format
msgid "<guilabel>Standard Headers</guilabel> Title, From, and To."
msgstr ""

#. Tag: para
#: menus.docbook:322
#, no-c-format
msgid "<guilabel>Long Headers</guilabel> Title, Date, From, and To."
msgstr ""

#. Tag: para
#: menus.docbook:325
#, no-c-format
msgid ""
"<guilabel>All Headers</guilabel> List everything you ever wanted to know "
"about the email, including every server it went through, virus/spam scanners "
"it went through &etc;"
msgstr ""

#. Tag: para
#: menus.docbook:328
#, no-c-format
msgid ""
"<guilabel>Custom Headers</guilabel> You must configure custom headers first "
"here: <menuchoice><guimenu>Settings</guimenu><guisubmenu>Configure &kmail;..."
"</guisubmenu></menuchoice> and select the <guiicon>Appearance</guiicon> "
"icon. From there you want the <guilabel>Message Window</guilabel> tab, and "
"you will find the settings at the bottom with the label <guilabel>Headers:</"
"guilabel>. See <link linkend=\"configure-appearance-message-window\">Message "
"Window configuration</link> for more information."
msgstr ""

#. Tag: para
#: menus.docbook:333
#, no-c-format
msgid ""
"<guilabel>Example</guilabel> An example header from the <guilabel>Download "
"New Themes</guilabel>"
msgstr ""

#. Tag: para
#: menus.docbook:336
#, no-c-format
msgid ""
"<guilabel>Example Fancy</guilabel> An example fancy header from the "
"<guilabel>Download New Themes</guilabel>"
msgstr ""

#. Tag: para
#: menus.docbook:339
#, no-c-format
msgid ""
"<guilabel>Download New Themes</guilabel> Allows you to download custom "
"themes created by other &kmail; users."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:345
#, no-c-format
msgid "<guimenu>View</guimenu><guimenuitem>Attachments</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:347
#, no-c-format
msgid ""
"Changes the way attachments appear in the <guilabel>Message Preview Pane</"
"guilabel> (independent of the &MIME; Tree) as follows:"
msgstr ""

#. Tag: para
#: menus.docbook:350
#, no-c-format
msgid ""
"<guimenuitem>As Icons</guimenuitem>, all attachments appear as icons at the "
"bottom of the message."
msgstr ""

#. Tag: para
#: menus.docbook:351
#, no-c-format
msgid ""
"<guimenuitem>Smart</guimenuitem> will show attachments as icons, unless the "
"message suggests that they should be displayed inline. You can suggest that "
"certain attachments should be shown inline in your own messages when you "
"select <guilabel>Suggest automatic display</guilabel> in the attachment's "
"properties dialog."
msgstr ""

#. Tag: para
#: menus.docbook:355
#, no-c-format
msgid ""
"<guimenuitem>Inline</guimenuitem> shows the contents of the attachments at "
"the bottom of the message. Attachments that cannot be displayed, &eg; "
"compressed files, will still be shown as an icon."
msgstr ""

#. Tag: para
#: menus.docbook:358
#, no-c-format
msgid "<guimenuitem>Hide</guimenuitem> will not show attachments."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:362
#, no-c-format
msgid ""
"<shortcut><keycap>.</keycap></shortcut><guimenu>View</guimenu> "
"<guimenuitem>Expand Thread / Group</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:365
#, no-c-format
msgid ""
"This will display the thread of the current message, &ie; all messages that "
"are replies to the current message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:369
#, no-c-format
msgid ""
"<shortcut><keycap>,</keycap></shortcut><guimenu>View</"
"guimenu><guimenuitem>Collapse Thread / Group</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:370
#, no-c-format
msgid ""
"This will hide the thread of the current message, &ie; it will hide all "
"messages that are replies to the current message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:373
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>.</keycap></keycombo></"
"shortcut><guimenu>View</guimenu> <guimenuitem>Expand All Threads</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:376
#, no-c-format
msgid "Expands all threads in the current folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:379
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>,</keycap></keycombo></"
"shortcut> <guimenu>View</guimenu><guimenuitem>Collapse All Threads</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:382
#, no-c-format
msgid "Collapses all threads in the current folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:385
#, no-c-format
msgid ""
"<shortcut><keycap>V</keycap></shortcut><guimenu>View</guimenu> "
"<guimenuitem>View Source</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:388
#, no-c-format
msgid ""
"Shows the message and its complete headers in plain text format in a new "
"window. This can be useful to find out the origin of a mail. You should know "
"that it is easy to fake the <literal>From:</literal> header of a mail, but "
"one can still find out which mail servers have been used to send the message "
"by looking at the <literal>Received:</literal> lines in the header."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:395
#, no-c-format
msgid ""
"<guimenu>View</guimenu> <guimenuitem>Show Message Structure</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:398
#, no-c-format
msgid ""
"Display the structure viewer, which is a part of the main window that lets "
"you access all parts of a message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:402
#, no-c-format
msgid ""
"<shortcut><keycap>X</keycap></shortcut><guimenu>View</guimenu> "
"<guimenuitem>Use Fixed Font</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:405
#, no-c-format
msgid ""
"Uses a fixed width (Monospace) font to display the messages in the current "
"folder. The font to be used can be configured in the <guilabel>Appearance</"
"guilabel>/<guilabel>Fonts</guilabel> in the <menuchoice> <guimenu>Settings</"
"guimenu><guimenuitem>Configure &kmail;...</guimenuitem></menuchoice> dialog."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:411
#, no-c-format
msgid "<guimenu>View</guimenu><guisubmenu>Set Encoding</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:413
#, no-c-format
msgid ""
"Lets you choose the character encoding to be used in the Message Pane. The "
"default, <guilabel>Auto</guilabel>, should work in almost all cases."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:417
#, no-c-format
msgid "<guimenu>View</guimenu><guisubmenu>Zoom</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:419
#, no-c-format
msgid "Allows to zoom message in the Message Pane."
msgstr ""

#. Tag: title
#: menus.docbook:428
#, no-c-format
msgid "Go Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:431
#, no-c-format
msgid ""
"<shortcut><keycap>J</keycap></shortcut><guimenu>Go</guimenu> "
"<guimenuitem>Jump to Folder...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:434
#, no-c-format
msgid ""
"Selecting this menu item with show a dialog box with a list of all your "
"folders. Click on the folder you wish to view and it will display it in the "
"message view pane."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:438
#, no-c-format
msgid ""
"<shortcut><keycap>N</keycap></shortcut><guimenu>Go</guimenu> "
"<guimenuitem>Next Message</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:441
#, no-c-format
msgid ""
"Selects the next message in the message list. The keyboard shortcut "
"<keycap>Right Arrow</keycap> also performs this action."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:445
#, no-c-format
msgid ""
"<shortcut><keycap>+</keycap></shortcut> <guimenu>Go</"
"guimenu><guimenuitem>Next Unread Message</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:448
#, no-c-format
msgid ""
"Selects the next unread message in the message list. If there are not any "
"unread messages below the currently selected message, then the behavior "
"depends on the value of the <xref linkend=\"configure-misc-folders-go-unread"
"\"/> option."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:452
#, no-c-format
msgid ""
"<shortcut><keycap>P</keycap></shortcut> <guimenu>Go</"
"guimenu><guimenuitem>Previous Message</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:455
#, no-c-format
msgid "Selects the previous message in the message list."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:458
#, no-c-format
msgid ""
"<shortcut><keycap>-</keycap></shortcut> <guimenu>Go</"
"guimenu><guimenuitem>Previous Unread Message</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:461
#, no-c-format
msgid ""
"Selects the previous unread message in the message list. If there is not an "
"unread message above the currently selected message, then the behavior "
"depends on the value of the <xref linkend=\"configure-misc-folders-go-unread"
"\"/> option."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:466
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Alt;<keycap>+</keycap></keycombo></"
"shortcut> <guimenu>Go</guimenu><guimenuitem>Next Unread Folder</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:469
#, no-c-format
msgid "Jumps to the next folder with unread messages."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:472
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Alt;<keycap>-</keycap></keycombo></"
"shortcut> <guimenu>Go</guimenu><guimenuitem>Previous Unread Folder</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:475
#, no-c-format
msgid "Jumps to the previous folder with unread messages."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:478
#, no-c-format
msgid ""
"<shortcut><keycap>Space</keycap></shortcut> <guimenu>Go</"
"guimenu><guimenuitem>Next Unread Text</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:481
#, no-c-format
msgid ""
"Scrolls down if you are not yet at the bottom of a message, otherwise jumps "
"to the next unread message."
msgstr ""

#. Tag: title
#: menus.docbook:490
#, no-c-format
msgid "Folder Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:492
#, no-c-format
msgid "<guimenu>Folder</guimenu><guimenuitem>Add Folder...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:494
#, no-c-format
msgid ""
"Opens the <link linkend=\"folders-properties-window\">Folder Properties</"
"link> dialog that lets you create a new folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:498
#, no-c-format
msgid ""
"<guimenu>Folder</guimenu><guimenuitem>Mark All Messages as Read</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:500
#, no-c-format
msgid ""
"Sets the status of all new and unread messages in the current folder to read."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:503
#, no-c-format
msgid ""
"<shortcut><keycap>F5</keycap></shortcut> <guimenu>Folder</"
"guimenu><guimenuitem>Update Folder</guimenuitem>"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:510
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>F5</keycap></keycombo></"
"shortcut> <guimenu>Folder</guimenu><guimenuitem>Update Folder</guimenuitem>"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:517
#, no-c-format
msgid ""
"<guimenu>Folder</guimenu> <guimenuitem>Move All Messages to Trash</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:520
#, no-c-format
msgid ""
"Moves all of the messages in the selected folder into the trash folder. This "
"is only available if the currently selected folder is not a trash folder."
msgstr ""

#. Tag: para
#: menus.docbook:523
#, no-c-format
msgid ""
"If the currently selected folder is a trash folder, you will see "
"<guilabel>Empty Trash</guilabel>. Please see next section for details."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:526
#, no-c-format
msgid "<guimenu>Folder</guimenu><guimenuitem>Empty Trash</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:528
#, no-c-format
msgid ""
"Permanently deletes all messages. This is only available if the currently "
"selected folder is a trash folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:532
#, no-c-format
msgid "<guimenu>Folder</guimenu> <guimenuitem>Archive Folder...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:535
#, no-c-format
msgid ""
"This option brings up a dialog to allow you to create an archive of the "
"currently selected folder. In the dialog select a format (choices are: zip, "
"tar, tar.bz2, and tar.gz). If you would like to change the default name or "
"location, click the folder at the end of <guilabel>Archive File</guilabel>. "
"Check the <guilabel>Delete folder and subfolders after completion</guilabel> "
"if you would like everything you archived deleted. By default all subfolders "
"will be archived, uncheck <guilabel>Archive all subfolders</guilabel> if you "
"only want to archive the parent folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:542
#, no-c-format
msgid "<guimenu>Folder</guimenu> <guimenuitem>Delete Folder</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:545
#, no-c-format
msgid "Removes the selected folder and all its contents, including subfolders."
msgstr ""

#. Tag: para
#: menus.docbook:546
#, no-c-format
msgid ""
"Please note that there is no way to access the contents of a folder after it "
"has been removed."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:550
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>*</keycap></keycombo></"
"shortcut> <guimenu>Folder</guimenu><guimenuitem>Remove Duplicate Messages</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:553
#, no-c-format
msgid "Searches the folder for duplicate messages and deletes the duplicates."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:557
#, no-c-format
msgid ""
"<guimenu>Folder</guimenu><guimenuitem>Apply All Filters On Folder</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:559
#, no-c-format
msgid ""
"Applies all configured filters on the currently selected folder. Please see "
"<link linkend=\"filter-dialog-id\">Filter dialog</link> for more information "
"on filters."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:563
#, no-c-format
msgid ""
"<guimenu>Folder</guimenu><guimenuitem>Prefer HTML to Plain Text</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:565
#, no-c-format
msgid ""
"If enabled then &html; messages in this folder will be shown using &html; "
"rendering. For security reasons, we recommend to only activate this for "
"folders which only contain trusted messages."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:570
#, no-c-format
msgid ""
"<guimenu>Folder</guimenu><guimenuitem>Load External References</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:572
#, no-c-format
msgid ""
"If you have &html; messages enabled (see above), then you have the option to "
"enable this to have images and resources linked from the web will load "
"automatically. For security reasons, we recommend to only activate this for "
"folders which only contain trusted messages."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:576
#, no-c-format
msgid ""
"<guimenu>Folder</guimenu><guimenuitem>Mailing List Management...</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:578
#, no-c-format
msgid ""
"This opens up the mailing list management dialog. Please see <link linkend="
"\"folders-properties-mailinglist\">Mailing List dialog</link> for more "
"information on mailing lists."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:581
#, no-c-format
msgid "<guimenu>Folder</guimenu><guimenuitem>Assign Shortcut...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:583
#, no-c-format
msgid ""
"This allows you to assign a keyboard shortcut to the currently selected "
"folder."
msgstr ""

#. Tag: title
#: menus.docbook:591
#, no-c-format
msgid "Message Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:594
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo></"
"shortcut> <guimenu>Message</guimenu><guimenuitem>New Message...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:597
#, no-c-format
msgid ""
"Opens the <link linkend=\"the-composer-window\">composer window</link> so "
"you can write a new message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:601
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>N</keycap></"
"keycombo></shortcut> <guimenu>Message</guimenu><guimenuitem>New Message to "
"Mailing-List...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:604
#, no-c-format
msgid ""
"Opens the composer window so you can write a new mail. If the current folder "
"holds a mailing list and has a posting address defined, this address will be "
"the default <guilabel>To:</guilabel> address."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:610
#, no-c-format
msgid ""
"<shortcut><keycap>R</keycap></shortcut> <guimenu>Message</"
"guimenu><guimenuitem>Reply...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:613
#, no-c-format
msgid ""
"Opens up the composer window, inserts the quoted text of the currently "
"selected message and presets the <guilabel>To:</guilabel> field either with "
"the mailing-list address (if you reply to a mailing-list message) or with "
"the preferred reply address of the sender. If you want to control which "
"address the <guilabel>To:</guilabel> field is preset with then you should "
"use <menuchoice><guimenu>Message</guimenu><guimenuitem>Reply Special</"
"guimenuitem></menuchoice>. Please see <link linkend=\"reply-special\">Reply "
"Special</link> for more information. Your identity will automatically be set "
"to the identity this message was sent to."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:624
#, no-c-format
msgid ""
"<shortcut><keycap>A</keycap></shortcut> <guimenu>Message</"
"guimenu><guimenuitem>Reply to All...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:627
#, no-c-format
msgid ""
"Opens up the composer window, inserts the quoted text of the currently "
"selected message and presets the <guilabel>To:</guilabel> field either with "
"the mailing-list address (if you reply to a mailing-list message) or with "
"the preferred reply address of the sender. The <guilabel>Copy to (CC):</"
"guilabel> field is preset with the addresses of all other recipients of the "
"currently selected message excluding your own addresses. Your identity will "
"automatically be set to the identity this message was sent to."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:637
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Shift;<keycap>A</keycap></keycombo></"
"shortcut> <guimenu>Message</guimenu><guisubmenu>Reply Special</"
"guisubmenu><guimenuitem>Reply to Author...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:640
#, no-c-format
msgid ""
"Opens up the composer window, inserts the quoted text of the currently "
"selected message and presets the <guilabel>To:</guilabel> field with the "
"preferred reply address of the sender. Your identity will automatically be "
"set to the identity this message was sent to."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:647
#, no-c-format
msgid ""
"<shortcut><keycap>L</keycap></shortcut><guimenu>Message</guimenu> "
"<guisubmenu>Reply Special</guisubmenu><guimenuitem>Reply to Mailing-List...</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:650
#, no-c-format
msgid ""
"Opens up the composer window, inserts the quoted text of the currently "
"selected message and presets the <guilabel>To:</guilabel> field with the "
"mailing-list address. If you did not specify a mailing-list address for the "
"currently selected folder and &kmail; cannot determine the posting address "
"from the currently selected message then the <guilabel>To:</guilabel> field "
"will be empty. Your identity will automatically be set to the identity this "
"message was sent to."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:659
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Shift;<keycap>R</keycap></keycombo></"
"shortcut> <guimenu>Message</guimenu><guisubmenu>Reply Special</"
"guisubmenu><guimenuitem>Reply Without Quote...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:662
#, no-c-format
msgid ""
"Works just like <guimenuitem>Reply...</guimenuitem> except that the text of "
"the currently selected message is not quoted."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:666
#, no-c-format
msgid ""
"<guimenu>Message</guimenu><guisubmenu>Reply Special</"
"guisubmenu><guimenuitem>Reply With Custom Template</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:668
#, no-c-format
msgid ""
"Works just like <guimenuitem>Reply...</guimenuitem> with the option to "
"select a custom template that has been configured in the composer custom "
"templates tab in <menuchoice><guimenu>Settings</"
"guimenu><guimenuitem>Configure &kmail;...</guimenuitem></menuchoice>, please "
"see <link linkend=\"configure-composer-custom-templates\">Custom Templates</"
"link> for more information."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:673
#, no-c-format
msgid ""
"<guimenu>Message</guimenu><guisubmenu>Reply Special</"
"guisubmenu><guimenuitem>Reply to All With Custom Template</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:675
#, no-c-format
msgid ""
"Works just like <guimenuitem>Reply to All...</guimenuitem> with the option "
"to select a custom template that has been configured in the composer custom "
"templates tab in <menuchoice><guimenu>Settings</"
"guimenu><guimenuitem>Configure &kmail;...</guimenuitem></menuchoice>, please "
"see <link linkend=\"configure-composer-custom-templates\">Custom Templates</"
"link> for more information."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:680
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Shift;<keycap>F</keycap></keycombo></"
"shortcut> <guimenu>Message</guimenu><guisubmenu>Forward</"
"guisubmenu><guimenuitem>As Attachment</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:683
#, no-c-format
msgid ""
"Forwards the message to a new recipient. The message and its attachments "
"will become an attachment of the new message. The original message headers "
"will be included in the forwarded message as well."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:687
#, no-c-format
msgid ""
"<shortcut><keycap>F</keycap></shortcut> <guimenu>Message</"
"guimenu><guisubmenu>Forward</guisubmenu><guimenuitem>Inline</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:690
#, no-c-format
msgid ""
"The message's text and some important header fields will be copied to the "
"body of the new message with text marking the forwarded part. Attachments "
"will be forwarded as attachments of the new message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:694
#, no-c-format
msgid ""
"<shortcut><keycap>E</keycap></shortcut> <guimenu>Message</"
"guimenu><guisubmenu>Forward</guisubmenu><guimenuitem>Redirect</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:697
#, no-c-format
msgid ""
"This works like forward, except that the message stays the same (even the "
"<guilabel>From:</guilabel> field). The user who redirected the message is "
"added in special header fields (<literal>Redirect-From</literal>, "
"<literal>Redirect-Date</literal>, <literal>Redirect-To</literal>, &etc;)."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:702
#, no-c-format
msgid ""
"<guimenu>Message</guimenu><guisubmenu>Forward</guisubmenu><guimenuitem>With "
"Custom Template</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:704
#, no-c-format
msgid ""
"Works just like forward with the option to select a custom template that has "
"been configured in the composer custom templates tab in "
"<menuchoice><guimenu>Settings</guimenu><guimenuitem>Configure &kmail;...</"
"guimenuitem></menuchoice>, please see <link linkend=\"configure-composer-"
"custom-templates\">Custom Templates</link> for more information."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:709
#, no-c-format
msgid "<guimenu>Message</guimenu><guimenuitem>Send Again...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:711
#, no-c-format
msgid ""
"Opens a composer window with the currently selected message so it can be "
"sent again. This is only available for messages which you have sent or, more "
"precisely, for messages which have the <guilabel>sent</guilabel> status."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:716
#, no-c-format
msgid ""
"<shortcut><keycap>T</keycap></shortcut> <guimenu>Message</"
"guimenu><guimenuitem>Edit Message</guimenuitem>"
msgstr ""

#. Tag: para
