msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo></"
"shortcut> <guimenu>Message</guimenu> <guimenuitem>New Composer</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1506
#, no-c-format
msgid "Opens up a new composer window."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1512
#, no-c-format
msgid "<guimenu>Message</guimenu> <guimenuitem>New Main Window</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1518
#, no-c-format
msgid "Creates a new main window."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1524
#, no-c-format
msgid ""
"<guimenu>Message</guimenu> <guimenuitem>New AddressBook Contact</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1530
#, no-c-format
msgid "Creates a new address book contact."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1536
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Return</keycap></"
"keycombo></shortcut> <guimenu>Message</guimenu> <guimenuitem>Send Mail</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1543
#, no-c-format
msgid ""
"Sends the message immediately. If you use SMTP to send your messages and the "
"&SMTP; server is not reachable, the message will be put into the outbox and "
"you will get an error message. You can then later send the messages in the "
"outbox using <menuchoice><guimenu>File</guimenu><guimenuitem>Send Queued "
"Messages</guimenuitem></menuchoice>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1553
#, no-c-format
msgid "<guimenu>Message</guimenu> <guimenuitem>Send Later</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1559
#, no-c-format
msgid ""
"Queues the message in the outbox for sending it later using "
"<menuchoice><guimenu>File</guimenu><guimenuitem>Send Queued Messages</"
"guimenuitem></menuchoice>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1568
#, no-c-format
msgid "<guimenu>Message</guimenu> <guimenuitem>Save as Draft</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1574
#, no-c-format
msgid ""
"Save the message in the <guilabel>drafts</guilabel> folder so you can later "
"edit and send it."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1581
#, no-c-format
msgid ""
"<guimenu>Messages</guimenu> <guimenuitem>Insert Text File...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1587
#, no-c-format
msgid ""
"Inserts a text file into the message text, starting at the cursor position."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1594
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo></"
"shortcut> <guimenu>Message</guimenu> <guimenuitem>Print...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1601
#, no-c-format
msgid "Prints the current text."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1607
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>W</keycap></keycombo></"
"shortcut> <guimenu>Message</guimenu> <guimenuitem>Close</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1614
#, no-c-format
msgid "Closes this composer window."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1630
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Paste as Quotation</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1636
#, no-c-format
msgid "Pastes the text from the clipboard marked as quotation."
msgstr ""

#. Tag: para
#: menus.docbook:1649
#, no-c-format
msgid "Undo your steps in editing the current message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1655
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>Z</keycap></"
"keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Redo</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1662
#, no-c-format
msgid "Redo your steps in editing the current message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1668
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>X</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Cut</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1675
#, no-c-format
msgid ""
"Cutting text works as with most editors: the selected text is removed and "
"put into the clipboard. Note that you can also select text and drag it to a "
"new position."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1683
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Copy</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1691
#, no-c-format
msgid ""
"Copying text works as with most editors: the selected text is copied to the "
"clipboard. Note that you can also select text while holding the &Ctrl; key, "
"and drag it to a new position to copy it."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1699
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>V</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Paste</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1706
#, no-c-format
msgid ""
"Pasting works the same as with most editors: the text from the clipboard is "
"pasted at the current cursor position."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1713
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>A</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Select All</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1720
#, no-c-format
msgid "Selects all of the text in your message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1726
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>F</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1733
#, no-c-format
msgid "Opens a dialog to search for strings in the current message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1739
#, no-c-format
msgid ""
"<shortcut><keycap>F3</keycap></shortcut> <guimenu>Edit</guimenu> "
"<guimenuitem>Find Next</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1746
#, no-c-format
msgid "Goes to the next occurrence of the previously searched string."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1752
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>R</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Replace...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1759
#, no-c-format
msgid ""
"Opens a dialog that lets you replace strings in your message with other "
"strings."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1765
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Clean Spaces</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1771
#, no-c-format
msgid ""
"This replaces multiple line breaks or spaces with single line breaks or "
"spaces. It works on the current selection or on the complete message if "
"there is no selection."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1778
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Add Quote Characters</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1784
#, no-c-format
msgid "Prepends the selected text with quotation marks."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1790
#, no-c-format
msgid ""
"<guimenu>Edit</guimenu> <guimenuitem>Remove Quote Characters</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1796
#, no-c-format
msgid "Removes the left-most quotation marks from the selected text."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1802
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Uppercase</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1808
#, no-c-format
msgid "Uppercase selected text."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1814
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Lowercase</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1820
#, no-c-format
msgid "Lowercase selected text."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1826
#, no-c-format
msgid ""
"<guimenu>Edit</guimenu> <guimenuitem>Insert Special Characters</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1832
#, no-c-format
msgid "It allows to insert special character in composer."
msgstr ""

#. Tag: para
#: menus.docbook:1845
#, no-c-format
msgid ""
"This menu lets you toggle the display of the header fields and other options "
"in this composer window."
msgstr ""

#. Tag: para
#: menus.docbook:1848
#, no-c-format
msgid "Options available are:"
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1852
#, no-c-format
msgid "All Fields"
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1855
#, no-c-format
msgid "Identity"
msgstr "Identitat"

#. Tag: guimenuitem
#: menus.docbook:1858
#, no-c-format
msgid "Dictionary"
msgstr "Diccionari"

#. Tag: guimenuitem
#: menus.docbook:1861
#, no-c-format
msgid "Sent-Mail folder"
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1864
#, no-c-format
msgid "Mail Transport"
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1867
#, no-c-format
msgid "From"
msgstr "De"

#. Tag: guimenuitem
#: menus.docbook:1870
#, no-c-format
msgid "Reply To"
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1873
#, no-c-format
msgid "Subject"
msgstr "Subjècte"

#. Tag: para
#: menus.docbook:1877
#, no-c-format
msgid ""
"Currently visible items have a checkmark shown next to their name in the "
"menu."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1883
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Use Fixed Font</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1889
#, no-c-format
msgid ""
"Uses a fixed width (monospaced) font to display the currently edited "
"message. The font to be used can be configured in the <guilabel>Appearance</"
"guilabel> section of &kmail;'s configuration dialog."
msgstr ""

#. Tag: title
#: menus.docbook:1904
#, no-c-format
msgid "<guimenu>Options</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1910
#, no-c-format
msgid "<guimenu>Options</guimenu> <guimenuitem>Urgent</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1916
#, no-c-format
msgid ""
"Sets the priority of the message to Urgent. The receiver's email client has "
"to support this or it will have no effect. &kmail; itself does not support "
"priorities for incoming messages."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1924
#, no-c-format
msgid ""
"<guimenu>Options</guimenu> <guimenuitem>Request Disposition Notification</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1930
#, no-c-format
msgid ""
"If you choose this option, you request a confirmation email once your "
"message is downloaded and read by its recipient. This has to be supported "
"and enabled by the receiver's email client in order to work."
msgstr ""

#. Tag: para
#: menus.docbook:1936
#, no-c-format
msgid ""
"See <xref linkend=\"configure-security-reading-mdns\"/> for background "
"information and ways to customize the read receipts that &kmail; itself "
"sends."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1946
#, no-c-format
msgid "<guimenu>Options</guimenu> <guisubmenu>Sign Message</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1952
#, no-c-format
msgid ""
"Digitally sign the message using <application>OpenPGP</application>. You can "
"learn more about this in the <link linkend=\"pgp\">chapter on OpenPGP</link>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1959
#, no-c-format
msgid "<guimenu>Options</guimenu> <guisubmenu>Encrypt Message</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1965
#, no-c-format
msgid ""
"Encrypt the message using <application>OpenPGP</application>. You can learn "
"more about this in the <link linkend=\"pgp\">chapter on OpenPGP</link>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1972
#, no-c-format
msgid ""
"<guimenu>Options</guimenu> <guisubmenu>Cryptographic Message Format</"
"guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1978
#, no-c-format
msgid ""
"Choose the cryptographic message format to use to digitally sign and/or "
"encrypt the message in. See <link linkend=\"cryptographic-message-formats"
"\">the previous description of each option</link> for more information."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1989
#, no-c-format
msgid "<guimenu>Options</guimenu> <guisubmenu>Formatting (HTML)</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1995
#, no-c-format
msgid "Enables &html; editing."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2001
#, no-c-format
msgid "<guimenu>Options</guimenu> <guisubmenu>Encoding</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:2007
#, no-c-format
msgid ""
"Set the charset encoding of this message. The chosen encoding will appear in "
"the header of the outgoing mail. You can use <guilabel>Auto</guilabel> for "
"almost all cases, &kmail; will tell you if you need to select a different "
"encoding manually."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2015
#, no-c-format
msgid "<guimenu>Options</guimenu> <guimenuitem>Wordwrap</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2021
#, no-c-format
msgid ""
"Toggles the automatic wordwrap. It may be useful to turn it off if you want "
"to paste long lines that should not wrap."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2028
#, no-c-format
msgid ""
"<guimenu>Options</guimenu> <guimenuitem>Automatic Spellchecking</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2034
#, no-c-format
msgid "Toggles automatic spellchecking."
msgstr ""

#. Tag: title
#: menus.docbook:2044
#, no-c-format
msgid "<guimenu>Attach</guimenu> Menu"
msgstr ""

#. Tag: para
#: menus.docbook:2046
#, no-c-format
msgid "This menu lets you select attachment options."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2052
#, no-c-format
msgid "<guimenu>Attach</guimenu> <guimenuitem>Append Signature</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2058
#, no-c-format
msgid ""
"Appends your signature (<quote>footer</quote>) to the end of the message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2065
#, no-c-format
msgid ""
"<guimenu>Attach</guimenu> <guimenuitem>Attach Public Key...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2071
#, no-c-format
msgid ""
"Attaches the corresponding <application>GnuPG</application> key to your "
"message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2078
#, no-c-format
msgid ""
"<guimenu>Attach</guimenu> <guimenuitem>Attach My Public Key</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2084
#, no-c-format
msgid ""
"Attaches your <application>GnuPG</application> public key to your message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2091
#, no-c-format
msgid "<guimenu>Attach</guimenu> <guimenuitem>Attach File...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2097
#, no-c-format
msgid "Attaches one or more files to the current message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2104
#, no-c-format
msgid "<guimenu>Attach</guimenu> <guimenuitem>Remove Attachment</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2110
#, no-c-format
msgid ""
"Removes the attachment that is selected in the attachment part of the "
"composer."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2116
#, no-c-format
msgid ""
"<guimenu>Attach</guimenu> <guimenuitem>Save Attachment As...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2122
#, no-c-format
msgid ""
"Saves the attachment that is selected in the attachment window to a file."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2129
#, no-c-format
msgid ""
"<guimenu>Attach</guimenu> <guimenuitem>Attachment Properties</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2135
#, no-c-format
msgid ""
"Displays the <link linkend=\"attachments\">properties of the attachment</"
"link> that is selected in the attachment window."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2151
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Spelling...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2157
#, no-c-format
msgid ""
"Uses <ulink url=\"help:/sonnet/\">&sonnet;</ulink> to check the spelling in "
"the body of your message. Note that you have to configure &sonnet; with "
"<menuchoice><guimenu>Settings</guimenu> <guimenuitem>Spellchecker...</"
"guimenuitem></menuchoice> if you use it for the first time."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2167
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Addressbook...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2173
#, no-c-format
msgid "Opens up <ulink url=\"help:/kaddressbook\">&kaddressbook;</ulink>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2188
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Toolbars Shown</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2194
#, no-c-format
msgid ""
"Enables and disables the Main Toolbar, &ie; the one with the icon to send "
"the message &etc; and the &html; Toolbar, &ie; the one which with the tools "
"to change certain properties of the composed text."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2202
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Spellchecker...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2208
#, no-c-format
msgid ""
"Allows you to configure <ulink url=\"help:/sonnet/\">&sonnet;</ulink>, "
"&kde;'s spellchecker."
msgstr ""

#. Tag: para
#: menus.docbook:2233
#, no-c-format
msgid ""
"Opens a window that allows you to decide which icons appear in the toolbar."
msgstr ""

#. Tag: para
#: menus.docbook:2246
#, no-c-format
msgid ""
"Opens &kmail;'s <link linkend=\"configure\">configuration dialog</link>."
msgstr ""

#. Tag: para
#: menus.docbook:2257
#, no-c-format
msgid ""
"The entries in this menu have the same meaning as <link linkend=\"reader-"
"help-menu\">the entries in the main window's help menu</link>."
msgstr ""
