msgid "Round recycle symbol"
msgstr ""

#. Tag: entry
#: menus.docbook:1159
#, no-c-format
msgid ""
"This status will not be set automatically by &kmail;. You can use it to mark "
"spam messages."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1163
#, no-c-format
msgid "<guimenuitem>Ham</guimenuitem>"
msgstr ""

#. Tag: entry
#: menus.docbook:1164
#, no-c-format
msgid "Green check mark"
msgstr ""

#. Tag: entry
#: menus.docbook:1165
#, no-c-format
msgid ""
"This status will not be set automatically by &kmail;. You can use it to mark "
"messages which are not spam."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1177
#, no-c-format
msgid "<guimenu>Message</guimenu> <guisubmenu>Mark Thread</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1183
#, no-c-format
msgid ""
"Allows you to change the status of all messages in a thread. The possible "
"states are the same as for <menuchoice><guimenu>Message</guimenu> "
"<guimenuitem>Mark Message</guimenuitem></menuchoice>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1217
#, no-c-format
msgid "<guimenu>Message</guimenu> <guisubmenu>Create Filter</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1223
#, no-c-format
msgid ""
"Opens up the <link linkend=\"filter-dialog-id\">Filter dialog</link> with a "
"new filter added. This new filter is based on fields of the current mail, "
"depending on which sub menu item you select."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1231
#, no-c-format
msgid "<guimenu>Message</guimenu> <guimenuitem>Apply Filter</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1237
#, no-c-format
msgid ""
"Allows you to apply an individual filter or all filters to the selected "
"messages. Only filters for which you enabled the <guilabel>Add this filter "
"to the Apply Filter menu</guilabel> option will be available."
msgstr ""

#. Tag: title
#: menus.docbook:1253 menus.docbook:2183
#, no-c-format
msgid "<guimenu>Tools</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1259
#, no-c-format
msgid ""
"<shortcut><keycap>S</keycap></shortcut> <guimenu>Tools</guimenu> "
"<guimenuitem>Find Messages...</guimenuitem>"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1276
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Address Book</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1282
#, no-c-format
msgid ""
"Starts up &kaddressbook;, the &kde; address book. If this menu item is "
"disabled and greyed out either &kaddressbook; is not installed or the "
"program was not found."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1290
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Certificate Manager...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1296
#, no-c-format
msgid ""
"Starts <ulink url=\"help:kleopatra\"><application>Kleopatra</application></"
"ulink>, the &kde; certificate manager."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1306
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>GnuPG Log Viewer</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1312
#, no-c-format
msgid ""
"Starts <ulink url=\"help:kwatchgnupg\"><application>KWatchGnuPG</"
"application></ulink>, a tool to present the debug output of "
"<application>GnuPG</application> application. If signing, encryption, or "
"verification mysteriously stop working, you might find out why by looking at "
"the log."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1325
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guisubmenu>Edit \"Out of Office\" Replies...</"
"guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1331
#, no-c-format
msgid ""
"Launch the <guilabel>Configure \"Out of Office\" Replies</guilabel> dialog, "
"which allow you to set-up vacation notifications."
msgstr ""

#. Tag: para
#: menus.docbook:1333
#, no-c-format
msgid ""
"<guilabel>Out of Office reply</guilabel> functionality relies on server-side "
"filtering. To be able to use it you need to configure the <link linkend="
"\"receiving-mail\">Filtering tab</link> (see option relevant to kolab "
"server) of your <guilabel>IMAP</guilabel> account set-up."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1341
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guisubmenu>Filter Log Viewer...</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1347
#, no-c-format
msgid ""
"Opens up the viewer window for the filter log; there you find some options "
"to control the logging of the filtering process. In the log you will find "
"valuable information about what filter rules were used, what was the result "
"of the evaluation of those rules, and which filter actions were applied to a "
"message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1356
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Anti-Spam Wizard...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1362
#, no-c-format
msgid ""
"It starts a <link linkend=\"the-anti-spam-wizard\">wizard</link> which can "
"help you to set up spam filtering."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1369
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Anti-Virus Wizard...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1375
#, no-c-format
msgid ""
"It starts a <link linkend=\"the-anti-virus-wizard\">wizard</link> which can "
"help you to set up scanning messages for viruses."
msgstr ""

#. Tag: title
#: menus.docbook:1386 menus.docbook:2220
#, no-c-format
msgid "<guimenu>Settings</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1392
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Toolbar</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1398
#, no-c-format
msgid ""
"If enabled, the Toolbar is visible (the Toolbar is the one with the icon to "
"compose a new message &etc;)."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1405
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>H</keycap></keycombo></"
"shortcut> <guimenu>Settings</guimenu> <guimenuitem>Show Quick Search bar</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1412
#, no-c-format
msgid ""
"If enabled, the Quick Search bar which allows you to quickly search for "
"messages matching a search text is visible."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1419
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Filters...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1425
#, no-c-format
msgid "Opens the <link linkend=\"filters\">Message Filters</link> window."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1433 menus.docbook:2252
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1439 menus.docbook:2258
#, no-c-format
msgid ""
"Opens a window that lets you configure the keyboard shortcuts for many menu "
"commands."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1446
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Notifications...</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1452
#, no-c-format
msgid ""
"Opens a window that lets you configure what happens when new mail arrives, "
"like playing a sound."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1459 menus.docbook:2265
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Toolbars...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1465
#, no-c-format
msgid ""
"Opens a window that lets you choose which icons are visible in the toolbar."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1472 menus.docbook:2278
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure &kmail;...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1478
#, no-c-format
msgid "Opens the <link linkend=\"configure\">Configure</link> window."
msgstr ""

#. Tag: title
#: menus.docbook:1487 menus.docbook:2293
#, no-c-format
msgid "<guimenu>Help</guimenu> Menu"
msgstr ""

#. Tag: para
#: menus.docbook:1489
#, no-c-format
msgid ""
"These are the &kde; standard items for the <guimenu>Help</guimenu> menu:"
msgstr ""

#. Tag: sect2
#: menus.docbook:1489
#, no-c-format
msgid "&help.menu.documentation;"
msgstr ""

#. Tag: para
#: menus.docbook:1493
#, no-c-format
msgid "Additionally &kmail; offers these items:"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1499
#, no-c-format
msgid "<guimenu>Help</guimenu> <guimenuitem>&kmail; Introduction</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1505
#, no-c-format
msgid ""
"This displays the welcome screen, which lists the most important differences "
"between your version of &kmail; and the previous one."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1512
#, no-c-format
msgid "<guimenu>Help</guimenu> <guimenuitem>Tip of the Day</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1518
#, no-c-format
msgid "This displays a dialog with useful hints for using &kmail;."
msgstr ""

#. Tag: title
#: menus.docbook:1528
#, no-c-format
msgid "The Composer Window"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1537
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo></"
"shortcut> <guimenu>Message</guimenu> <guimenuitem>New Composer</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1544
#, no-c-format
msgid "Opens up a new composer window."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1550
#, no-c-format
msgid "<guimenu>Message</guimenu> <guimenuitem>New Main Window</guimenuitem>"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1562
#, no-c-format
msgid ""
"<guimenu>Message</guimenu> <guimenuitem>New AddressBook Contact</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1568
#, no-c-format
msgid "Creates a new addressbook contact."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1574
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Return</keycap></"
"keycombo></shortcut> <guimenu>Message</guimenu> <guimenuitem>Send Mail</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1581
#, no-c-format
msgid ""
"Sends the message immediately. If you use SMTP to send your messages and the "
"SMTP server is not reachable, the message will be put into the outbox and "
"you will get an error message. You can then later send the messages in the "
"outbox using <menuchoice><guimenu>File</guimenu><guimenuitem>Send Queued "
"Messages</guimenuitem></menuchoice>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1591
#, no-c-format
msgid "<guimenu>Message</guimenu> <guimenuitem>Send Later</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1597
#, no-c-format
msgid ""
"Queues the message in the outbox for sending it later using "
"<menuchoice><guimenu>File</guimenu><guimenuitem>Send Queued Messages</"
"guimenuitem></menuchoice>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1606
#, no-c-format
msgid "<guimenu>Message</guimenu> <guimenuitem>Save as Draft</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1612
#, no-c-format
msgid ""
"Save the message in the <guilabel>drafts</guilabel> folder so you can later "
"edit and send it."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1619
#, no-c-format
msgid ""
"<guimenu>Messages</guimenu> <guimenuitem>Insert Text File...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1625
#, no-c-format
msgid ""
"Inserts a text file into the message text, starting at the cursor position."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1632
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo></"
"shortcut> <guimenu>Message</guimenu> <guimenuitem>Print...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1639
#, no-c-format
msgid "Prints the current text."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1645
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>W</keycap></keycombo></"
"shortcut> <guimenu>Message</guimenu> <guimenuitem>Close</guimenuitem>"
msgstr ""

#. Tag: para
