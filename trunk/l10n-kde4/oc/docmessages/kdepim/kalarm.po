msgstr ""

#. Tag: para
#: index.docbook:4029
#, no-c-format
msgid ""
"<filename>$KDEHOME/share/config/kresources/alarms/stdrc</filename> holds "
"your alarm resource configuration."
msgstr ""

#. Tag: para
#: index.docbook:4033
#, no-c-format
