#: index.docbook:3728
#, no-c-format
msgid "<refname>scheduleCommand</refname>"
msgstr ""

#. Tag: refpurpose
#: index.docbook:3729
#, no-c-format
msgid "schedule a new alarm which executes a shell command."
msgstr ""

#. Tag: synopsis
