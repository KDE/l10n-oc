msgstr ""

#. Tag: synopsis
#: index.docbook:3894
#, no-c-format
msgid ""
"bool scheduleEmail(const QString&amp; <replaceable>fromID</replaceable>,\n"
"                   const QString&amp; <replaceable>addresses</replaceable>,\n"
"                   const QString&amp; <replaceable>subject</replaceable>,\n"
