msgstr ""

#. Tag: para
#: index.docbook:1206
#, no-c-format
msgid ""
"<action>To merge contacts, simply select two or more and press the "
"<guimenuitem>Merge Contacts</guimenuitem> entry. The last contact selected "
"will be the merged contact, which now contains all information from both. </"
"action>."
msgstr ""

