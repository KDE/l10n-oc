#: index.docbook:209
#, no-c-format
msgid ""
"There are multiple other ways to find and add interesting feeds. Within "
"&kde;, websites browsed with &konqueror; will display the recognizable &quot;"
"RSS lozenge&quot;<inlinemediaobject> <imageobject> <imagedata fileref=\"rss3."
"png\" format=\"PNG\"/> </imageobject> </inlinemediaobject>in the bottom-"
"right if a compatible news feed is detected at the website. Just left-click "
"on the icon and choose <guimenuitem>Add Feed to &akregator;</guimenuitem>: "
"<screenshot> <screeninfo>Automatically finding feeds through &konqueror;</"
"screeninfo> <mediaobject> <imageobject><imagedata fileref=\"konq2.png\" "
"format=\"PNG\"/></imageobject> <textobject><phrase>Automatically finding "
"feeds through &konqueror;</phrase></textobject> </mediaobject> </screenshot> "
"On pages with this RSS icon<inlinemediaobject> <imageobject> <imagedata "
"fileref=\"rss.png\" format=\"PNG\"/> </imageobject> </inlinemediaobject>, "
"right-click on the icon and choose in the context menu <guimenuitem>Add Feed "
"to &akregator;</guimenuitem>:"
msgstr ""

#. Tag: screeninfo
#: index.docbook:233
#, no-c-format
msgid ""
"<screeninfo>Automatically finding feeds through &konqueror;</screeninfo>"
msgstr ""

#. Tag: phrase
#: index.docbook:236
#, no-c-format
msgid "<phrase>Automatically finding feeds through &konqueror;</phrase>"
msgstr ""

#. Tag: title
#: index.docbook:244
#, no-c-format
msgid "Creating a Folder"
msgstr "Crear un repertòri"

