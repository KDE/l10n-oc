msgstr ""

#. Tag: refname
#: index.docbook:1053
#, no-c-format
msgid "<refname>quit</refname>"
msgstr ""

#. Tag: refpurpose
#: index.docbook:1054
#, no-c-format
msgid "Return &karm;'s quit."
msgstr ""

#. Tag: synopsis
#: index.docbook:1057
#, no-c-format
msgid "QString quit()"
msgstr ""

#. Tag: para
#: index.docbook:1061
#, no-c-format
msgid ""
"<function>quit()</function> is a &DCOP; call that provides a way that an "
"external program can gracefully shutdown &karm;."
msgstr ""

#. Tag: refentrytitle
#: index.docbook:1069
#, no-c-format
msgid "<refentrytitle>hastodo</refentrytitle>"
msgstr ""

#. Tag: refname
#: index.docbook:1072
#, no-c-format
msgid "<refname>hastodo</refname>"
msgstr ""

#. Tag: refpurpose
#: index.docbook:1073
#, no-c-format
msgid "Check if top-level to-do exists."
msgstr ""

#. Tag: synopsis
#: index.docbook:1076
#, no-c-format
msgid "QString hastodo(QString taskname)"
msgstr ""

#. Tag: title
#: index.docbook:1078 index.docbook:1113
#, no-c-format
msgid "Parameters"
msgstr "Paramètres"

#. Tag: parameter
#: index.docbook:1081
#, no-c-format
msgid "taskname"
msgstr ""

#. Tag: para
#: index.docbook:1083
#, no-c-format
msgid "The name of the to-do to look for."
msgstr ""

#. Tag: para
#: index.docbook:1091
#, no-c-format
msgid ""
"<function>hastodo(QString taskname)</function> is a &DCOP; call that looks "
"for a of the given name. If found, it returns the iCalendar UID that "
"identifies that to-do. If not found, it returns an empty string."
msgstr ""

#. Tag: para
#: index.docbook:1096
#, no-c-format
msgid ""
"The iCalendar file that &karm; currently has opened is the file that is "
"searched. All to-do trees are searched, not just top-level to-do's. If more "
"than one to-do has a matching name, the first one found is returned."
msgstr ""

#. Tag: refentrytitle
#: index.docbook:1104
#, no-c-format
msgid "<refentrytitle>addtodo</refentrytitle>"
msgstr ""

#. Tag: refname
#: index.docbook:1107
#, no-c-format
msgid "<refname>addtodo</refname>"
msgstr ""

#. Tag: refpurpose
#: index.docbook:1108
#, no-c-format
msgid "Add new todo."
msgstr ""

#. Tag: synopsis
#: index.docbook:1111
#, no-c-format
msgid "QString addtodo(QString todoname)"
msgstr ""

#. Tag: parameter
#: index.docbook:1116
#, no-c-format
msgid "todoname"
msgstr ""

#. Tag: para
#: index.docbook:1118
#, no-c-format
msgid "The name of new to-do."
msgstr ""

#. Tag: para
#: index.docbook:1127
#, no-c-format
msgid ""
"<function>addtodo(QString todoname)</function> is a &DCOP; call that adds a "
"new top-level to-do to the current storage. The UID of the new to-do is "
"returned."
msgstr ""

