msgid "<refentrytitle>version</refentrytitle>"
msgstr ""

#. Tag: refname
#: index.docbook:1034
#, no-c-format
msgid "<refname>version</refname>"
msgstr ""

#. Tag: refpurpose
#: index.docbook:1035
#, no-c-format
msgid "Return &karm;'s version."
msgstr ""

#. Tag: synopsis
#: index.docbook:1038
#, no-c-format
msgid "QString version()"
msgstr ""

#. Tag: title
#: index.docbook:1041 index.docbook:1060 index.docbook:1090 index.docbook:1126
#, no-c-format
msgid "Description"
msgstr "Descripcion"

#. Tag: para
#: index.docbook:1042
#, no-c-format
msgid ""
"<function>version()</function> is a &DCOP; call that returns &karm;'s "
"version number; for example 1.5.0. The version number is returned as a "
"string in the typical &GNU; format of major.minor.bugfix."
msgstr ""

#. Tag: refentrytitle
