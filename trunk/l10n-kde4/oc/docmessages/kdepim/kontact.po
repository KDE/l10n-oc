msgstr ""

#. Tag: para
#: index.docbook:956
#, no-c-format
msgid "Current status"
msgstr ""

#. Tag: para
#: index.docbook:959
#, no-c-format
msgid "Available conduits"
msgstr ""

#. Tag: screeninfo
#: index.docbook:964
#, no-c-format
msgid "<screeninfo>&kontact; &kpilot; Summary Plugin</screeninfo>"
msgstr ""

#. Tag: phrase
#: index.docbook:970
#, no-c-format
msgid "<phrase>&kontact; &kpilot; Summary Plugin</phrase>"
msgstr ""

#. Tag: para
#: index.docbook:973
#, no-c-format
msgid "<para>&kontact; &kpilot; Summary Plugin</para>"
msgstr ""

#. Tag: title
#: index.docbook:982
#, no-c-format
msgid "&kontact; Summary Plugins: Mail"
msgstr ""

#. Tag: para
#: index.docbook:984
#, no-c-format
msgid ""
"The <quote>Mail</quote> plugin for &kontact;'s Summary View adds an area in "
"the view labeled <guilabel>New Messages</guilabel>. This area is updated "
"every time you receive new messages to inform you how many of these messages "
"there are and which folder they are in."
msgstr ""

#. Tag: screeninfo
#: index.docbook:992
#, no-c-format
msgid "<screeninfo>&kontact; Mail Summary Plugin</screeninfo>"
msgstr ""

#. Tag: phrase
#: index.docbook:998
#, no-c-format
msgid "<phrase>&kontact; Mail Summary Plugin</phrase>"
msgstr ""

#. Tag: para
#: index.docbook:1001
#, no-c-format
msgid "<para>&kontact; Mail Summary Plugin</para>"
msgstr ""

#. Tag: title
#: index.docbook:1010
#, no-c-format
msgid "&kontact; Summary Plugins: NewsTicker"
msgstr ""

#. Tag: para
#: index.docbook:1012
#, no-c-format
msgid ""
"The <quote>NewsTicker</quote> plugin for &kontact;'s Summary View adds an "
"area in the view labeled <guilabel>News Feeds</guilabel>. This area contains "
"the latest news from the currently configured news feeds. You can add and "
"remove feeds in &kontact;'s Summary View Configuration. Please note that as "
"of &kde; 3.4, the more efficient way of accessing RSS feed information is "
"the new &akregator; application, which provides notifications instead of "
"requiring constant checking of the Summary View to see if new articles have "
"appeared."
msgstr ""

#. Tag: para
#: index.docbook:1024
#, no-c-format
msgid ""
"The <quote>NewsTicker</quote> plugin is not available unless you have "
"installed the kdenetwork package. Some distributions may offer &knewsticker; "
"as a separate package."
msgstr ""

#. Tag: screeninfo
#: index.docbook:1030
#, no-c-format
msgid "<screeninfo>&kontact; NewsTicker Plugin</screeninfo>"
msgstr ""

#. Tag: phrase
#: index.docbook:1036
#, no-c-format
msgid "<phrase>&kontact; NewsTicker Plugin</phrase>"
msgstr ""

#. Tag: para
#: index.docbook:1039
#, no-c-format
msgid "<para>&kontact; NewsTicker Plugin</para>"
msgstr ""

#. Tag: title
#: index.docbook:1048
#, no-c-format
msgid "&kontact; Summary Plugins: Notes"
msgstr ""

#. Tag: para
#: index.docbook:1050
#, no-c-format
msgid ""
"The <quote>Notes</quote> plugin for &kontact;'s Summary View adds an area in "
"the view labeled <guilabel>Notes</guilabel>. This area displays all current "
"notes' titles (titles default to the date/time the note was created). "
"Clicking on the title of a note will bring up the Notes area."
msgstr ""

#. Tag: screeninfo
#: index.docbook:1059
#, no-c-format
msgid "<screeninfo>&kontact; Notes Summary Plugin</screeninfo>"
msgstr ""

#. Tag: phrase
#: index.docbook:1065
#, no-c-format
msgid "<phrase>&kontact; Notes Summary Plugin</phrase>"
msgstr ""

#. Tag: para
#: index.docbook:1068
#, no-c-format
msgid "<para>&kontact; Notes Summary Plugin</para>"
msgstr ""

#. Tag: title
#: index.docbook:1077
#, no-c-format
msgid "&kontact; Summary Plugins: To-do List"
msgstr ""

#. Tag: para
#: index.docbook:1079
#, no-c-format
msgid ""
"The <quote>To-do List</quote> plugin for &kontact;'s Summary View adds an "
"area in the view labeled <guilabel>To-dos</guilabel>. This area contains all "
"current to-dos, including ones that have been completed. It displays the "
"title of the to-do, the percentage of completion, and the current status of "
"the to-do. Note that you can purge all completed to-dos via the &kontact; To-"
"do List. Clicking on a to-do's title will currently do nothing."
msgstr ""

#. Tag: screeninfo
#: index.docbook:1090
#, no-c-format
msgid "<screeninfo>&kontact; To-do List Summary Plugin</screeninfo>"
msgstr ""

#. Tag: phrase
#: index.docbook:1096
#, no-c-format
msgid "<phrase>&kontact; To-do List Summary Plugin</phrase>"
msgstr ""

#. Tag: para
#: index.docbook:1099
#, no-c-format
msgid "<para>&kontact; To-do List Summary Plugin</para>"
msgstr ""

#. Tag: title
#: index.docbook:1108
#, no-c-format
msgid "&kontact; Summary Plugins: Special Dates"
msgstr ""

#. Tag: para
#: index.docbook:1110
#, no-c-format
msgid ""
"The <quote>Special Dates</quote> plugin for &kontact;'s Summary View adds an "
"area in the view labeled <guilabel>Special Dates</guilabel>. This area "
"contains information based on the criteria selected in the configuration "
"area of the plugin in &kontact;'s Summary View configuration. The "
"<quote>Special Dates</quote> plugin is especially useful because it can "
"display birthdays, anniversaries, holidays, and special occasions from both "
"the calendar and the contact list in one place."
msgstr ""

#. Tag: title
#: index.docbook:1141
#, no-c-format
msgid "&kontact; Summary Plugins: Weather"
msgstr ""

#. Tag: para
#: index.docbook:1143
#, no-c-format
msgid ""
"The <quote>Weather</quote> plugin for &kontact;'s Summary View adds an area "
"in the view labeled <guilabel>Weather Information</guilabel>. This area "
"contains the information for currently configured weather locations. For "
"more information about configuring KWeather, the weather reporter used as a "
"plugin within &kontact;, see the <ulink url=\"help:/kweather/configuring-"
"kweather.html\"> KWeather documentation</ulink>."
msgstr ""

#. Tag: screeninfo
#: index.docbook:1154
#, no-c-format
msgid "<screeninfo>&kontact; Weather Summary Plugin</screeninfo>"
msgstr ""

