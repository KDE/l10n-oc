#. Tag: title
#: index.docbook:59
#, no-c-format
msgid "Quick-start Guide"
msgstr ""

#. Tag: para
#: index.docbook:62
#, no-c-format
msgid "Start &kget;."
msgstr ""

#. Tag: para
#: index.docbook:63
#, no-c-format
msgid "Drag and drop the required &URL; in the &kget; window."
msgstr ""

#. Tag: title
#: index.docbook:70
#, no-c-format
msgid "Using &kget;"
msgstr ""

#. Tag: title
#: index.docbook:73
#, no-c-format
msgid "&kget; Tutorial"
msgstr ""

#. Tag: para
#: index.docbook:75
#, no-c-format
msgid ""
"Here is a brief tutorial that demonstrates some of the features of &kget;. "
"The screenshot shows three software packages that are to be downloaded. This "
"tutorial lists the procedure to download the middle one first, and then the "
"other two."
msgstr ""

#. Tag: para
#: index.docbook:84
#, no-c-format
msgid ""
"Place &kget; in offline mode, by choosing the menu item "
"<menuchoice><guimenu>Options</guimenu><guimenuitem>Offline Mode</"
"guimenuitem></menuchoice>."
msgstr ""

#. Tag: para
#: index.docbook:92
#, no-c-format
msgid ""
"Click on the first file with the &LMB;. Hold down the &Ctrl; key and click "
"on the bottom most file. The &kget; window should look similar to this:"
msgstr ""

#. Tag: screeninfo
#: index.docbook:97 index.docbook:121 index.docbook:143 index.docbook:233
#, no-c-format
msgid "Screenshot of Kget"
msgstr ""

#. Tag: phrase
#: index.docbook:103 index.docbook:127 index.docbook:149
#, no-c-format
msgid "Items to be downloaded from &konqueror;"
msgstr ""

#. Tag: para
#: index.docbook:112
#, no-c-format
msgid ""
"Click on the <guibutton>Delay</guibutton> button to prevent these items from "
"being downloaded."
msgstr ""

#. Tag: para
#: index.docbook:117
#, no-c-format
msgid ""
"Now click on the middle entry to highlight it. The top and bottom items will "
"no longer be highlighted."
msgstr ""

#. Tag: para
#: index.docbook:133
#, no-c-format
msgid ""
"Put &kget; back into the online mode by unchecking "
"<menuchoice><guimenu>Options</guimenu><guimenuitem>Offline Mode</"
"guimenuitem></menuchoice> and &kget; will download the middle file."
msgstr ""

#. Tag: para
#: index.docbook:139
#, no-c-format
msgid ""
"Click on the top item, hold down the &Shift; key and click on the bottom "
"item. The &kget; window should look like this:"
msgstr ""

#. Tag: para
#: index.docbook:155
#, no-c-format
msgid ""
"Holding down the &Ctrl; key allows you to select individual items; holding "
"down the &Shift; key allows you to select consecutive items, while clicking "
"with the &LMB;."
msgstr ""

#. Tag: para
#: index.docbook:163
#, no-c-format
msgid ""
"Now click on the <guiicon>Queue</guiicon> icon or choose <menuchoice> "
"<guimenu>Transfer</guimenu><guimenuitem>Queue</guimenuitem></menuchoice> to "
"download the two highlighted items."
msgstr ""

#. Tag: title
#: index.docbook:174
#, no-c-format
msgid "Special Configurations"
msgstr ""

#. Tag: title
#: index.docbook:176
#, no-c-format
msgid "Configuration of Auto-Disconnect"
msgstr ""

#. Tag: para
#: index.docbook:178
#, no-c-format
msgid ""
"This feature is used for automatically disconnecting your modem once a "
"download has been completed. To configure &kget; for auto-disconnect do:"
msgstr ""

#. Tag: para
#: index.docbook:184
#, no-c-format
msgid ""
"Go to <menuchoice><guimenu>Options</guimenu><guimenuitem>Auto-Disconnect "
"Mode </guimenuitem></menuchoice> <action> to disconnect the modem.</action> "
"Usually this would be &kppp;. Expert Mode must be on to use this feature."
msgstr ""

#. Tag: para
#: index.docbook:191
#, no-c-format
msgid ""
"For &SuSE; users the command <userinput><command>cinternet <option>-i</"
"option> <parameter>ppp0</parameter> <option>-0</option></command></"
"userinput> must be substituted for <userinput><command>kppp <option>-k</"
"option></command></userinput> in the <menuchoice><guimenu>Settings</guimenu> "
"<guimenuitem>Configure &kget;...</guimenuitem></menuchoice> <guilabel> "
"Automations</guilabel> menu."
msgstr ""

#. Tag: para
#: index.docbook:201
#, no-c-format
msgid ""
"For Fedora Core users the command should be <userinput><command>/usr/sbin/"
"usernetctl <parameter>ppp0</parameter> <option>down</option></command></"
"userinput>"
msgstr ""

#. Tag: para
#: index.docbook:207
#, no-c-format
msgid ""
"Users of other distributions, please check the documentation included with "
"your distribution for the appropriate command."
msgstr ""

#. Tag: title
#: index.docbook:215
#, no-c-format
msgid "Downloading Into Designated Folders"
msgstr ""

#. Tag: para
#: index.docbook:217
#, no-c-format
msgid "To download <acronym>JPEG</acronym> files into a designated folder do:"
msgstr ""

#. Tag: para
#: index.docbook:221
#, no-c-format
msgid ""
"Go to <menuchoice><guimenu>Settings</guimenu> <guimenuitem>Configure "
"&kget;...</guimenuitem></menuchoice> <guilabel>Folders</guilabel> menu."
msgstr ""

#. Tag: para
#: index.docbook:227
#, no-c-format
msgid ""
"Enter the files you wish to download using the extensions <literal role="
"\"extension\">.jpg</literal> and <literal role=\"extension\">.jpeg</literal> "
"as shown below:"
msgstr ""

#. Tag: phrase
#: index.docbook:239
#, no-c-format
msgid "Downloading into designated files"
msgstr ""

#. Tag: para
#: index.docbook:246
#, no-c-format
msgid ""
"Click on <interface>Apply</interface> and <interface>OK</interface>. When "
"you download any <literal role=\"extension\">.jpeg</literal> files they will "
"be stored in <filename>/home/kdecvs/pics/JPEG</filename>."
msgstr ""

#. Tag: title
#: index.docbook:258
#, no-c-format
msgid "Command Reference"
msgstr ""

#. Tag: title
#: index.docbook:261
#, no-c-format
msgid "The main &kget; window"
msgstr ""

#. Tag: title
#: index.docbook:264
#, no-c-format
msgid "The <guimenu>File</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: index.docbook:268
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>O</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Open</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:275
#, no-c-format
msgid "Opens the transfer window where you can paste &URL;'s."
msgstr ""

#. Tag: menuchoice
#: index.docbook:280
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>V</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Paste</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:287
#, no-c-format
msgid "Pastes the contents of the clipboard into the transfer window."
msgstr ""

#. Tag: menuchoice
#: index.docbook:292
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Export Transfer List...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:296
#, no-c-format
msgid ""
"<action>Opens a Save As window </action> that allows you to save highlighted "
"&URL;'s to a <literal role=\"extension\">.kget</literal> file. To use this "
"feature:"
msgstr ""

#. Tag: para
#: index.docbook:300
#, no-c-format
msgid ""
"Place &kget; in offline mode by clicking on the offline mode button in the "
"toolbar or choosing <menuchoice><guimenu>Options</"
"guimenu><guimenuitem>Offline Mode</guimenuitem></menuchoice>."
msgstr ""

#. Tag: para
#: index.docbook:306
#, no-c-format
msgid "Drag the &URL;'s you wish to download on to &kget;."
msgstr ""

#. Tag: para
#: index.docbook:310
#, no-c-format
msgid "Next click on the top entry so that it is highlighted."
msgstr ""

#. Tag: para
#: index.docbook:314
#, no-c-format
msgid ""
"Hold down the <userinput><keycombo> &Shift;</keycombo></userinput> key and "
"click on the bottom &URL; to highlight the entries like so:"
msgstr ""

#. Tag: screeninfo
#: index.docbook:319
#, no-c-format
msgid "Picture of kget saving to export file"
msgstr ""

#. Tag: para
#: index.docbook:328
#, no-c-format
msgid ""
"Now click on <menuchoice><guimenu>File</guimenu> <guimenuitem>Export "
"Transfer List...</guimenuitem></menuchoice> and enter the name of the "
"<literal role=\"extension\">.kget</literal> file for your downloads."
msgstr ""

#. Tag: para
#: index.docbook:336
#, no-c-format
msgid ""
"This feature is used to save items that will be downloaded on a regular "
"basis, such as the &kde; snapshots above."
msgstr ""

#. Tag: menuchoice
#: index.docbook:344
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Import Transfer List...</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:348
#, no-c-format
msgid ""
"Loads <literal role=\"extension\">.kget</literal> files that were created "
"with <menuchoice><guimenu>File</guimenu> <guimenuitem>Export Transfer List..."
"</guimenuitem></menuchoice>"
msgstr ""

#. Tag: menuchoice
#: index.docbook:355
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Import Text File...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:359
#, no-c-format
msgid ""
"<action> Imports &URL;'s that are in text files.</action> This is a powerful "
"feature that allows you to parse &URL;'s from text files and emails you may "
"have received. It can discriminate between ordinary text and &URL;'s, "
"provided the &URL; begins at the left margin of the document. &kget; will "
"find these &URL;'s and load them into its main window for you."
msgstr ""

#. Tag: para
#: index.docbook:365
#, no-c-format
msgid ""
"This feature only ignores regular text when you have clicked on the Expert "
"Mode icon. If the Expert Mode is not used then the text file must contain "
"only &URL;'s."
msgstr ""

#. Tag: menuchoice
#: index.docbook:373
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:380
#, no-c-format
msgid "Quits &kget;"
msgstr ""

#. Tag: title
#: index.docbook:387
#, no-c-format
msgid "The <guimenu>View</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: index.docbook:391
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Show Log Window</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:395
#, no-c-format
msgid ""
"Opens a log window that shows the events that have occurred. This is useful "
"for seeing what happened during a lengthy download. Here you can see if any "
"packages were skipped or if a connection timed out."
msgstr ""

#. Tag: title
#: index.docbook:412
#, no-c-format
msgid "The <guimenu>Transfer</guimenu> Menu"
msgstr ""

#. Tag: para
#: index.docbook:413
#, no-c-format
msgid ""
"In order for the entries in this menu to become active (not grayed out), you "
"must highlight a download by clicking on the entry with the &LMB;."
msgstr ""

#. Tag: menuchoice
#: index.docbook:420
#, no-c-format
msgid ""
"<guimenu>Transfer</guimenu> <guimenuitem>Copy &URL; to Clipboard</"
"guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:424
#, no-c-format
msgid "This pastes a highlighted line into the &kde; clipboard (&klipper;)."
msgstr ""

#. Tag: menuchoice
#: index.docbook:430
#, no-c-format
msgid "<guimenu>Transfer</guimenu> <guimenuitem>Open Individual Window</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:434
#, no-c-format
msgid "Displays the selected download in its own window."
msgstr ""

#. Tag: menuchoice
#: index.docbook:439
#, no-c-format
msgid "<guimenu>Transfer</guimenu> <guimenuitem>Move To Beginning</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:443
#, no-c-format
msgid "Moves a highlighted entry to the top of the download list."
msgstr ""

#. Tag: para
#: index.docbook:445
#, no-c-format
msgid "The topmost &URL; in &kget; is downloaded first."
msgstr ""

#. Tag: menuchoice
#: index.docbook:451
#, no-c-format
msgid "<guimenu>Transfer</guimenu> <guimenuitem>Move To End</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:455
#, no-c-format
msgid "Moves a highlighted entry to the bottom of the download list."
msgstr ""

#. Tag: menuchoice
#: index.docbook:460
#, no-c-format
msgid "<guimenu>Transfer</guimenu> <guimenuitem>Resume</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:464
#, no-c-format
msgid "Resumes a download that has been paused."
msgstr ""

#. Tag: menuchoice
#: index.docbook:469
#, no-c-format
msgid "<guimenu>Transfer</guimenu> <guimenuitem>Pause</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:473
#, no-c-format
msgid "Pauses a download that is running."
msgstr ""

#. Tag: menuchoice
#: index.docbook:478
#, no-c-format
msgid "<guimenu>Transfer</guimenu> <guimenuitem>Delete</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:482
#, no-c-format
msgid "Deletes a highlighted item from the &kget; main window."
msgstr ""

#. Tag: menuchoice
#: index.docbook:487
#, no-c-format
msgid "<guimenu>Transfer</guimenu> <guimenuitem>Restart</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:491
#, no-c-format
msgid "Combines the functions of Resume and Pause in one button."
msgstr ""

#. Tag: menuchoice
#: index.docbook:496
#, no-c-format
msgid "<guimenu>Transfer</guimenu> <guimenuitem>Queue</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:500
#, no-c-format
msgid "Causes the highlighted entries in &kget; to begin downloading."
msgstr ""

#. Tag: menuchoice
#: index.docbook:505
#, no-c-format
msgid "<guimenu>Transfer</guimenu> <guimenuitem>Timer</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:509
#, no-c-format
msgid ""
"Delays the download of the highlighted items by one minute. This is useful "
"if you need to pause the download to check email or go to a website."
msgstr ""

#. Tag: menuchoice
#: index.docbook:515
#, no-c-format
msgid "<guimenu>Transfer</guimenu> <guimenuitem>Delay</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:519
#, no-c-format
msgid "Delays the download of the highlighted items indefinitely."
msgstr ""

#. Tag: para
#: index.docbook:521
#, no-c-format
msgid ""
"<guimenuitem>Queue</guimenuitem>, <guimenuitem>Timer</guimenuitem> and "
"<guimenuitem>Delay</guimenuitem> are mutually exclusive; only one of them "
"may be selected at a time."
msgstr ""

#. Tag: title
#: index.docbook:532
#, no-c-format
msgid "The <guimenu>Options</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: index.docbook:537
#, no-c-format
msgid "<guimenu>Options</guimenu> <guimenuitem>Use Animations</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:542
#, no-c-format
msgid "<action>Toggle use of animations</action> to display &kget;'s state."
msgstr ""

#. Tag: menuchoice
#: index.docbook:548
#, no-c-format
msgid "<guimenu>Options</guimenu> <guimenuitem>Use Sound</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:553
#, no-c-format
msgid ""
"<action>Toggle the use of sound</action> to indicate events, &eg; a file "
"being added to the download list, or a download completing."
msgstr ""

#. Tag: menuchoice
#: index.docbook:560
#, no-c-format
msgid "<guimenu>Options</guimenu> <guimenuitem>Expert Mode</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:564
#, no-c-format
msgid "Turns off prompting."
msgstr ""

#. Tag: menuchoice
#: index.docbook:568
#, no-c-format
msgid "<guimenu>Options</guimenu> <guimenuitem>Use-Last-Folder Mode</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:572
#, no-c-format
msgid ""
"&kget; will ignore the current folder settings and place all new transfers "
"in the folder where the last transfer was placed."
msgstr ""

#. Tag: menuchoice
#: index.docbook:578
#, no-c-format
msgid "<guimenu>Options</guimenu> <guimenuitem>Offline Mode</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:582
#, no-c-format
msgid ""
"Toggles &kget; from being online (ready to download) to offline. The offline "
"mode is used when you want to copy &URL;'s into &kget; without them being "
"downloaded immediately."
msgstr ""

#. Tag: menuchoice
#: index.docbook:588
#, no-c-format
msgid "<guimenu>Options</guimenu> <guimenuitem>Auto-Disconnect Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:592
#, no-c-format
msgid ""
"<action>Causes &kget; to disconnect the modem.</action> Usually this would "
"be &kppp;. Expert Mode must be on to use this feature."
msgstr ""

#. Tag: para
#: index.docbook:594
#, no-c-format
msgid ""
"You can find more information about the Auto-Disconnect Mode in <xref "
"linkend=\"configuration-auto-disconnect\"/>."
msgstr ""

#. Tag: menuchoice
#: index.docbook:600
#, no-c-format
msgid "<guimenu>Options</guimenu> <guimenuitem>Auto Shutdown Mode</guimenuitem>"
msgstr ""

#. Tag: action
#: index.docbook:604
#, no-c-format
msgid ""
"Closes &kget; after all the downloads are completed. The Expert Mode must be "
"turned on."
msgstr ""

#. Tag: menuchoice
#: index.docbook:609
#, no-c-format
msgid "<guimenu>Options</guimenu><guimenuitem>Auto-Paste Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:611
#, no-c-format
msgid "Enable grabbing of files to download from the clipboard."
msgstr ""

#. Tag: title
#: index.docbook:620
#, no-c-format
msgid "The <guimenu>Settings</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: index.docbook:624
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Hide Statusbar</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:628
#, no-c-format
msgid ""
"<action>Hide the status bar</action>. The status bar normally displays "
"statistics about the currently downloading files."
msgstr ""

#. Tag: menuchoice
#: index.docbook:634
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Drop Target</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:638
#, no-c-format
msgid ""
"The drop target is a desktop icon that allows for hiding and restoring of "
"&kget;. Also, download links can be dragged-and-dropped onto this drop "
"target, to add it to the download queue."
msgstr ""

#. Tag: menuchoice
#: index.docbook:644
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:649
#, no-c-format
msgid "Display the the &kde; Keyboard Shortcut Configuration Dialog."
msgstr ""

#. Tag: menuchoice
#: index.docbook:655
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Configure Toolbars</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:661
#, no-c-format
msgid "Display the the &kde; Toolbar Configuration Dialog."
msgstr ""

#. Tag: menuchoice
#: index.docbook:667
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Configure &kget;</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:673
#, no-c-format
msgid "Launch the main &kget; configuration dialog."
msgstr ""

