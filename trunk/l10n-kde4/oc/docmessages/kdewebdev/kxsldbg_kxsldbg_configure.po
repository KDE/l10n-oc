#: kxsldbg_configure.docbook:43
#, no-c-format
msgid "&XSL; source"
msgstr ""

#. Tag: para
#: kxsldbg_configure.docbook:44
#, no-c-format
msgid "&XML; data"
msgstr ""

#. Tag: para
#: kxsldbg_configure.docbook:45
#, no-c-format
msgid "Output file"
msgstr ""

#. Tag: para
#: kxsldbg_configure.docbook:49
#, no-c-format
msgid ""
"By using the <guibutton>...</guibutton> button to choose file desired. The "
"<guilabel>&XSL; source</guilabel> and <guilabel>>&XML; data</guilabel> may "
"refer to URI that contains a http://, ftp:// or file://. The "
"<guilabel>Output file</guilabel> must refer to a writable local file."
msgstr ""

#. Tag: para
#: kxsldbg_configure.docbook:53
#, no-c-format
msgid ""
"To follow along with the examples, select the following files in the example "
"<filename role=\"directory\">&lt;KDE PREFIX&gt;/share/apps/kxsldbg</"
"filename> folder"
msgstr ""

