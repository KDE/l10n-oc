#. Tag: title
#: kxsldbg_inspector.docbook:42
#, no-c-format
msgid "Adding a Breakpoint"
msgstr ""

#. Tag: para
#: kxsldbg_inspector.docbook:44
#, no-c-format
msgid "You can add a breakpoint by supplying any of:"
msgstr ""

#. Tag: para
#: kxsldbg_inspector.docbook:47
#, no-c-format
msgid "a file and line number"
msgstr ""

#. Tag: para
#: kxsldbg_inspector.docbook:49
#, no-c-format
msgid "a template name"
msgstr ""

#. Tag: para
#: kxsldbg_inspector.docbook:51
#, no-c-format
msgid "a template name and a mode name"
msgstr ""

#. Tag: para
#: kxsldbg_inspector.docbook:53
#, no-c-format
msgid "a mode name"
msgstr ""

#. Tag: para
#: kxsldbg_inspector.docbook:58
#, no-c-format
msgid "And then pressing the <guibutton>Add</guibutton> button."
msgstr ""

#. Tag: title
#: kxsldbg_inspector.docbook:64
#, no-c-format
msgid "Argument Details"
msgstr ""

#. Tag: para
#: kxsldbg_inspector.docbook:66
#, no-c-format
msgid ""
"A file name may be absolute path to a local file. Or partial file (&eg; "
"<filename>xsldoc.xsl</filename>)."
msgstr ""

#. Tag: para
#: kxsldbg_inspector.docbook:71
#, no-c-format
msgid ""
"A template or mode name may is fully Qualified Name where the non-local part "
"is optional &eg; <emphasis>xsl:mytemplate</emphasis> is matched by "
"<emphasis>mytemplate</emphasis>"
msgstr ""

#. Tag: title
#: kxsldbg_inspector.docbook:79
#, no-c-format
msgid "Deleting a Breakpoint"
msgstr ""

#. Tag: para
#: kxsldbg_inspector.docbook:81
#, no-c-format
msgid ""
"Firstly left mouse click the breakpoint you want to delete in the list of "
"current breakpoints. Then click the <guibutton>Delete</guibutton> button."
msgstr ""

#. Tag: title
#: kxsldbg_inspector.docbook:88
#, no-c-format
msgid "Deleting All Breakpoints"
msgstr ""

#. Tag: para
#: kxsldbg_inspector.docbook:90
#, no-c-format
msgid "Click the <guibutton>Delete All</guibutton> button."
msgstr ""

#. Tag: title
#: kxsldbg_inspector.docbook:96
#, no-c-format
msgid "Enabling or Disabling a Breakpoint"
msgstr ""

#. Tag: para
#: kxsldbg_inspector.docbook:98
#, no-c-format
msgid ""
"Firstly &LMB; click the breakpoint you want to delete in the list of current "
"breakpoints. Then click the <guibutton>Enable</guibutton> button."
msgstr ""
