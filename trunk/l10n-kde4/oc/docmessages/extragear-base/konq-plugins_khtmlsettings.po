#. Tag: title
#: index.docbook:49
#, no-c-format
msgid "Using KHTMLSettings"
msgstr ""

#. Tag: para
#: index.docbook:51
#, no-c-format
msgid ""
"The &HTML; settings plugin can be accessed in the &konqueror; menubar under "
"<menuchoice><guimenu>Tools</guimenu><guimenuitem>HTML Settings</guimenuitem>"
"</menuchoice>. Below is a list of the settings and a short description of each "
"one."
msgstr ""

#. Tag: guimenuitem
#: index.docbook:55
#, no-c-format
msgid "JavaScript"
msgstr "JavaScript"

#. Tag: para
#: index.docbook:56
#, no-c-format
msgid "Allows you to turn the use of JavaScript in &konqueror; on or off."
msgstr ""

#. Tag: guimenuitem
#: index.docbook:60
#, no-c-format
msgid "Java"
msgstr "Java"

#. Tag: para
#: index.docbook:61
#, no-c-format
msgid "Allows you to turn the use of &Java; in &konqueror; on or off."
msgstr ""

#. Tag: guimenuitem
#: index.docbook:65
#, no-c-format
msgid "Cookies"
msgstr ""

#. Tag: para
#: index.docbook:66
#, no-c-format
msgid "Allows you to turn the use of Cookies in &konqueror; on or off."
msgstr ""

#. Tag: guimenuitem
#: index.docbook:70
#, no-c-format
msgid "Plugins"
msgstr "Ajustons"

#. Tag: para
#: index.docbook:71
#, no-c-format
msgid ""
"Allows you to turn the use of the &konqueror; plugins you have installed on or "
"off."
msgstr ""

#. Tag: guimenuitem
#: index.docbook:75
#, no-c-format
msgid "Autoload Images"
msgstr ""

#. Tag: para
#: index.docbook:76
#, no-c-format
msgid "Allows you to turn on or off the loading of images in web pages."
msgstr ""

#. Tag: guimenuitem
#: index.docbook:80
#, no-c-format
msgid "Enable Proxy"
msgstr ""

#. Tag: para
#: index.docbook:81
#, no-c-format
msgid "Allows you to enable or disable the use of a proxy in the &konqueror; browser."
msgstr ""

#. Tag: guimenuitem
#: index.docbook:85
#, no-c-format
msgid "Enable Cache"
msgstr ""

#. Tag: para
#: index.docbook:86
#, no-c-format
msgid "Allows you to enable or disable the use of cache in the &konqueror; browser."
msgstr ""

#. Tag: guimenuitem
#: index.docbook:90
#, no-c-format
msgid "Cache Policy"
msgstr ""

#. Tag: para
#: index.docbook:92
#, no-c-format
msgid ""
"The Cache Policy submenu provides you with a way to configure the how "
"&konqueror; uses cache. The possible uses include:"
msgstr ""

#. Tag: para
#: index.docbook:95
#, no-c-format
msgid "Keep Cache in Sync"
msgstr ""

#. Tag: para
#: index.docbook:96
#, no-c-format
msgid "Use Cache if Possible"
msgstr ""

#. Tag: para
#: index.docbook:97
#, no-c-format
msgid "Offline Browsing Mode"
msgstr ""

