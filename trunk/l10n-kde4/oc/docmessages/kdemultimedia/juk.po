"guisubmenu><guimenuitem>Default</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1219
#, no-c-format
msgid "Switches to <link linkend=\"juk-viewmode-default\">Default View mode</link>."
msgstr ""

#. Tag: menuchoice
