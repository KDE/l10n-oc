"<guimenu>View</guimenu><guisubmenu>View Modes</"
"guisubmenu><guimenuitem>Compact</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:1229
#, no-c-format
msgid "Switches to <link linkend=\"juk-viewmode-compact\">Compact View mode</link>."
msgstr ""

#. Tag: menuchoice
