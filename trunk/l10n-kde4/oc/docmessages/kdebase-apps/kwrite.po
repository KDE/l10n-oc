msgstr ""

#. Tag: guilabel
#: index.docbook:2039
#, no-c-format
msgid "Normal text"
msgstr ""

#. Tag: para
#: index.docbook:2040
#, no-c-format
msgid ""
"This is the default background for the editor area, it will be the dominant "
"color on the editor area."
