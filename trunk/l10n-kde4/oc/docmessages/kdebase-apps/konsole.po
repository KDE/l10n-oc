#. Tag: title
#: index.docbook:1009
#, no-c-format
msgid "Command-line Options"
msgstr ""

#. Tag: para
#: index.docbook:1011
#, no-c-format
msgid ""
"When &konsole; is started from the command-line, various options can be "
"specified to modify its behavior."
msgstr ""

#. Tag: option
#: index.docbook:1016
#, no-c-format
msgid "--help"
msgstr "--help"

#. Tag: para
#: index.docbook:1017
#, no-c-format
msgid "<action>List the various options</action>."
msgstr ""

#. Tag: term
#: index.docbook:1021
#, no-c-format
msgid "<option>-e</option> <parameter>command</parameter>"
msgstr ""

#. Tag: para
#: index.docbook:1022
#, no-c-format
msgid ""
"<action>Execute</action> <parameter>command</parameter> instead of the "
"normal shell."
msgstr ""

#. Tag: para
#: index.docbook:1024
#, no-c-format
msgid ""
"Any arguments after <parameter>command</parameter> will be passed to "
"<parameter>command</parameter>, not &konsole;."
msgstr ""

#. Tag: term
#: index.docbook:1030
#, no-c-format
msgid "<option>--keytab</option> <parameter>file</parameter>"
msgstr ""

#. Tag: para
#: index.docbook:1031
#, no-c-format
msgid ""
"<action>Start &konsole; using a specified .keytab file</action> to customize "
"key bindings."
msgstr ""

#. Tag: option
#: index.docbook:1036
#, no-c-format
msgid "--keytabs"
msgstr ""

#. Tag: para
#: index.docbook:1037
#, no-c-format
msgid "<action>List all of the available keytabs</action>."
msgstr ""

#. Tag: option
#: index.docbook:1042
#, no-c-format
msgid "--ls"
msgstr ""

#. Tag: para
#: index.docbook:1043
#, no-c-format
msgid ""
"<action>Start with a login shell environment</action>. What that does varies "
"depending on your system, but generally it means that files such as "
"<filename>~/.profile</filename> or <filename>~/.bash_profile</filename> will "
"be read. (If that doesn't mean anything to you, don't worry about it, but "
"keep in the back of your mind for when you realize you need it.)"
msgstr ""

#. Tag: term
#: index.docbook:1052
#, no-c-format
msgid "<option>--name</option> <parameter>name</parameter>"
msgstr ""

#. Tag: para
#: index.docbook:1053
#, no-c-format
msgid "<action>Set the name that appears in the titlebar</action>."
msgstr ""

#. Tag: option
#: index.docbook:1058
#, no-c-format
msgid "--noclose"
msgstr ""

#. Tag: para
#: index.docbook:1059
#, no-c-format
msgid ""
"<action>Prevent &konsole; from closing</action> when an "
"<userinput><command>exit</command></userinput> command is issued in the only "
"session window."
msgstr ""

#. Tag: option
#: index.docbook:1065
#, no-c-format
msgid "--noframe"
msgstr ""

#. Tag: para
#: index.docbook:1066
#, no-c-format
msgid "<action>Start &konsole; without a frame</action>."
msgstr ""

#. Tag: option
#: index.docbook:1071
#, no-c-format
msgid "--nohist"
msgstr ""

#. Tag: para
#: index.docbook:1072
#, no-c-format
msgid ""
"<action>Disable the saving of lines</action> that scroll off the top of the "
"window."
msgstr ""

#. Tag: option
#: index.docbook:1077
#, no-c-format
msgid "--nomenubar"
msgstr ""

#. Tag: para
#: index.docbook:1078
#, no-c-format
msgid "<action>Start &konsole; with the menubar hidden</action>."
msgstr ""

#. Tag: option
#: index.docbook:1083
#, no-c-format
msgid "--noresize"
msgstr ""

#. Tag: para
#: index.docbook:1084
#, no-c-format
msgid "<action>Disable the resizing</action> of the terminal window."
msgstr ""

#. Tag: option
#: index.docbook:1089
#, no-c-format
msgid "--noscrollbar"
msgstr ""

#. Tag: para
#: index.docbook:1090
#, no-c-format
msgid "<action>Start &konsole; with the scrollbar hidden</action>."
msgstr ""

#. Tag: option
#: index.docbook:1095
#, no-c-format
msgid "--notabbar"
msgstr ""

#. Tag: para
#: index.docbook:1096
#, no-c-format
msgid "<action>Start &konsole; with the tabbar hidden</action>."
msgstr ""

#. Tag: option
#: index.docbook:1101
#, no-c-format
msgid "--noxft"
msgstr ""

#. Tag: para
#: index.docbook:1102
#, no-c-format
msgid ""
"<action>Start &konsole; without Xft antialiasing</action>. Antialiasing of a "
"small font may be difficult to read."
msgstr ""

#. Tag: term
#: index.docbook:1107
#, no-c-format
msgid "<option>--profile</option> <parameter>file</parameter>"
msgstr ""

#. Tag: para
#: index.docbook:1108
#, no-c-format
msgid "<action>Start &konsole; using a saved set of sessions</action>."
msgstr ""

#. Tag: option
#: index.docbook:1112
#, no-c-format
msgid "--profiles"
msgstr ""

#. Tag: action
#: index.docbook:1113
#, no-c-format
msgid "List all of the available profiles."
msgstr ""

#. Tag: term
#: index.docbook:1118
#, no-c-format
msgid ""
"<option>--schema</option> <parameter>name</parameter> | <parameter>file</"
"parameter>"
msgstr ""

#. Tag: para
#: index.docbook:1119
#, no-c-format
msgid ""
"<action>Start &konsole; using schema 'name' or specified in 'file'</action> "
"to customize appearance."
msgstr ""

#. Tag: option
#: index.docbook:1123
#, no-c-format
msgid "--schemata"
msgstr ""

#. Tag: action
#: index.docbook:1124
#, no-c-format
msgid "List all of the available schemata."
msgstr ""

#. Tag: option
#: index.docbook:1129
#, no-c-format
msgid "--script"
msgstr ""

#. Tag: action
#: index.docbook:1130
#, no-c-format
msgid "Enable extended &DCOP; &Qt; functions."
msgstr ""

#. Tag: term
#: index.docbook:1135
#, no-c-format
msgid "<option>-T</option> <parameter>title</parameter>"
msgstr ""

#. Tag: para
#: index.docbook:1136
#, no-c-format
msgid "<action>Set the window title</action>."
msgstr ""

#. Tag: term
#: index.docbook:1140
#, no-c-format
msgid "<option>--tn</option> <parameter>terminal</parameter>"
msgstr ""

#. Tag: para
#: index.docbook:1141
#, no-c-format
msgid ""
"<action>Sets the environment variable TERM to the specified value</action>. "
"Read <userinput><command>man</command> <option>xterm</option> </userinput> "
"for more information on TERM."
msgstr ""

#. Tag: term
#: index.docbook:1147
#, no-c-format
msgid "<option>--type</option> <parameter>type</parameter>"
msgstr ""

#. Tag: para
#: index.docbook:1148
#, no-c-format
msgid ""
"<action>Start a session of the given type</action> rather than the default."
msgstr ""

#. Tag: option
#: index.docbook:1153
#, no-c-format
msgid "--types"
msgstr ""

#. Tag: action
#: index.docbook:1154
#, no-c-format
msgid "List all of the available session types."
msgstr ""

#. Tag: term
#: index.docbook:1159
#, no-c-format
msgid "<option>--vt_sz</option> <parameter>CCxLL</parameter>"
msgstr ""

#. Tag: para
#: index.docbook:1160
#, no-c-format
msgid "<action>Start a terminal window of CC Columns and LL lines</action>."
msgstr ""

#. Tag: term
#: index.docbook:1165
#, no-c-format
msgid "<option>--workdir</option> <parameter>dir</parameter>"
msgstr ""

#. Tag: para
#: index.docbook:1166
#, no-c-format
msgid ""
"<action>Open with</action> <parameter>dir</parameter> as the working folder."
msgstr ""

#. Tag: para
#: index.docbook:1173
#, no-c-format
msgid "Examples:"
msgstr ""

#. Tag: screen
#: index.docbook:1174
#, no-c-format
msgid ""
"<prompt>&percnt;</prompt> <userinput><command>konsole</command> <option>--"
"vt_sz</option> <parameter>90x25</parameter> <option>--nohist</option></"
"userinput>"
msgstr ""

#. Tag: para
#: index.docbook:1176
#, no-c-format
msgid "Starts a &konsole; window with 90 columns and 25 rows, with no history"
msgstr ""

#. Tag: screen
#: index.docbook:1179
#, no-c-format
msgid ""
"<prompt>&percnt;</prompt> <userinput><command>konsole</command> <option>--"
"noclose</option> <option>-e</option> <parameter>echo_args</parameter> "
"<parameter>Hello, thanks for using &konsole;!</parameter></userinput>"
msgstr ""

#. Tag: para
#: index.docbook:1181
#, no-c-format
msgid ""
"Starts a &konsole; window with the text printed 'Hello, thanks for using "
"&konsole;!'"
msgstr ""

#. Tag: para
#: index.docbook:1183
#, no-c-format
msgid "The <parameter>echo_args</parameter> is a simple Bash script:"
msgstr ""

#. Tag: programlisting
#: index.docbook:1184
#, no-c-format
msgid ""
"#!/bin/bash\n"
"echo $*"
msgstr ""

