#: index.docbook:1300
#, no-c-format
msgid ""
"<action>Open with</action> <parameter>dir</parameter> as the working folder."
msgstr ""

#. Tag: para
#: index.docbook:1307
#, no-c-format
msgid "Examples:"
msgstr ""

