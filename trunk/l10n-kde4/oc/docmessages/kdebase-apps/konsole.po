#. Tag: para
#: index.docbook:1230
#, no-c-format
msgid "<action>Start &konsole; with the tabbar hidden</action>."
msgstr ""

#. Tag: option
#: index.docbook:1235
#, no-c-format
msgid "--noxft"
msgstr ""

#. Tag: para
#: index.docbook:1236
#, no-c-format
msgid ""
"<action>Start &konsole; without Xft antialiasing</action>. Antialiasing of a "
"small font may be difficult to read."
msgstr ""

