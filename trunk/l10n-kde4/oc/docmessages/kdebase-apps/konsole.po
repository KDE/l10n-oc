#. Tag: title
#: index.docbook:1143
#, no-c-format
msgid "Command-line Options"
msgstr ""

#. Tag: para
#: index.docbook:1145
#, no-c-format
msgid ""
"When &konsole; is started from the command-line, various options can be "
"specified to modify its behavior."
msgstr ""

#. Tag: option
#: index.docbook:1150
#, no-c-format
msgid "--help"
msgstr ""

#. Tag: para
#: index.docbook:1151
#, no-c-format
msgid "<action>List the various options</action>."
msgstr ""

#. Tag: term
#: index.docbook:1155
#, no-c-format
msgid "<option>-e</option> <parameter>command</parameter>"
msgstr ""

#. Tag: para
#: index.docbook:1156
#, no-c-format
msgid ""
"<action>Execute</action> <parameter>command</parameter> instead of the "
"normal shell."
msgstr ""

#. Tag: para
#: index.docbook:1158
#, no-c-format
msgid ""
"Any arguments after <parameter>command</parameter> will be passed to "
"<parameter>command</parameter>, not &konsole;."
msgstr ""

#. Tag: term
#: index.docbook:1164
#, no-c-format
msgid "<option>--keytab</option> <parameter>file</parameter>"
msgstr ""

#. Tag: para
#: index.docbook:1165
#, no-c-format
msgid ""
"<action>Start &konsole; using a specified .keytab file</action> to customize "
"key bindings."
msgstr ""

#. Tag: option
#: index.docbook:1170
#, no-c-format
msgid "--keytabs"
msgstr ""

#. Tag: para
#: index.docbook:1171
#, no-c-format
msgid "<action>List all of the available keytabs</action>."
msgstr ""

#. Tag: option
#: index.docbook:1176
#, no-c-format
msgid "--ls"
msgstr ""

#. Tag: para
#: index.docbook:1177
#, no-c-format
msgid ""
"<action>Start with a login shell environment</action>. What that does varies "
"depending on your system, but generally it means that files such as "
"<filename>~/.profile</filename> or <filename>~/.bash_profile</filename> will "
"be read. (If that doesn't mean anything to you, don't worry about it, but "
"keep in the back of your mind for when you realize you need it.)"
msgstr ""

#. Tag: term
#: index.docbook:1186
#, no-c-format
msgid "<option>--name</option> <parameter>name</parameter>"
msgstr ""

#. Tag: para
#: index.docbook:1187
#, no-c-format
msgid "<action>Set the name that appears in the titlebar</action>."
msgstr ""

#. Tag: option
#: index.docbook:1192
#, no-c-format
msgid "--noclose"
msgstr ""

#. Tag: para
#: index.docbook:1193
#, no-c-format
msgid ""
"<action>Prevent &konsole; from closing</action> when an "
"<userinput><command>exit</command></userinput> command is issued in the only "
"session window."
msgstr ""

#. Tag: option
#: index.docbook:1199
#, no-c-format
msgid "--noframe"
msgstr ""

#. Tag: para
#: index.docbook:1200
#, no-c-format
msgid "<action>Start &konsole; without a frame</action>."
msgstr ""

#. Tag: option
#: index.docbook:1205
#, no-c-format
msgid "--nohist"
msgstr ""

#. Tag: para
#: index.docbook:1206
#, no-c-format
msgid ""
"<action>Disable the saving of lines</action> that scroll off the top of the "
"window."
msgstr ""

#. Tag: option
#: index.docbook:1211
#, no-c-format
msgid "--nomenubar"
msgstr ""

#. Tag: para
#: index.docbook:1212
#, no-c-format
msgid "<action>Start &konsole; with the menubar hidden</action>."
msgstr ""

#. Tag: option
#: index.docbook:1217
#, no-c-format
msgid "--noresize"
