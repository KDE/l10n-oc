#. Tag: link
#: kdevelop-survey.docbook:104
#, no-c-format
msgid "<link>Child Frame Windows</link>"
msgstr ""

#. Tag: para
#: kdevelop-survey.docbook:106 kdevelop-survey.docbook:114
#, no-c-format
msgid "All tool views are initially docked to the mainframe."
msgstr ""

#. Tag: para
#: kdevelop-survey.docbook:107
#, no-c-format
msgid ""
"Editor and browser views will live like toplevel windows within a view area "
"of the mainframe."
msgstr ""

#. Tag: link
