#. Tag: title
#: commands.docbook:17
#, no-c-format
msgid "Command Reference"
msgstr ""

#. Tag: para
#: commands.docbook:19
#, no-c-format
msgid ""
"The shortcut key combinations shown in this chapter are the default ones. "
"They can be changed."
msgstr ""

#. Tag: title
#: commands.docbook:26
#, no-c-format
msgid "The Menubar"
msgstr ""

#. Tag: para
#: commands.docbook:26
#, no-c-format
msgid ""
"Note that some menu entries only appear when they are applicable. "
"Especially, some entries are linked to <link linkend=\"plugin-tools"
"\">plugin</link> functionality which is only available when the plugin is "
"enabled."
msgstr ""

#. Tag: title
#: commands.docbook:39
#, no-c-format
msgid "The <guimenu>File</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: commands.docbook:43
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem><accel>N</accel>ew</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:50
#, no-c-format
msgid ""
"Creates a new file. The user is prompted to select the directory (default: "
"the current project's source directory) and enter a file name. The file type "
"can be selected from a list. Also, the user can choose whether the file is "
"to be added to the project. Then the Automake Manager asks which target to "
"add the new file to."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:59
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>O</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem><accel>O</accel>pen</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:66
#, no-c-format
msgid "Opens an existing file in a simple dialog box."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:71
#, no-c-format
msgid ""
"<guimenu>File</guimenu> <guimenuitem>Open <accel>R</accel>ecent</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:75
#, no-c-format
msgid ""
"For opening the most recently edited files. Once you have clicked on this "
"option, a list of recently edited files will appear. Select the file you "
"want and KWord will open the file."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:80
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Alt;&Ctrl;<keycap>O</keycap></"
"keycombo> </shortcut> <guimenu>File</guimenu> <guimenuitem>Quick Open "
"<accel>F</accel>ile</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:87
#, no-c-format
msgid ""
"Presents a list of files in the current project's source directory. The user "
"can select from this list or type a filename. That file is then opened."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:95
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem><accel>S</accel>ave</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:102
#, no-c-format
msgid "Saves the current file."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:107
#, no-c-format
msgid ""
"<guimenu>File</guimenu> <guimenuitem>Save <accel>A</accel>s...</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:111
#, no-c-format
msgid ""
"Uses the <guilabel>Save As...</guilabel> dialog box to let you save a copy "
"under a new name."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:117
#, no-c-format
msgid ""
"<guimenu>File</guimenu> <guimenuitem>Save Al<accel>l</accel></guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:121
#, no-c-format
msgid "Saves all open files."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:125
#, no-c-format
msgid ""
"<shortcut><keycap>F5</keycap></shortcut> <guimenu>File</guimenu> "
"<guimenuitem>Reloa<accel>d</accel></guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:130
#, no-c-format
msgid ""
"Reloads current file to show changes made by different programs. (Note that "
"such changes are normally detected automatically and the user is prompted "
"whether the file is to be reloaded.) ."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:138
#, no-c-format
msgid ""
"<guimenu>File</guimenu> <guimenuitem>Rever<accel>t</accel> all</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:142
#, no-c-format
msgid ""
"Reverts all changes in opened files. Prompts to save changes so the "
"reversion can be canceled for each modified file."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:152
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem><accel>P</accel>rint...</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:159
#, no-c-format
msgid "Prints the current file."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:163
#, no-c-format
msgid ""
"<guimenu>File</guimenu> <guimenuitem>E<accel>x</accel>port</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:167
#, no-c-format
msgid ""
"Exports the current file. Currently the following export formats are "
"supported: <variablelist> <varlistentry><term>HTML</"
"term><listitem><para>Syntax-highlighted HTML file</para></listitem></"
"varlistentry> </variablelist> Other formats may follow in future KDevelop "
"versions."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:180
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>F4</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem><accel>C</accel>lose</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:187
#, no-c-format
msgid "Closes current file."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:194
#, no-c-format
msgid ""
"<guimenu>File</guimenu> <guimenuitem>Clos<accel>e</accel> All</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:198
#, no-c-format
msgid "Closes all open files."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:205
#, no-c-format
msgid ""
"<guimenu>File</guimenu> <guimenuitem>Close All Ot<accel>h</accel>ers</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:209
#, no-c-format
msgid ""
"Closes all files except the current one. Very useful if you opened a lot of "
"files and you want to concentrate on the current one. Without this, you "
"would have to close them all and re-open the current one."
msgstr ""

#. Tag: para
#: commands.docbook:216
#, no-c-format
msgid "Note there is a similar command in the Window menu."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:222
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem><accel>Q</accel>uit</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:229
#, no-c-format
msgid "Quits KDevelop."
msgstr ""

#. Tag: title
#: commands.docbook:242
#, no-c-format
msgid "The <guimenu>Edit</guimenu> Menu"
msgstr ""

#. Tag: para
#: commands.docbook:244
#, no-c-format
msgid ""
"Most of the following commands operate on the current file, also simply "
"called \"document\"."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:253
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem><accel>U</accel>ndo</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:260
#, no-c-format
msgid "Reverses the last action you performed."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:267
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>Z</keycap></"
"keycombo> </shortcut> <guimenu>Edit</guimenu> <guimenuitem>Re<accel>d</"
"accel>o</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:274
#, no-c-format
msgid "Reverses the last Undo performed."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:281
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>X</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Cu<accel>t</accel></"
"guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:288
#, no-c-format
msgid ""
"Deletes the selected (highlighted) text from the document, and places a copy "
"in the clipboard."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:295
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem><accel>C</accel>opy</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:302
#, no-c-format
msgid "Places a copy of the selected text in the clipboard."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:309
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>V</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem><accel>P</accel>aste</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:316
#, no-c-format
msgid ""
"Inserts a copy of the clipboard into the current cursor position. If there "
"is selected text, KDevelop replaces it with the contents of the clipboard. "
"The clipboard is not altered."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:325
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>A</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Select <accel>A</accel>ll</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:332
#, no-c-format
msgid "Immediately selects all text of the current file."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:339
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>A</keycap></"
"keycombo> </shortcut> <guimenu>Edit</guimenu> <guimenuitem>Dese<accel>l</"
"accel>ect</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:346
#, no-c-format
msgid ""
"Every simple cursor movement (e.g. left, right etc. without Shift pressed) "
"deselects at the same time, i.e. if there was highlighted text before, after "
"the cursor action it will appear non-highlighted again. This command does an "
"explicit Deselect without cursor action."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:356
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>B</keycap></"
"keycombo> </shortcut> <guimenu>Edit</guimenu> <guimenuitem>Bl<accel>o</"
"accel>ck Selection Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:363
#, no-c-format
msgid ""
"KDevelop's editor can operate linewise or block-oriented. Linewise means: "
"Text is seen as a sequence of characters that may span several lines. A "
"selection ranges from the first to the last character and includes all lines "
"in-between completely."
msgstr ""

#. Tag: para
#: commands.docbook:368
#, no-c-format
msgid ""
"Block-oriented means: Text is seen as a rectangular matrix. You can select a "
"rectangular block (called rectangle in (X)Emacs) that leaves out the "
"beginnings and ends of all lines. The commands Cut and Copy then operate "
"only on that block, and place it in the clipboard."
msgstr ""

#. Tag: para
#: commands.docbook:374
#, no-c-format
msgid ""
"Thus you can e.g. indent all lines of a block: Select the block, Cut it, "
"then place the cursor in the first line at the beginning of the area you "
"want to put the block, e.g. 3 characters to the right of the old position. "
"There, Paste it, and all lines will be indented."
msgstr ""

#. Tag: para
#: commands.docbook:381
#, no-c-format
msgid ""
"This would be very useful if it honored the overwrite flag (e.g. block "
"comment). It doesn't, and I see this as a bug. TODO: - report bug - work out "
"more examples how block mode is useful (extra chapter?) - links to alternate "
"methods (for indent: Edit - Reformat Source, comment)"
msgstr ""

#. Tag: menuchoice
#: commands.docbook:395
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\"><keycap>Insert</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Overwr<accel>i</accel>te "
"Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:402
#, no-c-format
msgid "Toggles Insert/Overwrite Mode."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:409
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>F</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem><accel>F</accel>ind</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:416
#, no-c-format
msgid ""
"Calls the Find dialog box. You can search simple text or a regular "
"expression."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:424
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\"><keycap>F3</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find <accel>N</accel>ext</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:431
#, no-c-format
msgid ""
"After first using Find (see above), finds the same text or regular "
"expression again."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:439
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Shift;<keycap>F3</keycap></keycombo> "
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find Pre<accel>v</"
"accel>ious</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:446
#, no-c-format
msgid ""
"After first using Find (see above), finds the same text or regular "
"expression again, searching upwards."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:454
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>R</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem><accel>R</accel>eplace</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:461
#, no-c-format
msgid ""
"Opens the Find/Replace dialog box. You can search simple text or a regular "
"expression. You can replace by simple text or placeholders of the regular "
"expression."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:471
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>G</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem><accel>G</accel>o to Line</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:478
#, no-c-format
msgid ""
"Prompts for a line number and jumps to that line. You can show/hide line "
"numbers with View - Show/Hide Line Numbers (F11)."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:486
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Alt;&Ctrl;<keycap>F</keycap></"
"keycombo> </shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find in "
"Fi<accel>l</accel>es</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:493
#, no-c-format
msgid ""
"Finds text in several Files, like the grep Unix command. Matches will be "
"displayed, and you can switch to a match directly. TODO!!!"
msgstr ""

#. Tag: menuchoice
#: commands.docbook:502
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>R</keycap></"
"keycombo> </shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find-<accel>S</"
"accel>elect-Replace</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:509
#, no-c-format
msgid ""
"Opens the project wide string replacement dialog. There you can enter a "
"string or a regular expression which is then searched for within all files "
"in the locations you specify. Matches will be displayed in the Replace "
"window, you can replace them with the specified string, exclude them from "
"replace operation or cancel the whole replace."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:522
#, no-c-format
msgid ""
"<guimenu>Edit</guimenu> <guimenuitem><accel>R</accel>eformat Source</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:526
#, no-c-format
msgid ""
"Reformats Source code using the astyle library. If there is a selection, "
"only the selection will be formatted. Otherwise the entire file will be "
"formatted."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:535
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>J</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem><accel>E</accel>xpand Text</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:542
#, no-c-format
msgid ""
"A list of reasonable completions of the current word is presented, the user "
"can select one of them, and this is then placed in the text. For example, if "
"the user has typed \"whi\" and calls this command, \"while\" and \"while ( ) "
"{ }\" are offered. If the user selects the latter, the whole structure of a "
"while command is entered and the cursor is placed in the brackets to enter "
"the condition. TODO: BUG: Ctrl-J doesn't work"
msgstr ""

#. Tag: menuchoice
#: commands.docbook:555
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>L</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>E<accel>x</accel>pand "
"Abbreviation</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:562
#, no-c-format
msgid ""
"Expands abbreviation. Abbreviations can be defined in Settings - Configure "
"KDevelop - Abbreviations."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:570
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Space</keycap></"
"keycombo> </shortcut> <guimenu>Edit</guimenu> <guimenuitem>Complete Text</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:577
#, no-c-format
msgid ""
"Completes current expression using memory class store for the current "
"project and persistant class stores for external libraries. TODO"
msgstr ""

#. Tag: menuchoice
#: commands.docbook:586
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\"><keycap>F2</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem><accel>M</accel>ake Member</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:593
#, no-c-format
msgid ""
"Creates a class member function in implementation file based on the member "
"declaration at the current line. TODO"
msgstr ""

#. Tag: title
#: commands.docbook:611
#, no-c-format
msgid "The <guimenu>View</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: commands.docbook:615
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Back</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:619
#, no-c-format
msgid "Moves back in the list of tabs."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:626
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Forward</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:630
#, no-c-format
msgid "Moves forward in the list of tabs."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:637
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>/</keycap></keycombo> </"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Switch to...</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:644
#, no-c-format
msgid "Presents a dialog box to select a tab buffer an moves there."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:651
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Alt;<keycap>C</keycap></keycombo> </"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Raise Editor</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:658
#, no-c-format
msgid "Places the focus on the editor."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:665
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\"><keycap>F4</keycap></keycombo> </"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Next Error</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:672
#, no-c-format
msgid ""
"Switches to the file and line the next (compilation) error was reported from."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:680
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Shift;<keycap>F4</keycap></keycombo> "
"</shortcut> <guimenu>View</guimenu> <guimenuitem>Previous Error</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:687
#, no-c-format
msgid ""
"Switches to the file and line the previous (compilation) error was reported "
"from."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:695
#, no-c-format
msgid ""
