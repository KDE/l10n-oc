#: app-files.docbook:61
#, no-c-format
msgid "<link>Stand-alone Applications</link>"
msgstr ""

#. Tag: link
#: app-files.docbook:62
#, no-c-format
msgid "<link>Task Specific Parts</link>"
msgstr ""

#. Tag: link
#: app-files.docbook:63
#, no-c-format
msgid "<link>Project Generation Parts</link>"
msgstr ""

