msgstr ""

#. Tag: para
#: app-files.docbook:83
#, no-c-format
msgid ""
"<filename class=\"directory\">kdevdesigner/</filename> and <filename class="
"\"directory\">kdevdesignerpart/</filename> &mdash; provide menu bar and tool "
"bars of the stand-alone &kdevelop; user interface designer."
msgstr ""

