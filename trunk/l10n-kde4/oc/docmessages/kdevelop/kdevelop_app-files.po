msgstr ""

#. Tag: para
#: app-files.docbook:74
#, no-c-format
msgid ""
"<filename class=\"directory\">licenses/</filename> &mdash; contains various "
"licenses texts."
msgstr ""

#. Tag: para
#: app-files.docbook:75
#, no-c-format
msgid ""
