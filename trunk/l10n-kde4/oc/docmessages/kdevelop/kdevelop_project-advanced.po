msgid "Converting Old KDevelop Project Files"
msgstr ""

#. Tag: para
#: project-advanced.docbook:47
#, no-c-format
msgid ""
"&kdevelop; allows you to open old KDevelop 2.x project files and convert "
"them to &kdevelop; files. To do so go to <guimenuitem>Open Project...</"
"guimenuitem> and select <guilabel>KDevelop 2 project files</guilabel> in the "
"<guilabel>Filter:</guilabel>. Then select project file you want to open. The "
"project gets converted to &kdevelop; and saved as a <guilabel>&kdevelop; "
"project file</guilabel>."
msgstr ""

