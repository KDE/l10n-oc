#: kdevelop-install.docbook:374
#, no-c-format
msgid "LD_LIBRARY_PATH"
msgstr ""

#. Tag: primary
#: kdevelop-install.docbook:376
#, no-c-format
msgid "LIBRARY_PATH"
msgstr ""

#. Tag: primary
#: kdevelop-install.docbook:378
#, no-c-format
