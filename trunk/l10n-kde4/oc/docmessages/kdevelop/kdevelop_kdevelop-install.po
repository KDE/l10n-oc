#. Tag: primary
#: kdevelop-install.docbook:370
#, no-c-format
msgid "KDEDIR"
msgstr ""

#. Tag: primary
#: kdevelop-install.docbook:372
#, no-c-format
msgid "QTDIR"
msgstr ""

