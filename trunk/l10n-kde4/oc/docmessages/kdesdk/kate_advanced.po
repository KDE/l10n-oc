msgstr ""

#. Tag: para
#: advanced.docbook:1108 advanced.docbook:1127
#, no-c-format
msgid "<parameter>line</parameter> Specifies the line for the cursor."
msgstr ""

#. Tag: para
#: advanced.docbook:1110 advanced.docbook:1129
#, no-c-format
msgid "<parameter>column</parameter> Specifies the column for the cursor."
msgstr ""

#. Tag: para
#: advanced.docbook:1113
#, no-c-format
msgid ""
"Sets the input cursor position in the view to [<parameter>line</parameter>, "
"<parameter>col</parameter>]. This sets the cursor position by visual means, "
"that is the a TAB character counts up to <replaceable>tabwidth</replaceable> "
"depending on the position inside the line. The cursor position is made "
"visible. Both line and column are zero-based."
msgstr ""

#. Tag: function
#: advanced.docbook:1122
#, no-c-format
msgid ""
"view.setCursorPositionReal( <parameter>uint line</parameter>, "
"<parameter>uint column</parameter> ); [function]"
msgstr ""

#. Tag: para
#: advanced.docbook:1132
#, no-c-format
msgid ""
"Sets the input cursor position to [<parameter>line</parameter>, "
"<parameter>col</parameter>]. This sets the string position, that is a TAB "
"character counts for 1. The cursor position is made visible. Both line and "
"column are zero-based."
msgstr ""

#. Tag: function
#: advanced.docbook:1140
#, no-c-format
msgid ""
