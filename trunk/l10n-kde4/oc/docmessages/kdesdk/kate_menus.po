#. Tag: title
#: menus.docbook:8 menus.docbook:283
#, no-c-format
msgid "Menu Entries"
msgstr ""

#. Tag: title
#: menus.docbook:11
#, no-c-format
msgid "The <guimenu>File</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:17
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>New</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:26
#, no-c-format
msgid ""
"This command <action>starts a new document</action> in the editing window. "
"In the <guibutton>Documents</guibutton> list on the left the new file is "
"named <emphasis>Untitled</emphasis>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:37
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>O</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Open...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:46
#, no-c-format
msgid "Launches &kde;'s open file dialog box to let you open one or more files."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:55
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Open Recent</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:61
#, no-c-format
msgid ""
"This command allows you to <action>open a file</action> from a submenu that "
"contains a list of recently edited files."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:71
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Open With</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:77
#, no-c-format
msgid ""
"This submenu presents a list of applications known to handle the mime type "
"of your current document. Activating an entry will open the current document "
"with that application."
msgstr ""

#. Tag: para
#: menus.docbook:81
#, no-c-format
msgid ""
"In addition, a entry <guimenuitem>Other...</guimenuitem> command launches "
"the open with dialog box that allows you to <action>select another "
"application to open the active file</action>. Your file will still be open "
"in &kate;."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:91
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Save</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:100
#, no-c-format
msgid ""
"This command <action>saves your file</action>. Use it often. If the file is "
"<emphasis>Untitled</emphasis> then <guimenuitem>Save</guimenuitem> becomes "
"<guimenuitem>Save As</guimenuitem>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:112
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Save As...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:118
#, no-c-format
msgid ""
"<action>Name and rename files</action> with this command. It launches the "
"save file dialog box. This dialog works just as the open file dialog box "
"does. You can use it to navigate through your file system, preview existing "
"files, or filter your file view with file masks."
msgstr ""

#. Tag: para
#: menus.docbook:126
#, no-c-format
msgid ""
"Type the name you want to give the file you are saving in the Location combo "
"box and press the <guibutton>OK</guibutton> button."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:137
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>L</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Save All</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:146
#, no-c-format
msgid "This command <action>saves all modified open files</action>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:155
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\"><keycap>F5</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Reload</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:164
#, no-c-format
msgid ""
"<action>Reloads the active file</action>. This command is useful if another "
"program or process has changed the file while you have it open in &kate;"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:175
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Print...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:184
#, no-c-format
msgid "<action>Print the active file</action>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:192
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Export as HTML...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:198
#, no-c-format
msgid "Export your file in HTML format so your document can be viewed as a web page."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:207
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Mail...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:213
#, no-c-format
msgid "Open your mail client and attach the file in the mail."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:222
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>W</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Close</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:231
#, no-c-format
msgid ""
"<action>Close the active file</action> with this command. If you have made "
"unsaved changes, you will be prompted to save the file before &kate; closes "
"it."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:242
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Close All</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:248
#, no-c-format
msgid "This command <action>closes all the files you have open</action> in &kate;."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:258
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:267
#, no-c-format
msgid ""
"This command <action>closes &kate;</action> and any files you were editing. "
"If you have made unsaved changes to any of the files you were editing, you "
"will be prompted to save them."
msgstr ""

#. Tag: title
#: menus.docbook:278
#, no-c-format
msgid "The <guimenu>Edit</guimenu> Menu"
msgstr ""

#. Tag: para
#: menus.docbook:279
#, no-c-format
msgid ""
"The <guimenu>Edit</guimenu> menu contains a host of commands, all to work "
"with the currently active document."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:287
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Undo</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:294
#, no-c-format
msgid "Undo the last editing command (typing, copying, cutting etc.)"
msgstr ""

#. Tag: para
#: menus.docbook:295
#, no-c-format
msgid ""
"If grouped undo is enabled, this may undo several editing commands of the "
"same type, like typing in characters."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:302
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>Z</keycap></"
"keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Redo</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:309
#, no-c-format
msgid "Redo the last undo step."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:316
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>X</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Cut</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:323
#, no-c-format
msgid ""
"Removes selected text if any, and places a copy of the removed text in the "
"clipboard."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:330
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Copy</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:337
#, no-c-format
msgid "Copies selected text, if any, to the clipboard."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:344
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Copy as HTML</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:350
#, no-c-format
msgid "Copies selected text with the syntax highlight as HTML text."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:357
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>V</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Paste</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:364
#, no-c-format
msgid "Copies the first item in the clipboard into the editor at cursor position."
msgstr ""

#. Tag: para
#: menus.docbook:365
#, no-c-format
msgid ""
"If Overwrite Selection is enabled, the pasted text will overwrite the "
"selection, if any."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:372
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>A</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Select All</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:379
#, no-c-format
msgid "Selects all text in the editor."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:386
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>A</keycap></"
"keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Deselect</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:393
#, no-c-format
msgid "Deselects the selected text in the editor if any."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:400
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Shift</keycap> <keycap>B</"
"keycap></keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Block "
"Selection Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:408
#, no-c-format
msgid ""
"Toggles Selection Mode. When the Selection Mode is <quote>BLOCK</quote>, you "
"can make vertical selections, ie select column 5 to 10 in lines 9 to 15."
msgstr ""

#. Tag: para
#: menus.docbook:410
#, no-c-format
msgid ""
"The status bar shows the current state of the Selection Mode, either "
"<quote>NORM</quote> or <quote>BLK</quote>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:417
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>F</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:424
#, no-c-format
msgid ""
"Launch the Find Dialog to allow you to search for text in the edited "
"document."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:431
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F3</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find Next</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:438
#, no-c-format
msgid ""
"Go to the nearest downwards match of the last text or regular expression "
"searched for, starting from cursor position"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:445
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Shift;<keycap>F3</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find Previous</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:452
#, no-c-format
msgid ""
"Go to the nearest upwards match of the last text or regular expression "
"searched for, starting from cursor position"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:459
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>R</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Replace...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:466
#, no-c-format
msgid ""
"Launch the Replace Dialog to replace one or more instances of a defined text "
"with something else."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:473
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>G</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Go to line...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:480
#, no-c-format
msgid ""
"Launches the Go To Line Dialog, allowing you to enter the number of a line "
"to find in the document"
msgstr ""

#. Tag: title
#: menus.docbook:490
#, no-c-format
msgid "The <guimenu>Document</guimenu> Menu"
msgstr ""

#. Tag: para
#: menus.docbook:491
#, no-c-format
msgid ""
"The Document menu provides a menu entry for each open document. Clicking one "
"of these will bring the requested document to focus. If you have multiple "
"frames, an editor for that document will be displayed in the currently "
"active frame."
msgstr ""

#. Tag: para
#: menus.docbook:495
#, no-c-format
msgid "In addition, commands to browse your open documents are provided:"
msgstr ""

#. Tag: title
#: menus.docbook:497
#, no-c-format
msgid "Menu items"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:502
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Alt;<keycap>Left</keycap></keycombo></"
"shortcut> <guimenu>Document</guimenu> <guimenuitem>Back</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:509
#, no-c-format
msgid ""
"This will bring the previous document in the stack in focus. If you have "
"multiple frames, an editor for the document will be displayed in the "
"currently active frame."
msgstr ""

#. Tag: para
#: menus.docbook:511
#, no-c-format
msgid ""
"The order is the order in which documents were opened, rather than a logical "
"history. This behavior may change in future versions of &kate;."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:520
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Alt;<keycap>Right</keycap></keycombo></"
"shortcut> <guimenu>Document</guimenu> <guimenuitem>Forward</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:527
#, no-c-format
msgid ""
"This will bring the next document in the stack in focus. If you have "
"multiple frames, an editor for the document will be displayed in the "
"currently active frame."
msgstr ""

#. Tag: para
#: menus.docbook:530
#, no-c-format
msgid ""
"The order is the order in which the documents were opened, rather than a "
"logical history. This behavior may change in future versions of &kate;."
msgstr ""

#. Tag: title
#: menus.docbook:540
#, no-c-format
msgid "The <guimenu>View</guimenu> menu"
msgstr ""

#. Tag: para
#: menus.docbook:542
#, no-c-format
msgid ""
"The <guimenu>View</guimenu> menu allows you to manage settings specific to "
"the active editor, and to manage frames."
msgstr ""

#. Tag: title
#: menus.docbook:546 menus.docbook:698
#, no-c-format
msgid "Menu Items"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:549
#, no-c-format
msgid ""
"<shortcut><keycap>F7</keycap></shortcut> <guimenu>View</"
"guimenu><guimenuitem>Switch to Command Line</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:552
#, no-c-format
msgid ""
"This command will toggle the display of the <link linkend=\"advanced-editing-"
"tools-commandline\">built in command line</link>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:558
#, no-c-format
msgid "<guimenu>View</guimenu><guisubmenu>Schema</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:560
#, no-c-format
msgid ""
"This menu lists the available schemas. You can change the schema for the "
"current view here, to change the default schema you need to use the <link "
"linkend=\"config-dialog-editor-colors\">config dialog</link>"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:567
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F10</keycap> </keycombo></"
"shortcut> <guimenu>View</guimenu><guimenuitem>Dynamic Word Wrap</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:571
#, no-c-format
msgid ""
"Toggles dynamic word wrap in the current view. Dynamic word wrap makes all "
"the text in a view visible without the need for horizontal scrolling by "
"rendering one actual line on more visual lines as needed."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:578
#, no-c-format
msgid ""
"<guimenu>View</guimenu><guimenuitem>Show/Hide Static Word Wrap Marker</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:580
#, no-c-format
msgid ""
"Toggles the display of a vertical line indicating the position of the wrap "
"width as configured in the <link linkend=\"config-dialog-editor-wrap-words-at"
"\">config dialog</link>. This feature requires that you use a true fixed-"
"width font."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:590
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F6</keycap></keycombo></"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Show/Hide Icon Border</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:597
#, no-c-format
msgid ""
"This is a toggle item. Setting it on checked will make the Icon Border "
"visible in the left side of the active editor, and vice versa."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:605
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F11</keycap></keycombo></"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Show/Hide Line Numbers</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:612
#, no-c-format
msgid ""
"This is a toggle Item. Setting it on checked will make a pane displaying the "
"line numbers of the document visible in the left border of the active "
"editor, and vice versa."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:619
#, no-c-format
msgid "<guimenu>View</guimenu><guimenuitem>Show/Hide Scrollbar Marks</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:621
#, no-c-format
msgid ""
"Toggles the visualization of bookmarks (and other marks) on the vertical "
"scrollbar. When enabled, marks are represented by a thin line in the mark "
"color at the scrollbar, middleclicking on the lines will scroll the view to "
"a position near the mark."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:628
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F9</keycap> </keycombo></"
"shortcut> <guimenu>View</guimenu><guimenuitem>Show/Hide Folding Markers</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:632
#, no-c-format
msgid ""
"Toggles the display of the folding marker pane in the left side of the view. "
"See <link linkend=\"advanced-editing-tools-code-folding\">Using Code "
"Folding</link>."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:641
#, no-c-format
msgid "Code Folding"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:648
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl; <keycap>Shift</keycap><keycap>-</"
"keycap></keycombo></shortcut> <guimenuitem>Collapse Toplevel</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:652
#, no-c-format
msgid "Collapse all toplevel regions in the document."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:655
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl; <keycap>Shift</keycap><keycap>+</"
"keycap></keycombo></shortcut> <guimenuitem>Expand Toplevel</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:659
#, no-c-format
msgid "Expand all toplevel regions in the document."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:662
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl; <keycap>-</keycap></keycombo></"
"shortcut> <guimenuitem>Collapse One Local Level</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:666
#, no-c-format
msgid "Collapse the region closest to the cursor."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:669
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl; <keycap>+</keycap></keycombo></"
"shortcut> <guimenuitem>Expand One Local Level</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:673
#, no-c-format
msgid "Expand the region closest to the cursor."
msgstr ""

#. Tag: title
#: menus.docbook:685
#, no-c-format
msgid "The <guimenu>Bookmarks</guimenu> Menu"
msgstr ""

#. Tag: para
#: menus.docbook:687
#, no-c-format
msgid ""
"The <guimenu>Bookmarks</guimenu> menu allows you to work with the bookmarks "
"in the currently active document."
msgstr ""

#. Tag: para
#: menus.docbook:690
#, no-c-format
msgid ""
"Below the entries described here, one entry for each bookmark in the active "
"document will be available. The text will be the first few words of the "
"marked line. Choose an item to move the cursor to the start of that line. "
"The editor will scroll as necessary to make that line visible."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:703
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>B</keycap></keycombo></"
"shortcut> <guimenu>Bookmarks</guimenu> <guimenuitem>Set/Clear Bookmark</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:710
#, no-c-format
msgid ""
"Sets or removes a bookmark in the current line of the active document. (If "
"it's there, it is removed, otherwise one is set.)"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:718
#, no-c-format
msgid "<guimenu>Bookmarks</guimenu> <guimenuitem>Clear All Bookmarks</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:724
#, no-c-format
msgid "Clears (removes) all bookmarks in the active document."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:729
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Alt; <keycap>Page Up</keycap></"
"keycombo></shortcut> <guimenu>Bookmarks</guimenu><guimenuitem>Previous</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:733
#, no-c-format
msgid ""
"This will move the cursor to beginning of the first above line with a "
"bookmark. The menuitem text will include the line number and the first piece "
"of text on the line. This item is only available when there is a bookmark in "
"a line above the cursor."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:740
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Alt; <keycap>Page Down</keycap></"
"keycombo></shortcut> <guimenu>Bookmarks</guimenu><guimenuitem>Next</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:743
#, no-c-format
msgid ""
"This will move the cursor to beginning of the next line with a bookmark. The "
"menuitem text will include the line number and the first piece of text on "
"the line. This item is only available when there is a bookmark in a line "
"below the cursor."
msgstr ""

#. Tag: title
#: menus.docbook:755
#, no-c-format
msgid "The <guimenu>Tools</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:760
#, no-c-format
msgid "<guimenu>Tools</guimenu><guimenuitem>Pipe to Console</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:762
#, no-c-format
msgid ""
"Feed the currently selected text ito the built in terminal emulator. No "
"newline is added after the text."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:767
#, no-c-format
msgid "<guimenu>Tools</guimenu><guisubmenu>External Tools</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:769
#, no-c-format
msgid ""
"This submenu contains all the <link linkend=\"kate-mdi-tools-externaltools"
"\">external tools</link>you have configured."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:775
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Read Only Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:779
#, no-c-format
msgid ""
"Set the current document to Read Only mode. This prevents any text addition "
"and any changes in the document formatting."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:785
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Filletype</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:789
#, no-c-format
msgid ""
"Choose the filetype scheme you prefer for the active document. This "
"overwrites the global <link linkend=\"config-dialog-editor-filetypes"
"\">filetype</link> mode set in <menuchoice> <guimenu>Settings</guimenu> "
"<guimenuitem>Configure Editor...</guimenuitem></menuchoice> in the Filetypes "
"tab for your current document only."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:798
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Highlighting</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:802
#, no-c-format
msgid ""
"Choose the Highlighting scheme you prefer for the active document. This "
"overwrites the global highlighting mode set in <menuchoice> "
"<guimenu>Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem> </"
"menuchoice> for your current document only."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:810
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Indentation</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:814
#, no-c-format
msgid ""
"Choose the <link linkend=\"kate-part-autoindent\">style of indentation</"
"link> you want for your active document. This overwrites the global "
"indentation mode set in <menuchoice> <guimenu>Settings</guimenu> "
"<guimenuitem>Configure Editor...</guimenuitem> </menuchoice> for your "
"current document only."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:823
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Encoding</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:827
#, no-c-format
msgid ""
"You can overwrite the default encoding set in <menuchoice> "
"<guimenu>Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem></"
"menuchoice> in the <guilabel>Open/Save</guilabel> tab to set a different "
"encoding for your current document. The encoding you set here will be only "
"valid for your current document."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:837
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>End of Line</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:841
#, no-c-format
msgid ""
"Choose your prefered end of line mode for your active document. This "
"overwrites the global end of line mode set in <menuchoice> "
"<guimenu>Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem> </"
"menuchoice> for your current document only."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:849
#, no-c-format
msgid "<guimenu>Tools</guimenu><guimenuitem>Spelling...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:853
#, no-c-format
msgid ""
"<action>This initiates the spellchecking program &ndash; a program designed "
"to help the user catch and correct any spelling errors.</action> Clicking on "
"this entry will start the checker and bring up the speller dialog box "
"through which the user can control the process. There are four settings "
"lined up vertically in the center of the dialog with their corresponding "
"labels just to the left. Starting at the top they are:"
msgstr ""

#. Tag: guilabel
#: menus.docbook:862
#, no-c-format
msgid "Unknown word:"
msgstr ""

#. Tag: para
#: menus.docbook:863
#, no-c-format
msgid ""
"Here, the spellchecker indicates the word currently under consideration. "
"This happens when the checker encounters a word not in its dictionary "
"&ndash; a file containing a list of correctly spelled words against which it "
"compares each word in the editor."
msgstr ""

#. Tag: guilabel
#: menus.docbook:869
#, no-c-format
msgid "Replace with:"
msgstr ""

#. Tag: para
#: menus.docbook:870
#, no-c-format
msgid ""
"If the checker has any similar words in its dictionary the first one will be "
"listed here. The user can accept the suggestion, type in his or her own "
"correction, or choose a different suggestion from the next box."
msgstr ""

#. Tag: guilabel
#: menus.docbook:876
#, no-c-format
msgid "Suggested Words:"
msgstr ""

#. Tag: para
#: menus.docbook:877
#, no-c-format
msgid ""
"The checker may list here a number of possible replacements for the word "
"under consideration. Clicking on any one of the suggestions will cause that "
"word to be entered in the <guilabel>Replacement:</guilabel> box, above."
msgstr ""

#. Tag: guilabel
#: menus.docbook:883
#, no-c-format
msgid "Language:"
msgstr "Lenga :"

#. Tag: para
#: menus.docbook:884
#, no-c-format
msgid ""
"If you have installed multiple dictionaries, here you can select which "
"dictionary/language should be used."
msgstr ""

#. Tag: para
#: menus.docbook:889
#, no-c-format
msgid ""
"On the right side of the dialog box are 5 buttons that allow the user to "
"control the spellcheck process. They are:"
msgstr ""

#. Tag: guibutton
#: menus.docbook:894
#, no-c-format
msgid "Add to Dictionary"
msgstr ""

#. Tag: para
#: menus.docbook:895
#, no-c-format
msgid ""
"Pressing this button adds the word in the <guilabel>Misspelled Word:</"
"guilabel> box to the checker's dictionary. This means that in the future the "
"checker will always consider this word to be correctly spelled."
msgstr ""

#. Tag: guibutton
#: menus.docbook:901
#, no-c-format
msgid "Replace"
msgstr "Remplaçar"

#. Tag: para
#: menus.docbook:902
#, no-c-format
msgid ""
"This button has the checker replace the word under consideration in the "
"document with the word in the <guilabel>Replacement:</guilabel> box."
msgstr ""

#. Tag: guibutton
#: menus.docbook:907
#, no-c-format
msgid "Replace All"
msgstr "Tot remplaçar"

#. Tag: para
#: menus.docbook:908
#, no-c-format
msgid ""
"This button causes the checker to replace not only the current "
"<guilabel>Unknown word:</guilabel> but to automatically make the same "
"substitution for any other occurrences of this <guilabel>Misspelled Word:</"
"guilabel> in the document."
msgstr ""

#. Tag: guibutton
#: menus.docbook:914
#, no-c-format
msgid "Ignore"
msgstr "Ignorar"

#. Tag: para
#: menus.docbook:915
#, no-c-format
msgid ""
"Activating this button will have the checker move on without making any "
"changes."
msgstr ""

#. Tag: guibutton
#: menus.docbook:919
#, no-c-format
msgid "Ignore All"
msgstr ""

#. Tag: para
#: menus.docbook:920
#, no-c-format
msgid ""
"This button tells the checker to do nothing with the current "
"<guilabel>Unknown word:</guilabel> and to pass over any other instances of "
"the same word."
msgstr ""

#. Tag: para
#: menus.docbook:922
#, no-c-format
msgid ""
"This only applies to the current spellcheck run. If the checker is run again "
"later it will stop on this same word."
msgstr ""

#. Tag: para
#: menus.docbook:928
#, no-c-format
msgid ""
"Three more buttons are located horizontally along the bottom of the "
"spellcheck dialog. They are:"
msgstr ""

#. Tag: guibutton
#: menus.docbook:933
#, no-c-format
msgid "Help"
msgstr "Ajuda"

#. Tag: para
#: menus.docbook:934
#, no-c-format
msgid ""
"This invokes the &kde; help system starting at the &kate; help pages (this "
"document)."
msgstr ""

#. Tag: guibutton
#: menus.docbook:939
#, no-c-format
msgid "Finished"
msgstr "Terminat"

#. Tag: para
#: menus.docbook:940
#, no-c-format
msgid "This button ends the spellcheck process, and returns to the document."
msgstr ""

#. Tag: guibutton
#: menus.docbook:945
#, no-c-format
msgid "Cancel"
msgstr "Anullar"

#. Tag: para
#: menus.docbook:946
#, no-c-format
msgid ""
"This button cancels the spellcheck process, all modifications are reverted, "
"and you will return to your document."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:956
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Spelling (from cursor)...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:960
#, no-c-format
msgid ""
"This initiates the spellchecking program but it starts where your cursor is "
"instead of at the beginning of the document."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:966
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Spellcheck Selection...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:970
#, no-c-format
msgid "Spellchecks the current selection."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:975
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>I</keycap></keycombo> </"
"shortcut> <guimenu>Tools</guimenu><guimenuitem>Indent</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:981
#, no-c-format
msgid ""
"This increases the paragraph's indentation by one step. The size of the step "
"depends on the <link linkend=\"config-dialog-editor-indent\">indentation "
"settings</link>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:988
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>I</keycap></"
"keycombo> </shortcut> <guimenu>Tools</guimenu><guimenuitem>Unindent</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:995
#, no-c-format
msgid ""
"This reduces the paragraph's indentation by one step. The size of the step "
"depends on the <link linkend=\"config-dialog-editor-indent\">indentation "
"settings</link>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1003
#, no-c-format
msgid "<guimenu>Tools</guimenu><guimenuitem>Clean Indentation</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1006
#, no-c-format
msgid ""
"This cleans the indentation for the current selection or for the line the "
"cursor is currently in. Cleaning the indentation ensures that all your "
"selected text follows the indentation mode you choose."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1013
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Align</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1018
#, no-c-format
msgid ""
"Causes a realign of the current line or selected lines using the indentation "
"mode and indentation settings in the doucment."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1024
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>D</keycap></keycombo> </"
"shortcut> <guimenu>Tools</guimenu> <guimenuitem>Comment</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1031
#, no-c-format
msgid ""
"This adds one space to the beginning of the line where the text cursor is "
"located or to the beginning of any selected lines."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1038
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>D</keycap></"
"keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Uncomment</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1045
#, no-c-format
msgid ""
"This removes one space (if any exist) from the beginning of the line where "
"the text cursor is located or from the beginning of any selected lines."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1051
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>U</keycap></keycombo> </"
"shortcut> <guimenu>Tools</guimenu> <guimenuitem>Uppercase</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1058
#, no-c-format
msgid "Put the selected text or the letter after the cursor in uppercase."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1063
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>U</keycap></"
"keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Lowercase</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1070
#, no-c-format
msgid "Put the selected text or the letter after the cursor in lowercase."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1075
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Alt;&Ctrl;<keycap>U</keycap></"
"keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Capitalize</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1082
#, no-c-format
msgid "Capitalize the selected text or the current word."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1087
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>J</keycap></keycombo> </"
"shortcut> <guimenu>Tools</guimenu> <guimenuitem>Join Lines</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1094
#, no-c-format
msgid ""
"Joins the selected lines, or the current line and the line below with one "
"white space character as a separator. Leading/trailing white space on joined "
"lines is removed in the affected ends."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1100
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Word Wrap Document</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1104
#, no-c-format
msgid ""
"Apply static word wrapping on all the document. That means that a new line "
"of text will automatically start when the current line exceeds the length "
"specified by the Wrap words at: option in the Editing tab in <menuchoice> "
"<guimenu>Settings</guimenu><guimenuitem>Configure Editor...</guimenuitem></"
"menuchoice>"
msgstr ""

#. Tag: title
#: menus.docbook:1118
#, no-c-format
msgid "The <guimenu>Sessions</guimenu> Menu"
msgstr ""

#. Tag: para
#: menus.docbook:1120
#, no-c-format
msgid ""
"This menu contains entries for using and managing &kate; sessions. For more "
"information, read <link linkend=\"fundamentals-using-sessions\">Using "
"Sessions</link>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1127
#, no-c-format
msgid "<guimenu>Sessions</guimenu> <guimenuitem>New</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1129
#, no-c-format
msgid "Creates a new empty session. All currently open files will be closed."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1135
#, no-c-format
msgid "<guimenu>Sessions</guimenu><guimenuitem>Open...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1137
#, no-c-format
msgid ""
"Open an existing session. The Session Chooser dialog is displayed to let you "
"choose one."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1142
#, no-c-format
msgid "<guimenu>Sessions</guimenu><guisubmenu>Quick Open</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1144
#, no-c-format
msgid "This submenu lets you open an existing session."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1149
#, no-c-format
msgid "<guimenu>Sessions</guimenu><guimenuitem>Save</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1151
#, no-c-format
msgid ""
"Save the current session. If the session is anonymous, you will be prompted "
"for a session name."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1156
#, no-c-format
msgid "<guimenu>Sessions</guimenu><guimenuitem>Save As...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1158
#, no-c-format
msgid ""
"Save the current session under a new name. You are prompted for a name to "
"use."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1163
#, no-c-format
msgid "<guimenu>Sessions</guimenu><guimenuitem>Manage...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1165
#, no-c-format
msgid ""
"Displays the Session Manager dialog which allows you to rename and delete "
"sessions."
msgstr ""

#. Tag: title
#: menus.docbook:1176
#, no-c-format
msgid "The <guimenu>Settings</guimenu> Menu"
msgstr ""

#. Tag: para
#: menus.docbook:1178
#, no-c-format
msgid ""
"The <guimenu>Settings</guimenu> menu allows you to change the properties of "
"the main window, such as showing/hiding toolbars, and provides access to the "
"configuration dialogs."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1187
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guisubmenu>Toolbars</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1193
#, no-c-format
msgid ""
"This submenu lists the available toolbars, each item toggles the display of "
"the associated toolbar."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1199
#, no-c-format
msgid "<guimenu>Settings</guimenu><guimenuitem>Full Screen Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1201
#, no-c-format
msgid "Toggles full screen display."
msgstr ""

#. Tag: para
#: menus.docbook:1202
#, no-c-format
msgid "This commmand will be moved to the Window menu in a future version of &kate;"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1210
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1216
#, no-c-format
msgid "Display the familiar &kde; Keyboard Shortcut Configuration Dialog."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1225
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Configure Toolbars...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1231
#, no-c-format
msgid "Display the familiar &kde; Toolbar Configuration Dialog."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1238
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Configure &kate;...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1244
#, no-c-format
msgid "Launch the <link linkend=\"config-dialog\">Main Configuration Dialog</link>"
msgstr ""

#. Tag: title
#: menus.docbook:1253
#, no-c-format
msgid "the <guimenu>Window</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1259
#, no-c-format
msgid "<guimenu>Window</guimenu> <guimenuitem>New Window</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1265
#, no-c-format
msgid ""
"<action>Opens another instance of &kate;</action>. The new instance will be "
"identical to your previous instance."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1275
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>L</keycap></"
"keycombo></shortcut> <guimenu>Window</guimenu> <guimenuitem>Split Vertical</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1282
#, no-c-format
msgid ""
"This will split the frame (which may be the main editing area) in two "
"equally sized frames, the new one to the left of the current one. The new "
"frame gets the focus, and will display the same document as the old one."
msgstr ""

#. Tag: para
#: menus.docbook:1285 menus.docbook:1302 menus.docbook:1320
#, no-c-format
msgid "See also <link linkend=\"kate-mdi\">Working with the &kate; MDI</link>"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1292
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>T</keycap></"
"keycombo></shortcut> <guimenu>Window</guimenu> <guimenuitem>Split "
"Horizontal</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1299
#, no-c-format
msgid ""
"Splits the current frame (which may be the main editing area) in two equally "
"sized frames, the new one at the bottom half. The new frame gets the focus, "
"and displays the same document as the old one."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1309
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>R</keycap></"
"keycombo></shortcut> <guimenu>Window</guimenu> <guimenuitem>Close Current</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1316
#, no-c-format
msgid ""
"Closes the active frame. This is disabled, if there is only one frame (the "
"main editing area)."
msgstr ""

#. Tag: para
#: menus.docbook:1317
#, no-c-format
msgid ""
"No documents get closed by closing a frame &ndash; they will still be "
"available in the <link linkend=\"document-menu\"><guimenu>Documents</"
