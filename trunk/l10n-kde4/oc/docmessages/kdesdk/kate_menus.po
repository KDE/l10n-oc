#. Tag: title
#: menus.docbook:8 menus.docbook:331
#, no-c-format
msgid "Menu Entries"
msgstr ""

#. Tag: title
#: menus.docbook:11
#, no-c-format
msgid "The File Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:17
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>New</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:26
#, no-c-format
msgid ""
"This command <action>starts a new document</action> in the editing window. "
"In the <guibutton>Documents</guibutton> list on the left the new file is "
"named <emphasis>Untitled</emphasis>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:37
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>O</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Open...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:46
#, no-c-format
msgid ""
"Displays a standard &kde; <guilabel>Open File</guilabel> dialog. Use the "
"file view to select the file you want to open, and click on <guibutton>Open</"
"guibutton> to open it."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:56
#, no-c-format
msgid "<guimenu>File</guimenu> <guisubmenu>Open Recent</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:62
#, no-c-format
msgid ""
"This is a shortcut to open recently saved documents. Clicking on this item "
"opens a list to the side of the menu with several of the most recently saved "
"files. Clicking on a specific file will open it in &kappname; - if the file "
"still resides at the same location."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:75
#, no-c-format
msgid "<guimenu>File</guimenu> <guisubmenu>Open With</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:81
#, no-c-format
msgid ""
"This submenu presents a list of applications known to handle the mime type "
"of your current document. Activating an entry will open the current document "
"with that application."
msgstr ""

#. Tag: para
#: menus.docbook:85
#, no-c-format
msgid ""
"In addition, a entry <guimenuitem>Other...</guimenuitem> command launches "
"the open with dialog box that allows you to <action>select another "
"application to open the active file</action>. Your file will still be open "
"in &kate;."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:95
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>L</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Save All</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:104
#, no-c-format
msgid "This command <action>saves all modified open files</action>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:113
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Reload All</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:119
#, no-c-format
msgid "<action>Reloads all opened files.</action>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:128
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Close Orphaned</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:134
#, no-c-format
msgid ""
"<action>Close</action> all documents in the file list, which could not be "
"reopened during startup, because they are not accessible anymore."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:143
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Save</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:152
#, no-c-format
msgid ""
"This command <action>saves your file</action>. Use it often. If the file is "
"<emphasis>Untitled</emphasis> then <guimenuitem>Save</guimenuitem> becomes "
"<guimenuitem>Save As</guimenuitem>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:164
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Save As...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:170
#, no-c-format
msgid ""
"<action>Name and rename files</action> with this command. It launches the "
"save file dialog box. This dialog works just as the open file dialog box "
"does. You can use it to navigate through your file system, preview existing "
"files, or filter your file view with file masks."
msgstr ""

#. Tag: para
#: menus.docbook:178
#, no-c-format
msgid ""
"Type the name you want to give the file you are saving in the Location combo "
"box and press the <guibutton>OK</guibutton> button."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:189
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Close Other</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:195
#, no-c-format
msgid "Close other open documents."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:204
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\"><keycap>F5</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Reload</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:213
#, no-c-format
msgid ""
"<action>Reloads the active file</action>. This command is useful if another "
"program or process has changed the file while you have it open in &kate;"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:224
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Print...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:233
#, no-c-format
msgid "<action>Print the active file</action>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:241
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Export as HTML...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:247
#, no-c-format
msgid ""
"Export your file in &HTML; format so your document can be viewed as a web "
"page. This item is only displayed when the plugin <guilabel>Exporter</"
"guilabel> is loaded."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:256
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Mail...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:262
#, no-c-format
msgid ""
"Open your mail client and attach the file in the mail. This item is only "
"displayed, when the plugin <guilabel>Mail files</guilabel> in &kate;'s "
"settings is loaded."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:271
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>W</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Close</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:280
#, no-c-format
msgid ""
"Close the active file with this command. If you have made unsaved changes, "
"you will be prompted to save the file before &kate; closes it."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:290
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Close All</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:296
#, no-c-format
msgid ""
"This command <action>closes all the files you have open</action> in &kate;."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:306
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:315
#, no-c-format
msgid ""
"This command <action>closes &kate;</action> and any files you were editing. "
"If you have made unsaved changes to any of the files you were editing, you "
"will be prompted to save them."
msgstr ""

#. Tag: title
#: menus.docbook:326
#, no-c-format
msgid "The Edit Menu"
msgstr ""

#. Tag: para
#: menus.docbook:327
#, no-c-format
msgid ""
"The <guimenu>Edit</guimenu> menu contains a host of commands, all to work "
"with the currently active document."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:335
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Undo</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:342
#, no-c-format
msgid "Undo the last editing command (typing, copying, cutting etc.)"
msgstr ""

#. Tag: para
#: menus.docbook:343
#, no-c-format
msgid ""
"If grouped undo is enabled, this may undo several editing commands of the "
"same type, like typing in characters."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:350
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>Z</keycap></"
"keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Redo</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:357
#, no-c-format
msgid "Redo the last undo step."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:364
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>X</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Cut</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:371
#, no-c-format
msgid ""
"Removes selected text if any, and places a copy of the removed text in the "
"clipboard."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:378
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Copy</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:385
#, no-c-format
msgid "Copies selected text, if any, to the clipboard."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:392
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>V</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Paste</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:399
#, no-c-format
msgid ""
"Copies the first item in the clipboard into the editor at cursor position."
msgstr ""

#. Tag: para
#: menus.docbook:400
#, no-c-format
msgid ""
"If Overwrite Selection is enabled, the pasted text will overwrite the "
"selection, if any."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:407
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Copy as HTML...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:413
#, no-c-format
msgid ""
"Copies selected text with the syntax highlight as HTML text. This item is "
"only displayed when the plugin <guilabel>Exporter</guilabel> is loaded."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:421
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>A</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Select All</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:428
#, no-c-format
msgid "Selects all text in the editor."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:435
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>A</keycap></"
"keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Deselect</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:442
#, no-c-format
msgid "Deselects the selected text in the editor if any."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:449
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift; <keycap>B</keycap></"
"keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Block Selection "
"Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:457
#, no-c-format
msgid ""
"Toggles Selection Mode. When the Selection Mode is <quote>BLOCK</quote>, you "
"can make vertical selections, &eg; select column 5 to 10 in lines 9 to 15."
msgstr ""

#. Tag: para
#: menus.docbook:459
#, no-c-format
msgid ""
"The status bar shows the current state of the Selection Mode, either "
"<quote>LINE</quote> or <quote>BLOCK</quote>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:464
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\"><keysym>Meta</keysym>&Ctrl;<keycap>V</"
"keycap></keycombo> </shortcut> <guimenu>Edit</guimenu><guimenuitem>VI input "
"Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:471
#, no-c-format
msgid ""
"Switch to a vi-like, modal editing mode. This mode supports the most used "
"commands and motions from vim's normal and visual mode and has an optional "
"vi mode statusbar. This status bar shows commands while they are being "
"entered, output from commands and the current mode.The behavior of this mode "
"can be configured in the <link linkend=\"pref-edit-vi-input-mode\">Vi Input "
"Mode</link> section of the <guilabel>Editing</guilabel> page in &kappname;'s "
"settings dialog."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:481
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\"><keycap>Ins</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu><guimenuitem>Overwrite Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:488
#, no-c-format
msgid ""
"Toggles the Insert/Overwrite modes. When the mode is <guilabel>INS</"
"guilabel>, you insert characters where the cursor is. When the mode is "
"<guilabel>OVR</guilabel>, writing characters will replace the current "
"characters if your cursor is positioned before any character. The status bar "
"shows the current state of the Overwrite Mode, either <guilabel>INS</"
"guilabel> or <guilabel>OVR</guilabel>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:499
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Find in Files...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:505
#, no-c-format
msgid ""
"Launch the <guilabel>Find in Files</guilabel> dialog to allow you to search "
"for text in the files of a folder. This item is only displayed when the "
"plugin <guilabel>Find in Files</guilabel> is loaded."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:513
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>F</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:520
#, no-c-format
msgid ""
"Launch the incremental search bar to allow you to search for text in the "
"edited document."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:527
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F3</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find Next</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:534
#, no-c-format
msgid ""
"Go to the nearest downwards match of the last text or regular expression "
"searched for, starting from cursor position"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:541
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Shift;<keycap>F3</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find Previous</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:548
#, no-c-format
msgid ""
"Go to the nearest upwards match of the last text or regular expression "
"searched for, starting from cursor position"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:555
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>R</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Replace...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:562
#, no-c-format
msgid ""
"Launch the power search and replace bar to replace one or more instances of "
"a defined text with something else."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:568
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>H</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu><guimenuitem>Find Selected</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:573
#, no-c-format
msgid "Finds next occurrence of selected text."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:579
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>H</keycap></"
"keycombo></shortcut> <guimenu>Edit</guimenu><guimenuitem>Find Selected "
"Backwards</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:584
#, no-c-format
msgid "Finds previous occurrence of selected text."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:591
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>G</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Go to Line...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:598
#, no-c-format
msgid ""
"Launches the Go To Line bar, allowing you to enter the number of a line to "
"find in the document"
msgstr ""

#. Tag: title
#: menus.docbook:608
#, no-c-format
msgid "The View menu"
msgstr ""

#. Tag: para
#: menus.docbook:610
#, no-c-format
msgid ""
"The <guimenu>View</guimenu> menu allows you to manage settings specific to "
"the active editor, and to manage frames."
msgstr ""

#. Tag: title
#: menus.docbook:614 menus.docbook:1025
#, no-c-format
msgid "Menu Items"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:619
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>New Window</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:625
#, no-c-format
msgid ""
"<action>Opens another instance of &kate;</action>. The new instance will be "
"identical to your previous instance."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:635
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>L</keycap></"
"keycombo></shortcut> <guimenu>View</guimenu><guisubmenu>Split View</"
"guisubmenu> <guimenuitem>Split Vertical</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:642
#, no-c-format
msgid ""
"This will split the frame (which may be the main editing area) in two "
"equally sized frames, the new one to the left of the current one. The new "
"frame gets the focus, and will display the same document as the old one."
msgstr ""

#. Tag: para
#: menus.docbook:645 menus.docbook:662 menus.docbook:680
#, no-c-format
msgid "See also <link linkend=\"kate-mdi\">Working with the &kate; MDI</link>"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:652
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>T</keycap></"
"keycombo></shortcut> <guimenu>View</guimenu><guisubmenu>Split View</"
"guisubmenu> <guimenuitem>Split Horizontal</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:659
#, no-c-format
msgid ""
"Splits the current frame (which may be the main editing area) in two equally "
"sized frames, the new one at the bottom half. The new frame gets the focus, "
"and displays the same document as the old one."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:669
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>R</keycap></"
"keycombo></shortcut> <guimenu>View</guimenu><guisubmenu>Split View</"
"guisubmenu> <guimenuitem>Close Current View</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:676
#, no-c-format
msgid ""
"Closes the active frame. This is disabled, if there is only one frame (the "
"main editing area)."
msgstr ""

#. Tag: para
#: menus.docbook:677
#, no-c-format
msgid ""
"No documents get closed by closing a frame &ndash; they will still be "
"available in the <link linkend=\"go-menu\"><guimenu>Go</guimenu> Menu</link> "
"as well as in the File List."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:686
#, no-c-format
msgid "<guimenu>View</guimenu><guisubmenu>Tool Views</guisubmenu>"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:692
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Alt;&Shift;<keycap>F</keycap> </"
"keycombo></shortcut><guimenu>View</guimenu><guisubmenu>Tool Views</"
"guisubmenu> <guimenuitem>Show Sidebars</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:695
#, no-c-format
msgid ""
"Toggles the display of the sidebar button rows. This command does not affect "
"the display of the sidebar content widgets, any sidebar that is visible will "
"stay visible, and if you assigned shortcuts to the below commands those will "
"of course continue to work."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:704
#, no-c-format
msgid ""
"<guimenu>View</guimenu><guisubmenu>Tool Views</guisubmenu> <guimenuitem>Show "
"Documents</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:710
#, no-c-format
msgid "Toggle the display of &kate;'s Documents list"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:717
#, no-c-format
msgid ""
"<guimenu>View</guimenu><guisubmenu>Tool Views</guisubmenu> <guimenuitem>Show "
"Terminal</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:723
#, no-c-format
msgid "Toggles the display of the built in terminal emulator."
msgstr ""

#. Tag: para
#: menus.docbook:724
#, no-c-format
msgid "When activated the first time, the terminal will be created."
msgstr ""

#. Tag: para
#: menus.docbook:725
#, no-c-format
msgid ""
"When the terminal emulator is displayed, it will get the focus, so that you "
"can start typing in commands immediately. If the <link linkend=\"config-"
"dialog-general-sync-konsole\">Automatically synchronize the terminal with "
"the current document when possible</link> option is enabled in the "
"<guilabel>Terminal</guilabel> page of the <link linkend=\"config-dialog"
"\">Main configuration dialog</link> the shell session will change to the "
"directory of the active document, if it is a local file."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:738
#, no-c-format
msgid ""
"<guimenu>View</guimenu><guisubmenu>Tool Views</guisubmenu> <guimenuitem>Show "
"Filesystem Browser</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:744
#, no-c-format
msgid "Toggle the display of &kate;'s Filesystem Browser"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:751
#, no-c-format
msgid ""
"<guimenu>View</guimenu><guisubmenu>Tool Views</guisubmenu> <guimenuitem>Show "
"Find in Files</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:757
#, no-c-format
msgid ""
"Toggle the display of &kate;'s <guilabel>Find in Files</guilabel> tool. This "
"item is only displayed when the plugin <guilabel>Find in Files</guilabel> is "
"loaded."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:768
#, no-c-format
msgid ""
"<shortcut><keycap>F7</keycap></shortcut> <guimenu>View</"
"guimenu><guimenuitem>Switch to Command Line</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:771
#, no-c-format
msgid ""
"This command will toggle the display of the <link linkend=\"advanced-editing-"
"tools-commandline\">built in command line</link>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:777
#, no-c-format
msgid "<guimenu>View</guimenu><guisubmenu>Schema</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:779
#, no-c-format
msgid ""
"This menu lists the available schemas. You can change the schema for the "
"current view here, to change the default schema you need to use the <link "
"linkend=\"prefcolors\">Fonts &amp; Colors</link> page of the config dialog."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:787
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F10</keycap> </keycombo></"
"shortcut> <guimenu>View</guimenu><guimenuitem>Dynamic Word Wrap</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:791
#, no-c-format
msgid ""
"Toggles dynamic word wrap in the current view. Dynamic word wrap makes all "
"the text in a view visible without the need for horizontal scrolling by "
"rendering one actual line on more visual lines as needed."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:800
#, no-c-format
msgid ""
"<guimenu>View</guimenu> <guisubmenu>Dynamic Word Wrap Indicators</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:804
#, no-c-format
msgid ""
"Choose when and how the dynamic word wrap indicators should be displayed. "
"This is only available if the <guilabel>Dynamic Word Wrap</guilabel> option "
"is checked."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:811
#, no-c-format
msgid ""
"<guimenu>View</guimenu><guimenuitem>Show Static Word Wrap Marker</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:813
#, no-c-format
msgid ""
"Toggles the display of a vertical line indicating the position of the wrap "
"width as configured in the <link linkend=\"pref-wrap-words-at\">config "
"dialog</link>. This feature requires that you use a true fixed-width font."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:823
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F6</keycap></keycombo></"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Show Icon Border</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:830
#, no-c-format
msgid ""
"This is a toggle item. Setting it on checked will make the Icon Border "
"visible in the left side of the active editor, and vice versa."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:838
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F11</keycap></keycombo></"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Show Line Numbers</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:845
#, no-c-format
msgid ""
"This is a toggle Item. Setting it on checked will make a pane displaying the "
"line numbers of the document visible in the left border of the active "
"editor, and vice versa."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:852
#, no-c-format
msgid "<guimenu>View</guimenu><guimenuitem>Show Scrollbar Marks</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:854
#, no-c-format
msgid ""
"Toggles the visualization of bookmarks (and other marks) on the vertical "
"scrollbar. When enabled, marks are represented by a thin line in the mark "
"color at the scrollbar, middleclicking on the lines will scroll the view to "
"a position near the mark."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:861
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F9</keycap> </keycombo></"
"shortcut> <guimenu>View</guimenu><guimenuitem>Show Folding Markers</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:865
#, no-c-format
msgid ""
"Toggles the display of the folding marker pane in the left side of the view. "
"See <link linkend=\"advanced-editing-tools-code-folding\">Using Code "
"Folding</link>."
msgstr ""

#. Tag: guisubmenu
#: menus.docbook:874
#, no-c-format
msgid "Code Folding"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:880
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl; &Shift;<keycap>-</keycap></"
"keycombo></shortcut> <guimenuitem>Collapse Toplevel</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:884
#, no-c-format
msgid "Collapse all toplevel regions in the document."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:887
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl; &Shift;<keycap>+</keycap></"
"keycombo></shortcut> <guimenuitem>Expand Toplevel</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:891
#, no-c-format
msgid "Expand all toplevel regions in the document."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:894
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl; <keycap>-</keycap></keycombo></"
"shortcut> <guimenuitem>Collapse One Local Level</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:898
#, no-c-format
msgid "Collapse the region closest to the cursor."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:901
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl; <keycap>+</keycap></keycombo></"
"shortcut> <guimenuitem>Expand One Local Level</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:905
#, no-c-format
msgid "Expand the region closest to the cursor."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:912
#, no-c-format
msgid "Enlarge Font"
msgstr ""

#. Tag: para
#: menus.docbook:914
#, no-c-format
msgid "This increases the display font size."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:918
#, no-c-format
msgid "Shrink Font"
msgstr ""

#. Tag: para
#: menus.docbook:920
#, no-c-format
msgid "This decreases the display font size."
msgstr ""

#. Tag: title
#: menus.docbook:928
#, no-c-format
msgid "The Go Menu"
msgstr ""

#. Tag: para
#: menus.docbook:929
#, no-c-format
msgid ""
"The <guimenu>Go</guimenu> menu provides a menu entry for each open document. "
"Clicking one of these will bring the requested document to focus. If you "
"have multiple frames, an editor for that document will be displayed in the "
"currently active frame."
msgstr ""

#. Tag: para
#: menus.docbook:933
#, no-c-format
msgid "In addition, commands to browse your open documents are provided:"
msgstr ""

#. Tag: title
#: menus.docbook:935
#, no-c-format
msgid "Menu items"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:940
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Alt;<keycap>Left</keycap></keycombo></"
"shortcut> <guimenu>Go</guimenu> <guimenuitem>Back</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:947
#, no-c-format
msgid ""
"This will bring the previous document in the stack in focus. If you have "
"multiple frames, an editor for the document will be displayed in the "
"currently active frame."
msgstr ""

#. Tag: para
#: menus.docbook:949
#, no-c-format
msgid ""
"The order is the order in which documents were opened, rather than a logical "
"history. This behavior may change in future versions of &kate;."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:958
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Alt;<keycap>Right</keycap></keycombo></"
"shortcut> <guimenu>Go</guimenu> <guimenuitem>Forward</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:965
#, no-c-format
msgid ""
"This will bring the next document in the stack in focus. If you have "
"multiple frames, an editor for the document will be displayed in the "
"currently active frame."
msgstr ""

#. Tag: para
#: menus.docbook:968
#, no-c-format
msgid ""
"The order is the order in which the documents were opened, rather than a "
"logical history. This behavior may change in future versions of &kate;."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:975
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Shift;<keycap>F8</keycap> </keycombo></"
"shortcut><guimenu>Go</guimenu><guimenuitem>Previous Split View</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:978
#, no-c-format
msgid ""
"Focus the previous document view, if you have split the editor area in more "
"views."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:983
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"><keycap>F8</keycap> </keycombo></"
"shortcut><guimenu>Go</guimenu><guimenuitem>Next Split View</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:986
#, no-c-format
msgid ""
"Focus the next document view, if you have split the editor area in more "
"views."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:991
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>1</keycap> </keycombo></"
"shortcut><guimenu>Go</guimenu><guimenuitem>Quickswitch </guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:994
#, no-c-format
msgid ""
"Opens the <guilabel>Document Quick Switch</guilabel> dialog with a search "
"field and a list of opened files. While entering text in the search field "
"the document names and document urls are searched for matching text. While "
"entering text in the search field you can use the cursor keys <keysym>Up</"
"keysym> and <keysym>Down</keysym> to navigate in the list view. If the "
"dialog is left with <guilabel>OK</guilabel> the plugin switches the view to "
"the document selected in the list view. This makes switching between "
"documents easier, if there are a lot of them open. This menu item is only "
"displayed if the plugin <guilabel>Quick Document switcher</guilabel> is "
"loaded."
msgstr ""

#. Tag: title
#: menus.docbook:1012
#, no-c-format
msgid "The Bookmarks Menu"
msgstr ""

#. Tag: para
#: menus.docbook:1014
#, no-c-format
msgid ""
"The <guimenu>Bookmarks</guimenu> menu allows you to work with the bookmarks "
"in the currently active document."
msgstr ""

#. Tag: para
#: menus.docbook:1017
#, no-c-format
msgid ""
"Below the entries described here, one entry for each bookmark in the active "
"document will be available. The text will be the first few words of the "
"marked line. Choose an item to move the cursor to the start of that line. "
"The editor will scroll as necessary to make that line visible."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1030
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>B</keycap></keycombo></"
"shortcut> <guimenu>Bookmarks</guimenu> <guimenuitem>Set Bookmark</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1037
#, no-c-format
msgid ""
"Sets or removes a bookmark in the current line of the active document. (If "
"it's there, it is removed, otherwise one is set.)"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1045
#, no-c-format
msgid ""
"<guimenu>Bookmarks</guimenu> <guimenuitem>Clear All Bookmarks</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1051
#, no-c-format
msgid "Clears (removes) all bookmarks in the active document."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1056
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Alt; <keycap>PgUp</keycap></keycombo></"
"shortcut> <guimenu>Bookmarks</guimenu><guimenuitem>Previous</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1060
#, no-c-format
msgid ""
"This will move the cursor to beginning of the first above line with a "
"bookmark. The menuitem text will include the line number and the first piece "
"of text on the line. This item is only available when there is a bookmark in "
"a line above the cursor."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1067
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Alt; <keycap>PgDown</keycap></"
"keycombo></shortcut> <guimenu>Bookmarks</guimenu><guimenuitem>Next</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1070
#, no-c-format
msgid ""
"This will move the cursor to beginning of the next line with a bookmark. The "
"menuitem text will include the line number and the first piece of text on "
"the line. This item is only available when there is a bookmark in a line "
"below the cursor."
msgstr ""

#. Tag: title
#: menus.docbook:1081
#, no-c-format
msgid "The Sessions Menu"
msgstr ""

#. Tag: para
#: menus.docbook:1083
#, no-c-format
msgid ""
"This menu contains entries for using and managing &kate; sessions. For more "
"information, read <link linkend=\"fundamentals-using-sessions\">Using "
"Sessions</link>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1090
#, no-c-format
msgid "<guimenu>Sessions</guimenu> <guimenuitem>New</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1092
#, no-c-format
msgid "Creates a new empty session. All currently open files will be closed."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1098
#, no-c-format
msgid "<guimenu>Sessions</guimenu><guimenuitem>Open Session...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1100
#, no-c-format
msgid ""
"Open an existing session. The Session Chooser dialog is displayed to let you "
"choose one."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1105
#, no-c-format
msgid "<guimenu>Sessions</guimenu><guisubmenu>Quick Open Session</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1107
#, no-c-format
msgid "This submenu lets you open an existing session."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1112
#, no-c-format
msgid "<guimenu>Sessions</guimenu><guimenuitem>Save Session</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1114
#, no-c-format
msgid ""
"Save the current session. If the session is anonymous, you will be prompted "
"for a session name."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1119
#, no-c-format
msgid ""
"<guimenu>Sessions</guimenu><guimenuitem>Save Session As...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1121
#, no-c-format
msgid ""
"Save the current session under a new name. You are prompted for a name to "
"use."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1126
#, no-c-format
msgid ""
"<guimenu>Sessions</guimenu><guimenuitem>Save Session as Default...</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1128
#, no-c-format
msgid "Save the current session as default."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1132
#, no-c-format
msgid ""
"<guimenu>Sessions</guimenu><guimenuitem>Manage Sessions...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1134
#, no-c-format
msgid ""
"Displays the Session Manager dialog which allows you to rename and delete "
"sessions."
msgstr ""

#. Tag: title
#: menus.docbook:1145
#, no-c-format
msgid "The Tools Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1150
#, no-c-format
msgid "<guimenu>Tools</guimenu><guimenuitem>Pipe to Terminal</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1152
#, no-c-format
msgid ""
"Feed the currently selected text into the built in terminal emulator. No "
"newline is added after the text."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1157
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Synchronize Terminal with Current "
"Document</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1161
#, no-c-format
msgid ""
"This will cause the built-in Terminal to <command>cd</command> into the "
"directory of the active document when launched and when a new document gets "
"the focus."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1168
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Focus/Defocus Terminal</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1172
#, no-c-format
msgid ""
"Switch the focus from the current document to the terminal and vice versa."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1177
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Read Only Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1181
#, no-c-format
msgid ""
"Set the current document to Read Only mode. This prevents any text addition "
"and any changes in the document formatting."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1187
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1191
#, no-c-format
msgid ""
"Choose the filetype scheme you prefer for the active document. This "
"overwrites the global <link linkend=\"pref-open-save-modes-filetypes"
"\">filetype</link> mode set in <menuchoice> <guimenu>Settings</guimenu> "
"<guimenuitem>Configure &kate;...</guimenuitem></menuchoice> in the Filetypes "
"tab for your current document only."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1200
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guisubmenu>Highlighting</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1204
#, no-c-format
msgid ""
"Choose the Highlighting scheme you prefer for the active document. This "
"overwrites the global highlighting mode set in <menuchoice> "
"<guimenu>Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem> </"
"menuchoice> for your current document only."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1212
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guisubmenu>Indentation</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1216
#, no-c-format
msgid ""
"Choose the <link linkend=\"kate-part-autoindent\">style of indentation</"
"link> you want for your active document. This overwrites the global "
"indentation mode set in <menuchoice> <guimenu>Settings</guimenu> "
"<guimenuitem>Configure Editor...</guimenuitem> </menuchoice> for your "
"current document only."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1225
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guisubmenu>Encoding</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1229
#, no-c-format
msgid ""
"You can overwrite the default encoding set in <menuchoice> "
"<guimenu>Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem></"
"menuchoice> in the <guilabel>Open/Save</guilabel> page to set a different "
"encoding for your current document. The encoding you set here will be only "
"valid for your current document."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1241
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guisubmenu>End of Line</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1245
#, no-c-format
msgid ""
"Choose your preferred end of line mode for your active document. This "
"overwrites the global end of line mode set in <menuchoice> "
"<guimenu>Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem> </"
"menuchoice> for your current document only."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1253
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guisubmenu>Add Byte Mark Order (BOM)</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1257
#, no-c-format
msgid ""
"Checking this action you can explicitly add a byte order mark for unicode "
"encoded documents. The byte order mark (BOM) is a Unicode character used to "
"signal the endianness (byte order) of a text file or stream, for more "
"information see <ulink url=\"http://en.wikipedia.org/wiki/Byte_Order_Mark"
"\">Byte Order Mark</ulink>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1265
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Space</keycap></"
"keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Invoke Code "
"Completion</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1273
#, no-c-format
msgid ""
"Manually invoke command completion, usually by using a shortcut bound to "
"this action."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1278
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Word Completion</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1283
#, no-c-format
msgid ""
"<guimenuitem>Reuse Word Below</guimenuitem> (<keycombo action=\"simul"
"\">&Ctrl; <keycap>9</keycap></keycombo>) and <guimenuitem>Reuse Word Above</"
"guimenuitem> (<keycombo action=\"simul\">&Ctrl; <keycap>8</keycap></"
"keycombo>) complete the currently typed text by searching for similar words "
"backward or forward from the current cursor position. <guimenuitem>Shell "
"Completion</guimenuitem> pops up a completion box with matching entries."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1293
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>O</keycap></"
"keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Automatic Spell "
"Checking</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1301
#, no-c-format
msgid ""
"When <guimenuitem>Automatic Spell Checking</guimenuitem> is enabled, wrong "
"text is underlined in the document on-the-fly."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1307
#, no-c-format
msgid "<guimenu>Tools</guimenu><guimenuitem>Spelling...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1311
#, no-c-format
msgid ""
"<action>This initiates the spellchecking program - a program designed to "
"help the user catch and correct any spelling errors.</action> Clicking on "
"this entry will start the checker and bring up the speller dialog box "
"through which the user can control the process. There are four settings "
"lined up vertically in the center of the dialog with their corresponding "
"labels just to the left. Starting at the top they are:"
msgstr ""

#. Tag: guilabel
#: menus.docbook:1320
#, no-c-format
msgid "Unknown word:"
msgstr "Mot desconegut :"

#. Tag: para
#: menus.docbook:1321
#, no-c-format
msgid ""
"Here, the spellchecker indicates the word currently under consideration. "
"This happens when the checker encounters a word not in its dictionary - a "
"file containing a list of correctly spelled words against which it compares "
"each word in the editor."
msgstr ""

#. Tag: guilabel
#: menus.docbook:1327
#, no-c-format
msgid "Replace with:"
msgstr "Remplaçar per :"

#. Tag: para
#: menus.docbook:1328
#, no-c-format
msgid ""
"If the checker has any similar words in its dictionary the first one will be "
"listed here. The user can accept the suggestion, type in his or her own "
"correction, or choose a different suggestion from the next box."
msgstr ""

#. Tag: guilabel
#: menus.docbook:1334
#, no-c-format
msgid "Language:"
msgstr "Lenga :"

#. Tag: para
#: menus.docbook:1335
#, no-c-format
msgid ""
"If you have installed multiple dictionaries, here you can select which "
"dictionary/language should be used."
msgstr ""

#. Tag: para
#: menus.docbook:1340
#, no-c-format
msgid ""
"On the right side of the dialog box are 6 buttons that allow the user to "
"control the spellcheck process. They are:"
msgstr ""

#. Tag: guibutton
#: menus.docbook:1345
#, no-c-format
msgid "Add to Dictionary"
msgstr ""

#. Tag: para
#: menus.docbook:1346
#, no-c-format
msgid ""
"Pressing this button adds the <guilabel>Unknown word </guilabel> to the "
"checker's dictionary. This means that in the future the checker will always "
"consider this word to be correctly spelled."
msgstr ""

#. Tag: guilabel
#: menus.docbook:1352
#, no-c-format
msgid "Suggest"
msgstr ""

#. Tag: para
#: menus.docbook:1353
#, no-c-format
msgid ""
"The checker may list here a number of possible replacements for the word "
"under consideration. Clicking on any one of the suggestions will cause that "
"word to be entered in the <guilabel>Replace with</guilabel> box, above."
msgstr ""

#. Tag: guibutton
#: menus.docbook:1359
#, no-c-format
msgid "Replace"
msgstr "Remplaçar"

#. Tag: para
#: menus.docbook:1360
#, no-c-format
msgid ""
"This button has the checker replace the word under consideration in the "
"document with the word in the <guilabel>Replace with</guilabel> box."
msgstr ""

#. Tag: guibutton
#: menus.docbook:1365
#, no-c-format
msgid "Replace All"
msgstr "Tot remplaçar"

#. Tag: para
#: menus.docbook:1366
#, no-c-format
msgid ""
"This button causes the checker to replace not only the current "
"<guilabel>Unknown word:</guilabel> but to automatically make the same "
"substitution for any other occurrences of this <guilabel>Unknown word</"
"guilabel> in the document."
msgstr ""

#. Tag: guibutton
#: menus.docbook:1372
#, no-c-format
msgid "Ignore"
msgstr "Ignorar"

#. Tag: para
#: menus.docbook:1373
#, no-c-format
msgid ""
"Activating this button will have the checker move on without making any "
"changes."
msgstr ""

#. Tag: guibutton
#: menus.docbook:1377
#, no-c-format
msgid "Ignore All"
msgstr "Tot ignorar"

#. Tag: para
#: menus.docbook:1378
#, no-c-format
msgid ""
"This button tells the checker to do nothing with the current "
"<guilabel>Unknown word:</guilabel> and to pass over any other instances of "
"the same word."
msgstr ""

#. Tag: para
#: menus.docbook:1380
#, no-c-format
msgid ""
"This only applies to the current spellcheck run. If the checker is run again "
"later it will stop on this same word."
msgstr ""

#. Tag: para
#: menus.docbook:1386
#, no-c-format
msgid ""
"Three more buttons are located horizontally along the bottom of the "
"spellcheck dialog. They are:"
msgstr ""

#. Tag: guibutton
#: menus.docbook:1391
#, no-c-format
msgid "Help"
msgstr "Ajuda"

#. Tag: para
#: menus.docbook:1392
#, no-c-format
msgid ""
"This invokes the &kde; help system starting at the &kate; help pages (this "
"document)."
msgstr ""

#. Tag: guibutton
#: menus.docbook:1397
#, no-c-format
msgid "Finished"
msgstr "Terminat"

#. Tag: para
#: menus.docbook:1398
#, no-c-format
msgid "This button ends the spellcheck process, and returns to the document."
msgstr ""

#. Tag: guibutton
#: menus.docbook:1403
#, no-c-format
msgid "Cancel"
msgstr "Anullar"

#. Tag: para
#: menus.docbook:1404
#, no-c-format
msgid ""
"This button cancels the spellcheck process, all modifications are reverted, "
"and you will return to your document."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1414
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Spelling (from cursor)...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1418
#, no-c-format
msgid ""
"This initiates the spellchecking program but it starts where your cursor is "
"instead of at the beginning of the document."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1424
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Spellcheck Selection...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1428
#, no-c-format
msgid "Spellchecks the current selection."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1433
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Change Dictionary</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1437
#, no-c-format
msgid ""
"Displays a drop down box with all available dictionaries for spellchecking "
"at the bottom of the editor window. This allows easy switching of the "
"spellcheck dictionary &eg; for automatic spellcheck of text in different "
"languages."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1444
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>I</keycap></keycombo> </"
"shortcut> <guimenu>Tools</guimenu><guimenuitem>Indent</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1450
#, no-c-format
msgid ""
"This increases the paragraph's indentation by one step. The size of the step "
"depends on the <link linkend=\"pref-edit-indent\"> indentation settings</"
"link>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1457
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>I</keycap></"
"keycombo> </shortcut> <guimenu>Tools</guimenu><guimenuitem>Unindent</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1463
#, no-c-format
msgid ""
"This reduces the paragraph's indentation by one step. The size of the step "
"depends on the <link linkend=\"pref-edit-indent\"> indentation settings</"
"link>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1469
#, no-c-format
msgid "<guimenu>Tools</guimenu><guimenuitem>Clean Indentation</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1472
#, no-c-format
msgid ""
"This cleans the indentation for the current selection or for the line the "
"cursor is currently in. Cleaning the indentation ensures that all your "
"selected text follows the indentation mode you choose."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1479
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Align</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1484
#, no-c-format
msgid ""
"Causes a realign of the current line or selected lines using the indentation "
"mode and indentation settings in the document."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1490
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>D</keycap></keycombo> </"
"shortcut> <guimenu>Tools</guimenu> <guimenuitem>Comment</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1497
#, no-c-format
msgid ""
"This adds one space to the beginning of the line where the text cursor is "
"located or to the beginning of any selected lines."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1504
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>D</keycap></"
"keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Uncomment</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1511
#, no-c-format
msgid ""
"This removes one space (if any exist) from the beginning of the line where "
"the text cursor is located or from the beginning of any selected lines."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1517
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>U</keycap></keycombo> </"
"shortcut> <guimenu>Tools</guimenu> <guimenuitem>Uppercase</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1524
#, no-c-format
msgid "Put the selected text or the letter after the cursor in uppercase."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1529
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>U</keycap></"
"keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Lowercase</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1536
#, no-c-format
msgid "Put the selected text or the letter after the cursor in lowercase."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1541
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Alt;&Ctrl;<keycap>U</keycap></"
"keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Capitalize</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1548
#, no-c-format
msgid "Capitalize the selected text or the current word."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1553
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>J</keycap></keycombo> </"
"shortcut> <guimenu>Tools</guimenu> <guimenuitem>Join Lines</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1560
#, no-c-format
msgid ""
"Joins the selected lines, or the current line and the line below with one "
"white space character as a separator. Leading/trailing white space on joined "
"lines is removed in the affected ends."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1566
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Apply Word Wrap</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1570
#, no-c-format
msgid ""
"Apply static word wrapping on all the document. That means that a new line "
"of text will automatically start when the current line exceeds the length "
"specified by the <guilabel>Wrap words at</guilabel> option in the Editing "
"tab in <menuchoice> <guimenu>Settings</guimenu><guimenuitem>Configure "
"Editor...</guimenuitem></menuchoice>"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1579
#, no-c-format
msgid "<guimenu>Tools</guimenu><guisubmenu>External Tools</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1581
#, no-c-format
msgid ""
"This submenu contains all the <link linkend=\"kate-mdi-tools-externaltools"
"\">external tools</link> you have configured."
msgstr ""

#. Tag: para
#: menus.docbook:1587
#, no-c-format
msgid ""
"Menu items for the selected <link linkend=\"pref-plugins\">plugins</link> "
"are displayed at the end of this menu"
msgstr ""

#. Tag: title
#: menus.docbook:1595
#, no-c-format
msgid "The Settings Menu"
msgstr ""

#. Tag: para
#: menus.docbook:1597
#, no-c-format
msgid ""
"The <guimenu>Settings</guimenu> menu allows you to change the properties of "
"the main window, such as showing/hiding toolbars, and provides access to the "
"configuration dialogs."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1604
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Toolbar</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1610
#, no-c-format
msgid ""
"When checked, this displays a movable toolbar containing buttons used to "
"initiate frequently used commands. When unchecked the toolbar is hidden."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1618
#, no-c-format
msgid "<guimenu>Settings</guimenu><guimenuitem>Show Statusbar</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1622
#, no-c-format
msgid ""
"When checked, this displays a small bar at the bottom of the editor "
"containing information about the status of the current document. When "
"unchecked the status bar is hidden."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1629
#, no-c-format
msgid "<guimenu>Settings</guimenu><guimenuitem>Show Path</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1633
#, no-c-format
msgid ""
"When selected, this displays in the titlebar the path (its location in the "
"file system) of the current document. When unchecked the path is hidden."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1639
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>F</keycap></"
"keycombo> </shortcut> <guimenu>Settings</guimenu><guimenuitem>Full Screen "
"Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1645
#, no-c-format
msgid "Toggles full screen display."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1652
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1658
#, no-c-format
msgid "Display the familiar &kde; Keyboard Shortcut Configuration Dialog."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1667
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Toolbars...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1673
#, no-c-format
msgid "Display the familiar &kde; Toolbar Configuration Dialog."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1680
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure &kate;...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1686
#, no-c-format
msgid ""
"Launch the <link linkend=\"config-dialog\">Main Configuration Dialog</link>"
msgstr ""

#. Tag: title
#: menus.docbook:1696
#, no-c-format
msgid "The Help Menu"
msgstr ""

#. Tag: para
#: menus.docbook:1698
#, no-c-format
msgid ""
"Apart from standard &kde; <guimenu>Help</guimenu> menu items described below "
"you will have menu entries to show the <guimenuitem>Tip of the Day</"
"guimenuitem> and the <guimenuitem>About Editor Component</guimenuitem> "
"information."
msgstr ""

#. Tag: sect1
#: menus.docbook:1701
#, no-c-format
msgid "&help.menu.documentation;"
msgstr ""
