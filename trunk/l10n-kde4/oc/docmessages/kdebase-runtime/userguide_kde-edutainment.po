#. Tag: application
#: kde-edutainment.docbook:285
#, no-c-format
msgid "&kgeography;"
msgstr ""

#. Tag: para
#: kde-edutainment.docbook:286
#, no-c-format
msgid ""
"&kgeography; is a geography learning tool for &kde;. You can browse the maps "
"by clicking in a map division to see its name and you can also answer "
"several types of questions where the program shows you a map division or a "
"capital for example and you have to guess its name."
msgstr ""

#. Tag: para
#: kde-edutainment.docbook:289
#, no-c-format
msgid ""
"Website: <ulink url=\"http://kgeography.berlios.de/\">http://kgeography."
"berlios.de/</ulink> and <ulink url=\"http://edu.kde.org/kgeography\">http://"
"edu.kde.org/kgeography</ulink>"
msgstr ""

#. Tag: ulink
#: kde-edutainment.docbook:290
#, no-c-format
msgid "<application>&kgeography;</application> Handbook"
msgstr ""

#. Tag: application
#: kde-edutainment.docbook:298
#, no-c-format
msgid "&blinken;"
msgstr ""

#. Tag: para
#: kde-edutainment.docbook:299
#, no-c-format
msgid ""
"&blinken; is a Simon Says game for &kde;. The player should remember the "
"sequence of lights in the correct order and is then presented with an "
"identical sequence with one extra step."
msgstr ""

#. Tag: para
#: kde-edutainment.docbook:302
#, no-c-format
msgid ""
"Website: <ulink url=\"http://edu.kde.org/blinken\">http://edu.kde.org/"
"blinken</ulink>"
msgstr ""

