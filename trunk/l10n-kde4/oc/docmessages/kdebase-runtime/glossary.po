#. Tag: glossary
#: index.docbook:11
#, no-c-format
msgid "&glossary-kdeprinting;"
msgstr ""

#. Tag: title
#: index.docbook:16
#, no-c-format
msgid "Technologies"
msgstr ""

#. Tag: glossterm
#: index.docbook:18
#, no-c-format
msgid "<glossterm><acronym>IO</acronym> Slave</glossterm>"
msgstr ""

#. Tag: para
#: index.docbook:19
#, no-c-format
msgid ""
"<acronym>IO</acronym> Slaves enable &kde; applications to access remote "
"resources as easily as local resources (making them <quote>network "
"transparent</quote>). Remote resources (&eg; files) might be stored on "
"<acronym>SMB</acronym> shares or similar."
msgstr ""

#. Tag: glossdef
#: index.docbook:22
#, no-c-format
msgid ""
"<glossseealso otherterm=\"gloss-smb\"><acronym>SMB</acronym></glossseealso> "
"<glossseealso otherterm=\"gloss-kde\">&kde;</glossseealso>"
msgstr ""

#. Tag: acronym
#: index.docbook:28
#, no-c-format
msgid "<acronym>KIO</acronym>"
msgstr ""

#. Tag: para
#: index.docbook:29
#, no-c-format
msgid ""
"The &kde; Input/Output system which makes use of so-called "
"<quote><acronym>IO</acronym> Slaves</quote>."
msgstr ""

#. Tag: glossdef
#: index.docbook:30
#, no-c-format
msgid ""
"<glossseealso otherterm=\"gloss-ioslave\"><acronym>IO</acronym> Slave</"
"glossseealso> <glossseealso otherterm=\"gloss-kde\">&kde;</glossseealso>"
msgstr ""

#. Tag: glossterm
#: index.docbook:37
#, no-c-format
msgid "KParts"
msgstr ""

#. Tag: para
#: index.docbook:38
#, no-c-format
msgid ""
"KParts is an embedding technology which allows &kde; applications to embed "
"other &kde; applications. For example, the text view used by &konqueror; is "
"a KPart."
msgstr ""

#. Tag: glossseealso
#: index.docbook:41 index.docbook:139
#, no-c-format
msgid "<glossseealso>&konqueror;</glossseealso>"
msgstr ""

#. Tag: acronym
#: index.docbook:45
#, no-c-format
msgid "KSycoca"
msgstr ""

#. Tag: para
#: index.docbook:46
#, no-c-format
msgid ""
"<acronym>KSycoca</acronym> (&kde; <emphasis>Sy</emphasis>stem <emphasis>Co</"
"emphasis>nfiguration <emphasis>Ca</emphasis>che) is a configuration cache "
"which, for example, guarantees fast access to the menu entries."
msgstr ""

#. Tag: application
#: index.docbook:51 index.docbook:84
#, no-c-format
msgid "KBuildSycoca"
msgstr "KBuildSycoca"

#. Tag: title
#: index.docbook:57
#, no-c-format
msgid "XFree86"
msgstr ""

#. Tag: glossterm
#: index.docbook:59
#, no-c-format
msgid "Antialiasing"
msgstr ""

#. Tag: para
#: index.docbook:60
#, no-c-format
msgid ""
"If mentioned in context with &kde;, anti-aliasing often means the smoothing "
"of the fonts visible on the screen. &Qt; version 2.3.0 or higher used "
"together with XFree86 4.x makes this possible under &kde; as well."
msgstr ""

#. Tag: glossdef
#: index.docbook:63
#, no-c-format
msgid ""
"<glossseealso otherterm=\"gloss-kde\">&kde;</glossseealso> <glossseealso "
"otherterm=\"gloss-qt\">&Qt;</glossseealso>"
msgstr ""

#. Tag: glossterm
#: index.docbook:69
#, no-c-format
msgid "&X-Server;"
msgstr ""

#. Tag: para
#: index.docbook:70
#, no-c-format
msgid ""
"The &X-Server; represents a basic layer upon which the various &GUI;s like "
"&kde; are built. It manages the basic mouse and keyboard input (from the "
"local host as well as from remote hosts) and provides elementary graphic "
"routines to draw rectangles and other primitives."
msgstr ""

#. Tag: glossdef
#: index.docbook:74 index.docbook:208 index.docbook:225
#, no-c-format
msgid ""
"<glossseealso otherterm=\"gloss-kde\">&kde;</glossseealso> <glossseealso "
"otherterm=\"gloss-gui\">&GUI;</glossseealso>"
msgstr ""

#. Tag: title
#: index.docbook:82
#, no-c-format
msgid "Applications"
msgstr "Aplicacions"

#. Tag: para
#: index.docbook:85
#, no-c-format
msgid ""
"<application>KBuildSycoca4</application> is a command line program and "
"regenerates the so-called <acronym>KSycoca</acronym>. This is useful, for "
"example, if some or all modules in &kcontrol; are missing."
msgstr ""

#. Tag: glossdef
#: index.docbook:89
#, no-c-format
msgid ""
"<glossseealso otherterm=\"gloss-ksycoca\"><acronym>KSycoca</acronym></"
"glossseealso> <glossseealso otherterm=\"gloss-kcontrol\">&kcontrol;</"
"glossseealso>"
msgstr ""

#. Tag: glossterm
#: index.docbook:96
#, no-c-format
msgid "&kcontrol;"
msgstr ""

#. Tag: para
#: index.docbook:97
#, no-c-format
msgid ""
"This is the project and filename of the &kde; control center. "
"&kcontrolcenter; allows you to customize virtually every configuration "
"option of &kde;."
msgstr ""

#. Tag: glossseealso
#: index.docbook:100 index.docbook:117 index.docbook:149
#, no-c-format
msgid "<glossseealso>&kde;</glossseealso>"
msgstr ""

#. Tag: glossterm
#: index.docbook:104
#, no-c-format
msgid "&kicker;"
msgstr ""

#. Tag: para
#: index.docbook:105
#, no-c-format
msgid "&kicker; is the nickname as well as project name of the &kde; panel."
msgstr ""

#. Tag: glossdef
#: index.docbook:106
#, no-c-format
msgid ""
"<glossseealso otherterm=\"gloss-kde\">&kde;</glossseealso> <glossseealso "
"otherterm=\"gloss-panel\">Panel</glossseealso>"
msgstr ""

#. Tag: glossterm
#: index.docbook:112
#, no-c-format
msgid "<glossterm>&konqueror;</glossterm>"
msgstr ""

#. Tag: para
#: index.docbook:113
#, no-c-format
msgid ""
"&konqueror; is a filemanager, web browser, picture viewer and more, and a "
"core part of the &kde; project. You can find more information about "
"&konqueror; at <ulink url=\"http://www.konqueror.org\">www.konqueror.org</"
"ulink>."
msgstr ""

#. Tag: glossterm
#: index.docbook:121
#, no-c-format
msgid "&ksirc;"
msgstr ""

#. Tag: para
#: index.docbook:122
#, no-c-format
msgid ""
"&ksirc; is the default <acronym>IRC</acronym> client, which is shipped with "
"&kde;. You can use &ksirc; to chat with anyone on an <acronym>IRC</acronym> "
"network."
msgstr ""

#. Tag: acronym
#: index.docbook:125 index.docbook:276
#, no-c-format
msgid "<acronym>IRC</acronym>"
msgstr ""

#. Tag: title
#: index.docbook:131
#, no-c-format
msgid "Desktop Terminology"
msgstr ""

#. Tag: glossterm
#: index.docbook:133
#, no-c-format
msgid "Drag and Drop"
msgstr "Rossegar e pausar"

#. Tag: para
#: index.docbook:134
#, no-c-format
msgid ""
"This concept tries to replace many actions like copying files from one place "
"to another by a certain mouse movement, &eg; clicking on an icon in a "
"&konqueror; window, moving the mouse to another window while keeping the "
"mouse button pressed, and releasing the mouse button (<quote>dropping</"
"quote> the object) copies files."
msgstr ""

#. Tag: glossterm
#: index.docbook:143
#, no-c-format
msgid "<glossterm>&GUI;</glossterm>"
msgstr ""

#. Tag: para
#: index.docbook:144
#, no-c-format
msgid ""
"Abbreviation for <emphasis>G</emphasis>raphical <emphasis>U</emphasis>ser "
"<emphasis>I</emphasis>nterface. Every desktop environment (like &kde;) is a "
"&GUI;. Most &GUI;s feature mouse support and/or windows to manage the "
"programs."
msgstr ""

#. Tag: glossterm
#: index.docbook:153
#, no-c-format
msgid "<glossterm>&kde;</glossterm>"
msgstr ""

#. Tag: para
#: index.docbook:154
#, no-c-format
msgid ""
"Abbreviation for <quote>K Desktop Environment</quote>, a leading &GUI; for "
"&UNIX;-based systems. You can find more detailed information at <ulink url="
"\"http://www.kde.org\">www.kde.org</ulink>."
msgstr ""

#. Tag: glossseealso
#: index.docbook:158 index.docbook:167
#, no-c-format
msgid "<glossseealso>&GUI;</glossseealso>"
msgstr ""

#. Tag: acronym
#: index.docbook:162
#, no-c-format
msgid "GNOME"
msgstr "GNOME"

#. Tag: para
#: index.docbook:164
#, no-c-format
msgid ""
"<emphasis>G</emphasis>NU <emphasis>N</emphasis>etwork <emphasis>O</"
"emphasis>bject <emphasis>M</emphasis>odel <emphasis>E</emphasis>nvironment, "
"one of the leading &UNIX; &GUI;s."
msgstr ""

#. Tag: glossterm
#: index.docbook:171
#, no-c-format
msgid "Panel"
msgstr "Panèl"

#. Tag: para
#: index.docbook:172
#, no-c-format
msgid ""
"Refers to the panel (also known as <quote>&kicker;</quote>) which often "
"resides at the bottom of the screen."
msgstr ""

#. Tag: glossdef
#: index.docbook:174
#, no-c-format
msgid ""
"<glossseealso otherterm=\"gloss-kde\">&kde;</glossseealso> <glossseealso "
"otherterm=\"gloss-kicker\">&kicker;</glossseealso>"
msgstr ""

#. Tag: glossterm
#: index.docbook:180
#, no-c-format
msgid "ripping"
msgstr ""

#. Tag: para
#: index.docbook:181
#, no-c-format
msgid ""
"The process of reading audio data from a &cdrom; and storing it on the hard "
"disk."
msgstr ""

#. Tag: title
#: index.docbook:188
#, no-c-format
msgid "&kde; Development"
msgstr ""

#. Tag: glossterm
#: index.docbook:190
#, no-c-format
msgid "&Qt;"
msgstr ""

#. Tag: para
#: index.docbook:191
#, no-c-format
msgid ""
"The &GUI; of &kde; is built on top of the &Qt; toolkit, which provides many "
"graphical elements (so-called <quote>Widgets</quote>) which are used to "
"construct the desktop. You can find more information about &Qt; at <ulink "
"url=\"http://www.trolltech.com\">www.trolltech.com</ulink>."
msgstr ""

#. Tag: glossdef
#: index.docbook:195
#, no-c-format
msgid ""
"<glossseealso otherterm=\"gloss-kde\">&kde;</glossseealso> <glossseealso "
"otherterm=\"gloss-gui\">&GUI;</glossseealso> <glossseealso otherterm=\"gloss-"
"widget\">Widget</glossseealso>"
msgstr ""

#. Tag: glossterm
#: index.docbook:202
#, no-c-format
msgid "<glossterm>i18n</glossterm>"
msgstr ""

#. Tag: para
#: index.docbook:203
#, no-c-format
msgid ""
"Abbreviation for <quote>internationalization</quote>. &kde; supports many "
"different languages, and several i18n techniques make it easy to translate "
"the &GUI; as well as the accompanying documents of &kde; into all these "
"languages. More information about the i18n process is available at <ulink "
"url=\"http://l10n.kde.org\">l10n.kde.org</ulink>."
msgstr ""

#. Tag: glossterm
#: index.docbook:214
#, no-c-format
msgid "l10n"
msgstr ""

#. Tag: para
#: index.docbook:215
#, no-c-format
msgid ""
"Abbreviation for <quote>localization</quote>, the process of adapting a "
"program to the local environment. This includes &eg; the currency used for "
"monetary values or the time format."
msgstr ""

#. Tag: glossseealso
#: index.docbook:218
#, no-c-format
msgid "<glossseealso>i18n</glossseealso>"
msgstr ""

#. Tag: glossterm
#: index.docbook:222
#, no-c-format
msgid "Widget"
msgstr ""

#. Tag: para
#: index.docbook:223
#, no-c-format
msgid ""
"Graphical elements like scrollbars, buttons or input fields which are used "
"by &kde; to construct the &GUI;."
msgstr ""

#. Tag: acronym
#: index.docbook:231
#, no-c-format
msgid "<acronym>SVN</acronym>"
msgstr ""

#. Tag: para
#: index.docbook:233
#, no-c-format
msgid ""
"Abbreviation for <emphasis>Subversion</emphasis>, a version control system. "
"The <acronym>SVN</acronym> is a very elegant way of managing file versions "
"that allow more than one developer to easily work on the same project. You "
"can find a description of how to get the latest (developer) version of the "
"&kde; sources via anonymous <acronym>SVN</acronym> on <ulink url=\"http://"
"developer.kde.org/source/anonsvn.html\">http://developer.kde.org/source/"
"anonsvn.html</ulink>. More about <acronym>SVN</acronym> is available at "
"<ulink url=\"http://subversion.tigris.org/\">http://subversion.tigris.org/</"
"ulink>."
msgstr ""

#. Tag: title
#: index.docbook:250
#, no-c-format
msgid "Miscellaneous"
msgstr "Divèrs"

#. Tag: acronym
#: index.docbook:252 index.docbook:280
#, no-c-format
msgid "<acronym>RFC</acronym>"
msgstr ""

#. Tag: para
#: index.docbook:253
#, no-c-format
msgid ""
"<emphasis>R</emphasis>equest <emphasis>F</emphasis>or <emphasis>C</"
"emphasis>omment. A common way to publish new protocol ideas or procedures "
"for evaluation of the Internet community. Though <acronym>RFC</acronym>s are "
"not mandatory, many applications try to adhere to them, once they have been "
"approved by the community. More information about <acronym>RFC</acronym>s "
"can be found at the <ulink url=\"http://www.rfc-editor.org\">RFC Homepage</"
"ulink>."
msgstr ""

#. Tag: title
#: index.docbook:265
#, no-c-format
msgid "Various protocols"
msgstr ""

#. Tag: acronym
#: index.docbook:267
#, no-c-format
msgid "<acronym>SMB</acronym>"
msgstr ""

#. Tag: para
#: index.docbook:268
#, no-c-format
msgid ""
"<emphasis>S</emphasis>erver <emphasis>M</emphasis>essage <emphasis>B</"
"emphasis>lock. A network protocol used in &Microsoft; &Windows; networks to "
"access the file systems of other computers."
msgstr ""

#. Tag: glossseealso
#: index.docbook:271
#, no-c-format
msgid "<glossseealso><acronym>IO</acronym> Slave</glossseealso>"
msgstr ""

#. Tag: para
#: index.docbook:277
#, no-c-format
msgid ""
"<emphasis>I</emphasis>nternet <emphasis>R</emphasis>elay <emphasis>C</"
"emphasis>hat. A protocol defined in <acronym>RFC</acronym> 1459, which "
"handles the specification to enable real-time text chat."
msgstr ""

#. Tag: glossterm
#: index.docbook:284
#, no-c-format
msgid "host"
msgstr ""

#. Tag: para
#: index.docbook:285
#, no-c-format
msgid ""
"This can either be a name from your <filename>/etc/hosts</filename> file "
"(<systemitem class=\"systemname\">mycomputer</systemitem>), an Internet name "
"(<systemitem class=\"systemname\">www.kde.org</systemitem>) or an IP-Address "
"(<systemitem>192.168.0.10</systemitem>)."
msgstr ""
