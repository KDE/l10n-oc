#. Tag: guilabel
#: index.docbook:32
#, no-c-format
msgid "Appearance Tab"
msgstr ""

#. Tag: para
#: index.docbook:34
#, no-c-format
msgid "Here you can configure how icons on your desktop appear."
msgstr ""

#. Tag: guilabel
#: index.docbook:38
#, no-c-format
msgid "Standard font:"
msgstr ""

#. Tag: para
#: index.docbook:39
#, no-c-format
msgid ""
"This option can be used to change the typeface used on the desktop. Simply "
"select your typeface from the dropdown box."
msgstr ""

#. Tag: guilabel
#: index.docbook:43
#, no-c-format
msgid "Font size:"
msgstr "Talha de la poliça :"

#. Tag: para
#: index.docbook:44
#, no-c-format
msgid "You can change the relative size of the text on the Desktop."
msgstr ""

#. Tag: guilabel
#: index.docbook:48
#, no-c-format
msgid "Normal text color:"
msgstr ""

#. Tag: para
#: index.docbook:49
#, no-c-format
msgid ""
"This option lets you select the color of normal (or unhighlighted) text."
msgstr ""

#. Tag: guilabel
#: index.docbook:52
#, no-c-format
msgid "Text background color:"
msgstr ""

#. Tag: para
#: index.docbook:53
#, no-c-format
msgid ""
"This option lets you select the background color of normal text. If left "
"unchecked, the text has a transparent background. If selected, you can "
"choose the color by pressing the button."
msgstr ""

#. Tag: guilabel
#: index.docbook:59
#, no-c-format
msgid "Underline filenames:"
msgstr ""

#. Tag: para
#: index.docbook:60
#, no-c-format
msgid "Determines if file names are underlined on the Desktop."
msgstr ""

#. Tag: guilabel
#: index.docbook:67
#, no-c-format
msgid "Multiple Desktops"
msgstr ""

#. Tag: para
#: index.docbook:69
#, no-c-format
msgid ""
"&kde; offers you the possibility to have several virtual desktops. In this "
"tab you can configure the number of desktops as well as their names. Just "
"use the slider to adjust the number of desktops. You can assign names to the "
"desktops by entering text into the text fields below."
msgstr ""

#. Tag: para
#: index.docbook:75
#, no-c-format
msgid ""
"If you enable <guilabel>Mouse wheel over desktop switches desktop</guilabel> "
"then scrolling the wheel over an empty space on the desktop will change to "
"the next virtual desktop numerically, in the direction you scrolled (either "
"up or down)."
msgstr ""
