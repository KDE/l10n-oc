#: accessibility.docbook:23
#, no-c-format
msgid "lsm file"
msgstr ""

#. Tag: para
#: accessibility.docbook:26
#, no-c-format
msgid ""
"For more information on the project, visit the <ulink url=\"http://"
"accessibility.kde.org/\">&kde; Accessibility Home Page</ulink>."
msgstr ""

