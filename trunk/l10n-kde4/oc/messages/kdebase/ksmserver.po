#: main.cpp:52
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"Lo gestionari de session fisable de KDE gerent lo protocòl\n"
"estandard de gestion de session X11R6 (XSMP)."

#: main.cpp:244
msgid "The KDE Session Manager"
msgstr "Lo gestionari de sesilhas de KDE"

#: main.cpp:246
msgid "(C) 2000, The KDE Developers"
msgstr ""

#: main.cpp:247
msgid "Matthias Ettrich"
msgstr "Matthias Ettrich"

#: main.cpp:248
msgid "Luboš Luňák"
msgstr ""

#: main.cpp:248
msgid "Maintainer"
msgstr "Manteneire"

#: main.cpp:256
msgid "Restores the saved user session if available"
msgstr "Restablís la session precedenta se disponibla"

#: main.cpp:258
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"Amoda « wm » al cas que cap d'autre gestionari de fenèstras\n"
"es pas disponible per la session. Per defaut, « kwin »."

#: main.cpp:259
msgid "Also allow remote connections"
msgstr "Autorizar tanben las connexions distantas"

