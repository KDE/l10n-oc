msgid "Name=Developer"
msgstr "Name=Desvelopador"

msgid ""
"Name=The application %progname (%appname) crashed and caused the signal "
"%signum (%signame)."
msgstr ""
"Name=Lo programo d'aplicacion %progname (%appname) ei tombat e a causat lo "
"sinhal %signum (%signame)."

msgid ""
"Name=You might want to fix you program. Take a look at the backtrace tab."
