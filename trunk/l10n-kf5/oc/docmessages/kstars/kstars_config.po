#. Tag: para
#: config.docbook:228
#, no-c-format
msgid ""
"For detailed explanation of <guilabel>Ekos</guilabel> astrophotography "
"suite, see the <link linkend=\"tool-ekos\">Ekos section of this manual</"
"link>."
msgstr ""

#. Tag: secondary
#: config.docbook:235
#, no-c-format
msgid "Xplanet page"
msgstr ""

#. Tag: para
#: config.docbook:235
#, no-c-format
