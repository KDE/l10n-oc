#. Tag: title
#: config.docbook:885
#, no-c-format
msgid "Importing CSV (and similar formats)"
msgstr ""

#. Tag: screeninfo
#: config.docbook:887
#, no-c-format
msgid "<screeninfo>Importing CSV Catalogs</screeninfo>"
