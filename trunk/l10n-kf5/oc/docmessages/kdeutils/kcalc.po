#: index.docbook:315
#, no-c-format
msgid "Display the sum of all data items entered"
msgstr ""

#. Tag: guibutton
#: index.docbook:317
#, no-c-format
msgid "<guibutton>Mea</guibutton>"
msgstr ""

#. Tag: entry
