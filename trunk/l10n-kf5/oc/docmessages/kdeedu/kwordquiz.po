#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>K</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Delete Row</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:414
#, no-c-format
msgid ""
