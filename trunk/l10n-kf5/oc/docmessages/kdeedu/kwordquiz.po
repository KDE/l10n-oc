"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Insert Row</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:397
#, no-c-format
msgid ""
"<action>Insert</action> a new row at the current selection. If the selection "
