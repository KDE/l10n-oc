#. Tag: refpurpose
#: man-qt5options.7.docbook:22
#, no-c-format
msgid "Common commandline options for all applications based on the Qt toolkit"
msgstr ""

#. Tag: cmdsynopsis
#: man-qt5options.7.docbook:26
#, no-c-format
msgid ""
"<command><replaceable>Qt application</replaceable></command> <arg choice="
"\"opt\">Qt Generic Options</arg>"
msgstr ""

#. Tag: title
#: man-qt5options.7.docbook:34
#, no-c-format
msgid "Options"
msgstr "Opcions"

#. Tag: para
#: man-qt5options.7.docbook:36
#, no-c-format
msgid "The following options apply to all &Qt; applications:"
msgstr ""

#. Tag: term
#: man-qt5options.7.docbook:40
#, no-c-format
msgid "<option>--display</option> <parameter>displayname</parameter>"
msgstr ""

#. Tag: para
#: man-qt5options.7.docbook:44
#, no-c-format
msgid "Use the X-server display <parameter>displayname</parameter>."
msgstr ""

#. Tag: term
#: man-qt5options.7.docbook:50
#, no-c-format
msgid "<option>--session</option> <parameter>sessionId</parameter>"
msgstr ""

#. Tag: para
#: man-qt5options.7.docbook:54
#, no-c-format
msgid "Restore the application for the given <parameter>sessionId</parameter>."
msgstr ""

#. Tag: option
#: man-qt5options.7.docbook:61
#, no-c-format
msgid "--cmap"
msgstr ""

#. Tag: para
#: man-qt5options.7.docbook:64
#, no-c-format
msgid ""
"Causes the application to install a private color map on an 8-bit display."
msgstr ""

#. Tag: term
#: man-qt5options.7.docbook:70
#, no-c-format
msgid "<option>--ncols</option> <parameter>count</parameter>"
msgstr ""

#. Tag: para
#: man-qt5options.7.docbook:74
#, no-c-format
msgid ""
"Limits the number of colors allocated in the color cube on an 8-bit display, "
"if the application is using the <methodname>QApplication::ManyColor</"
"methodname> color specification."
msgstr ""

#. Tag: option
#: man-qt5options.7.docbook:83
#, no-c-format
msgid "--nograb"
msgstr ""

#. Tag: para
#: man-qt5options.7.docbook:86
#, no-c-format
msgid "Tells &Qt; to never grab the mouse or the keyboard."
msgstr ""

#. Tag: option
#: man-qt5options.7.docbook:92
#, no-c-format
msgid "--dograb"
msgstr ""

#. Tag: para
#: man-qt5options.7.docbook:95
#, no-c-format
msgid ""
"Running under a debugger can cause an implicit <option>--nograb</option>, "
"use <option>--dograb</option> to override."
msgstr ""

#. Tag: option
#: man-qt5options.7.docbook:103
#, no-c-format
msgid "--sync"
msgstr ""

#. Tag: para
#: man-qt5options.7.docbook:106
#, no-c-format
msgid "Switches to synchronous mode for debugging."
msgstr ""

#. Tag: term
#: man-qt5options.7.docbook:111
#, no-c-format
msgid ""
"<option>--fn</option>,<option>--font</option> <parameter>fontname</parameter>"
msgstr ""

#. Tag: para
#: man-qt5options.7.docbook:116
#, no-c-format
msgid "Defines the application font."
msgstr ""

#. Tag: term
#: man-qt5options.7.docbook:121
#, no-c-format
msgid ""
"<option>--bg</option>,<option>--background</option> <parameter>color</"
"parameter>"
msgstr ""

#. Tag: para
#: man-qt5options.7.docbook:126
#, no-c-format
msgid ""
"Sets the default background color and an application palette (light and dark "
"shades are calculated)."
msgstr ""

#. Tag: term
#: man-qt5options.7.docbook:132
#, no-c-format
msgid ""
"<option>--fg</option>,<option>--foreground</option> <parameter>color</"
"parameter>"
msgstr ""

#. Tag: para
#: man-qt5options.7.docbook:137
#, no-c-format
msgid "Sets the default foreground color"
msgstr ""

#. Tag: term
#: man-qt5options.7.docbook:142
#, no-c-format
msgid ""
"<option>--btn</option>,<option>--button</option> <parameter>color</parameter>"
msgstr ""

#. Tag: para
#: man-qt5options.7.docbook:147
#, no-c-format
msgid "Sets the default button color."
msgstr ""

#. Tag: term
#: man-qt5options.7.docbook:153
#, no-c-format
msgid "<option>--name</option> <parameter>name</parameter>"
msgstr ""

#. Tag: para
#: man-qt5options.7.docbook:157
#, no-c-format
msgid "Sets the application name."
msgstr ""

#. Tag: term
#: man-qt5options.7.docbook:162
#, no-c-format
msgid "<option>--title</option> <parameter>title</parameter>"
msgstr ""

#. Tag: para
#: man-qt5options.7.docbook:166
#, no-c-format
msgid "Sets the application title (caption)."
msgstr ""

#. Tag: term
#: man-qt5options.7.docbook:171
#, no-c-format
msgid "<option>--visual</option> <parameter>TrueColor</parameter>"
msgstr ""

#. Tag: para
#: man-qt5options.7.docbook:175
#, no-c-format
msgid ""
"Forces the application to use a <parameter>TrueColor</parameter> visual on "
"an 8-bit display."
msgstr ""

#. Tag: term
#: man-qt5options.7.docbook:182
#, no-c-format
msgid "<option>--inputstyle</option> <parameter>inputstyle</parameter>"
msgstr ""

#. Tag: para
#: man-qt5options.7.docbook:186
#, no-c-format
msgid ""
"Sets XIM (X Input Method) input style. Possible values are "
"<parameter>onthespot</parameter>, <parameter>overthespot</parameter>, "
"<parameter>offthespot</parameter> and <parameter>root</parameter>."
msgstr ""

#. Tag: term
#: man-qt5options.7.docbook:194
#, no-c-format
msgid "<option>--im</option> <parameter>XIM server</parameter>"
msgstr ""

#. Tag: para
#: man-qt5options.7.docbook:198
#, no-c-format
msgid "Set XIM server."
msgstr ""

#. Tag: option
#: man-qt5options.7.docbook:204
#, no-c-format
msgid "--noxim"
msgstr ""

#. Tag: para
#: man-qt5options.7.docbook:207
#, no-c-format
msgid "Disable XIM"
msgstr ""

#. Tag: option
#: man-qt5options.7.docbook:213
#, no-c-format
msgid "--reverse"
msgstr ""

#. Tag: para
#: man-qt5options.7.docbook:216
#, no-c-format
msgid "mirrors the whole layout of widgets"
msgstr ""

#. Tag: term
#: man-qt5options.7.docbook:221
#, no-c-format
msgid "<option>--stylesheet</option> <replaceable>file.qss</replaceable>"
msgstr ""

#. Tag: para
#: man-qt5options.7.docbook:225
#, no-c-format
msgid "applies the Qt stylesheet to the application widgets"
msgstr ""

