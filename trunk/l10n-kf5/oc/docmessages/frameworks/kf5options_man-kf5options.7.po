#. Tag: title
#: man-kf5options.7.docbook:34
#, no-c-format
msgid "Options"
msgstr "Opcions"

#. Tag: para
#: man-kf5options.7.docbook:36
#, no-c-format
msgid "The following options apply to all &kde; applications:"
msgstr ""

#. Tag: term
#: man-kf5options.7.docbook:39
#, no-c-format
msgid "<option>--caption</option> <parameter>caption</parameter>"
msgstr ""

#. Tag: para
#: man-kf5options.7.docbook:40
#, no-c-format
msgid "Use <parameter>caption</parameter> as name in the titlebar."
msgstr ""

#. Tag: term
#: man-kf5options.7.docbook:44
#, no-c-format
msgid "<option>--icon</option> <parameter>icon</parameter>"
msgstr ""

#. Tag: para
#: man-kf5options.7.docbook:45
#, no-c-format
msgid "Use <parameter>icon</parameter> as the application icon."
msgstr ""

#. Tag: term
#: man-kf5options.7.docbook:48
#, no-c-format
msgid "<option>--config</option> <parameter>filename</parameter>"
msgstr ""

#. Tag: para
#: man-kf5options.7.docbook:49
#, no-c-format
msgid "Use the alternative configuration <parameter>filename</parameter>"
msgstr ""

#. Tag: option
#: man-kf5options.7.docbook:52
#, no-c-format
msgid "--nocrashhandler"
msgstr ""

#. Tag: para
#: man-kf5options.7.docbook:53
#, no-c-format
msgid "Disable the crash handler, to get core dumps."
msgstr ""

#. Tag: option
#: man-kf5options.7.docbook:56
#, no-c-format
msgid "--waitforwm"
msgstr ""

#. Tag: para
#: man-kf5options.7.docbook:57
#, no-c-format
msgid "Waits for a WM_NET compatible windowmanager."
msgstr ""

#. Tag: term
#: man-kf5options.7.docbook:60
#, no-c-format
msgid "<option>--style</option> <parameter>style</parameter>"
msgstr ""

#. Tag: para
#: man-kf5options.7.docbook:61
#, no-c-format
msgid "Sets the application &GUI; style."
msgstr ""

#. Tag: term
#: man-kf5options.7.docbook:64
#, no-c-format
msgid "<option>--geometry</option> <parameter>geometry</parameter>"
msgstr ""

#. Tag: para
#: man-kf5options.7.docbook:65
#, no-c-format
msgid "Sets the client geometry of the main widget."
msgstr ""

