#. Tag: para
#: index.docbook:21
#, no-c-format
msgid ""
"This is the documentation for the &systemsettings; module to customize the "
"mouse cursor appearance."
msgstr ""

#. Tag: keyword
#: index.docbook:27
#, no-c-format
msgid "<keyword>KDE</keyword>"
msgstr "<keyword>KDE</keyword>"

#. Tag: keyword
#: index.docbook:28
