#, no-c-format
msgid "5: gaseous nebula"
msgstr ""

#. Tag: para
#: config.docbook:446
#, no-c-format
msgid "6: planetary nebula"
msgstr ""

#. Tag: para
#: config.docbook:447
#, no-c-format
msgid "7: supernova remnant"
msgstr ""

#. Tag: para
#: config.docbook:448
#, no-c-format
msgid "8: galaxy"
