#. Tag: title
#: index.docbook:76
#, no-c-format
msgid "Introduction"
msgstr "Introduccion"

#. Tag: para
#: index.docbook:77
#, no-c-format
msgid "Gametype: Toy"
msgstr ""

#. Tag: para
#: index.docbook:78
#, no-c-format
