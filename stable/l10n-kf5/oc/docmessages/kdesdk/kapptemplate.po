#. Tag: title
#: index.docbook:187
#, no-c-format
msgid "The plasmoid application"
msgstr ""

#. Tag: para
#: index.docbook:188
#, no-c-format
msgid ""
"This template generates a simple plasma applet with an icon and some text on "
"it."
msgstr ""

#. Tag: screeninfo
#: index.docbook:191
#, no-c-format
msgid "<screeninfo>&kde; 4 plasma applet template</screeninfo>"
msgstr ""

#. Tag: phrase
#: index.docbook:197
#, no-c-format
msgid "<phrase>&kde; 4 plasma applet template</phrase>"
msgstr ""

#. Tag: para
#: index.docbook:201
#, no-c-format
msgid ""
"You need &kde; 4.1 to build this template and it uses CMake. You can read "
"more about it on <ulink url=\"http://techbase.kde.org/index.php?"
"title=Development/Tutorials/Plasma/GettingStarted\">http://techbase.kde.org/"
"index.php?title=Development/Tutorials/Plasma/GettingStarted</ulink>, all "
"methods are explained here."
msgstr ""

#. Tag: para
#: index.docbook:202
#, no-c-format
msgid ""
"Restart plasma to load the applet by issuing <userinput>kquitapp plasma &amp;"
"&amp; plasma</userinput> or view it with <userinput>plasmoidviewer "
"YourAppletName</userinput>."
msgstr ""

