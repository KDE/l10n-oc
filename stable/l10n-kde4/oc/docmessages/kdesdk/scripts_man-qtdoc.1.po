#. Tag: title
#: man-qtdoc.1.docbook:31
#, no-c-format
msgid "Description"
msgstr "Descripcion"

#. Tag: para
#: man-qtdoc.1.docbook:33
#, no-c-format
msgid ""
"<command>qtdoc</command> opens a &Qt; help page in &konqueror;. If "
"<replaceable>classname</replaceable> is given, it opens the help page for "
"that class. Otherwise the main &Qt; help page is opened. "
"<replaceable>classname</replaceable> is case insensitive."
msgstr ""

