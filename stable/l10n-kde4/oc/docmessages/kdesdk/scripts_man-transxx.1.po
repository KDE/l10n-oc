#. Tag: title
#: man-transxx.1.docbook:30
#, no-c-format
msgid "Description"
msgstr "Descripcion"

#. Tag: para
#: man-transxx.1.docbook:32
#, no-c-format
msgid ""
"<command>transxx</command> is a command-line tool that produces a basic "
"fleshed-out PO-file from a PO-template file. Some of the formatting and "
"structure of the msgid strings will be copied to the msgstr strings, but "
"otherwise text will be translated to <quote>xx</quote>."
msgstr ""

#. Tag: para
#: man-transxx.1.docbook:38
#, no-c-format
msgid "The fleshed-out PO-file is sent to standard output."
msgstr ""

#. Tag: para
#: man-transxx.1.docbook:40
#, no-c-format
msgid ""
"Running your software with the language <quote>xx</quote> will quickly show "
"you any user visible strings that are not translatable."
msgstr ""

