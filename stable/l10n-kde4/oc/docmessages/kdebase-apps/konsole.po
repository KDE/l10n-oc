#. Tag: title
#: index.docbook:724
#, no-c-format
msgid "Rename Tab Dialog"
msgstr ""

#. Tag: para
#: index.docbook:726
#, no-c-format
msgid ""
"The name of the current tab can be changed from this dialog. The dialog can "
"be display via the menu, the shortcut or by double-clicking on the tab in "
"the tab bar. These changes can be made permanent by editing the current "
"profile."
msgstr ""

#. Tag: para
#: index.docbook:732
#, no-c-format
msgid "&konsole; will subsitute these tokens:"
msgstr ""

#. Tag: para
#: index.docbook:735
#, no-c-format
msgid "%n : program name"
msgstr ""

#. Tag: para
#: index.docbook:736
#, no-c-format
msgid "%d : current directory (short)"
msgstr ""

#. Tag: para
#: index.docbook:737
#, no-c-format
msgid "%D : current directory (long)"
msgstr ""

#. Tag: para
#: index.docbook:738
#, no-c-format
msgid "%w : window title set by shell"
msgstr ""

#. Tag: para
#: index.docbook:739
#, no-c-format
msgid "%# : session number"
msgstr ""

#. Tag: para
#: index.docbook:749
#, no-c-format
msgid "Examples:"
msgstr ""

#. Tag: para
#: index.docbook:753
#, no-c-format
msgid ""
"<userinput>%d : %n</userinput> with /usr/src as current directory and "
"running <application>bash</application> will display <guibutton>usr/s : "
"bash</guibutton>"
msgstr ""

#. Tag: para
#: index.docbook:760
#, no-c-format
msgid ""
"<userinput>%D : %n</userinput> with /usr/src as current directory and "
"running <application>top</application> will display <guibutton>/usr/src : "
"top</guibutton>"
msgstr ""

#. Tag: para
#: index.docbook:767
#, no-c-format
msgid ""
"<userinput>%w (%#)</userinput> with ~ as current directory and running "
"<application>vim</application> in the first tab will display <guibutton>[No "
"Name] (~) - VIM(1)</guibutton>"
msgstr ""

#. Tag: title
#: index.docbook:781
#, no-c-format
msgid "Copy Input Dialog"
msgstr ""

#. Tag: para
#: index.docbook:783
#, no-c-format
msgid ""
"The text entered in one tab can simultaneously be sent to other tabs. This "
"dialog allows you to select which tabs will get that input. The current tab "
"will be greyed out."
msgstr ""

#. Tag: title
#: index.docbook:805
#, no-c-format
msgid "Scrollback Options Dialog"
msgstr ""

#. Tag: para
#: index.docbook:807
#, no-c-format
msgid ""
"The <link linkend=\"scrollback\">scrollback</link> option for the history "
"size can be changed in this dialog."
msgstr ""

#. Tag: title
#: index.docbook:817
#, no-c-format
msgid "Command-line Options"
msgstr ""

#. Tag: para
#: index.docbook:819
#, no-c-format
msgid ""
"When &konsole; is started from the command line, various options can be "
"specified to modify its behavior."
msgstr ""

#. Tag: option
#: index.docbook:824
#, no-c-format
msgid "--help"
msgstr "--help"

#. Tag: para
#: index.docbook:825
#, no-c-format
msgid "<action>List the various options</action>."
msgstr ""

#. Tag: term
#: index.docbook:829
#, no-c-format
msgid "<option>--profile</option> <parameter>file</parameter>"
msgstr ""

#. Tag: para
#: index.docbook:830
#, no-c-format
msgid "<action>Start &konsole;</action> using a saved set of sessions."
msgstr ""

#. Tag: option
#: index.docbook:834
#, no-c-format
msgid "--list-profiles"
msgstr ""

#. Tag: para
#: index.docbook:835
#, no-c-format
msgid "<action>List</action> all of the available profiles."
msgstr ""

#. Tag: option
#: index.docbook:840
#, no-c-format
msgid "--background-mode"
msgstr ""

#. Tag: para
#: index.docbook:841
#, no-c-format
msgid ""
"<action>Start &konsole;</action> in the background and bring to the front "
"when the F12 key is pressed."
msgstr ""

#. Tag: option
#: index.docbook:846
#, no-c-format
msgid "--new-tab"
msgstr ""

#. Tag: para
#: index.docbook:847
#, no-c-format
msgid ""
"<action>Create a new tab</action> in an existing window rather than creating "
"a new window."
msgstr ""

#. Tag: term
#: index.docbook:852
#, no-c-format
msgid "<option>--workdir</option> <parameter>dir</parameter>"
msgstr ""

#. Tag: para
#: index.docbook:853
#, no-c-format
msgid ""
"<action>Open with</action> <parameter>dir</parameter> as the working "
"(starting) directory."
msgstr ""

#. Tag: option
#: index.docbook:858
#, no-c-format
msgid "--notransparency"
msgstr ""

#. Tag: para
#: index.docbook:859
#, no-c-format
msgid ""
"<action>Disable</action> transparent backgrounds, even if the system "
"supports them."
msgstr ""

#. Tag: option
#: index.docbook:864
#, no-c-format
msgid "--force-transparency"
msgstr ""

#. Tag: para
#: index.docbook:865
#, no-c-format
msgid ""
"<action>Try to enable transparency</action>, even if the system does not "
"appear to support it."
msgstr ""

#. Tag: option
#: index.docbook:870
#, no-c-format
msgid "--hold, --noclose"
msgstr ""

#. Tag: para
#: index.docbook:871
#, no-c-format
msgid ""
"<action>Do not close</action> the initial session automatically when it ends."
msgstr ""

#. Tag: term
#: index.docbook:876
#, no-c-format
msgid "<option>-p</option> <parameter>property=value</parameter>"
msgstr ""

#. Tag: para
#: index.docbook:877
#, no-c-format
msgid "<action>Change</action> the value of a profile property."
msgstr ""

#. Tag: term
#: index.docbook:882
#, no-c-format
msgid "<option>-e</option> <parameter>command</parameter>"
msgstr ""

#. Tag: para
#: index.docbook:883
#, no-c-format
msgid ""
"<action>Execute</action> <parameter>command</parameter> instead of the "
"normal shell."
msgstr ""

#. Tag: para
#: index.docbook:885
#, no-c-format
msgid ""
"Any arguments after <parameter>command</parameter> will be passed to "
"<parameter>command</parameter>, not &konsole;."
msgstr ""

#. Tag: para
#: index.docbook:892
#, no-c-format
msgid "&konsole; also accepts generic &Qt; and &kde; options:"
msgstr ""

