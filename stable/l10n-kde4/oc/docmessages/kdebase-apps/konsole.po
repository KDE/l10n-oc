#: index.docbook:906
#, no-c-format
msgid ""
"<option>--fn</option>, <option>--font</option> <parameter>fontname</"
"parameter>"
msgstr ""

#. Tag: action
#: index.docbook:908
#, no-c-format
msgid "Defines the application font"
msgstr ""

#. Tag: term
#: index.docbook:912
#, no-c-format
msgid ""
"<option>--bg</option>, <option>--background</option> <parameter>color</"
"parameter>"
msgstr ""

#. Tag: action
#: index.docbook:914
#, no-c-format
msgid "Sets the default background color"
