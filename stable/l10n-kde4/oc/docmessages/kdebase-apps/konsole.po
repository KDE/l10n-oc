msgstr ""

#. Tag: action
#: index.docbook:926
#, no-c-format
msgid "Sets the default button color"
msgstr ""

#. Tag: option
#: index.docbook:936
#, no-c-format
msgid "--help-kde"
msgstr ""

#. Tag: action
#: index.docbook:937
#, no-c-format
msgid "List &kde;-specific options"
msgstr ""

#. Tag: option
#: index.docbook:940
#, no-c-format
