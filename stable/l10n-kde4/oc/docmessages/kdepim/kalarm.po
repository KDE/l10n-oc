msgid ""
"<function>edit()</function> is a D-Bus call to display the <link linkend="
"\"alarm-edit-dlg\">Alarm Edit dialog</link> to edit the specified alarm."
msgstr ""

#. Tag: refentrytitle
#: index.docbook:3996
#, no-c-format
