#. Tag: title
#: menus.docbook:32
#, no-c-format
msgid "Menu Entries"
msgstr ""

#. Tag: para
#: menus.docbook:34
#, no-c-format
msgid ""
"Each menu item is discussed below. When there is a keyboard shortcut that "
"performs a menu item function, the default shortcut is listed with the menu "
"item."
msgstr ""

#. Tag: title
#: menus.docbook:38
#, no-c-format
msgid "The Main Window"
msgstr ""

#. Tag: title
#: menus.docbook:41
#, no-c-format
msgid "<guimenu>File</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:46
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>New Window</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:52 menus.docbook:1479
#, no-c-format
msgid "Creates a new main window."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:58
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>O</keycap></keycombo></"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Open...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:65
#, no-c-format
msgid "Allows you to open files which contain email messages."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:71
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo></"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Save As...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:78
#, no-c-format
msgid ""
"Saves the currently displayed message to a text file, including all the "
"headers and attachments."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:85
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Import Messages...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:91
#, no-c-format
msgid ""
"Starts up <application>kmailcvt</application> (which is part of kdepim). "
"This application lets you import messages from several email clients &kmail;."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:101
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo></"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Print...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:108
#, no-c-format
msgid "Display a dialog that lets you prints the currently displayed message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:126
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Expire All Folders</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:131
#, no-c-format
msgid ""
"Delete old messages from all folders, according to the rules in each "
"folder's <link linkend=\"folders-properties-window\">Properties dialog</"
"link> (the default is not to delete old messages at all)."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:139
#, no-c-format
msgid ""
"<guimenu>File</guimenu> <guimenuitem>Refresh Local &imap; Cache</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:144
#, no-c-format
msgid ""
"This will remove all changes that you have done locally to your IMAP folders "
"and redownload everything from the server. Use this if the local cache was "
"corrupted."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:152
#, no-c-format
msgid ""
"<guimenu>File</guimenu> <guimenuitem>Empty All Trash Folders</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:157
#, no-c-format
msgid ""
"Use this to empty all trash folders, &ie; the local trash folder and all "
"trash folders that you might have on &imap; servers."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:164
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>L</keycap></keycombo></"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Check Mail</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:170
#, no-c-format
msgid ""
"Checks for new messages in all your accounts, except those that have "
"<guilabel>Exclude from &quot;Check Mail&quot;</guilabel> enabled."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:177
#, no-c-format
msgid "<guimenu>File</guimenu> <guisubmenu>Check Mail In</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:183
#, no-c-format
msgid "Submenu that lets you check for new messages from a particular account."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:189
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Send Queued Messages</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:194
#, no-c-format
msgid "Sends the messages that are in your outbox."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:200
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo></"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:207
#, no-c-format
msgid ""
"Closes the current main window or exits &kmail; if there is only this one "
"window."
msgstr ""

#. Tag: title
#: menus.docbook:218 menus.docbook:1573
#, no-c-format
msgid "<guimenu>Edit</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:224 menus.docbook:1579
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Undo</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:231
#, no-c-format
msgid ""
"Revokes your last move or delete action. Note that you cannot undo a "
"deletion in the trash."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:238
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Copy</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:245
#, no-c-format
msgid "Copies selected text to the clipboard."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:251
#, no-c-format
msgid ""
"<shortcut><keycap>Del</keycap></shortcut> <guimenu>Edit</guimenu> "
"<guimenuitem>Move to Trash</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:258
#, no-c-format
msgid ""
"Moves the selected messages to the trash folder. If the selected messages "
"are already in the trash folder, they will really be deleted."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:279
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>F</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find in Message...</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:286
#, no-c-format
msgid "Lets you search for a string in the currently displayed message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:292
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>A</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Select All Messages</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:299
#, no-c-format
msgid "Selects all messages in the current folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:305
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>T</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Select All Text</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:312
#, no-c-format
msgid "Selects the text of the currently displayed message."
msgstr ""

#. Tag: title
#: menus.docbook:322 menus.docbook:1754
#, no-c-format
msgid "<guimenu>View</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:328
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Headers</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:334
#, no-c-format
msgid ""
"Changes the format of the message header in the <guilabel>Message pane</"
"guilabel>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:340
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Attachments</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:346
#, no-c-format
msgid ""
"Changes the way attachments appear in the <guilabel>Message pane</guilabel> "
"(independent of the MIME Tree). With <guimenuitem>As Icons</guimenuitem> all "
"attachments appear as icons at the bottom of the message. "
"<guimenuitem>Smart</guimenuitem> will show attachments as icons, unless the "
"message suggests that they should be displayed inline. You can suggest that "
"certain attachments should be shown inline in your own messages when you "
"select <guilabel>Suggest automatic display</guilabel> in the attachment's "
"properties dialog. <guimenuitem>Inline</guimenuitem> shows the contents of "
"the attachments at the bottom of the message. Attachments that cannot be "
"displayed, &eg; compressed files, will still be shown as an icon. "
"<guimenuitem>Hide</guimenuitem> will not show attachments."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:392
#, no-c-format
msgid ""
"<shortcut><keycap>.</keycap></shortcut> <guimenu>View</guimenu> "
"<guimenuitem>Expand Thread</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:399
#, no-c-format
msgid ""
"If <menuchoice><guimenu>Folder</guimenu><guimenuitem>Thread Messages</"
"guimenuitem> </menuchoice> is activated, this will display the thread of the "
"current message, &ie; all messages that are replies to the current message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:407
#, no-c-format
msgid ""
"<shortcut><keycap>,</keycap></shortcut> <guimenu>View</guimenu> "
"<guimenuitem>Collapse Thread</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:414
#, no-c-format
msgid ""
"If <menuchoice><guimenu>Folder</guimenu><guimenuitem>Thread Messages</"
"guimenuitem> </menuchoice> is activated, this will hide the thread of the "
"current message, &ie; it will hide all messages that are replies to the "
"current message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:422
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>.</keycap></keycombo></"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Expand All Threads</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:429
#, no-c-format
msgid "Expands all threads in the current folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:435
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>,</keycap></keycombo></"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Collapse All Threads</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:442
#, no-c-format
msgid "Collapses all threads in the current folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:448
#, no-c-format
msgid ""
"<shortcut><keycap>V</keycap></shortcut> <guimenu>View</guimenu> "
"<guimenuitem>View Source</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:455
#, no-c-format
msgid ""
"Shows the message and its complete headers in plain text format in a new "
"window. This can be useful to find out the origin of a mail. You should know "
"that it is easy to fake the <literal>From:</literal> header of a mail, but "
"one can still find out which mail servers have been used to send the message "
"by looking at the <literal>Received:</literal> lines in the header."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:465
#, no-c-format
msgid ""
"<shortcut><keycap>X</keycap></shortcut> <guimenu>View</guimenu> "
"<guimenuitem>Use Fixed Font</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:472
#, no-c-format
msgid ""
"Uses a fixed width (monospaced) font to display the messages in the current "
"folder. The font to be used can be configured in the <guilabel>Appearance</"
"guilabel> section of &kmail;'s configuration dialog."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:481
#, no-c-format
msgid "<guimenu>View</guimenu> <guisubmenu>Set Encoding</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:487
#, no-c-format
msgid ""
"Lets you choose the character encoding to be used in the Message Pane. The "
"default, <guilabel>Auto</guilabel>, should work in almost all cases."
msgstr ""

#. Tag: title
#: menus.docbook:498
#, no-c-format
msgid "<guimenu>Go</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:504
#, no-c-format
msgid ""
"<shortcut><keycap>N</keycap></shortcut> <guimenu>Go</guimenu> "
"<guimenuitem>Next Message</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:511
#, no-c-format
msgid ""
"Selects the next message in the message list. The keyboard shortcut "
"<keycap>Right Arrow</keycap> also performs this action."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:518
#, no-c-format
msgid ""
"<shortcut><keycap>+</keycap></shortcut> <guimenu>Go</guimenu> "
"<guimenuitem>Next Unread Message</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:525
#, no-c-format
msgid ""
"Selects the next unread message in the message list. If there is no unread "
"message below the currently selected message then the behavior depends on "
"the value of the <xref linkend=\"configure-misc-folders-go-unread\"/> option."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:534
#, no-c-format
msgid ""
"<shortcut><keycap>P</keycap></shortcut> <guimenu>Go</guimenu> "
"<guimenuitem>Previous Message</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:541
#, no-c-format
msgid "Selects the previous message in the message list."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:547
#, no-c-format
msgid ""
"<shortcut><keycap>-</keycap></shortcut> <guimenu>Go</guimenu> "
"<guimenuitem>Previous Unread Message</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:554
#, no-c-format
msgid ""
"Selects the previous unread message in the message list. If there is no "
"unread message above the currently selected message then the behavior "
"depends on the value of the <xref linkend=\"configure-misc-folders-go-unread"
"\"/> option."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:563
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Alt;<keycap>+</keycap></keycombo></"
"shortcut> <guimenu>Go</guimenu> <guimenuitem>Next Unread Folder</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:570
#, no-c-format
msgid "Jumps to the next folder with unread messages."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:576
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Alt;<keycap>-</keycap></keycombo></"
"shortcut> <guimenu>Go</guimenu> <guimenuitem>Previous Unread Folder</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:583
#, no-c-format
msgid "Jumps to the previous folder with unread messages."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:589
#, no-c-format
msgid ""
"<shortcut><keycap>Space</keycap></shortcut> <guimenu>Go</guimenu> "
"<guimenuitem>Next Unread Text</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:596
#, no-c-format
msgid ""
"Scrolls down if you are not yet at the bottom of a message, otherwise jumps "
"to the next unread message."
msgstr ""

#. Tag: title
#: menus.docbook:607
#, no-c-format
msgid "<guimenu>Folder</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:613
#, no-c-format
msgid "<guimenu>Folder</guimenu> <guimenuitem>New Folder...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:619
#, no-c-format
msgid ""
"Opens the <link linkend=\"folders-properties-window\">Folder Properties</"
"link> dialog that lets you create a new folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:626
#, no-c-format
msgid ""
"<guimenu>Folder</guimenu> <guimenuitem>Mark All Messages as Read</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:632
#, no-c-format
msgid ""
"Sets the status of all new and unread messages in the current folder to read."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:638
#, no-c-format
msgid ""
"<shortcut><keycap>F5</keycap></shortcut> <guimenu>Folder</guimenu> "
"<guimenuitem>Check Mail in This Folder</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:645
#, no-c-format
msgid ""
"Checks whether new mail arrived in the currently selected folder. This is "
"only available for &imap; folders."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:652
#, no-c-format
msgid ""
"<guimenu>Folder</guimenu> <guimenuitem>Move All Messages to Trash</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:658
#, no-c-format
msgid ""
"Moves all of the messages in the selected folder into the trash folder. This "
"is only available if the currently selected folder is not a trash folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:696
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>*</keycap></keycombo></"
"shortcut> <guimenu>Folder</guimenu> <guimenuitem>Remove Duplicate Messages</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:703
#, no-c-format
msgid "Searches the folder for duplicate messages and deletes the duplicates."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:723
#, no-c-format
msgid "<guimenu>Folder</guimenu> <guimenuitem>Delete Folder</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:729
#, no-c-format
msgid "Removes the selected folder and all its contents, including subfolders."
msgstr ""

#. Tag: para
#: menus.docbook:730
#, no-c-format
msgid ""
"Note that there is no way to access the contents of a folder after it has "
"been removed."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:737
#, no-c-format
msgid ""
"<guimenu>Folder</guimenu> <guimenuitem>Prefer HTML to Plain Text</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:743
#, no-c-format
msgid ""
"If enabled then &html; messages in this folder will be shown using &html; "
"rendering. For security reasons, we recommend to only activate this for "
"folders which only contain trusted messages."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:782
#, no-c-format
msgid "<guimenu>Folder</guimenu> <guimenuitem>Properties</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:788
#, no-c-format
msgid ""
"Opens up the <link linkend=\"folders-properties-window\">Properties dialog</"
"link> which lets you change the settings for the selected folder."
msgstr ""

#. Tag: title
#: menus.docbook:798 menus.docbook:1454
#, no-c-format
msgid "<guimenu>Message</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:804
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo></"
"shortcut> <guimenu>Message</guimenu> <guimenuitem>New Message...</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:811
#, no-c-format
msgid ""
"Opens the <link linkend=\"the-composer-window\">composer window</link> so "
"you can write a new message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:818
#, no-c-format
msgid ""
"<guimenu>Message</guimenu> <guimenuitem>New Message to Mailing-List...</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:824
#, no-c-format
msgid ""
"Opens the composer window so you can write a new mail. If the current folder "
"holds a mailing list and has a posting address defined, this address will be "
"the default <guilabel>To:</guilabel> address."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:833
#, no-c-format
msgid ""
"<shortcut><keycap>R</keycap></shortcut> <guimenu>Message</guimenu> "
"<guimenuitem>Reply...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:840
#, no-c-format
msgid ""
"Opens up the composer window, inserts the quoted text of the currently "
"selected message and presets the <guilabel>To:</guilabel> field either with "
"the mailing-list address (if you reply to a mailing-list message) or with "
"the preferred reply address of the sender. If you want to control which "
"address the <guilabel>To:</guilabel> field is preset with then you should "
"either use <menuchoice><guimenu>Message</guimenu><guimenuitem>Reply to "
"Author...</guimenuitem></menuchoice> or <menuchoice><guimenu>Message</"
"guimenu><guimenuitem>Reply to Mailing-List...</guimenuitem></menuchoice>. "
"Your identity will automatically be set to the one which this message was "
"sent to."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:856
#, no-c-format
msgid ""
"<shortcut><keycap>A</keycap></shortcut> <guimenu>Message</guimenu> "
"<guimenuitem>Reply to All...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:863
#, no-c-format
msgid ""
"Opens up the composer window, inserts the quoted text of the currently "
"selected message and presets the <guilabel>To:</guilabel> field either with "
"the mailing-list address (if you reply to a mailing-list message) or with "
"the preferred reply address of the sender. The <guilabel>Copy to (CC):</"
"guilabel> field is preset with the addresses of all other recipients of the "
"currently selected message excluding your own addresses. Your identity will "
"automatically be set to the one which this message was sent to."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:876
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Shift;<keycap>A</keycap></keycombo></"
"shortcut> <guimenu>Message</guimenu> <guisubmenu>Reply Special</guisubmenu> "
"<guimenuitem>Reply to Author...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:884
#, no-c-format
msgid ""
"Opens up the composer window, inserts the quoted text of the currently "
"selected message and presets the <guilabel>To:</guilabel> field with the "
"preferred reply address of the sender. Your identity will automatically be "
"set to the one which this message was sent to."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:894
#, no-c-format
msgid ""
"<shortcut><keycap>L</keycap></shortcut> <guimenu>Message</guimenu> "
"<guisubmenu>Reply Special</guisubmenu> <guimenuitem>Reply to Mailing-List..."
"</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:902
#, no-c-format
msgid ""
"Opens up the composer window, inserts the quoted text of the currently "
"selected message and presets the <guilabel>To:</guilabel> field with the "
"mailing-list address. If you did not specify a mailing-list address for the "
"currently selected folder and &kmail; cannot determine the posting address "
"from the currently selected message then the <guilabel>To:</guilabel> field "
"will be empty. Your identity will automatically be set to the one which this "
"message was sent to."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:915
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Shift;<keycap>R</keycap></keycombo></"
"shortcut> <guimenu>Message</guimenu> <guisubmenu>Reply Special</guisubmenu> "
"<guimenuitem>Reply Without Quote...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:923
#, no-c-format
msgid ""
"Works just like <guimenuitem>Reply...</guimenuitem> except that the text of "
"the currently selected message is not quoted."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:929
#, no-c-format
msgid "<guimenu>Message</guimenu> <guimenuitem>Forward</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:935
#, no-c-format
msgid ""
"Forwards the message to a new recipient. Using <guimenuitem>Inline</"
"guimenuitem>, the message's text and some important header fields will be "
"copied to the body of the new message with a text marking the forwarded "
"part. Attachments will be forwarded as attachments of the new message. Using "
"<guimenuitem>As Attachment</guimenuitem> the message and its attachments "
"will become an attachment of the new message. The original message headers "
"will be included in the forwarded message, too. <guimenuitem>Redirect</"
"guimenuitem> works like forward, except that the message stays the same "
"(even the <guilabel>From:</guilabel> field). The user who redirected the "
"message is added in special header fields (<literal>Redirect-From</literal>, "
"<literal>Redirect-Date</literal>, <literal>Redirect-To</literal>, &etc;)."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:950
#, no-c-format
msgid "<guimenu>Message</guimenu> <guimenuitem>Send Again...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:956
#, no-c-format
msgid ""
"Opens a composer window with the currently selected message so it can be "
"sent again. This is only available for messages which you have sent or, more "
"precisely, for messages which have the <guilabel>sent</guilabel> status."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:964
#, no-c-format
msgid ""
"<shortcut><keycap>T</keycap></shortcut> <guimenu>Message</guimenu> "
"<guimenuitem>Edit Message</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:971
#, no-c-format
msgid ""
"Edits the selected message if it is editable. Only messages in the "
"<guilabel>outbox</guilabel> and <guilabel>drafts</guilabel> folder can be "
"edited."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:978
#, no-c-format
msgid "<guimenu>Message</guimenu> <guisubmenu>Copy To</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:984
#, no-c-format
msgid "Copies the selected messages to a certain folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:990
#, no-c-format
msgid "<guimenu>Message</guimenu> <guisubmenu>Move To</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:996
#, no-c-format
msgid "Moves the selected messages to a certain folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1002
#, no-c-format
msgid "<guimenu>Message</guimenu> <guisubmenu>Mark Message</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1008
#, no-c-format
msgid ""
"Allows you to change the status of the selected message to one of the "
"following states:"
msgstr ""

