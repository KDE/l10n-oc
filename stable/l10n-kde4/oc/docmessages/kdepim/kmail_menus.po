#. Tag: guimenuitem
#: menus.docbook:1063
#, no-c-format
msgid "Spam"
msgstr ""

#. Tag: entry
#: menus.docbook:1064
#, no-c-format
msgid "Round recycle symbol"
msgstr ""

#. Tag: entry
#: menus.docbook:1065
#, no-c-format
msgid ""
"This status will not be set automatically by &kmail;. You can use it to mark "
"spam messages."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1069
#, no-c-format
msgid "<guimenuitem>Ham</guimenuitem>"
msgstr ""

#. Tag: entry
#: menus.docbook:1070
#, no-c-format
msgid "Green check mark"
msgstr ""

#. Tag: entry
#: menus.docbook:1071
#, no-c-format
msgid ""
"This status will not be set automatically by &kmail;. You can use it to mark "
"messages which are not spam."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1083
#, no-c-format
msgid "<guimenu>Message</guimenu> <guisubmenu>Mark Thread</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1089
#, no-c-format
msgid ""
"Allows you to change the status of all messages in a thread. The possible "
"states are the same as for <menuchoice><guimenu>Message</guimenu> "
"<guimenuitem>Mark Message</guimenuitem></menuchoice>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1123
#, no-c-format
msgid "<guimenu>Message</guimenu> <guisubmenu>Create Filter</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1129
#, no-c-format
msgid ""
"Opens up the <link linkend=\"filter-dialog-id\">Filter dialog</link> with a "
"new filter added. This new filter is based on fields of the current mail, "
"depending on which sub menu item you select."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1137
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>J</keycap></keycombo></"
"shortcut> <guimenu>Message</guimenu> <guimenuitem>Apply Filters</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1144
#, no-c-format
msgid "Applies your filters to the selected messages."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1150
#, no-c-format
msgid "<guimenu>Message</guimenu> <guimenuitem>Apply Filter</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1156
#, no-c-format
msgid ""
"Allows you to apply an individual filter to the selected messages. Only "
"filters for which you enabled the <guilabel>Add this filter to the Apply "
"Filter menu</guilabel> option will be available."
msgstr ""

#. Tag: title
#: menus.docbook:1168 menus.docbook:2061
#, no-c-format
msgid "<guimenu>Tools</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1174
#, no-c-format
msgid ""
"<shortcut><keycap>S</keycap></shortcut> <guimenu>Tools</guimenu> "
"<guimenuitem>Find Messages...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1181
#, no-c-format
msgid ""
"Opens up a search window that lets you search for messages with certain "
"characteristics, &eg; a certain subject. Start the search by entering some "
"values and press <guibutton>Search</guibutton>. Click on one of the "
"resulting messages and it will appear in the <guilabel>Message pane</"
"guilabel>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1191
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Address Book</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1197
#, no-c-format
msgid ""
"Starts up <ulink url=\"/kaddressbook/\">&kaddressbook;</ulink>, the &kde; "
"address book."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1204
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Certificate Manager...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1210
#, no-c-format
msgid ""
"Starts <ulink url=\"/kleopatra\"><application>Kleopatra</application></"
"ulink>, the &kde; certificate manager."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1220
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>GnuPG Log Viewer</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1226
#, no-c-format
msgid ""
"Starts <ulink url=\"/kwatchgnupg\"><application>KWatchGnuPG</application></"
"ulink>, a tool to present the debug output of <application>GnuPG</"
"application> application. If signing, encryption, or verification "
"mysteriously stop working, you might find out why by looking at the log."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1239
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guisubmenu>Edit \"Out of Office\" Replies...</"
"guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1245
#, no-c-format
msgid ""
"Launch the <guilabel>Configure \"Out of Office\" Replies</guilabel> dialog, "
"which allow you to set-up vacation notifications."
msgstr ""

#. Tag: para
#: menus.docbook:1247
#, no-c-format
msgid ""
"<guilabel>Out of Office reply</guilabel> functionality relies on server-side "
"filtering. To be able to use it you need to configure the <link linkend="
"\"receiving-mail\">Filtering tab</link> (see option relevant to kolab "
"server) of your <guilabel>IMAP</guilabel> account set-up."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1255
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guisubmenu>Filter Log Viewer...</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1261
#, no-c-format
msgid ""
"Opens up the viewer window for the filter log; there you find some options "
"to control the logging of the filtering process. In the log you will find "
"valuable information about what filter rules were used, what was the result "
"of the evaluation of those rules, and which filter actions were applied to a "
"message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1270
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Anti-Spam Wizard...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1276
#, no-c-format
msgid ""
"It starts a <link linkend=\"the-anti-spam-wizard\">wizard</link> which can "
"help you to set up spam filtering."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1283
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Anti-Virus Wizard...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1289
#, no-c-format
msgid ""
"It starts a <link linkend=\"the-anti-virus-wizard\">wizard</link> which can "
"help you to set up scanning messages for viruses."
msgstr ""

#. Tag: title
#: menus.docbook:1300 menus.docbook:2098
#, no-c-format
msgid "<guimenu>Settings</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1306
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Toolbar</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1312
#, no-c-format
msgid ""
"If enabled, the Toolbar is visible (the Toolbar is the one with the icon to "
"compose a new message &etc;)."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1332
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Filters...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1338
#, no-c-format
msgid "Opens the <link linkend=\"filters\">Message Filters</link> window."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1344
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure POP Filters...</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1350
#, no-c-format
msgid ""
"Opens the <link linkend=\"popfilters\">Configure Pop Filters</link> window."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1356 menus.docbook:2130
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1362 menus.docbook:2136
#, no-c-format
msgid ""
"Opens a window that lets you configure the keyboard shortcuts for many menu "
"commands."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1369
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Notifications...</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1375
#, no-c-format
msgid ""
"Opens a window that lets you configure what happens when new mail arrives, "
"like playing a sound."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1382 menus.docbook:2143
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Toolbars...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1388
#, no-c-format
msgid ""
"Opens a window that lets you choose which icons are visible in the toolbar."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1395 menus.docbook:2156
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure &kmail;...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1401
#, no-c-format
msgid "Opens the <link linkend=\"configure\">Configure</link> window."
msgstr ""

#. Tag: title
#: menus.docbook:1410 menus.docbook:2171
#, no-c-format
msgid "<guimenu>Help</guimenu> Menu"
msgstr ""

#. Tag: para
#: menus.docbook:1412
#, no-c-format
msgid ""
"These are the &kde; standard items for the <guimenu>Help</guimenu> menu:"
msgstr ""

#. Tag: sect2
#: menus.docbook:1412
#, no-c-format
msgid "&help.menu.documentation;"
msgstr ""

#. Tag: para
#: menus.docbook:1416
#, no-c-format
msgid "Additionally &kmail; offers these items:"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1422
#, no-c-format
msgid "<guimenu>Help</guimenu> <guimenuitem>&kmail; Introduction</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1428
#, no-c-format
msgid ""
"This displays the welcome screen, which lists the most important differences "
"between your version of &kmail; and the previous one."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1435
#, no-c-format
msgid "<guimenu>Help</guimenu> <guimenuitem>Tip of the Day</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1441
#, no-c-format
msgid "This displays a dialog with useful hints for using &kmail;."
msgstr ""

#. Tag: title
#: menus.docbook:1451
#, no-c-format
msgid "The Composer Window"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1460
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo></"
"shortcut> <guimenu>Message</guimenu> <guimenuitem>New Composer</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1467
#, no-c-format
msgid "Opens up a new composer window."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1473
#, no-c-format
msgid "<guimenu>Message</guimenu> <guimenuitem>New Main Window</guimenuitem>"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1485
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Return</keycap></"
"keycombo></shortcut> <guimenu>Message</guimenu> <guimenuitem>Send Mail</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1492
#, no-c-format
msgid ""
"Sends the message immediately. If you use SMTP to send your messages and the "
"SMTP server is not reachable, the message will be put into the outbox and "
"you will get an error message. You can then later send the messages in the "
"outbox using <menuchoice><guimenu>File</guimenu><guimenuitem>Send Queued "
"Messages</guimenuitem></menuchoice>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1502
#, no-c-format
msgid "<guimenu>Message</guimenu> <guimenuitem>Send Later</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1508
#, no-c-format
msgid ""
"Queues the message in the outbox for sending it later using "
"<menuchoice><guimenu>File</guimenu><guimenuitem>Send Queued Messages</"
"guimenuitem></menuchoice>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1517
#, no-c-format
msgid ""
"<guimenu>Message</guimenu> <guimenuitem>Save in Drafts Folder</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1523
#, no-c-format
msgid ""
"Save the message in the <guilabel>drafts</guilabel> folder so you can later "
"edit and send it."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1530
#, no-c-format
msgid "<guimenu>Messages</guimenu> <guimenuitem>Insert File...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1536
#, no-c-format
msgid ""
"Inserts a text file into the message text, starting at the cursor position."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1543
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo></"
"shortcut> <guimenu>Message</guimenu> <guimenuitem>Print...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1550
#, no-c-format
msgid "Prints the current text."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1556
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>W</keycap></keycombo></"
"shortcut> <guimenu>Message</guimenu> <guimenuitem>Close</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1563
#, no-c-format
msgid "Closes this composer window."
msgstr ""

#. Tag: para
#: menus.docbook:1586
#, no-c-format
msgid "Undo your steps in editing the current message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1592
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>Z</keycap></"
"keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Redo</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1599
#, no-c-format
msgid "Redo your steps in editing the current message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1605
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>X</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Cut</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1612
#, no-c-format
msgid ""
"Cutting text works as with most editors: the selected text is removed and "
"put into the clipboard. Note that you can also select text and drag it to a "
"new position."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1620
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Copy</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1628
#, no-c-format
msgid ""
"Copying text works as with most editors: the selected text is copied to the "
"clipboard. Note that you can also select text while holding the &Ctrl; key, "
"and drag it to a new position to copy it."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1636
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>V</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Paste</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1643
#, no-c-format
msgid ""
"Pasting works the same as with most editors: the text from the clipboard is "
"pasted at the current cursor position."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1650
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Paste as Quotation</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1656
#, no-c-format
msgid "Pastes the text from the clipboard marked as quotation."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1662
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>A</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Select All</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1669
#, no-c-format
msgid "Selects all of the text in your message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1675
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>F</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1682
#, no-c-format
msgid "Opens a dialog to search for strings in the current message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1688
#, no-c-format
msgid ""
"<shortcut><keycap>F3</keycap></shortcut> <guimenu>Edit</guimenu> "
"<guimenuitem>Find Next</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1695
#, no-c-format
msgid "Goes to the next occurrence of the previously searched string."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1701
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>R</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Replace...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1708
#, no-c-format
msgid ""
"Opens a dialog that lets you replace strings in your message with other "
"strings."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1714
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Clean Spaces</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1720
#, no-c-format
msgid ""
"This replaces multiple line breaks or spaces with single line breaks or "
"spaces. It works on the current selection or on the complete message if "
"there is no selection."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1727
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Add Quote Characters</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1733
#, no-c-format
msgid "Prepends the selected text with quotation marks."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1739
#, no-c-format
msgid ""
"<guimenu>Edit</guimenu> <guimenuitem>Remove Quote Characters</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1745
#, no-c-format
msgid "Removes the left-most quotation marks from the selected text."
msgstr ""

#. Tag: para
#: menus.docbook:1756
#, no-c-format
msgid ""
"This menu lets you toggle the display of the header fields and other options "
"in this composer window."
msgstr ""

#. Tag: para
#: menus.docbook:1759
#, no-c-format
msgid "Options available are:"
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1763
#, no-c-format
msgid "All Fields"
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1766
#, no-c-format
msgid "Identity"
msgstr "Identitat"

#. Tag: guimenuitem
#: menus.docbook:1769
#, no-c-format
msgid "Dictionary"
msgstr "Diccionari"

#. Tag: guimenuitem
#: menus.docbook:1772
#, no-c-format
msgid "Sent-Mail folder"
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1775
#, no-c-format
msgid "Mail Transport"
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1778
#, no-c-format
msgid "From"
msgstr "De"

#. Tag: guimenuitem
#: menus.docbook:1781
#, no-c-format
msgid "Reply To"
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1784
#, no-c-format
msgid "<guimenuitem>To</guimenuitem>"
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1787
#, no-c-format
msgid "<guimenuitem>CC</guimenuitem>"
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1790
#, no-c-format
msgid "<guimenuitem>BCC</guimenuitem>"
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1793
#, no-c-format
msgid "Subject"
msgstr "Subjècte"

#. Tag: para
#: menus.docbook:1797
#, no-c-format
msgid ""
"Currently visible items have a checkmark shown next to their name in the "
"menu."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1803
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Use Fixed Font</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1809
#, no-c-format
msgid ""
"Uses a fixed width (monospaced) font to display the currently edited "
"message. The font to be used can be configured in the <guilabel>Appearance</"
"guilabel> section of &kmail;'s configuration dialog."
msgstr ""

#. Tag: title
#: menus.docbook:1820
#, no-c-format
msgid "<guimenu>Options</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1826
#, no-c-format
msgid "<guimenu>Options</guimenu> <guimenuitem>Urgent</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1832
#, no-c-format
msgid ""
"Sets the priority of the message to Urgent. The receiver's email client has "
"to support this or it will have no effect. &kmail; itself does not support "
"priorities for incoming messages."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1840
#, no-c-format
msgid ""
"<guimenu>Options</guimenu> <guimenuitem>Request Disposition Notification</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1846
#, no-c-format
msgid ""
"If you choose this option, you request a confirmation email once your "
"message is downloaded and read by its recipient. This has to be supported "
"and enabled by the receiver's email client in order to work."
msgstr ""

#. Tag: para
#: menus.docbook:1852
#, no-c-format
msgid ""
"See <xref linkend=\"configure-security-reading-mdns\"/> for background "
"information and ways to customize the read receipts that &kmail; itself "
"sends."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1862
#, no-c-format
msgid "<guimenu>Options</guimenu> <guisubmenu>Sign Message</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1868
#, no-c-format
msgid ""
"Digitally sign the message using <application>OpenPGP</application>. You can "
"learn more about this in the <link linkend=\"pgp\">chapter on OpenPGP</link>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1875
#, no-c-format
msgid "<guimenu>Options</guimenu> <guisubmenu>Encrypt Message</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1881
#, no-c-format
msgid ""
"Encrypt the message using <application>OpenPGP</application>. You can learn "
"more about this in the <link linkend=\"pgp\">chapter on OpenPGP</link>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1888
#, no-c-format
msgid ""
"<guimenu>Options</guimenu> <guisubmenu>Select Cryptographic Message Format</"
"guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1894
#, no-c-format
msgid ""
"Choose the cryptographic message format to use to digitally sign and/or "
"encrypt the message in. See <link linkend=\"cryptographic-message-formats"
"\">the previous description of each option</link> for more information."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1905
#, no-c-format
msgid "<guimenu>Options</guimenu> <guisubmenu>Formatting (HTML)</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1911
#, no-c-format
msgid "Enables &html; editing."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1917
#, no-c-format
msgid "<guimenu>Options</guimenu> <guisubmenu>Set Encoding</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1923
#, no-c-format
msgid ""
"Set the charset encoding of this message. The chosen encoding will appear in "
"the header of the outgoing mail. You can use <guilabel>Auto</guilabel> for "
"almost all cases, &kmail; will tell you if you need to select a different "
"encoding manually."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1931
#, no-c-format
msgid "<guimenu>Options</guimenu> <guimenuitem>Wordwrap</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1937
#, no-c-format
msgid ""
"Toggles the automatic wordwrap. It may be useful to turn it off if you want "
"to paste long lines that should not wrap."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1944
#, no-c-format
msgid ""
"<guimenu>Options</guimenu> <guimenuitem>Automatic Spellchecking</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1950
#, no-c-format
msgid "Toggles automatic spellchecking."
msgstr ""

#. Tag: title
#: menus.docbook:1960
#, no-c-format
msgid "<guimenu>Attach</guimenu> Menu"
msgstr ""

#. Tag: para
#: menus.docbook:1962
#, no-c-format
msgid "This menu lets you select attachment options."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1968
#, no-c-format
msgid "<guimenu>Attach</guimenu> <guimenuitem>Append Signature</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1974
#, no-c-format
msgid ""
"Appends your signature (<quote>footer</quote>) to the end of the message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1981
#, no-c-format
msgid ""
"<guimenu>Attach</guimenu> <guimenuitem>Attach Public Key...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1987
#, no-c-format
msgid ""
"Attaches the corresponding <application>PGP</application>/"
"<application>GnuPG</application> key to your message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1994
#, no-c-format
msgid ""
"<guimenu>Attach</guimenu> <guimenuitem>Attach My Public Key</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2000
#, no-c-format
msgid ""
"Attaches your <application>PGP</application>/<application>GnuPG</"
"application> public key to your message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2007
#, no-c-format
msgid "<guimenu>Attach</guimenu> <guimenuitem>Attach File...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2013
#, no-c-format
msgid "Attaches one or more files to the current message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2020
#, no-c-format
msgid "<guimenu>Attach</guimenu> <guimenuitem>Remove Attachment</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2026
#, no-c-format
msgid ""
"Removes the attachment that is selected in the attachment part of the "
"composer."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2032
#, no-c-format
msgid ""
"<guimenu>Attach</guimenu> <guimenuitem>Save Attachment As...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2038
#, no-c-format
msgid ""
"Saves the attachment that is selected in the attachment window to a file."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2045
#, no-c-format
msgid ""
"<guimenu>Attach</guimenu> <guimenuitem>Attachment Properties</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2051
#, no-c-format
msgid ""
"Displays the <link linkend=\"attachments\">properties of the attachment</"
"link> that is selected in the attachment window."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2067
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Spelling...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2073
#, no-c-format
msgid ""
"Uses <ulink url=\"/kspell/\">&sonnet;</ulink> to check the spelling in the "
"body of your message. Note that you have to configure &sonnet; with "
"<menuchoice><guimenu>Settings</guimenu> <guimenuitem>Spellchecker...</"
"guimenuitem></menuchoice> if you use it for the first time."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2083
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Addressbook...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2089
#, no-c-format
msgid "Opens up <ulink url=\"/kaddressbook/\">&kaddressbook;</ulink>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2104
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Toolbars Shown</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2110
#, no-c-format
msgid ""
"Enables and disables the Main Toolbar, &ie; the one with the icon to send "
"the message &etc; and the &html; Toolbar, &ie; the one which with the tools "
"to change certain properties of the composed text."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:2118
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Spellchecker...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:2124
#, no-c-format
msgid ""
"Allows you to configure <ulink url=\"/kspell/\">&sonnet;</ulink>, &kde;'s "
"spellchecker."
msgstr ""

#. Tag: para
#: menus.docbook:2149
#, no-c-format
msgid ""
"Opens a window that allows you to decide which icons appear in the toolbar."
msgstr ""

#. Tag: para
#: menus.docbook:2162
#, no-c-format
msgid ""
"Opens &kmail;'s <link linkend=\"configure\">configuration dialog</link>."
msgstr ""

#. Tag: para
#: menus.docbook:2173
#, no-c-format
msgid ""
"The entries in this menu have the same meaning as <link linkend=\"reader-"
"help-menu\">the entries in the main window's help menu</link>."
msgstr ""
