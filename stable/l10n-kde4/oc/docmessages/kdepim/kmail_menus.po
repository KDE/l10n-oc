#. Tag: title
#: menus.docbook:47
#, no-c-format
msgid "Menu Entries"
msgstr ""

#. Tag: para
#: menus.docbook:48
#, no-c-format
msgid ""
"&kmail; has common &kde; <guimenu>Edit</guimenu>, <guimenu>Settings</"
"guimenu>, and <guimenu>Help</guimenu> menu items, for more information read "
"the sections about the <ulink url=\"help:/fundamentals/ui.html#menus-edit"
"\">Edit Menu</ulink>, <ulink url=\"help:/fundamentals/ui.html#menus-settings"
"\">Settings Menu</ulink>, and <ulink url=\"help:/fundamentals/ui.html#menus-"
"help\">Help Menu</ulink> of the &kde; Fundamentals."
msgstr ""

#. Tag: para
#: menus.docbook:54
#, no-c-format
msgid ""
"Each &kmail; specific menu item is discussed below. When there is a keyboard "
"shortcut that performs a menu item function, the default shortcut is listed "
"with the menu item."
msgstr ""

#. Tag: title
#: menus.docbook:58
#, no-c-format
msgid "The Main Window"
msgstr ""

#. Tag: title
#: menus.docbook:61
#, no-c-format
msgid "File Menu"
msgstr ""

#. Tag: guimenu
#: menus.docbook:63
#, no-c-format
msgid "File"
msgstr ""

#. Tag: para
#: menus.docbook:65
#, no-c-format
msgid "The main file menu to work with the current message/folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:68
#, no-c-format
msgid "<guimenu>File</guimenu><guisubmenu>New</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:70
#, no-c-format
msgid "Here you can create several new items as follows:"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:73
#, no-c-format
msgid ""
"<guimenu>File</guimenu><guisubmenu>New</guisubmenu><guimenuitem>New "
"Message...</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:75
#, no-c-format
msgid "Compose a new message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:78
#, no-c-format
msgid ""
"<guimenu>File</guimenu><guisubmenu>New</guisubmenu><guisubmenu>Message from "
"Template</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:80
#, no-c-format
msgid ""
"If you have any saved templates, they will be listed on the submenu, select "
"the one you wish to use. To save messages to a template, select "
"<menuchoice><shortcut><keycap>T</keycap></shortcut><guimenu>Message</"
"guimenu><guimenuitem>Edit Message</guimenuitem></menuchoice>, and in the "
"message edit window, select <menuchoice><guimenu>Message</"
"guimenu><guimenuitem>Save as Template</guimenuitem></menuchoice>"
msgstr ""

#. Tag: para
#: menus.docbook:83
#, no-c-format
msgid ""
"If you do not have any templates saved, you will see "
"<menuchoice><guimenu>Message</guimenu><guisubmenu>Message from Template</"
"guisubmenu><guimenuitem>(no templates)</guimenuitem></menuchoice>"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:86
#, no-c-format
msgid ""
"<guimenu>File</guimenu><guisubmenu>New</guisubmenu><guimenuitem>Add Folder..."
"</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:88
#, no-c-format
msgid "Create a new folder"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:91
#, no-c-format
msgid ""
"<guimenu>File</guimenu><guisubmenu>New</guisubmenu><guimenuitem>New "
"AddressBook Contact...</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:93
#, no-c-format
msgid "Brings up the new contact dialog"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:96
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>O</keycap></keycombo></"
"shortcut> <guimenu>File</guimenu><guimenuitem>Open...</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:98
#, no-c-format
msgid "Open email messages or mailboxes."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:100
#, no-c-format
msgid "<guimenu>File</guimenu><guimenuitem>Open Recent</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:102
#, no-c-format
msgid ""
"<action>Opens recently used messages.</action> Only messages that have been "
"saved and then opened will show up on this list."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:105
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo></"
"shortcut> <guimenu>File</guimenu><guimenuitem>Save As...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:108
#, no-c-format
msgid ""
"<action>Saves the currently displayed message to a .mbox file.</action> This "
"includes all the headers and attachments."
msgstr ""

#. Tag: para
#: menus.docbook:109
#, no-c-format
msgid ""
"If you would like to save it to a different format &eg; text, deselect "
"<guilabel>Automatically select filename extension (.mbox)</guilabel> and be "
"sure to change the file extension."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:113
#, no-c-format
msgid "<guimenu>File</guimenu><guimenuitem>Import Messages...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:114
#, no-c-format
msgid ""
"<action>Starts up <application>kmailcvt</application></action>. This "
"application lets you import messages from several email clients into &kmail;."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:118
#, no-c-format
msgid "<guimenu>File</guimenu><guimenuitem>Print Preview...</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:120
#, no-c-format
msgid ""
"Display a dialog which shows how your email will be printed. Note: This will "
"only be available if a printer is available."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:123
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo></"
"shortcut> <guimenu>File</guimenu><guimenuitem>Print...</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:126
#, no-c-format
msgid "Display a dialog that lets you print the currently displayed message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:129
#, no-c-format
msgid "<guimenu>File</guimenu><guimenuitem>Expire All Folders</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:131
#, no-c-format
msgid ""
"Delete old messages from all folders, according to the rules in each "
"folder's <link linkend=\"folders-properties-window\">Properties dialog</"
"link> (the default is not to delete old messages at all)."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:135
#, no-c-format
msgid ""
"<guimenu>File</guimenu><guimenuitem>Empty All Trash Folders</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:137
#, no-c-format
msgid ""
"Use this to empty all trash folders, &ie; the local trash folder and all "
"trash folders that you might have on &imap; servers."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:141
#, no-c-format
msgid "<guimenu>File</guimenu><guimenuitem>Work Offline</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:143
#, no-c-format
msgid ""
"<action>Sets &kmail; to offline mode.</action> This turns off all network "
"jobs. This is useful when working with messages without a network "
"connection. This selection will become <menuchoice><guimenu>File</"
"guimenu><guimenuitem>Work Online</guimenuitem></menuchoice>, which needs to "
"be selected to go back online (required to send and receive)."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:148
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>L</keycap></keycombo></"
"shortcut> <guimenu>File</guimenu><guimenuitem>Check Mail</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:151
#, no-c-format
msgid "Checks for new messages in all your accounts."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:154
#, no-c-format
msgid "<guimenu>File</guimenu><guisubmenu>Check Mail In</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:156
#, no-c-format
msgid "Submenu that lets you check for new messages from a particular account."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:159
#, no-c-format
msgid ""
"<shortcut><keycap>F5</keycap></shortcut> <guimenu>File</"
"guimenu><guimenuitem>Update Folder</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:162 menus.docbook:529
#, no-c-format
msgid ""
"Checks whether new mail arrived in the currently selected folder. This is "
"only available for &imap; folders."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:165
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>F5</keycap></keycombo></"
"shortcut> <guimenu>File</guimenu><guimenuitem>Update This Folder and All Its "
"Subfolders</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:168
#, no-c-format
msgid ""
"Checks whether new mail arrived in the currently selected folder and all of "
"its subfolders. This is only available for &imap; folders. You can also "
"select multiple folders and the menu item will turn into "
"<menuchoice><guimenu>File</guimenu><guimenuitem>Update These Folders and All "
"Their Subfolders</guimenuitem></menuchoice>"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:172
#, no-c-format
msgid "<guimenu>File</guimenu><guimenuitem>Send Queued Messages</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:174
#, no-c-format
msgid ""
"<action>Sends the messages that are in your outbox.</action> Messages can "
"end up in your outbox by selecting Queue in the composer menu, Composing a "
"message in offline mode, and sending while you have no Internet connection."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:178
#, no-c-format
msgid ""
"<guimenu>File</guimenu><guimenuitem>Send Queued Messages via</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:180
#, no-c-format
msgid ""
"<action>Sends the messages that are in your outbox via a specific outgoing "
"account.</action> This allows you to choose which server to send your queued "
"messages from. They must be configured in <menuchoice><guimenu>Settings</"
"guimenu> <guimenuitem>Configure &kmail;...</guimenuitem></menuchoice> in the "
"<menuchoice><guiicon>Accounts</guiicon><guilabel>Sending</guilabel></"
"menuchoice> tab to show up here."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:192
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo></"
"shortcut> <guimenu>File</guimenu><guimenuitem>Quit</guimenuitem>"
msgstr ""

#. Tag: action
#: menus.docbook:195
#, no-c-format
msgid "Exits &kmail;"
msgstr ""

#. Tag: title
#: menus.docbook:204
#, no-c-format
msgid "Edit Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:207
#, no-c-format
msgid ""
"<shortcut><keycap>Del</keycap></shortcut><guimenu>Edit</"
"guimenu><guimenuitem>Move to Trash</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:209
#, no-c-format
msgid ""
"Moves the selected messages to the trash folder. If the selected messages "
"are already in the trash folder, they will be permanently deleted."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:213
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Del</keycap></keycombo></"
"shortcut><guimenu>Edit</guimenu><guimenuitem>Move Thread to Trash</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:215
#, no-c-format
msgid ""
"Moves the selected thread to the trash folder, &eg; a conversation in a "
"mailing list."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:218
#, no-c-format
msgid ""
"<shortcut><keycap>S</keycap></shortcut><guimenu>Edit</"
"guimenu><guimenuitem>Find Messages...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:220
#, no-c-format
msgid ""
"Opens up a search window that lets you search for messages with certain "
"characteristics, &eg; a certain subject. Start the search by entering some "
"values and press <guibutton>Search</guibutton>."
msgstr ""

#. Tag: para
#: menus.docbook:223
#, no-c-format
msgid ""
"Your search results will display in the text area, at which point you can "
"open the <guibutton>Open Search Folder</guibutton> or highlight the desired "
"message and select <guibutton>Open Message</guibutton>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:227
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>F</keycap></keycombo></"
"shortcut><guimenu>Edit</guimenu><guimenuitem>Find in Message...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:229
#, no-c-format
msgid "Lets you search for a string in the currently displayed message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:232
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>A</keycap></keycombo></"
"shortcut><guimenu>Edit</guimenu><guimenuitem>Select All Messages</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:234
#, no-c-format
msgid "Selects all messages in the current folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:238
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>T</keycap></keycombo></"
"shortcut><guimenu>Edit</guimenu><guimenuitem>Select All Text</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:240
#, no-c-format
msgid "Selects the text of the currently displayed message."
msgstr ""

#. Tag: title
#: menus.docbook:248
#, no-c-format
msgid "View Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:251
#, no-c-format
msgid "<guimenu>View</guimenu><guisubmenu>Message List</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:253
#, no-c-format
msgid ""
"This menu has the following options to change the view of your message list."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:255
#, no-c-format
msgid "<guimenu>Message List</guimenu><guisubmenu>Sorting</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:257
#, no-c-format
msgid "Contains options to customize your sort order as follows:"
msgstr ""

#. Tag: para
#: menus.docbook:260
#, no-c-format
msgid ""
"<guilabel>Message Sort Order</guilabel> has several options, most are self "
"explanatory. The following options may not be immediately obvious, therefore "
"deserve an explanation."
msgstr ""

#. Tag: para
#: menus.docbook:264
#, no-c-format
msgid ""
"<guilabel>Smart Sender/Receiver</guilabel> will display the sender when you "
"are reading in your outbox folder/template folder, and display the receiver "
"when you are in your inbox/inbox subfolders."
msgstr ""

#. Tag: para
#: menus.docbook:268
#, no-c-format
msgid ""
"<guilabel>By Action Item Status</guilabel> and <guilabel>By Important "
"Status</guilabel> need to be set before they can be sorted. Please see <link "
"linkend=\"mark-messages\">Mark Messages</link> for more information on "
"marking your messages."
msgstr ""

#. Tag: para
#: menus.docbook:274
#, no-c-format
msgid ""
"<guilabel>Message Sort Direction</guilabel> and <guilabel>Group Sort "
"Direction</guilabel> allow you to change the direction of your message/group "
"sort respectively."
msgstr ""

#. Tag: para
#: menus.docbook:278
#, no-c-format
msgid ""
"<guilabel>Folder always Uses this Sort Order</guilabel> allows you to keep "
"your sort settings per folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:283
#, no-c-format
msgid "<guimenu>Message List</guimenu><guisubmenu>Aggregation</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:285
#, no-c-format
msgid "Allows you to set your aggregation view."
msgstr ""

#. Tag: para
#: menus.docbook:286
#, no-c-format
msgid ""
"<guilabel>Configure...</guilabel> Allows you to configure aggregation, "
"please see <link linkend=\"configure-appearance-message-list\">Configure "
"Appearance Message List</link> for more information on aggregation."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:289
#, no-c-format
msgid "<guimenu>Message List</guimenu><guisubmenu>Theme</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:291
#, no-c-format
msgid "Allows you to select a theme."
msgstr ""

#. Tag: para
#: menus.docbook:292
#, no-c-format
msgid ""
"<guilabel>Configure...</guilabel> Allows you to configure themes, please see "
"<link linkend=\"configure-appearance-message-list\">Configure Appearance "
"Message List</link> for more information on themes."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:295
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>T</keycap></"
"keycombo></shortcut><guimenu>Message List</guimenu><guisubmenu>Create New "
"Tab</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:297
#, no-c-format
msgid ""
"Allows you to create a tab, then select the folder you would like to display "
"in the tab."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:300
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>W</keycap></"
"keycombo></shortcut><guimenu>Message List</guimenu><guisubmenu>Close Tab</"
"guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:301
#, no-c-format
msgid "Closes the currently selected tab."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:306
#, no-c-format
msgid "<guimenu>View</guimenu><guisubmenu>Headers</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:308
#, no-c-format
msgid ""
"This allows you to select your headers view. Your choices are as follows:"
msgstr ""

#. Tag: para
#: menus.docbook:310
#, no-c-format
msgid ""
"<guilabel>Enterprise Headers</guilabel> A minimal header with title, From, "
"and To, with a graphical design."
msgstr ""

#. Tag: para
#: menus.docbook:313
#, no-c-format
msgid ""
"<guilabel>Fancy Headers</guilabel> Minimal header with a spam status "
"notification."
msgstr ""

#. Tag: para
#: menus.docbook:316
#, no-c-format
msgid ""
"<guilabel>Brief Headers</guilabel> Title, and in parentheses you will find "
"From and the date."
msgstr ""

#. Tag: para
#: menus.docbook:319
#, no-c-format
msgid "<guilabel>Standard Headers</guilabel> Title, From, and To."
msgstr ""

#. Tag: para
#: menus.docbook:322
#, no-c-format
msgid "<guilabel>Long Headers</guilabel> Title, Date, From, and To."
msgstr ""

#. Tag: para
#: menus.docbook:325
#, no-c-format
msgid ""
"<guilabel>All Headers</guilabel> List everything you ever wanted to know "
"about the email, including every server it went through, virus/spam scanners "
"it went through &etc;"
msgstr ""

#. Tag: para
#: menus.docbook:328
#, no-c-format
msgid ""
"<guilabel>Custom Headers</guilabel> You must configure custom headers first "
"here: <menuchoice><guimenu>Settings</guimenu><guisubmenu>Configure &kmail;..."
"</guisubmenu></menuchoice> and select the <guiicon>Appearance</guiicon> "
"icon. From there you want the <guilabel>Message Window</guilabel> tab, and "
"you will find the settings at the bottom with the label <guilabel>Headers:</"
"guilabel>. See <link linkend=\"configure-appearance-message-window\">Message "
"Window configuration</link> for more information."
msgstr ""

#. Tag: para
#: menus.docbook:333
#, no-c-format
msgid ""
"<guilabel>Example</guilabel> An example header from the <guilabel>Download "
"New Themes</guilabel>"
msgstr ""

#. Tag: para
#: menus.docbook:336
#, no-c-format
msgid ""
"<guilabel>Example Fancy</guilabel> An example fancy header from the "
"<guilabel>Download New Themes</guilabel>"
msgstr ""

#. Tag: para
#: menus.docbook:339
#, no-c-format
msgid ""
"<guilabel>Download New Themes</guilabel> Allows you to download custom "
"themes created by other &kmail; users."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:345
#, no-c-format
msgid "<guimenu>View</guimenu><guimenuitem>Attachments</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:347
#, no-c-format
msgid ""
"Changes the way attachments appear in the <guilabel>Message Preview Pane</"
"guilabel> (independent of the &MIME; Tree) as follows:"
msgstr ""

#. Tag: para
#: menus.docbook:350
#, no-c-format
msgid ""
"<guimenuitem>As Icons</guimenuitem>, all attachments appear as icons at the "
"bottom of the message."
msgstr ""

#. Tag: para
#: menus.docbook:351
#, no-c-format
msgid ""
"<guimenuitem>Smart</guimenuitem> will show attachments as icons, unless the "
"message suggests that they should be displayed inline. You can suggest that "
"certain attachments should be shown inline in your own messages when you "
"select <guilabel>Suggest automatic display</guilabel> in the attachment's "
"properties dialog."
msgstr ""

#. Tag: para
#: menus.docbook:355
#, no-c-format
msgid ""
"<guimenuitem>Inline</guimenuitem> shows the contents of the attachments at "
"the bottom of the message. Attachments that cannot be displayed, &eg; "
"compressed files, will still be shown as an icon."
msgstr ""

#. Tag: para
#: menus.docbook:358
#, no-c-format
msgid "<guimenuitem>Hide</guimenuitem> will not show attachments."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:362
#, no-c-format
msgid ""
"<shortcut><keycap>.</keycap></shortcut><guimenu>View</guimenu> "
"<guimenuitem>Expand Thread / Group</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:365
#, no-c-format
msgid ""
"This will display the thread of the current message, &ie; all messages that "
"are replies to the current message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:369
#, no-c-format
msgid ""
"<shortcut><keycap>,</keycap></shortcut><guimenu>View</"
"guimenu><guimenuitem>Collapse Thread / Group</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:370
#, no-c-format
msgid ""
"This will hide the thread of the current message, &ie; it will hide all "
"messages that are replies to the current message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:373
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>.</keycap></keycombo></"
"shortcut><guimenu>View</guimenu> <guimenuitem>Expand All Threads</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:376
#, no-c-format
msgid "Expands all threads in the current folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:379
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>,</keycap></keycombo></"
"shortcut> <guimenu>View</guimenu><guimenuitem>Collapse All Threads</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:382
#, no-c-format
msgid "Collapses all threads in the current folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:385
#, no-c-format
msgid ""
"<shortcut><keycap>V</keycap></shortcut><guimenu>View</guimenu> "
"<guimenuitem>View Source</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:388
#, no-c-format
msgid ""
"Shows the message and its complete headers in plain text format in a new "
"window. This can be useful to find out the origin of a mail. You should know "
"that it is easy to fake the <literal>From:</literal> header of a mail, but "
"one can still find out which mail servers have been used to send the message "
"by looking at the <literal>Received:</literal> lines in the header."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:395
#, no-c-format
msgid ""
"<guimenu>View</guimenu> <guimenuitem>Show Message Structure</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:398
#, no-c-format
msgid ""
"Display the structure viewer, which is a part of the main window that lets "
"you access all parts of a message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:402
#, no-c-format
msgid ""
"<shortcut><keycap>X</keycap></shortcut><guimenu>View</guimenu> "
"<guimenuitem>Use Fixed Font</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:405
#, no-c-format
msgid ""
"Uses a fixed width (Monospace) font to display the messages in the current "
"folder. The font to be used can be configured in the <guilabel>Appearance</"
"guilabel>/<guilabel>Fonts</guilabel> in the <menuchoice> <guimenu>Settings</"
"guimenu><guimenuitem>Configure &kmail;...</guimenuitem></menuchoice> dialog."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:411
#, no-c-format
msgid "<guimenu>View</guimenu><guisubmenu>Set Encoding</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:413
#, no-c-format
msgid ""
"Lets you choose the character encoding to be used in the Message Pane. The "
"default, <guilabel>Auto</guilabel>, should work in almost all cases."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:417
#, no-c-format
msgid "<guimenu>View</guimenu><guisubmenu>Zoom</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:419
#, no-c-format
msgid "Allows to zoom message in the Message Pane."
msgstr ""

#. Tag: title
#: menus.docbook:428
#, no-c-format
msgid "Go Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:431
#, no-c-format
msgid ""
"<shortcut><keycap>J</keycap></shortcut><guimenu>Go</guimenu> "
"<guimenuitem>Jump to Folder...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:434
#, no-c-format
msgid ""
"Selecting this menu item with show a dialog box with a list of all your "
"folders. Click on the folder you wish to view and it will display it in the "
"message view pane."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:438
#, no-c-format
msgid ""
"<shortcut><keycap>N</keycap></shortcut><guimenu>Go</guimenu> "
"<guimenuitem>Next Message</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:441
#, no-c-format
msgid ""
"Selects the next message in the message list. The keyboard shortcut "
"<keycap>Right Arrow</keycap> also performs this action."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:445
#, no-c-format
msgid ""
"<shortcut><keycap>+</keycap></shortcut> <guimenu>Go</"
"guimenu><guimenuitem>Next Unread Message</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:448
#, no-c-format
msgid ""
"Selects the next unread message in the message list. If there are not any "
"unread messages below the currently selected message, then the behavior "
"depends on the value of the <xref linkend=\"configure-misc-folders-go-unread"
"\"/> option."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:452
#, no-c-format
msgid ""
"<shortcut><keycap>P</keycap></shortcut> <guimenu>Go</"
"guimenu><guimenuitem>Previous Message</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:455
#, no-c-format
msgid "Selects the previous message in the message list."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:458
#, no-c-format
msgid ""
"<shortcut><keycap>-</keycap></shortcut> <guimenu>Go</"
"guimenu><guimenuitem>Previous Unread Message</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:461
#, no-c-format
msgid ""
"Selects the previous unread message in the message list. If there is not an "
"unread message above the currently selected message, then the behavior "
"depends on the value of the <xref linkend=\"configure-misc-folders-go-unread"
"\"/> option."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:466
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Alt;<keycap>+</keycap></keycombo></"
"shortcut> <guimenu>Go</guimenu><guimenuitem>Next Unread Folder</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:469
#, no-c-format
msgid "Jumps to the next folder with unread messages."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:472
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Alt;<keycap>-</keycap></keycombo></"
"shortcut> <guimenu>Go</guimenu><guimenuitem>Previous Unread Folder</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:475
#, no-c-format
msgid "Jumps to the previous folder with unread messages."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:478
#, no-c-format
msgid ""
"<shortcut><keycap>Space</keycap></shortcut> <guimenu>Go</"
"guimenu><guimenuitem>Next Unread Text</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:481
#, no-c-format
msgid ""
"Scrolls down if you are not yet at the bottom of a message, otherwise jumps "
"to the next unread message."
msgstr ""

#. Tag: title
#: menus.docbook:491
#, no-c-format
msgid "<guimenu>Folder</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:497
#, no-c-format
msgid "<guimenu>Folder</guimenu> <guimenuitem>Add Folder...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:503
#, no-c-format
msgid ""
"Opens the <link linkend=\"folders-properties-window\">Folder Properties</"
"link> dialog that lets you create a new folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:510
#, no-c-format
msgid ""
"<guimenu>Folder</guimenu> <guimenuitem>Mark All Messages as Read</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:516
#, no-c-format
msgid ""
"Sets the status of all new and unread messages in the current folder to read."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:522
#, no-c-format
msgid ""
"<shortcut><keycap>F5</keycap></shortcut> <guimenu>Folder</guimenu> "
"<guimenuitem>Update Folders</guimenuitem>"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:538
#, no-c-format
msgid ""
"<guimenu>Folder</guimenu> <guimenuitem>Move All Messages to Trash</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:544
#, no-c-format
msgid ""
"Moves all of the messages in the selected folder into the trash folder. This "
"is only available if the currently selected folder is not a trash folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:586
#, no-c-format
msgid "<guimenu>Folder</guimenu> <guimenuitem>Delete Folder</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:592
#, no-c-format
msgid "Removes the selected folder and all its contents, including subfolders."
msgstr ""

#. Tag: para
#: menus.docbook:593
#, no-c-format
msgid ""
"Note that there is no way to access the contents of a folder after it has "
"been removed."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:600
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>*</keycap></keycombo></"
"shortcut> <guimenu>Folder</guimenu> <guimenuitem>Remove Duplicate Messages</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:607
#, no-c-format
msgid "Searches the folder for duplicate messages and deletes the duplicates."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:627
#, no-c-format
msgid ""
"<guimenu>Folder</guimenu> <guimenuitem>Prefer HTML to Plain Text</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:633
#, no-c-format
msgid ""
"If enabled then &html; messages in this folder will be shown using &html; "
"rendering. For security reasons, we recommend to only activate this for "
"folders which only contain trusted messages."
msgstr ""

#. Tag: title
#: menus.docbook:695 menus.docbook:1237
#, no-c-format
msgid "<guimenu>Message</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:701
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo></"
"shortcut> <guimenu>Message</guimenu> <guimenuitem>New Message...</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:708
#, no-c-format
msgid ""
"Opens the <link linkend=\"the-composer-window\">composer window</link> so "
"you can write a new message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:715
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>N</keycap></"
"keycombo></shortcut> <guimenu>Message</guimenu> <guimenuitem>New Message to "
"Mailing-List...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:722
#, no-c-format
msgid ""
"Opens the composer window so you can write a new mail. If the current folder "
"holds a mailing list and has a posting address defined, this address will be "
"the default <guilabel>To:</guilabel> address."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:731
#, no-c-format
msgid ""
"<shortcut><keycap>R</keycap></shortcut> <guimenu>Message</guimenu> "
"<guimenuitem>Reply...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:738
#, no-c-format
msgid ""
"Opens up the composer window, inserts the quoted text of the currently "
"selected message and presets the <guilabel>To:</guilabel> field either with "
"the mailing-list address (if you reply to a mailing-list message) or with "
"the preferred reply address of the sender. If you want to control which "
"address the <guilabel>To:</guilabel> field is preset with then you should "
"either use <menuchoice><guimenu>Message</guimenu><guimenuitem>Reply to "
"Author...</guimenuitem></menuchoice> or <menuchoice><guimenu>Message</"
"guimenu><guimenuitem>Reply to Mailing-List...</guimenuitem></menuchoice>. "
"Your identity will automatically be set to the one which this message was "
"sent to."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:754
#, no-c-format
msgid ""
"<shortcut><keycap>A</keycap></shortcut> <guimenu>Message</guimenu> "
"<guimenuitem>Reply to All...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:761
#, no-c-format
msgid ""
"Opens up the composer window, inserts the quoted text of the currently "
"selected message and presets the <guilabel>To:</guilabel> field either with "
"the mailing-list address (if you reply to a mailing-list message) or with "
"the preferred reply address of the sender. The <guilabel>Copy to (CC):</"
"guilabel> field is preset with the addresses of all other recipients of the "
"currently selected message excluding your own addresses. Your identity will "
"automatically be set to the one which this message was sent to."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:774
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Shift;<keycap>A</keycap></keycombo></"
"shortcut> <guimenu>Message</guimenu> <guisubmenu>Reply Special</guisubmenu> "
"<guimenuitem>Reply to Author...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:782
#, no-c-format
msgid ""
"Opens up the composer window, inserts the quoted text of the currently "
"selected message and presets the <guilabel>To:</guilabel> field with the "
"preferred reply address of the sender. Your identity will automatically be "
"set to the one which this message was sent to."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:792
#, no-c-format
msgid ""
"<shortcut><keycap>L</keycap></shortcut> <guimenu>Message</guimenu> "
"<guisubmenu>Reply Special</guisubmenu> <guimenuitem>Reply to Mailing-List..."
"</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:800
#, no-c-format
msgid ""
"Opens up the composer window, inserts the quoted text of the currently "
"selected message and presets the <guilabel>To:</guilabel> field with the "
"mailing-list address. If you did not specify a mailing-list address for the "
"currently selected folder and &kmail; cannot determine the posting address "
"from the currently selected message then the <guilabel>To:</guilabel> field "
"will be empty. Your identity will automatically be set to the one which this "
"message was sent to."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:813
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Shift;<keycap>R</keycap></keycombo></"
"shortcut> <guimenu>Message</guimenu> <guisubmenu>Reply Special</guisubmenu> "
"<guimenuitem>Reply Without Quote...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:821
#, no-c-format
msgid ""
"Works just like <guimenuitem>Reply...</guimenuitem> except that the text of "
"the currently selected message is not quoted."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:830
#, no-c-format
msgid "<guimenu>Message</guimenu> <guimenuitem>Forward</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:836
#, no-c-format
msgid ""
"Forwards the message to a new recipient. Using <guimenuitem>Inline</"
"guimenuitem>, the message's text and some important header fields will be "
"copied to the body of the new message with a text marking the forwarded "
"part. Attachments will be forwarded as attachments of the new message. Using "
"<guimenuitem>As Attachment</guimenuitem> the message and its attachments "
"will become an attachment of the new message. The original message headers "
"will be included in the forwarded message, too. <guimenuitem>Redirect</"
"guimenuitem> works like forward, except that the message stays the same "
"(even the <guilabel>From:</guilabel> field). The user who redirected the "
"message is added in special header fields (<literal>Redirect-From</literal>, "
"<literal>Redirect-Date</literal>, <literal>Redirect-To</literal>, &etc;)."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:851
#, no-c-format
msgid "<guimenu>Message</guimenu> <guimenuitem>Send Again...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:857
#, no-c-format
msgid ""
"Opens a composer window with the currently selected message so it can be "
"sent again. This is only available for messages which you have sent or, more "
"precisely, for messages which have the <guilabel>sent</guilabel> status."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:865
#, no-c-format
msgid ""
"<shortcut><keycap>T</keycap></shortcut> <guimenu>Message</guimenu> "
"<guimenuitem>Edit Message</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:872
#, no-c-format
msgid ""
"Edits the selected message if it is editable. Only messages in the "
"<guilabel>outbox</guilabel> and <guilabel>drafts</guilabel> folder can be "
"edited."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:879
#, no-c-format
msgid "<guimenu>Message</guimenu> <guisubmenu>Copy Message To</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:885
#, no-c-format
msgid "Copies the selected messages to a certain folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:891
#, no-c-format
msgid "<guimenu>Message</guimenu> <guisubmenu>Move Message To</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:897
#, no-c-format
msgid "Moves the selected messages to a certain folder."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:903
#, no-c-format
msgid "<guimenu>Message</guimenu> <guisubmenu>Mark Message</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:909
#, no-c-format
msgid ""
"Allows you to change the status of the selected message to one of the "
"following states:"
msgstr ""

#. Tag: entry
#: menus.docbook:927
#, no-c-format
msgid "Status"
msgstr "Estatut"

#. Tag: entry
#: menus.docbook:928
#, no-c-format
msgid "Symbol"
msgstr "Simbòl"

#. Tag: entry
#: menus.docbook:929
#, no-c-format
msgid "Meaning"
msgstr "Significacion"

#. Tag: guimenuitem
#: menus.docbook:934
#, no-c-format
msgid "Read"
msgstr "Lectura"

#. Tag: entry
#: menus.docbook:935
#, no-c-format
msgid "Sheet of paper before an envelope"
msgstr ""

#. Tag: entry
#: menus.docbook:936
#, no-c-format
msgid "The message has been read."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:939
#, no-c-format
msgid "<guimenuitem>New</guimenuitem>"
msgstr ""

#. Tag: entry
#: menus.docbook:940
#, no-c-format
msgid "Closed envelope with a star"
msgstr ""

#. Tag: entry
#: menus.docbook:941
#, no-c-format
msgid "The message is new to &kmail; and you."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:944
#, no-c-format
msgid "Unread"
msgstr "Pas legit"

#. Tag: entry
#: menus.docbook:945
#, no-c-format
msgid "Close envelope"
msgstr ""

#. Tag: entry
#: menus.docbook:946
#, no-c-format
msgid "The message is not new to &kmail; but has not been read yet."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:949
#, no-c-format
msgid "Important"
msgstr "Important"

#. Tag: entry
#: menus.docbook:950
#, no-c-format
msgid "Flag"
msgstr ""

#. Tag: entry
#: menus.docbook:951
#, no-c-format
msgid ""
"This status will not automatically be set by &kmail;. You can use it freely "
"to mark messages that are in some way important to you."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:955
#, no-c-format
msgid "Replied"
msgstr ""

#. Tag: entry
#: menus.docbook:956
#, no-c-format
msgid "Blue u-turn arrow"
msgstr ""

#. Tag: entry
#: menus.docbook:957
#, no-c-format
msgid "A reply to this message has been sent."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:960
#, no-c-format
msgid "Forwarded"
msgstr "Trasmes"

#. Tag: entry
#: menus.docbook:961
#, no-c-format
msgid "Blue arrow"
msgstr ""

#. Tag: entry
#: menus.docbook:962
#, no-c-format
msgid "The message has been forwarded to someone else."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:965
#, no-c-format
msgid "Queued"
msgstr ""

#. Tag: entry
#: menus.docbook:966
#, no-c-format
msgid "Envelope"
msgstr "Envolopa"

#. Tag: entry
#: menus.docbook:967
#, no-c-format
msgid "The message has been queued in the outbox to be sent later."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:970
#, no-c-format
msgid "Sent"
msgstr "Enviat"

#. Tag: entry
#: menus.docbook:971
#, no-c-format
msgid "Angled envelope"
msgstr ""

#. Tag: entry
#: menus.docbook:972
#, no-c-format
msgid "The message has been sent."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:975
#, no-c-format
msgid "Spam"
msgstr ""

#. Tag: entry
#: menus.docbook:976
#, no-c-format
msgid "Round recycle symbol"
msgstr ""

#. Tag: entry
#: menus.docbook:977
#, no-c-format
msgid ""
"This status will not be set automatically by &kmail;. You can use it to mark "
"spam messages."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:981
#, no-c-format
msgid "<guimenuitem>Ham</guimenuitem>"
msgstr ""

#. Tag: entry
#: menus.docbook:982
#, no-c-format
msgid "Green check mark"
msgstr ""

#. Tag: entry
#: menus.docbook:983
#, no-c-format
msgid ""
"This status will not be set automatically by &kmail;. You can use it to mark "
"messages which are not spam."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:995
#, no-c-format
msgid "<guimenu>Message</guimenu> <guisubmenu>Mark Thread</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1001
#, no-c-format
msgid ""
"Allows you to change the status of all messages in a thread. The possible "
"states are the same as for <menuchoice><guimenu>Message</guimenu> "
"<guimenuitem>Mark Message</guimenuitem></menuchoice>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1035
#, no-c-format
msgid "<guimenu>Message</guimenu> <guisubmenu>Create Filter</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1041
#, no-c-format
msgid ""
"Opens up the <link linkend=\"filter-dialog-id\">Filter dialog</link> with a "
"new filter added. This new filter is based on fields of the current mail, "
"depending on which sub menu item you select."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1049
#, no-c-format
msgid "<guimenu>Message</guimenu> <guimenuitem>Apply Filter</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1055
#, no-c-format
msgid ""
"Allows you to apply an individual filter or all filters to the selected "
"messages. Only filters for which you enabled the <guilabel>Add this filter "
"to the Apply Filter menu</guilabel> option will be available."
msgstr ""

#. Tag: title
#: menus.docbook:1071 menus.docbook:1889
#, no-c-format
msgid "<guimenu>Tools</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1077
#, no-c-format
msgid ""
"<shortcut><keycap>S</keycap></shortcut> <guimenu>Tools</guimenu> "
"<guimenuitem>Find Messages...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1084
#, no-c-format
msgid ""
"Opens up a search window that lets you search for messages with certain "
"characteristics, &eg; a certain subject. Start the search by entering some "
"values and press <guibutton>Search</guibutton>. Click on one of the "
"resulting messages and it will appear in the <guilabel>Message pane</"
"guilabel>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1094
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Address Book</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1100
#, no-c-format
msgid ""
"Starts up &kaddressbook;, the &kde; address book. If this menu item is "
"disabled and greyed out either &kaddressbook; is not installed or the "
"program was not found."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1108
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Certificate Manager...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1114
#, no-c-format
msgid ""
"Starts <ulink url=\"help:kleopatra\">&kleopatra;</ulink>, the &kde; "
"certificate manager."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1124
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>GnuPG Log Viewer</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1130
#, no-c-format
msgid ""
"Starts <ulink url=\"help:kwatchgnupg\"><application>KWatchGnuPG</"
"application></ulink>, a tool to present the debug output of "
"<application>GnuPG</application> application. If signing, encryption, or "
"verification mysteriously stop working, you might find out why by looking at "
"the log."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1143
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guisubmenu>Edit \"Out of Office\" Replies...</"
"guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1149
#, no-c-format
msgid ""
"Launch the <guilabel>Configure \"Out of Office\" Replies</guilabel> dialog, "
"which allow you to set-up vacation notifications."
msgstr ""

#. Tag: para
#: menus.docbook:1151
#, no-c-format
msgid ""
"<guilabel>Out of Office reply</guilabel> functionality relies on server-side "
"filtering. To be able to use it you need to configure the <link linkend="
"\"receiving-mail\">Filtering tab</link> (see option relevant to kolab "
"server) of your <guilabel>IMAP</guilabel> account set-up."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1159
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guisubmenu>Filter Log Viewer...</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1165
#, no-c-format
msgid ""
"Opens up the viewer window for the filter log; there you find some options "
"to control the logging of the filtering process. In the log you will find "
"valuable information about what filter rules were used, what was the result "
"of the evaluation of those rules, and which filter actions were applied to a "
"message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1174
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Anti-Spam Wizard...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1180
#, no-c-format
msgid ""
"It starts a <link linkend=\"the-anti-spam-wizard\">wizard</link> which can "
"help you to set up spam filtering."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1187
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Anti-Virus Wizard...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1193
#, no-c-format
msgid ""
"It starts a <link linkend=\"the-anti-virus-wizard\">wizard</link> which can "
"help you to set up scanning messages for viruses."
msgstr ""

#. Tag: title
#: menus.docbook:1204 menus.docbook:1926
#, no-c-format
msgid "<guimenu>Settings</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1207
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>H</keycap></keycombo></"
"shortcut> <guimenu>Settings</guimenu><guimenuitem>Show Quick Search bar</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1210
#, no-c-format
msgid ""
"If enabled, the Quick Search bar which allows you to quickly search for "
"messages matching a search text, is visible."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1214
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu><guimenuitem>Configure Filters...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1216
#, no-c-format
msgid "Opens the <link linkend=\"filters\">Message Filters</link> window."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1219
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu><guimenuitem>Manage Sieve Scripts...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1221
#, no-c-format
msgid ""
"If your mail server supports sieve (server side filtering), you would "
"configure your scripts here."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1224
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu><guimenuitem>Configure Notifications...</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1226
#, no-c-format
msgid ""
"Opens a window that lets you configure what happens when new mail arrives, "
"&eg; play a sound, display a popup."
msgstr ""

#. Tag: title
#: menus.docbook:1234
#, no-c-format
msgid "The Composer Window"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1243
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo></"
"shortcut> <guimenu>Message</guimenu> <guimenuitem>New Composer</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1250
#, no-c-format
msgid "Opens up a new composer window."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1256
#, no-c-format
msgid "<guimenu>Message</guimenu> <guimenuitem>New Main Window</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1262
#, no-c-format
msgid "Creates a new main window."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1268
#, no-c-format
msgid ""
"<guimenu>Message</guimenu> <guimenuitem>New AddressBook Contact</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1274
#, no-c-format
msgid "Creates a new address book contact."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1280
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Return</keycap></"
"keycombo></shortcut> <guimenu>Message</guimenu> <guimenuitem>Send Mail</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1287
#, no-c-format
msgid ""
"Sends the message immediately. If you use SMTP to send your messages and the "
"&SMTP; server is not reachable, the message will be put into the outbox and "
"you will get an error message. You can then later send the messages in the "
"outbox using <menuchoice><guimenu>File</guimenu><guimenuitem>Send Queued "
"Messages</guimenuitem></menuchoice>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1297
#, no-c-format
msgid "<guimenu>Message</guimenu> <guimenuitem>Send Later</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1303
#, no-c-format
msgid ""
"Queues the message in the outbox for sending it later using "
"<menuchoice><guimenu>File</guimenu><guimenuitem>Send Queued Messages</"
"guimenuitem></menuchoice>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1312
#, no-c-format
msgid "<guimenu>Message</guimenu> <guimenuitem>Save as Draft</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1318
#, no-c-format
msgid ""
"Save the message in the <guilabel>drafts</guilabel> folder so you can later "
"edit and send it."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1325
#, no-c-format
msgid ""
"<guimenu>Messages</guimenu> <guimenuitem>Insert Text File...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1331
#, no-c-format
msgid ""
"Inserts a text file into the message text, starting at the cursor position."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1338
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo></"
"shortcut> <guimenu>Message</guimenu> <guimenuitem>Print...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1345
#, no-c-format
msgid "Prints the current text."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1351
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>W</keycap></keycombo></"
"shortcut> <guimenu>Message</guimenu> <guimenuitem>Close</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1358
#, no-c-format
msgid "Closes this composer window."
msgstr ""

#. Tag: title
#: menus.docbook:1368
#, no-c-format
msgid "<guimenu>Edit</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1374
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Paste as Quotation</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1380
#, no-c-format
msgid "Pastes the text from the clipboard marked as quotation."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1386
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Undo</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1393
#, no-c-format
msgid "Undo your steps in editing the current message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1399
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;&Shift;<keycap>Z</keycap></"
"keycombo></shortcut> <guimenu>Edit</guimenu> <guimenuitem>Redo</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1406
#, no-c-format
msgid "Redo your steps in editing the current message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1412
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>X</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Cut</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1419
#, no-c-format
msgid ""
"Cutting text works as with most editors: the selected text is removed and "
"put into the clipboard. Note that you can also select text and drag it to a "
"new position."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1427
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Copy</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1435
#, no-c-format
msgid ""
"Copying text works as with most editors: the selected text is copied to the "
"clipboard. Note that you can also select text while holding the &Ctrl; key, "
"and drag it to a new position to copy it."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1443
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>V</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Paste</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1450
#, no-c-format
msgid ""
"Pasting works the same as with most editors: the text from the clipboard is "
"pasted at the current cursor position."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1457
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>A</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Select All</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1464
#, no-c-format
msgid "Selects all of the text in your message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1470
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>F</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1477
#, no-c-format
msgid "Opens a dialog to search for strings in the current message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1483
#, no-c-format
msgid ""
"<shortcut><keycap>F3</keycap></shortcut> <guimenu>Edit</guimenu> "
"<guimenuitem>Find Next</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1490
#, no-c-format
msgid "Goes to the next occurrence of the previously searched string."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1496
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>R</keycap></keycombo></"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Replace...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1503
#, no-c-format
msgid ""
"Opens a dialog that lets you replace strings in your message with other "
"strings."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1509
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Clean Spaces</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1515
#, no-c-format
msgid ""
"This replaces multiple line breaks or spaces with single line breaks or "
"spaces. It works on the current selection or on the complete message if "
"there is no selection."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1522
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Add Quote Characters</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1528
#, no-c-format
msgid "Prepends the selected text with quotation marks."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1534
#, no-c-format
msgid ""
"<guimenu>Edit</guimenu> <guimenuitem>Remove Quote Characters</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1540
#, no-c-format
msgid "Removes the left-most quotation marks from the selected text."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1546
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Uppercase</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1552
#, no-c-format
msgid "Uppercase selected text."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1558
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Lowercase</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1564
#, no-c-format
msgid "Lowercase selected text."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1570
#, no-c-format
msgid ""
"<guimenu>Edit</guimenu> <guimenuitem>Insert Special Characters</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1576
#, no-c-format
msgid "It allows to insert special character in composer."
msgstr ""

#. Tag: title
#: menus.docbook:1587
#, no-c-format
msgid "<guimenu>View</guimenu> Menu"
msgstr ""

#. Tag: para
#: menus.docbook:1589
#, no-c-format
msgid ""
"This menu lets you toggle the display of the header fields and other options "
"in this composer window."
msgstr ""

#. Tag: para
#: menus.docbook:1592
#, no-c-format
msgid "Options available are:"
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1596
#, no-c-format
msgid "All Fields"
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1599
#, no-c-format
msgid "Identity"
msgstr "Identitat"

#. Tag: guimenuitem
#: menus.docbook:1602
#, no-c-format
msgid "Dictionary"
msgstr "Diccionari"

#. Tag: guimenuitem
#: menus.docbook:1605
#, no-c-format
msgid "Sent-Mail folder"
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1608
#, no-c-format
msgid "Mail Transport"
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1611
#, no-c-format
msgid "From"
msgstr "De"

#. Tag: guimenuitem
#: menus.docbook:1614
#, no-c-format
msgid "Reply To"
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1617
#, no-c-format
msgid "Subject"
msgstr "Subjècte"

#. Tag: para
#: menus.docbook:1621
#, no-c-format
msgid ""
"Currently visible items have a checkmark shown next to their name in the "
"menu."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1627
#, no-c-format
msgid "<guimenu>View</guimenu> <guimenuitem>Use Fixed Font</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1633
#, no-c-format
msgid ""
"Uses a fixed width (monospaced) font to display the currently edited "
"message. The font to be used can be configured in the <guilabel>Appearance</"
"guilabel> section of &kmail;'s configuration dialog."
msgstr ""

#. Tag: title
#: menus.docbook:1648
#, no-c-format
msgid "<guimenu>Options</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1654
#, no-c-format
msgid "<guimenu>Options</guimenu> <guimenuitem>Urgent</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1660
#, no-c-format
msgid ""
"Sets the priority of the message to Urgent. The receiver's email client has "
"to support this or it will have no effect. &kmail; itself does not support "
"priorities for incoming messages."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1668
#, no-c-format
msgid ""
"<guimenu>Options</guimenu> <guimenuitem>Request Disposition Notification</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1674
#, no-c-format
msgid ""
"If you choose this option, you request a confirmation email once your "
"message is downloaded and read by its recipient. This has to be supported "
"and enabled by the receiver's email client in order to work."
msgstr ""

#. Tag: para
#: menus.docbook:1680
#, no-c-format
msgid ""
"See <xref linkend=\"configure-security-reading-mdns\"/> for background "
"information and ways to customize the read receipts that &kmail; itself "
"sends."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1690
#, no-c-format
msgid "<guimenu>Options</guimenu> <guisubmenu>Sign Message</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1696
#, no-c-format
msgid ""
"Digitally sign the message using <application>OpenPGP</application>. You can "
"learn more about this in the <link linkend=\"pgp\">chapter on OpenPGP</link>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1703
#, no-c-format
msgid "<guimenu>Options</guimenu> <guisubmenu>Encrypt Message</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1709
#, no-c-format
msgid ""
"Encrypt the message using <application>OpenPGP</application>. You can learn "
"more about this in the <link linkend=\"pgp\">chapter on OpenPGP</link>."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1716
#, no-c-format
msgid ""
"<guimenu>Options</guimenu> <guisubmenu>Cryptographic Message Format</"
"guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1722
#, no-c-format
msgid ""
"Choose the cryptographic message format to use to digitally sign and/or "
"encrypt the message in. See <link linkend=\"cryptographic-message-formats"
"\">the previous description of each option</link> for more information."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1733
#, no-c-format
msgid "<guimenu>Options</guimenu> <guisubmenu>Formatting (HTML)</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1739
#, no-c-format
msgid "Enables &html; editing."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1745
#, no-c-format
msgid "<guimenu>Options</guimenu> <guisubmenu>Encoding</guisubmenu>"
msgstr ""

#. Tag: para
#: menus.docbook:1751
#, no-c-format
msgid ""
"Set the charset encoding of this message. The chosen encoding will appear in "
"the header of the outgoing mail. You can use <guilabel>Auto</guilabel> for "
"almost all cases, &kmail; will tell you if you need to select a different "
"encoding manually."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1759
#, no-c-format
msgid "<guimenu>Options</guimenu> <guimenuitem>Wordwrap</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1765
#, no-c-format
msgid ""
"Toggles the automatic wordwrap. It may be useful to turn it off if you want "
"to paste long lines that should not wrap."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1772
#, no-c-format
msgid ""
"<guimenu>Options</guimenu> <guimenuitem>Automatic Spellchecking</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1778
#, no-c-format
msgid "Toggles automatic spellchecking."
msgstr ""

#. Tag: title
#: menus.docbook:1788
#, no-c-format
msgid "<guimenu>Attach</guimenu> Menu"
msgstr ""

#. Tag: para
#: menus.docbook:1790
#, no-c-format
msgid "This menu lets you select attachment options."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1796
#, no-c-format
msgid "<guimenu>Attach</guimenu> <guimenuitem>Append Signature</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1802
#, no-c-format
msgid ""
"Appends your signature (<quote>footer</quote>) to the end of the message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1809
#, no-c-format
msgid ""
"<guimenu>Attach</guimenu> <guimenuitem>Attach Public Key...</guimenuitem>"
msgstr ""

#. Tag: para
#: menus.docbook:1815
#, no-c-format
msgid ""
"Attaches the corresponding <application>GnuPG</application> key to your "
"message."
msgstr ""

#. Tag: menuchoice
#: menus.docbook:1822
#, no-c-format
msgid ""
"<guimenu>Attach</guimenu> <guimenuitem>Attach My Public Key</guimenuitem>"
