#: menus.docbook:1049
#, no-c-format
msgid "Blue arrow"
msgstr ""

#. Tag: entry
#: menus.docbook:1050
#, no-c-format
msgid "The message has been forwarded to someone else."
msgstr ""

#. Tag: guimenuitem
#: menus.docbook:1053
#, no-c-format
msgid "Queued"
msgstr ""

#. Tag: entry
#: menus.docbook:1054
#, no-c-format
msgid "Envelope"
msgstr "Envolopa"

