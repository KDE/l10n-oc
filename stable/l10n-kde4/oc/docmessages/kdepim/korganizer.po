msgstr ""

#. Tag: para
#: index.docbook:2712
#, no-c-format
msgid ""
"Select if all calendars should be merged into one agenda view, each calendar "
"should be displayed in its own agenda view or if both view should be "
"available via tabs."
msgstr ""

#. Tag: para
#: index.docbook:2720
#, no-c-format
msgid "<link linkend=\"month-view\">Month view</link> options:"
