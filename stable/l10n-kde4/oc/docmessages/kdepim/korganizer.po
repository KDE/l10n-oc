#. Tag: guilabel
#: index.docbook:2597
#, no-c-format
msgid "Default reminder time"
msgstr ""

#. Tag: para
#: index.docbook:2598
#, no-c-format
msgid ""
"Select how long before the actual event's scheduled time will the alarm "
"activate."
msgstr ""

