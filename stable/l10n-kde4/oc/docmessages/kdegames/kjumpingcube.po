#, no-c-format
msgid "Introduction"
msgstr "Introduccion"

#. Tag: title
#: index.docbook:67
#, no-c-format
msgid "Gametype:"
msgstr ""

#. Tag: para
#: index.docbook:67
#, no-c-format
