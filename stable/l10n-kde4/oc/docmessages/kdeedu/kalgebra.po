#: index.docbook:289
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl; <keycap>L</keycap></keycombo></"
"shortcut> <guimenu>Console</guimenu><guimenuitem>Load Script</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:294
#, no-c-format
msgid ""
"Executes the instructions in a file sequentially. Useful if you want to "
"define some libraries or resume some previous work."
msgstr ""

#. Tag: menuchoice
#: index.docbook:299
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl; <keycap>G</keycap></keycombo></"
"shortcut> <guimenu>Console</guimenu><guimenuitem>Save Script</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:304
#, no-c-format
msgid ""
"Saves the instructions you have typed since the session began to be able to "
"reuse. Generates text files so it should be easy to fix using any text "
"editor, like Kate."
msgstr ""

#. Tag: menuchoice
#: index.docbook:309
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl; <keycap>S</keycap></keycombo></"
"shortcut> <guimenu>Console</guimenu><guimenuitem>Export Log</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:314
#, no-c-format
msgid ""
"Saves the log with all results into an &HTML; file to be able to print or "
"publish."
msgstr ""

#. Tag: title
#: index.docbook:322
#, no-c-format
msgid "2D Graphs"
msgstr ""

#. Tag: para
#: index.docbook:323
#, no-c-format
msgid ""
"To add a new 2D graph on &kalgebra;, select the <guilabel>2D Graph</"
"guilabel> tab and click the <guilabel>Add</guilabel> tab to add a new "
"function. Your focus will go to an input text box where you can type your "
"function."
msgstr ""

#. Tag: para
#: index.docbook:330
#, no-c-format
msgid ""
"If you want to use a typical f(x) function it is not necessary to specify "
"it, but if you want a f(y) or a polar function, you will have to add y-&gt; "
"and q-&gt; as the bounded variables."
msgstr ""

#. Tag: para
#: index.docbook:334 index.docbook:410
#, no-c-format
msgid "Examples:"
msgstr ""

#. Tag: para
#: index.docbook:336
#, no-c-format
msgid "sin(x)"
msgstr ""

#. Tag: para
#: index.docbook:337
#, no-c-format
msgid "<para>x²</para>"
msgstr ""

#. Tag: para
#: index.docbook:338
#, no-c-format
msgid "y->sin(y)"
msgstr ""

#. Tag: para
#: index.docbook:339
#, no-c-format
msgid "q->3*sin(7*q)"
msgstr ""

#. Tag: para
#: index.docbook:340
#, no-c-format
msgid "t->vector{sin t, t**2}"
msgstr ""

#. Tag: para
#: index.docbook:342
#, no-c-format
msgid ""
"If you have entered the function click on the <guibutton>OK</guibutton> "
"button to display the graph in the main window."
msgstr ""

