#: index.docbook:146
#, no-c-format
msgid "Overview of Kalziums usage"
msgstr ""

#. Tag: para
#: index.docbook:147
#, no-c-format
msgid "Here are some screenshots of &kalzium; in action:"
msgstr ""

#. Tag: para
#: index.docbook:149
#, no-c-format
msgid ""
"&kalzium; is very easy to use. It is specially designed for students of all "
"ages to use as a small and quick database."
msgstr ""

#. Tag: screeninfo
#: index.docbook:151
#, no-c-format
msgid "&kalzium; main screen, immediately after the first start"
msgstr ""

#. Tag: phrase
#: index.docbook:157
#, no-c-format
msgid "&kalzium; main screen"
