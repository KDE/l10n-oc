#. Tag: title
#: commands.docbook:2
#, no-c-format
msgid "Command Reference"
msgstr ""

#. Tag: title
#: commands.docbook:5
#, no-c-format
msgid "The <guimenu>File</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: commands.docbook:11
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>New</guimenuitem>"
msgstr ""

#. Tag: action
#: commands.docbook:20
#, no-c-format
msgid ""
"Starts a new Plot by clearing the coordinate system and resetting the "
"function parser."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:27
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>O</keycap></keycombo></"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Open...</guimenuitem>"
msgstr ""

#. Tag: action
#: commands.docbook:31
#, no-c-format
msgid "Opens an existing document."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:36
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Open Recent</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:40
#, no-c-format
msgid ""
"<action>Displays a list of recently opened files.</action> Selecting one "
"from this list plots the functions in the file."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:46
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo></"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Save</guimenuitem>"
msgstr ""

#. Tag: action
#: commands.docbook:51
#, no-c-format
msgid "Saves the document."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:56
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Save As...</guimenuitem>"
msgstr ""

#. Tag: action
#: commands.docbook:59
#, no-c-format
msgid "Saves the document under another name."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:65
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Print...</guimenuitem>"
msgstr ""

#. Tag: action
#: commands.docbook:74
#, no-c-format
msgid "Sends the plot to a printer or file."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:80
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Export...</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:83
#, no-c-format
msgid ""
"<action>Export values to a textfile. </action>Every value in the parameter "
"list will be written to one line in the file."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:90
#, no-c-format
msgid ""
"<shortcut><keycombo action=\"simul\"> &Ctrl;<keycap>Q</keycap> </keycombo></"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:96
#, no-c-format
msgid "<action>Exits</action> &kmplot;."
msgstr ""

#. Tag: title
#: commands.docbook:102
#, no-c-format
msgid "The <guimenu>Edit</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: commands.docbook:106
#, no-c-format
msgid "<guimenu>Edit</guimenu><guimenuitem>Undo</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:108
#, no-c-format
msgid "Undo the last command."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:112
#, no-c-format
msgid "<guimenu>Edit</guimenu><guimenuitem>Redo</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:114
#, no-c-format
msgid "Redo the last command that was undone."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:119
#, no-c-format
msgid "<guimenu>Edit</guimenu><guimenuitem>Coordinate System...</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:121
#, no-c-format
msgid ""
"Displays the <guilabel>Coordinate System</guilabel> dialog box. See <xref "
"linkend=\"coords-config\"/>."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:127
#, no-c-format
msgid "<guimenu>Edit</guimenu><guimenuitem>Constants...</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:129
#, no-c-format
msgid ""
"Displays the <guilabel>Constants</guilabel> dialog box. See <xref linkend="
"\"constants-config\"/>."
msgstr ""

#. Tag: title
#: commands.docbook:137
#, no-c-format
msgid "The <guimenu>View</guimenu> Menu"
msgstr ""

#. Tag: para
#: commands.docbook:138
#, no-c-format
msgid "The first three items in the menu are related to zooming."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:143
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>1</keycap></keycombo> </"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Zoom In</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:152
#, no-c-format
msgid ""
"This tool can be operator in two different manners. To zoom in on a point on "
"the graph, click on it. To zoom in on a specific section of the graph, hold "
"and drag the mouse to form a rectangle, which will be the new axes ranges "
"when the mouse button is released."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:158
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>2</keycap></keycombo> </"
"shortcut> <guimenu>View</guimenu> <guimenuitem>Zoom Out</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:167
#, no-c-format
msgid ""
"The tool can also be used in two different manners. To zoom out and center "
"on a point, click on that point. To fit the existing view into a rectangle, "
"hold and drag the mouse to form that rectangle."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:172
#, no-c-format
msgid ""
"<guimenu>Zoom</guimenu> <guimenuitem>Fit Widget to Trigonometric Functions</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:177
#, no-c-format
msgid ""
"The scale will be adapted to trigonometric functions. This works both for "
"radians and degrees."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:181
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Show Sliders</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:185
#, no-c-format
msgid "<action>Toggles</action> the visibility of the slider dialog."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:190
#, no-c-format
msgid "<guimenu>Edit</guimenu><guimenuitem>Coordinate System I</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:192
#, no-c-format
msgid "Show both positive and negative x- and y-values on the grid."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:198
#, no-c-format
msgid "<guimenu>Edit</guimenu><guimenuitem>Coordinate System II</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:200
#, no-c-format
msgid "Show positive and negative y-values, but positive x-values only"
msgstr ""

#. Tag: menuchoice
#: commands.docbook:206
#, no-c-format
msgid "<guimenu>Edit</guimenu><guimenuitem>Coordinate System III</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:208
#, no-c-format
msgid "Show only positive x- and y-values."
msgstr ""

#. Tag: title
#: commands.docbook:216
#, no-c-format
msgid "The <guimenu>Tools</guimenu> Menu"
msgstr ""

#. Tag: para
#: commands.docbook:218
#, no-c-format
msgid "This menu contains some tools for the functions that can be useful:"
msgstr ""

#. Tag: menuchoice
#: commands.docbook:223
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Get y-Value...</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:227
#, no-c-format
msgid ""
"Let the user get the y-value from a specific x-value. Type a value or "
"expression in the text box under \"X:\". In the list below all the available "
"functions are shown. Press Enter to calculate the function's y-value. The "
"result will be shown in the y-value box."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:232
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Search for Minimum Value...</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:236
#, no-c-format
msgid "Find the minimum value of the graph in a specified range."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:241
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Search for Maximum Value...</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:245
#, no-c-format
msgid "Find the maximum value of the graph in a specified range."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:250
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Calculate Integral</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:254
#, no-c-format
msgid ""
"Select a graph and the x-values in the new dialog that appears. Calulates "
"the integral and draws the area between the graph and the x-axis in the "
"range of the selected x-values in the color of the graph."
msgstr ""

#. Tag: title
#: commands.docbook:264
#, no-c-format
msgid "The <guimenu>Settings</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: commands.docbook:268
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Show/Hide Statusbar</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:272
#, no-c-format
msgid ""
"<action>Toggle on and off the display of the status bar at the bottom of the "
"&kmplot; main window.</action> The default is on."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:283
#, no-c-format
msgid ""
"<shortcut> <keycombo>&Ctrl;&Shift;<keycap>F</keycap></keycombo> </shortcut> "
"<guimenu>Settings</guimenu> <guimenuitem>Full Screen Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:290
#, no-c-format
msgid "With this action you toggle the full screen mode."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:295
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:299
#, no-c-format
msgid "<action>Personalize the keybindings</action> for &kmplot;."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:304
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Toolbars...</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:308
#, no-c-format
msgid "<action>Personalize the toolbars</action> for &kmplot;."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:313
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure &kmplot;...</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:317
#, no-c-format
msgid ""
"<action>Customize</action> &kmplot;. The options available to you are "
"described in <xref linkend=\"configuration\"/>."
msgstr ""

#. Tag: menuchoice
#: commands.docbook:323
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Show/Hide Toolbar</guimenuitem>"
msgstr ""

#. Tag: para
#: commands.docbook:327
#, no-c-format
msgid ""
"<action>Toggle on and off the display of the toolbar.</action> The default "
"is on."
msgstr ""

#. Tag: title
