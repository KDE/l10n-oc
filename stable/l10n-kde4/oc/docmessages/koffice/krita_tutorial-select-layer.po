#, no-c-format
msgid ""
"The image above is the image we will work with. Start krita with this image "
"(in the documentation folder <filename>$<envar>KDEDIR</envar>/share/doc/HTML/"
"en/krita/tutorial-select-layer-sample.png</filename>) and save it to your "
"Home folder (by choosing <guilabel>Save Image As...</guilabel>). Then open "
"it in &krita; &mdash; your screen will look a bit like this (we have zoomed "
"in):"
msgstr ""

