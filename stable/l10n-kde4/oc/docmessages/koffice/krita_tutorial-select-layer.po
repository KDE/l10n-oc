#. Tag: para
#: tutorial-select-layer.docbook:75
#, no-c-format
msgid ""
"If you accidentally select too much, you can cut that part easily off by "
"switching the tool to <guilabel>Subtract</guilabel> mode:"
msgstr ""

#. Tag: screeninfo
#: tutorial-select-layer.docbook:80
#, no-c-format
msgid "<screeninfo>The <guilabel>Subtract</guilabel> mode</screeninfo>"
msgstr ""

#. Tag: phrase
