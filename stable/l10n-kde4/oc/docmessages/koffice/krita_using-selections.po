#. Tag: title
#: using-selections.docbook:163
#, no-c-format
msgid "<title>Selecting similar colors</title>"
msgstr ""

#. Tag: para
#: using-selections.docbook:164
#, no-c-format
msgid ""
"The <guilabel>Select Similar</guilabel> tool lets you pick a pixel and then "
"select all pixels that have a similar color. Picking a color in one corner "
"of the image may select a pixel in another corner if they have similar "
"color. With the <guilabel>Fuzziness</guilabel> option you can set how "
"similar the colors must be to become selected."
msgstr ""

