msgid ""
"This menu contains a list of the elements that are in the currently loaded "
"toolbars. If you have the Standard (&HTML;) toolbar loaded, the <guimenu> "
"Tags</guimenu> menu will contain a submenu <guisubmenu>Standard </"
"guisubmenu> which will contain the list of tags/actions on that toolbar."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:1736
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>E</keycap></keycombo> </"
"shortcut> <guimenu>Tags</guimenu> <guimenuitem>Edit Current Tag...</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:1745
#, no-c-format
msgid ""
"Allows you to access the current markup tag settings dialog if one exists. "
"This entry is always present, followed by the &DTD; specific submenus."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:1754
#, no-c-format
msgid ""
"<guimenu>Tags</guimenu> <guimenuitem>Select Current Tag Area</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:1760
#, no-c-format
msgid ""
"This highlights the current tag area. The tag area begins where the mouse "
"cursor is placed."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:1768
#, no-c-format
msgid "<guimenu>Tags</guimenu> <guimenuitem>Smart Tag Insertion</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:1774
#, no-c-format
msgid ""
"Activates/deactivates the smart insertion of tags. Currently it works only "
"in (X)HTML DTDs. Smart insertion means that &quantaplus; will refuse to "
"insert a tag using the toolbar if the tag cannot be present in the current "
"location."
msgstr ""

#. Tag: title
#: quanta-menus.docbook:1783
#, no-c-format
msgid "The <guimenu>Plugins</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:1788
#, no-c-format
msgid ""
"<guimenu>Plugins</guimenu> <guimenuitem><replaceable>Plugin</replaceable></"
"guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:1794
#, no-c-format
msgid ""
"The <menuchoice><guimenu>Plugins</guimenu></menuchoice> menu lists the "
"available plugins under the above menu items. Clicking them will activate "
"them. Clicking an activated plugin will deactivate it."
msgstr ""

#. Tag: title
#: quanta-menus.docbook:1806
#, no-c-format
msgid "The <guimenu>Tools</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:1812
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guisubmenu>Highlight Mode</guisubmenu>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:1818
#, no-c-format
msgid ""
"Choose the syntax highlighting mode for the current file. The list of "
"available highlighting schemes varies depending on your version of &kate;."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:1827
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guisubmenu>End of Line</guisubmenu>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:1833
#, no-c-format
msgid ""
"Select the end of line encoding type. Useful if you have folks using other "
"&OS; platforms to develop on. Choose from <guimenuitem>Unix</guimenuitem>, "
"<guimenuitem>Windows/DOS</guimenuitem> or <guimenuitem>Macintosh</"
"guimenuitem>."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:1845
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>I</keycap></keycombo> </"
"shortcut> <guimenu>Tools</guimenu> <guimenuitem>Indent</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:1854
#, no-c-format
msgid "Move the selected block of text one tab width to the right."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:1862
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>I</keycap></"
"keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Unindent</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:1871
#, no-c-format
msgid "Move the selected block of text one tab width to the left."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:1879
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Clean Indentation</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:1885
#, no-c-format
msgid "Removes all indentation."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:1892
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>D</keycap></keycombo> </"
"shortcut> <guimenu>Tools</guimenu> <guimenuitem>Comment</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:1901
#, no-c-format
msgid "Comments selected text."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:1909
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>D</keycap></"
"keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>Uncomment</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:1918
#, no-c-format
msgid "Uncomments selected text."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:1926
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Word Wrap Document</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:1932
#, no-c-format
msgid "Wrap the text in the current window to a predefined width."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:1940
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Spelling...</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:1946
#, no-c-format
msgid "Check the spelling in the current document."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:1954
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Document Properties</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:1960
#, no-c-format
msgid ""
"Edit specific properties of a currently loaded document when using the "
"<guilabel>&VPL; Editor</guilabel>."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:1969
#, no-c-format
msgid ""
"<guimenu>Tools</guimenu> <guimenuitem>Convert Tag &amp; Attribute Case...</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:1975
#, no-c-format
msgid "Convert all tags and/or attributes character cases to another."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:1983
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Alt;&Ctrl;<keycap>T</keycap></"
"keycombo> </shortcut> <guimenu>Tools</guimenu> <guimenuitem>HTML Tidy Syntax "
"Checking</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:1992
#, no-c-format
msgid ""
"Checks the syntax of the current document against the selected &DTD; using "
"the external <filename>tidy</filename> application."
msgstr ""

#. Tag: title
#: quanta-menus.docbook:2001
#, no-c-format
msgid "The <guimenu>Window</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:2005
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>W</keycap></keycombo> </"
"shortcut> <guimenu>Window</guimenu> <guimenuitem>Close</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:2014
#, no-c-format
msgid "Closes the current tab (document, plugin, preview or documentation)."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:2021
#, no-c-format
msgid "<guimenu>Window</guimenu> <guimenuitem>Close All</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:2027
#, no-c-format
msgid "Closes all opened tabs."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:2034
#, no-c-format
msgid "<guimenu>Window</guimenu> <guimenuitem>MDI Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:2040
#, no-c-format
msgid ""
"On-the-fly switching between different UI modes. Due to some limitations in "
"the KDE libraries, the switching might take time and cause ugly artifacts. "
"The recommended modes to use are <guilabel>IDEAl Mode</guilabel>, which is "
"the default or <guilabel>Tab Page Mode</guilabel>, which is the same mode "
"that was present in &quantaplus; 3.2 and earlier versions."
msgstr ""

#. Tag: para
#: quanta-menus.docbook:2048
#, no-c-format
msgid ""
"Furthermore this menu contains an entry for every opened tab. By selecting "
"such an entry, that selected tab will become the active one."
msgstr ""

#. Tag: title
#: quanta-menus.docbook:2052
#, no-c-format
msgid "The <guimenu>Settings</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:2057
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Toolbars</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:2063
#, no-c-format
msgid "Show or hide the non-user toolbars."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:2070
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Show/Hide DTD Toolbar</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:2076
#, no-c-format
msgid "Toggle on and off the display of the &DTD; specific toolbar."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:2084
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Show/Hide Statusbar</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:2090
#, no-c-format
msgid ""
"Toggle on and off the display of the status bar at the bottom of the main "
"&quantaplus; window."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:2098
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Quanta...</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:2104
#, no-c-format
msgid ""
"Setup the <link linkend=\"configure-quanta\">behavior</link> of &quantaplus;."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:2112
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Preview...</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:2118
#, no-c-format
msgid "Setup the behavior of the integrated preview."
msgstr ""

#. Tag: para
#: quanta-menus.docbook:2119
#, no-c-format
msgid ""
"The changes made in the dialog have effects on every application using the "
"KHTML part, including the &konqueror; web browser."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:2127
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Actions...</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:2133
#, no-c-format
msgid ""
"This is where you define the actions for use on toolbars. See <xref linkend="
"\"user-actions\"/>."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:2141
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Plugins...</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:2147
#, no-c-format
msgid "This is where you can define and modify the plugins."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:2155
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Editor...</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:2161
#, no-c-format
msgid ""
"Setup the behavior of the editor window. See the documentation on &kate; for "
"details."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:2170
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Toolbars...</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:2176
#, no-c-format
msgid ""
"Dialog that allows you to add/delete items to/from toolbars and change the "
"order the icons appear in."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:2185
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure Shortcuts...</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:2191
#, no-c-format
msgid ""
"Allows you to configure the many editor shortcuts available to &quantaplus;."
msgstr ""

#. Tag: title
#: quanta-menus.docbook:2202
#, no-c-format
msgid "The <guimenu>Help</guimenu> Menu"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:2204
#, no-c-format
msgid ""
"&quantaplus; contains a standard &kde; <guimenu>Help</guimenu> menu with the "
"addition of these items:"
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:2212
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>H</keycap></keycombo> </"
"shortcut> <guimenu>Help</guimenu> <guimenuitem>Context Help</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:2221
#, no-c-format
msgid ""
"This should produce help based on the current pointer context. At the time "
"of this writing this feature is not implemented."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:2230
#, no-c-format
msgid "<guimenu>Help</guimenu> <guimenuitem>Make A Donation</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:2236
#, no-c-format
msgid ""
"&quantaplus; is a high quality product that is freely available, and freely "
"licensed, but like any open source project, its developers can always use "
"help. If you would like to support &quantaplus; development in a financial "
"manner, you can find out how to here."
msgstr ""

#. Tag: para
#: quanta-menus.docbook:2247
#, no-c-format
msgid "The standard &kde; help menu items are as follows:"
msgstr ""

