#. Tag: menuchoice
#: quanta-menus.docbook:743
#, no-c-format
msgid ""
"<guimenu>View</guimenu><guisubmenu>Tool Views</guisubmenu> <guimenuitem>Show "
"Document Structure</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:749
#, no-c-format
msgid "Toggle display of the document structure tree."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:757
#, no-c-format
msgid ""
"<guimenu>View</guimenu><guisubmenu>Tool Views</guisubmenu> <guimenuitem>Show "
"Attribute Editor</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:763
#, no-c-format
msgid "Toggle display of the attribute tree."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:771
#, no-c-format
msgid ""
"<guimenu>View</guimenu><guisubmenu>Tool Views</guisubmenu> <guimenuitem>Show "
"Documentation</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:777
#, no-c-format
msgid "Toggle display of the documentation tree."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:784
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>M</keycap></keycombo> </"
"shortcut> <guimenu>View</guimenu><guisubmenu>Tool Views</guisubmenu> "
"<guimenuitem>Show Messages</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:793
#, no-c-format
msgid ""
"Toggle display of the message window. This is the window where you see the "
"output of any scripting actions and the debugger."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:802
#, no-c-format
msgid ""
"<guimenu>View</guimenu><guisubmenu>Tool Views</guisubmenu> <guimenuitem>Show "
"Problems</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:808
#, no-c-format
msgid ""
"Toggle display of the <guilabel>Problem Reporter</guilabel> at the bottom of "
"the main &quantaplus; window. The <guilabel>Problem Reporter</guilabel> "
"activates when you switch to the <guilabel>Structure Tree</guilabel>."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:818
#, no-c-format
msgid ""
"<guimenu>View</guimenu><guisubmenu>Tool Views</guisubmenu> <guimenuitem>Show "
"Annotations</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:824
#, no-c-format
msgid ""
"Shows the annotation view. Read the <xref linkend=\"annotations\"/> for "
"details."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:832
#, no-c-format
msgid ""
"<guimenu>View</guimenu><guisubmenu>Tool Views</guisubmenu> <guimenuitem>Show "
"Upload Profile:...</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:838
#, no-c-format
msgid ""
"Shows the files on the server for an <link linkend=\"upload-profiles"
"\">upload profile</link>."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:851
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Shift;<keycap>F9</keycap></keycombo> "
"</shortcut> <guimenu>View</guimenu> <guimenuitem>Show Icon Border</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:860
#, no-c-format
msgid ""
"Toggle display of the icon border to the left of the main editor window. "
"This bar allows for click toggling of bookmarks."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:869
