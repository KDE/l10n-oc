#. Tag: title
#: quanta-menus.docbook:53
#, no-c-format
msgid "The <guimenu>File</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:58
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>New</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:67
#, no-c-format
msgid "Create a new, blank file."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:75
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>O</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Open...</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:84
#, no-c-format
msgid "Search the file system to open an existing file."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:92
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Open Recent</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:98
#, no-c-format
msgid ""
"Quick list of the last several files you've opened. This list will change "
"each time you open a file that is not on it, with the oldest being bumped "
"off first."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:109
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Save</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:118
#, no-c-format
msgid "Save the active file's changes."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:126
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Save As...</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:132
#, no-c-format
msgid "Save the active file with another name."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:140
#, no-c-format
msgid "<guimenu>File</guimenu> <guisubmenu>Save as Template</guisubmenu>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:146
#, no-c-format
msgid ""
"This allows you to save code snippets and entire files as a template for "
"later use. See the section on <link linkend=\"templates-3-2\">templates</"
"link>. If you try to save the selected text/file outside of the local/"
"project template dir, then you will receive an error."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:156
#, no-c-format
msgid ""
"<guimenu>File</guimenu> <guisubmenu>Save as Template</guisubmenu> "
"<guisubmenu>Save as Local Template...</guisubmenu>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:163
#, no-c-format
msgid "Allows you to save a file as a template within the local scope."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:171
#, no-c-format
msgid ""
"<guimenu>File</guimenu> <guisubmenu>Save as Template</guisubmenu> "
"<guisubmenu>Save as Project Template...</guisubmenu>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:178
#, no-c-format
msgid "Allows you to save a file as a template within the project scope."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:186
#, no-c-format
msgid ""
"<guimenu>File</guimenu> <guisubmenu>Save as Template</guisubmenu> "
"<guisubmenu>Save Selection to Local Template File...</guisubmenu>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:193
#, no-c-format
msgid ""
"Allows you to save the selected text (&eg; a code snippet) in a local "
"template file."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:202
#, no-c-format
msgid ""
"<guimenu>File</guimenu> <guisubmenu>Save as Template</guisubmenu> "
"<guisubmenu>Save Selection to Project Template File...</guisubmenu>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:209
#, no-c-format
msgid ""
"Allows you to save the selected text (&eg; a code snippet) in a project "
"template file."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:222
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>S</keycap></"
"keycombo> </shortcut> <guimenu>File</guimenu> <guimenuitem>Save All...</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:231
#, no-c-format
msgid "Save all modified files in the editor."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:239
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Shift;<keycap>F5</keycap></keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Reload</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:248
#, no-c-format
msgid "Reloads the current focused document."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:256
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>P</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Print...</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:265
#, no-c-format
msgid ""
"You can actually print out your documents. Uses the <application>kprinter </"
"application> interface."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:305
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> </"
"shortcut> <guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:314
#, no-c-format
msgid "Exit &quantaplus;"
msgstr ""

#. Tag: title
#: quanta-menus.docbook:324
#, no-c-format
msgid "The <guimenu>Edit</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:329
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Z</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Undo</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:338
#, no-c-format
msgid "Undo the last action performed."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:346
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>Z</keycap></"
"keycombo> </shortcut> <guimenu>Edit</guimenu> <guimenuitem>Redo</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:355
#, no-c-format
msgid "Redo the last action undone."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:363
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>X</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Cut</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:372
#, no-c-format
msgid "Cut the current block of text and place its contents on the clipboard."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:380
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>C</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Copy</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:389
#, no-c-format
msgid "Copy the current block of text to the clipboard."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:397
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>V</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Paste</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:406
#, no-c-format
msgid "Paste the contents of the clipboard at the current cursor position."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:414
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guisubmenu>Paste Special</guisubmenu>"
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:424
#, no-c-format
msgid ""
"<guimenu>Edit</guimenu> <guisubmenu>Paste Special</guisubmenu> "
"<guimenuitem>Paste HTML Quoted</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:431
#, no-c-format
msgid ""
"Converts the clipboard text &HTML; special characters to &HTML; entities "
"before pasting into the text body, so they show up properly when viewed and "
"aren't picked up as tags by the client browser."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:440
#, no-c-format
msgid ""
"<guimenu>Edit</guimenu> <guisubmenu>Paste Special</guisubmenu> "
"<guimenuitem>Paste &URL; Encoded</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:447
#, no-c-format
msgid ""
"Converts the clipboard text into &URL; encoding, which is the correct way to "
"include special characters and spaces into &URL;s. Used primarily when "
"pasting a &URL; into an anchor tag."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:460
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>A</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Select All</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:469
#, no-c-format
msgid "Select all of the text in the current document."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:477
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>A</keycap></"
"keycombo> </shortcut> <guimenu>Edit</guimenu> <guimenuitem>Deselect</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:486
#, no-c-format
msgid "Unselect all text in the current document."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:494
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>B</keycap></"
"keycombo> </shortcut> <guimenu>Edit</guimenu> <guimenuitem>Block Selection "
"Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:503
#, no-c-format
msgid ""
"Turn on/off block highlighting. Allows you to select text blocks with your "
"keyboard without holding down the shift key."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:512
#, no-c-format
msgid ""
"<shortcut> <keycap>Insert</keycap> </shortcut> <guimenu>Edit</guimenu> "
"<guimenuitem>Overwrite Mode</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:521
#, no-c-format
msgid "Overrides the Insert key."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:529
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>F</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find...</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:538
#, no-c-format
msgid "String or regular expression pattern to find in the current document."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:546
#, no-c-format
msgid ""
"<shortcut> <keycap>F3</keycap> </shortcut> <guimenu>Edit</guimenu> "
"<guimenuitem>Find Next</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:555
#, no-c-format
msgid "Repeat the find downward in the document from the current location."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:563
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Shift;<keycap>F3</keycap></keycombo> "
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find Previous</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:572
#, no-c-format
msgid "Repeat the find upward in the document from the current location."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:580
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>R</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Replace...</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:589
#, no-c-format
msgid "String or regular expression replacement of text in the current file."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:597
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>G</keycap></keycombo> </"
"shortcut> <guimenu>Edit</guimenu> <guimenuitem>Go to Line...</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:606
#, no-c-format
msgid ""
"Go directly to a specific line number. This is really helpful when your "
"&PHP; script is breaking unexpectedly!"
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:615
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Alt;&Ctrl;<keycap>F</keycap></"
"keycombo> </shortcut> <guimenu>Edit</guimenu> <guimenuitem>Find in Files...</"
"guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:624
#, no-c-format
msgid ""
"Find a string or expression in files in the selected folder. Sort of a &GUI; "
"<command>grep</command> or <command>sed</command> with some predefined "
"pattern spaces to help you out."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:634
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;&Shift;<keycap>J</keycap></"
"keycombo> </shortcut> <guimenu>Edit</guimenu> <guimenuitem>Expand "
"Abbreviation</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:643
#, no-c-format
msgid ""
"Expands the abbreviations. Abbreviations can be defined in the <menuchoice> "
"<guimenu>Settings</guimenu> <guimenuitem>Configure Quanta...</guimenuitem> </"
"menuchoice> dialog."
msgstr ""

#. Tag: menuchoice
#: quanta-menus.docbook:654
#, no-c-format
msgid ""
"<guimenu>Edit</guimenu> <guimenuitem>Apply Source Indentation</guimenuitem>"
msgstr ""

#. Tag: para
#: quanta-menus.docbook:660
#, no-c-format
msgid ""
"Reformats the source code according to the same rules as the &VPL; part "
"inserts the tags."
msgstr ""

#. Tag: title
#: quanta-menus.docbook:671
#, no-c-format
msgid "The <guimenu>View</guimenu> Menu"
msgstr ""

#. Tag: menuchoice
